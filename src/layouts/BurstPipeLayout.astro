---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Burst Pipe Damage Restoration | Paramount Property Restoration",
  description = "24/7 Rapid Response for burst pipes in Florida. We stop the water, dry the property, and fix the damage."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts: Space Grotesk & Noto Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Burst Pipe Page */
        :root {
            --color-primary: #135bec; 
            --color-secondary: #f97316;
            --color-urgent: #dc2626; 
            
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Noto Sans', sans-serif;
        }
        
        /* Icon styles */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(229, 231, 235, 0.5);
        }
        .dark .glass-nav {
            background: rgba(16, 22, 34, 0.85);
            border-bottom: 1px solid rgba(55, 65, 81, 0.5);
        }
    </style>
</head>
<body class="bg-[#f6f6f8] dark:bg-[#101622] text-slate-900 dark:text-white font-body overflow-x-hidden antialiased transition-colors duration-200">
    <!-- Unified Header -->
    <Header 
        theme="light" 
        secondaryColor="#dc2626" 
        emergencyBtnText="Stop the Water" 
    />

    <slot />
    
    <!-- Footer from user HTML -->
    <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="text-left">
                <div class="flex items-center gap-2 mb-2">
                    <div class="flex items-center justify-center w-8 h-8 rounded bg-[#135bec] text-white">
                        <span class="material-symbols-outlined text-lg">water_drop</span>
                    </div>
                    <span class="text-lg font-bold text-slate-900 dark:text-white font-display">PARAMOUNT</span>
                </div>
                <p class="text-sm text-slate-500">© 2023 Paramount Property Restoration. All rights reserved.</p>
            </div>
            <div class="flex gap-6 text-sm font-medium text-slate-600 dark:text-slate-400">
                <a href="#" class="hover:text-[#135bec] transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-[#135bec] transition-colors">Terms of Service</a>
                <a href="#" class="hover:text-[#135bec] transition-colors">Sitemap</a>
            </div>
        </div>
    </footer>
</body>
</html>
