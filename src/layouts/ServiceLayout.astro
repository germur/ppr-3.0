---
import MainLayout from "./MainLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    description: string;
    themeColor?: string;
    heroImage: string | ImageMetadata;
    heroImagePosition?: string;
    schema?: Record<string, any>;
}

const {
    title,
    description,
    heroImage,
    heroImagePosition = "object-center",
    schema,
} = Astro.props;
---

<MainLayout title={title} description={description} customSchema={schema}>
    <!-- Hero Section -->
    <div
        class="relative w-full h-[500px] md:h-[600px] flex items-center justify-center overflow-hidden"
    >
        <div class="absolute inset-0 bg-black/50 z-10 transition-colors"></div>
        {
            typeof heroImage === "string" ? (
                <Image
                    src={heroImage}
                    alt={title}
                    class={`absolute inset-0 w-full h-full object-cover ${heroImagePosition}`}
                    quality={80}
                    format="webp"
                    inferSize={true}
                />
            ) : (
                <Image
                    src={heroImage}
                    alt={title}
                    class={`absolute inset-0 w-full h-full object-cover ${heroImagePosition}`}
                    quality={80}
                    format="webp"
                />
            )
        }

        <div
            class="relative z-20 flex flex-col items-center justify-center px-4 text-center max-w-4xl mx-auto"
        >
            <h1
                class="text-4xl md:text-6xl font-display font-bold text-white mb-6 drop-shadow-lg leading-tight"
            >
                {title}
            </h1>
            {
                description && (
                    <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto drop-shadow-md hidden md:block mb-8">
                        {description}
                    </p>
                )
            }
            <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
                <a
                    href="tel:7866022217"
                    class="flex items-center justify-center gap-2 h-12 md:h-14 px-6 md:px-8 bg-[#dc2626] hover:bg-red-700 text-white text-base md:text-lg font-bold rounded-lg shadow-lg hover:shadow-red-500/30 transition-all hover:-translate-y-0.5"
                >
                    <span
                        class="material-symbols-outlined text-[20px] md:text-[24px]"
                        >emergency_home</span
                    >
                    Dispatch Emergency Team
                </a>
                <a
                    href="/contact"
                    class="flex items-center justify-center gap-2 h-12 md:h-14 px-6 md:px-8 bg-white/10 hover:bg-white/20 text-white text-base md:text-lg font-bold rounded-lg backdrop-blur-sm border border-white/30 transition-all"
                >
                    <span
                        class="material-symbols-outlined text-[20px] md:text-[24px]"
                        >assignment</span
                    >
                    Free Evaluation
                </a>
            </div>
        </div>
    </div>

    <slot />
</MainLayout>
