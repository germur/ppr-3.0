---
import MainLayout from "./MainLayout.astro";

interface Props {
    title: string;
    description: string;
    themeColor?: string;
    heroImage: string;
    heroImagePosition?: string;
    schema?: Record<string, any>;
}

const {
    title,
    description,
    themeColor = "blue",
    heroImage,
    heroImagePosition = "object-center",
    schema,
} = Astro.props;
---

<MainLayout title={title} description={description} customSchema={schema}>
    <!-- Hero Section -->
    <div
        class="relative w-full h-[500px] md:h-[600px] flex items-center justify-center overflow-hidden"
    >
        <div class="absolute inset-0 bg-black/50 z-10 transition-colors"></div>
        <img
            src={heroImage}
            alt={title}
            class={`absolute inset-0 w-full h-full object-cover ${heroImagePosition}`}
        />

        <div
            class="relative z-20 flex flex-col items-center justify-center px-4 text-center max-w-4xl mx-auto"
        >
            <h1
                class="text-4xl md:text-6xl font-display font-bold text-white mb-6 drop-shadow-lg leading-tight"
            >
                {title}
            </h1>
            {
                description && (
                    <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto drop-shadow-md hidden md:block">
                        {description}
                    </p>
                )
            }
        </div>
    </div>

    <slot />
</MainLayout>
