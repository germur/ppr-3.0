---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Wind Damage Repair | Paramount Property Restoration",
  description = "Immediate board-up services and comprehensive structural repairs for wind damage in Florida."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Wind Damage Page */
        :root {
            --color-primary: #0d7ff2;
            --color-secondary: #f25c0d; /* Brand Specific Orange-Red */
            --color-background-light: #ffffff;
            --color-background-dark: #101922;
            --color-surface-light: #f3f4f6;
            --color-surface-dark: #1e293b;

            --font-display: 'Manrope', sans-serif;
            --font-body: 'Manrope', sans-serif;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        .bento-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .bento-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body class="bg-white dark:bg-[#101922] font-display text-slate-900 dark:text-white overflow-x-hidden selection:bg-[#f25c0d] selection:text-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Unified Header -->
    <Header 
        theme="light" 
        secondaryColor="#f25c0d" 
        emergencyBtnText="Emergency Board-Up" 
    />

    <slot />

    <!-- Footer -->
    <footer class="bg-[#101922] text-white pt-16 pb-8 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
                <div>
                    <div class="flex items-center gap-2 mb-6">
                        <div class="size-6 text-[#0d7ff2]">
                            <svg class="w-full h-full" fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 4C25.7818 14.2173 33.7827 22.2182 44 24C33.7827 25.7818 25.7818 33.7827 24 44C22.2182 33.7827 14.2173 25.7818 4 24C14.2173 22.2182 22.2182 14.2173 24 4Z" fill="currentColor"></path>
                            </svg>
                        </div>
                        <span class="text-xl font-bold">Paramount</span>
                    </div>
                    <p class="text-slate-400 text-sm mb-6">Restoring homes and businesses with integrity, speed, and precision. Your trusted local partner for disaster recovery.</p>
                    <div class="flex gap-4">
                        <a class="text-slate-400 hover:text-white" href="/contact/"><span class="material-symbols-outlined">social_leaderboard</span></a>
                        <a class="text-slate-400 hover:text-white" href="/contact/"><span class="material-symbols-outlined">photo_camera</span></a>
                        <a class="text-slate-400 hover:text-white" href="/contact/"><span class="material-symbols-outlined">alternate_email</span></a>
                    </div>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-4">Services</h3>
                    <ul class="space-y-2 text-sm text-slate-400">
                        <li><a class="hover:text-[#0d7ff2]" href="/restoration/water-damage/">Water Damage Restoration</a></li>
                        <li><a class="hover:text-[#0d7ff2]" href="/restoration/fire-damage/">Fire & Smoke Damage</a></li>
                        <li><a class="hover:text-[#0d7ff2]" href="/restoration/wind-damage/">Wind & Storm Repair</a></li>
                        <li><a class="hover:text-[#0d7ff2]" href="/restoration/mold-remediation/">Mold Remediation</a></li>
                        <li><a class="hover:text-[#0d7ff2]" href="/commercial/">Commercial Services</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-4">Resources</h3>
                    <ul class="space-y-2 text-sm text-slate-400">
                        <li><a class="hover:text-[#0d7ff2]" href="/resources/insurance-claims/">Insurance Claims Help</a></li>
                        <li><a class="hover:text-[#0d7ff2]" href="/resources/">Home Maintenance Tips</a></li>
                        <li><a class="hover:text-[#0d7ff2]" href="/service-areas/">Service Areas</a></li>

                        <li><a class="hover:text-[#0d7ff2]" href="/careers/">Careers</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-4">Contact</h3>
                    <ul class="space-y-3 text-sm text-slate-400">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-[#0d7ff2] text-[20px] mt-0.5">location_on</span>
                            <span>123 Restoration Way,<br/>Suite 100<br/>Orlando, FL 32801</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[#0d7ff2] text-[20px]">call</span>
                            <a class="hover:text-white" href="tel:1-800-555-4357">1-800-555-HELP</a>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[#0d7ff2] text-[20px]">mail</span>
                            <a class="hover:text-white" href="mailto:help@paramountrestoration.com">help@paramountrestoration.com</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
                <p>© 2024 Paramount Property Restoration. All rights reserved.</p>
                <div class="flex gap-6">
                    <a class="hover:text-slate-300" href="/privacy-policy/">Privacy Policy</a>
                    <a class="hover:text-slate-300" href="/terms-of-service/">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
