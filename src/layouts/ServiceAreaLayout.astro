---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SEO from '../components/common/SEO.astro';

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
  accentColor?: string;
  // pSEO Props
  city?: string;
  serviceName?: string;
  noindex?: boolean;
  customSchema?: any;
  faqItems?: { question: string; answer: string }[];
}

const { 
  title, 
  description, 
  themeColor = "#0f172a", 
  accentColor = "#f97316",
  city,
  serviceName,
  noindex,
  customSchema,
  faqItems
} = Astro.props;

// Defined explicitly to inject into :root for this page scope
const cssVariables = `
  :root {
    --color-primary: ${themeColor};
    --color-accent: ${accentColor};
    --font-display: 'Inter', sans-serif;
  }
`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    
    <SEO 
      title={title} 
      description={description || `Professional restoration services in ${title}`}
      schemaType="Service"
      city={city}
      serviceName={serviceName}
      noindex={noindex}
      customSchema={customSchema}
      faqData={faqItems}
    />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style set:html={cssVariables}></style>
  </head>
  <body class="font-display bg-[#f6f7f8] dark:bg-[#101822] text-[#111418] dark:text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
      
      <!-- TopNavBar (Standardized) -->
      <Header 
        sticky={true} 
        secondaryColor={accentColor} 
        variant="default" 
      />

      <slot />

      <!-- Footer (Standardized) -->
      <Footer />

    </div>
  </body>
</html>
