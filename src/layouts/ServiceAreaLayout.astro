---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title: string;
  themeColor: string;
  accentColor: string;
}

const { title, themeColor, accentColor } = Astro.props;

// Defined explicitly to inject into :root for this page scope
const cssVariables = `
  :root {
    --color-primary: ${themeColor};
    --color-accent: ${accentColor};
    --font-display: 'Inter', sans-serif;
  }
`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={title} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style set:html={cssVariables}></style>
  </head>
  <body class="font-display bg-[#f6f7f8] dark:bg-[#101822] text-[#111418] dark:text-white antialiased">
    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
      
      <!-- TopNavBar (Standardized) -->
      <Header 
        sticky={true} 
        secondaryColor={accentColor} 
        variant="default" 
      />

      <slot />

      <!-- Footer (Standardized) -->
      <footer class="bg-white dark:bg-[#101822] border-t border-gray-200 dark:border-gray-800 pt-16 pb-8">
        <div class="layout-container max-w-[1200px] mx-auto px-4 w-full">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-2 text-[#111418] dark:text-white">
                <span class="material-symbols-outlined text-3xl" style={`color: ${themeColor}`}>water_drop</span>
                <span class="font-bold text-xl">Paramount</span>
              </div>
                Trusted partner for property restoration. Professional & Experienced.
              </p>
            </div>
            <div>
              <h4 class="font-bold text-[#111418] dark:text-white mb-4">Services</h4>
              <ul class="flex flex-col gap-2 text-sm text-gray-500 dark:text-gray-400">
                <li><a class="hover:underline transition-colors" style={`color: ${themeColor}`} href="#">Water Damage Restoration</a></li>
                <li><a class="hover:underline transition-colors" style={`color: ${themeColor}`} href="#">Mold Remediation</a></li>
                <li><a class="hover:underline transition-colors" style={`color: ${themeColor}`} href="#">Fire Damage Repair</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-[#111418] dark:text-white mb-4">Company</h4>
              <ul class="flex flex-col gap-2 text-sm text-gray-500 dark:text-gray-400">

                <li><a class="hover:underline transition-colors" style={`color: ${themeColor}`} href="#">Contact</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-[#111418] dark:text-white mb-4">Contact</h4>
              <ul class="flex flex-col gap-3 text-sm text-gray-500 dark:text-gray-400">
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-sm" style={`color: ${themeColor}`}>call</span>
                  (786) 602-2217
                </li>
                <li class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-sm" style={`color: ${themeColor}`}>location_on</span>
                  Orlando, FL
                </li>
              </ul>
            </div>
          </div>
          <div class="border-t border-gray-100 dark:border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-400">
            <p>© 2024 Paramount Property Restoration. All rights reserved.</p>
          </div>
        </div>
      </footer>

    </div>
  </body>
</html>
