---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SEO from '../components/common/SEO.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string; 
  schemaType?: 'LocalBusiness' | 'Service' | 'Article' | 'FAQPage' | 'EmergencyService' | 'CleaningService';
  faqItems?: { question: string; answer: string }[];
  customSchema?: any;
  noindex?: boolean;
  city?: string;
  serviceName?: string;
  breadcrumbItems?: { label: string; href: string }[];
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { 
  title = "Paramount Property Restoration | Florida General Contractor",
  description = "Florida’s Trusted General Contractor for Restoration & Remodeling. From catastrophic storm recovery to luxury kitchen renovations.",
  image,
  type,
  schemaType,
  faqItems,
  customSchema,
  noindex,
  city,
  serviceName,
  hideHeader = false,
  hideFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
        
        <SEO 
          title={title}
          description={description}
          image={image}
          schemaType={schemaType}
          faqData={faqItems}
          customSchema={customSchema}
          noindex={noindex}
          city={city}
          serviceName={serviceName}
        />

        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans:wght@400;500;700;900&family=Oswald:wght@400;500;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
        <script>
            import { registerSW } from 'virtual:pwa-register';
            registerSW({
                immediate: true,
                onNeedRefresh() {
                    // Optional: show a prompt to user
                    console.log('New content available, reload to update.');
                },
                onOfflineReady() {
                    console.log('App is ready to work offline.');
                },
            });
        </script>
        <slot name="head" />
    <!-- Google Ads (Hardcoded) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17595666136"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17595666136');
    </script>
    </head>
    <body class="bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark font-body transition-colors duration-300">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
        
        { !hideHeader && <Header /> }

        <!-- Breadcrumbs (Auto-generated or Prop-based) -->
        {(() => {
            // Priority: Props > Auto-generated
            let items = Astro.props.breadcrumbItems;

            if (!items) {
                const path = Astro.url.pathname;
                if (path === '/' || path === '') return null;

                const parts = path.split('/').filter(Boolean);
                items = [{ label: 'Home', href: '/' }];

                let currentPath = '';
                parts.forEach((part, index) => {
                    currentPath += `/${part}`;
                    // Simple capitalization for label
                    let label = part.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
                    
                    // Special case for "Service Areas" to be shorter if deep
                    if (part === 'service-areas' && parts.length > 2) label = 'Areas';

                    items!.push({ label, href: currentPath });
                });
            }

            return items && items.length > 0 ? (
                <div class="bg-gray-50 dark:bg-black/20 border-b border-gray-200 dark:border-gray-800">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
                        <Breadcrumbs items={items} />
                    </div>
                </div>
            ) : null;
        })()}

        <slot />

        { !hideFooter && <Footer /> }
    </body>
</html>
