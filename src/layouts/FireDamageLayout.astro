---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Fire Damage Restoration Hub - Paramount Property Restoration",
  description = "24/7 Fire Damage Restoration. Immediate stabilization, smoke removal, and structural reconstruction. Restoration experts."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Fire Damage Page */
        :root {
             --color-primary: #135bec;
            --color-secondary: #f97316; /* Orange for urgency */
            --color-background-light: #f6f6f8;
            --color-background-dark: #0f172a; /* Deep slate for dark mode */
            --color-card-dark: #1e293b;
            --color-border-dark: #334155;
            --color-text-dim: #94a3b8;

            --font-display: 'Inter', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        body {
            font-family: 'Inter', sans-serif;
        }
        .glass-nav {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        
        /* Icon styles */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-[#0f172a] text-white overflow-x-hidden selection:bg-[#135bec] selection:text-white font-display">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Sticky Glass Navigation -->
    <Header 
        theme="light" 
        secondaryColor="#f97316" 
        emergencyBtnText="24/7 Fire Dispatch" 
    />

    <slot />
    
    <!-- Custom Footer -->
    <Footer />
</body>
</html>
