---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Expert Water Damage Restoration & Mitigation in Florida | Paramount Property Restoration",
  description = "Immediate dispatch for water emergencies. We use hospital-grade technology and licensed experts to extract, dry, and restore your property—fast."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Water Damage Section */
        :root {
            --color-primary: #137fec; /* Dominant Blue */
            --color-secondary: #ff6b00; /* Brand Orange */
            --font-display: 'Public Sans', sans-serif;
            --font-body: 'Noto Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-[#f8f9fa] text-[#111418] font-display antialiased selection:bg-primary/20 selection:text-primary transition-colors duration-200">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
        <!-- Unified Header -->
        <Header 
            theme="light" 
            secondaryColor="#ff6b00" 
            emergencyBtnText="24/7 Water Removal" 
        />

        <slot />
        
        <!-- Footer matches the provided HTML design -->
        <footer class="bg-[#111418] text-white pt-20 pb-10 border-t border-gray-800">
            <div class="max-w-[1280px] mx-auto px-4 md:px-10 lg:px-40">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-16">
                    <div class="col-span-1 md:col-span-2">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="size-8 bg-primary rounded-lg flex items-center justify-center">
                                <span class="material-symbols-outlined text-lg text-white">water_damage</span>
                            </div>
                            <h2 class="text-xl font-bold">Paramount Property Restoration</h2>
                        </div>
                        <p class="text-gray-400 text-sm leading-relaxed max-w-sm mb-6">
                            Florida's premier water damage restoration and remodeling experts. Dedicated to restoring your property with speed, integrity, and scientific precision.
                        </p>
                        <div class="flex gap-4">
                            <!-- Social placeholders -->
                            <a href="/contact/" class="size-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-primary hover:text-white transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-sm">public</span>
                            </a>
                            <a href="/contact/" class="size-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-primary hover:text-white transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-sm">mail</span>
                            </a>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-bold text-white mb-6">Services</h4>
                        <ul class="space-y-3 text-sm text-gray-400">
                            <li><a class="hover:text-primary" href="/restoration/water-damage/">Water Damage</a></li>
                            <li><a class="hover:text-primary" href="/restoration/fire-damage/">Fire Restoration</a></li>
                            <li><a class="hover:text-primary" href="/restoration/mold-remediation/">Mold Remediation</a></li>
                            <li><a class="hover:text-primary" href="/restoration/storm-damage/">Storm Damage</a></li>
                            <li><a class="hover:text-primary" href="/commercial/construction/">Reconstruction</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold text-white mb-6">Contact</h4>
                            <li class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-sm">phone</span>
                                <a href="tel:7866022217" class="hover:text-white transition-colors">(786) 602-2217 (24/7)</a>
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-sm">location_on</span>
                                10890 NW 17th St Suite 138<br/>Miami, FL 33172
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-sm">email</span>
                                <a href="mailto:services@paramountpropertyrestoration.com" class="hover:text-white transition-colors">services@paramountpropertyrestoration.com</a>
                            </li>
                    </div>
                </div>
                <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                    <p class="text-xs text-gray-500">© 2023 Paramount Property Restoration. All rights reserved.</p>
                    <div class="flex gap-6 text-xs text-gray-500">
                        <a class="hover:text-white" href="/privacy-policy/">Privacy Policy</a>
                        <a class="hover:text-white" href="/terms-of-service/">Terms of Service</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</body>
</html>
