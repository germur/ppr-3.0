---
import ServiceLayout from "./ServiceLayout.astro";

interface Props {
  title?: string;
  description?: string;
  schema?: any;
  heroImage?: string;
}

const {
  title = "Expert Water Damage Restoration & Mitigation in Florida | Paramount Property Restoration",
  description = "Immediate dispatch for water emergencies. We use hospital-grade technology and licensed experts to extract, dry, and restore your property—fast.",
  schema,
  heroImage = "/assets/images/water-damage.webp",
} = Astro.props;
---

<ServiceLayout
  title={title}
  description={description}
  schema={schema}
  themeColor="blue"
  heroImage={heroImage}
>
  <slot />
</ServiceLayout>
