---
import SEO from '../components/common/SEO.astro';
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="description" content="Expert Water Damage Restoration in Orlando. 24/7 Emergency Service, 60-minute response time." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/ppr-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body class="font-display bg-[#f6f7f8] dark:bg-[#101822] text-[#111418] dark:text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
      
      <!-- TopNavBar (Standardized) -->
      <Header 
        sticky={true} 
        secondaryColor="#1162d4" 
        variant="default" 
      />

      <slot />

      <!-- Footer (Strictly from HTML) -->
      <!-- Footer (Standardized) -->
      <Footer />

    </div>
  </body>
</html>

<style is:global>
  /* Explicitly Override Global Colors for this Layout */
  :root {
    --font-display: 'Inter', sans-serif;
    --color-primary: #1162d4;
    --color-accent: #f97316;
    --color-background-light: #f6f7f8;
    --color-background-dark: #101822;
  }
  
  html {
    font-family: 'Inter', sans-serif;
  }
</style>
