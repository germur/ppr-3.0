---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Ceiling Water Damage Repair | Paramount Property Restoration",
  description = "Emergency ceiling leak repair and restoration. We identify the source, stop the leak, and restore your property structurally and aesthetically."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts: Space Grotesk -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Ceiling Leak Page */
        :root {
            --color-primary: #135bec; 
            --color-secondary: #f97316;
            --color-urgent: #f97316; 
            
            /* User HTML applies font-display (Space Grotesk) to the body */
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Space Grotesk', sans-serif; 
        }
        
        /* Icon styles */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-[#f6f6f8] dark:bg-[#101622] text-slate-900 dark:text-white font-display overflow-x-hidden antialiased selection:bg-[#135bec] selection:text-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Unified Header -->
    <Header />

    <slot />
    
    <!-- Footer from user HTML -->
    <footer class="bg-[#101622] py-12 text-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid gap-8 md:grid-cols-4">
                <div class="col-span-1 md:col-span-2">
                    <h2 class="text-xl font-bold">Paramount Property Restoration</h2>
                    <p class="mt-4 max-w-xs text-sm text-slate-400">Your trusted partner for restoration, remodeling, and commercial services. We bring your property back to life.</p>
                </div>
                <div>
                    <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-slate-400">Quick Links</h3>
                    <ul class="space-y-2 text-sm text-slate-300">
                        <li><a href="#" class="hover:text-[#135bec] transition-colors">Water Damage</a></li>
                        <li><a href="#" class="hover:text-[#135bec] transition-colors">Fire Restoration</a></li>
                        <li><a href="#" class="hover:text-[#135bec] transition-colors">Mold Remediation</a></li>
                        <li><a href="#" class="hover:text-[#135bec] transition-colors">Reconstruction</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-slate-400">Contact</h3>
                    <ul class="space-y-2 text-sm text-slate-300">
                        <li class="flex items-center gap-2"><span class="material-symbols-outlined text-sm">phone</span> (555) 123-4567</li>
                        <li class="flex items-center gap-2"><span class="material-symbols-outlined text-sm">mail</span> help@ppr-restoration.com</li>
                        <li class="flex items-center gap-2"><span class="material-symbols-outlined text-sm">location_on</span> Serving Greater Florida</li>
                    </ul>
                </div>
            </div>
            <div class="mt-12 border-t border-slate-800 pt-8 text-center text-xs text-slate-500">
                © 2023 Paramount Property Restoration. All rights reserved.
            </div>
        </div>
    </footer>
    
    <!-- FAB for mobile from user HTML -->
    <div class="fixed bottom-4 right-4 z-40 md:hidden">
        <button class="flex size-14 items-center justify-center rounded-full bg-[#f97316] text-white shadow-xl shadow-orange-500/30">
            <span class="material-symbols-outlined text-2xl">phone_in_talk</span>
        </button>
    </div>
</body>
</html>
