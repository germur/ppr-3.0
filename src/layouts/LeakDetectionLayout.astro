---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Non-Invasive Water Leak Detection - Paramount Property Restoration",
  description = "Find hidden leaks without destruction. Thermal imaging, acoustic listening, and moisture mapping experts in Florida."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts: Space Grotesk & Noto Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Leak Detection */
        :root {
            --color-primary: #135bec; 
            --color-secondary: #f97316;
            --color-urgent: #f97316; 
            
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Noto Sans', sans-serif;
        }
        
        /* Icon styles from user HTML */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .filled-icon {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-[#f8fafc] dark:bg-[#101622] text-slate-900 dark:text-white font-body overflow-x-hidden antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Unified Header -->
    <Header 
        theme="light" 
        secondaryColor="#0d7ff2" 
        emergencyBtnText="Find my Leak" 
    />

    <slot />
    
    <!-- Footer from user HTML -->
    <footer class="bg-slate-900 text-white pt-16 pb-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
                <div class="col-span-1 lg:col-span-1">
                    <div class="flex items-center gap-2 mb-6">
                        <span class="material-symbols-outlined text-[#135bec] text-3xl">water_drop</span>
                        <span class="font-display font-bold text-xl">Paramount</span>
                    </div>
                    <p class="text-slate-400 text-sm mb-6">
                        Leading the industry in non-invasive leak detection and property restoration across Florida.
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="text-slate-400 hover:text-white transition-colors"><span class="material-symbols-outlined">social_leaderboard</span></a>
                        <a href="#" class="text-slate-400 hover:text-white transition-colors"><span class="material-symbols-outlined">smart_display</span></a>
                        <a href="#" class="text-slate-400 hover:text-white transition-colors"><span class="material-symbols-outlined">photo_camera</span></a>
                    </div>
                </div>
                <div class="col-span-1 lg:col-span-3">
                    <h4 class="text-lg font-bold font-display mb-6 border-b border-slate-800 pb-2">Local Service Areas</h4>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm text-slate-400">
                        <a href="#" class="hover:text-[#135bec] transition-colors">Miami Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Ft. Lauderdale Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Boca Raton Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">West Palm Beach Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Orlando Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Tampa Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Jacksonville Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Naples Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Sarasota Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Kissimmee Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Coral Gables Leak Detection</a>
                        <a href="#" class="hover:text-[#135bec] transition-colors">Hollywood Leak Detection</a>
                    </div>
                </div>
            </div>
            <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-slate-500 gap-4">
                <p>© 2023 Paramount Property Restoration. All rights reserved.</p>
                <div class="flex gap-6">
                    <a href="#" class="hover:text-slate-300">Privacy Policy</a>
                    <a href="#" class="hover:text-slate-300">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>
    
    <!-- Sticky Mobile Emergency Bar -->
    <div class="fixed bottom-0 left-0 w-full bg-[#f97316] z-50 md:hidden shadow-[0_-4px_10px_rgba(0,0,0,0.1)]">
        <a href="tel:888-555-LEAK" class="flex items-center justify-center gap-2 p-4 text-white font-bold text-lg w-full">
            <span class="material-symbols-outlined animate-pulse filled-icon">notifications_active</span>
            Emergency: 888-555-LEAK
        </a>
    </div>
</body>
</html>
