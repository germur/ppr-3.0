---
import "../styles/global.css";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import { COMPANY_INFO } from "../data/company";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Hurricane Damage Restoration | Paramount Property Restoration",
    description = "Immediate mobilization and readiness. 24/7 Rapid Response Teams standing by for dispatch covering Miami-Dade, Broward, and Palm Beach.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <!-- Google Tag Manager -->
        <script is:inline>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    "gtm.start": new Date().getTime(),
                    event: "gtm.js",
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-WG5DT6GN");
        </script>
        <!-- End Google Tag Manager -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link href="https://fonts.googleapis.com" rel="preconnect" />
        <link
            crossorigin=""
            href="https://fonts.gstatic.com"
            rel="preconnect"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />

        <style>
            /* Scoped Variables for Hurricane Page */
            :root {
                --color-primary: #1162d4;
                --color-secondary: #f97316;
                --color-background-light: #f6f7f8;
                --color-background-dark: #101822;
                --color-alert: #dc2626;

                --font-display: "Inter", sans-serif;
                --font-body: "Inter", sans-serif;
            }

            .pulsate-btn {
                animation: shadow-pulse 1.5s infinite;
            }
            @keyframes shadow-pulse {
                0% {
                    box-shadow: 0 0 0 0px rgba(249, 115, 22, 0.7);
                }
                100% {
                    box-shadow: 0 0 0 15px rgba(249, 115, 22, 0);
                }
            }
        </style>
    </head>
    <body
        class="bg-[#f8fafc] dark:bg-[#0f172a] font-sans antialiased text-slate-600 dark:text-slate-400 overflow-x-hidden antialiased"
    >
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->
        <!-- Sticky Header Wrapper -->
        <div class="sticky top-0 z-50 w-full shadow-md">
            <!-- Disaster Mode Alert Bar -->
            <div
                class="bg-[#dc2626] text-white px-4 py-3 flex items-center justify-center gap-2 font-bold text-sm md:text-base text-center relative overflow-hidden"
            >
                <span
                    class="material-symbols-outlined animate-pulse text-yellow-300"
                    >warning</span
                >
                <span class="tracking-wide uppercase"
                    >24/7 Hurricane Response Unit Active - Immediate Deployment
                    Available</span
                >
            </div>

            <!-- Main Navigation -->
            <Header
                theme="light"
                secondaryColor="#f97316"
                emergencyBtnText={COMPANY_INFO.phone}
                logoText="Paramount Property Restoration"
                sticky={false}
            />
        </div>

        <main class="flex flex-col w-full">
            <slot />

            <!-- CTA Footer -->
            <Footer />
        </main>
    </body>
</html>
