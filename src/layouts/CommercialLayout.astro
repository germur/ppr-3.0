---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Paramount Property Restoration | Commercial Services",
  description = "Commercial Restoration & Construction Leaders in Florida."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        /* Scoped Variables for Commercial Section to override Global Defaults */
        :root {
            --color-primary: #137fec;
            --color-secondary: #f97316;
            --font-display: 'Inter', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="font-display bg-[#f6f7f8] dark:bg-[#101922] text-slate-900 dark:text-white overflow-x-hidden transition-colors duration-200">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Top Navigation -->
    <!-- Top Navigation -->
    <Header 
        secondaryColor="#f97316" 
    />

    <slot />

    <!-- Footer -->
    <footer class="bg-slate-900 text-white pt-20 pb-10">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
                <div>
                    <div class="flex items-center gap-2 mb-6">
                        <div class="w-8 h-8 text-primary">
                            <svg class="w-full h-full" fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 4C25.7818 14.2173 33.7827 22.2182 44 24C33.7827 25.7818 25.7818 33.7827 24 44C22.2182 33.7827 14.2173 25.7818 4 24C14.2173 22.2182 22.2182 14.2173 24 4Z" fill="currentColor"></path>
                            </svg>
                        </div>
                        <h2 class="text-xl font-bold">Paramount</h2>
                    </div>
                    <p class="text-slate-400 mb-6">Florida's trusted partner for commercial restoration, construction, and disaster recovery.</p>
                    <div class="flex gap-4">
                        <a class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary transition-colors text-white" href="/contact/"><span class="material-symbols-outlined text-sm">public</span></a>
                        <a class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary transition-colors text-white" href="/contact/"><span class="material-symbols-outlined text-sm">chat_bubble</span></a>
                        <a class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary transition-colors text-white" href="/contact/"><span class="material-symbols-outlined text-sm">mail</span></a>
                    </div>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-6">Services</h3>
                    <ul class="space-y-4 text-slate-400">
                        <li><a class="hover:text-white transition-colors" href="/restoration/water-damage/">Water Damage Restoration</a></li>
                        <li><a class="hover:text-white transition-colors" href="/restoration/fire-damage/">Fire & Smoke Damage</a></li>
                        <li><a class="hover:text-white transition-colors" href="/restoration/mold-remediation/">Mold Remediation</a></li>
                        <li><a class="hover:text-white transition-colors" href="/commercial/construction/">Commercial Construction</a></li>
                        <li><a class="hover:text-white transition-colors" href="/commercial/">Disaster Planning (ERP)</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-6">Industries</h3>
                    <ul class="space-y-4 text-slate-400">
                        <li><a class="hover:text-white transition-colors" href="/commercial/">Healthcare Facilities</a></li>
                        <li><a class="hover:text-white transition-colors" href="/commercial/">Educational Institutions</a></li>
                        <li><a class="hover:text-white transition-colors" href="/commercial/">Hospitality & Tourism</a></li>
                        <li><a class="hover:text-white transition-colors" href="/commercial/">Property Management</a></li>
                        <li><a class="hover:text-white transition-colors" href="/commercial/">Government Buildings</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-6">Contact Us</h3>
                    <ul class="space-y-4 text-slate-400">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-primary mt-1">location_on</span>
                            <span>10890 NW 17th St Suite 138,<br />Miami, FL 33172</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary">phone</span>
                            <a href="tel:7866022217" class="hover:text-white transition-colors">(786) 602-2217</a>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary">email</span>
                            <a href="mailto:services@paramountpropertyrestoration.com" class="hover:text-white transition-colors">services@paramountpropertyrestoration.com</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
                <p>© 2024 Paramount Property Restoration. All rights reserved.</p>
                <div class="flex gap-8">
                    <a class="hover:text-white transition-colors" href="/privacy-policy/">Privacy Policy</a>
                    <a class="hover:text-white transition-colors" href="/terms-of-service/">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
