---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
}

const { title = "Property Knowledge Center | Paramount Property Restoration" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Google Fonts: Public Sans -->
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"/>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Resources Hub */
        :root {
            --color-primary: #137fec; 
            --color-secondary: #f97316;
            --color-urgent: #f97316; /* Using orange for urgent accents in header if needed */
            
            --font-display: 'Public Sans', sans-serif;
            --font-body: 'Public Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-[#f6f7f8] dark:bg-[#101922] font-display text-[#111418] dark:text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Unified Header -->
    <Header 
        secondaryColor="#f97316" 
    />

    <slot />
    
    <!-- Footer from user HTML -->
    <footer class="w-full bg-[#111418] text-white pt-16 pb-8">
        <div class="max-w-[1440px] mx-auto px-4 md:px-10 grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-2 text-white">
                    <div class="size-8 rounded-lg bg-white/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">roofing</span>
                    </div>
                    <h2 class="text-lg font-bold">Paramount</h2>
                </div>
                <p class="text-neutral-400 text-sm leading-relaxed">
                    Your trusted partner for restoration, remodeling, and commercial property services in Orlando and Central Florida.
                </p>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Services</h4>
                <ul class="space-y-2 text-neutral-400 text-sm">
                    <li><a class="hover:text-[#137fec] transition-colors" href="/restoration/water-damage/">Water Damage</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/restoration/fire-damage/">Fire Restoration</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/restoration/mold-remediation/">Mold Remediation</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/restoration/storm-damage/">Storm Damage</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/commercial/">Commercial Services</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Company</h4>
                <ul class="space-y-2 text-neutral-400 text-sm">

                    <li><a class="hover:text-[#137fec] transition-colors" href="/careers/">Careers</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/resources/">Our Blog</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/contact/">Contact</a></li>
                    <li><a class="hover:text-[#137fec] transition-colors" href="/privacy-policy/">Privacy Policy</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Contact HQ</h4>
                <ul class="space-y-3 text-neutral-400 text-sm">
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-[#137fec] mt-0.5">location_on</span>
                        <span>10890 NW 17th St Suite 138<br>Miami, FL 33172</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-[#137fec]">call</span>
                        <a href="tel:7866022217" class="hover:text-white transition-colors">(786) 602-2217</a>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-[#137fec]">mail</span>
                        <a href="mailto:services@paramountpropertyrestoration.com" class="hover:text-white transition-colors">services@paramountpropertyrestoration.com</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="max-w-[1440px] mx-auto px-4 md:px-10 border-t border-neutral-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-neutral-500 text-sm">© 2024 Paramount Property Restoration. All rights reserved.</p>
            <div class="flex gap-4">
                <a class="text-neutral-500 hover:text-white transition-colors" href="/contact/">
                    <span class="sr-only">Facebook</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path></svg>
                </a>
                <a class="text-neutral-500 hover:text-white transition-colors" href="/contact/">
                    <span class="sr-only">Twitter</span>
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path></svg>
                </a>
            </div>
        </div>
    </footer>
</body>
</html>
