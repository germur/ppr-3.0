---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Mold Remediation Hub | Paramount Property Restoration",
  description = "Professional Mold Remediation & Air Quality Solutions. Professional testing, scientific remediation, and humidity control."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Mold Remediation Page */
        :root {
            --color-primary: #11d4c4; /* Teal */
            --color-secondary: #f97316; /* Orange */
            --color-brand-blue: #0f172a; /* Deep Blue */
            --color-background-light: #f6f8f8;
            --color-background-dark: #102220;

            --font-display: 'Inter', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        .glass-nav {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f6f8f8; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }
        
        details > summary {
            list-style: none;
        }
        details > summary::-webkit-details-marker {
            display: none;
        }
    </style>
</head>
<body class="bg-[#f6f8f8] dark:bg-[#102220] text-[#0f172a] font-display overflow-x-hidden antialiased selection:bg-[#11d4c4] selection:text-[#0f172a]">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Sticky Glass Navigation -->
    <!-- Unified Header -->
    <Header 
        theme="light" 
        secondaryColor="#11d4c4" 
        emergencyBtnText="Schedule Inquiry" 
    />

    <slot />

    <!-- Footer -->
    <footer class="bg-[#0f172a] text-white py-12 border-t border-white/10 mt-auto">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-start gap-8">
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-8 h-8 bg-[#11d4c4] rounded flex items-center justify-center text-[#0f172a]">
                            <span class="material-symbols-outlined text-xl">water_drop</span>
                        </div>
                        <span class="font-bold text-lg">Paramount Property Restoration</span>
                    </div>
                    <p class="text-slate-400 text-sm max-w-xs">Restoring homes and health with integrity and scientific precision.</p>
                </div>
                <div class="flex gap-8 text-sm text-slate-300">
                    <a class="hover:text-[#11d4c4] transition-colors" href="/privacy-policy/">Privacy Policy</a>
                    <a class="hover:text-[#11d4c4] transition-colors" href="/terms-of-service/">Terms of Service</a>
                    <a class="hover:text-[#11d4c4] transition-colors" href="/contact/">Contact</a>
                </div>
            </div>
            <div class="mt-12 pt-8 border-t border-white/10 text-center md:text-left text-xs text-slate-500">
                © 2024 Paramount Property Restoration. License MRSR-2831. All rights reserved.
            </div>
        </div>
    </footer>
</body>
</html>
