---
import "../styles/global.css";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import { COMPANY_INFO } from "../data/company";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Emergency Restoration Services | Paramount Property Restoration",
    description = "24/7 Emergency Response for Water, Fire, and Storm Damage in Florida.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="light">
    <head>
        <!-- Google Tag Manager -->
        <script is:inline>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    "gtm.start": new Date().getTime(),
                    event: "gtm.js",
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-WG5DT6GN");
        </script>
        <!-- End Google Tag Manager -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <style>
            /* Scoped Variables for Emergency Section to override Global Defaults */
            :root {
                --color-primary: #137fec; /* Blue */
                --color-urgent: #ff5722; /* Orange/Red */
                --font-display: "Inter", sans-serif;
                --font-body: "Inter", sans-serif;
            }
        </style>
    </head>
    <body
        class="bg-[#f6f7f8] dark:bg-[#101922] font-display text-[#111418] overflow-x-hidden"
    >
        <!-- Google Tag Manager (noscript) -->
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >
        <!-- End Google Tag Manager (noscript) -->
        <div class="relative flex flex-col min-h-screen w-full">
            <!-- Top Alert Bar -->
            <div
                class="w-full bg-urgent text-white py-2 px-4 text-center text-sm font-bold tracking-wide animate-pulse"
            >
                EMERGENCY RESPONSE ACTIVE: 60-Minute Arrival Guarantee in
                Florida Zones
            </div>

            <!-- Navigation -->
            <!-- Navigation -->
            <Header variant="emergency" />

            <slot />

            <!-- Footer -->
            <Footer />
            <!-- Floating Mobile CTA -->
            <div class="fixed bottom-6 right-6 z-50 lg:hidden">
                <a
                    class="flex items-center justify-center w-14 h-14 bg-urgent text-white rounded-full shadow-2xl animate-bounce"
                    href={`tel:${COMPANY_INFO.phoneRaw}`}
                >
                    <span class="material-symbols-outlined text-2xl"
                        >phone_in_talk</span
                    >
                </a>
            </div>
        </div>
    </body>
</html>
