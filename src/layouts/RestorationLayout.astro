---
import '../styles/global.css';
import Header from '../components/common/Header.astro';

interface Props {
  title?: string;
}

const { title = "Emergency Restoration Services | Paramount Property Restoration" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        /* Scoped Variables for Restoration Hub */
        :root {
            --color-primary: #137fec; 
            --color-urgent: #FF5722;
            --color-secondary: #FF5722; /* Mapping secondary to urgent if needed or just use urgent */
            
            --font-display: 'Inter', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#f6f7f8] font-display text-[#111418] antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="relative flex flex-col min-h-screen w-full overflow-x-hidden">
        <!-- Top Alert Bar -->
        <div class="w-full bg-[#FF5722] text-white py-2 px-4 text-center text-sm font-bold tracking-wide animate-pulse">
            EMERGENCY RESPONSE ACTIVE: 60-Minute Arrival Guarantee in Florida Zones
        </div>

        <!-- Unified Header -->
        <Header variant="emergency" />

        <slot />
        
        <!-- Footer matches the provided HTML design -->
        <footer class="bg-[#111418] text-white py-16">
            <div class="max-w-[1280px] mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
                    <div>
                        <div class="flex items-center gap-2 mb-6">
                            <div class="w-8 h-8 bg-[#137fec] text-white flex items-center justify-center rounded">
                                <span class="material-symbols-outlined text-xl">shield_with_house</span>
                            </div>
                            <span class="text-xl font-bold">Paramount</span>
                        </div>
                        <p class="text-slate-400 text-sm leading-relaxed mb-6">
                            Florida's trusted partner for emergency restoration. We bring properties back to life with speed, integrity, and expertise.
                        </p>
                        <div class="flex gap-4">
                            <a class="text-slate-400 hover:text-white" href="/contact/"><span class="material-symbols-outlined">thumb_up</span></a> <!-- Social Icon placeholder -->
                            <a class="text-slate-400 hover:text-white" href="/contact/"><span class="material-symbols-outlined">share</span></a>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-bold text-lg mb-6">Services</h4>
                        <ul class="space-y-3 text-sm text-slate-400">
                            <li><a class="hover:text-[#137fec]" href="/restoration/water-damage/">Water Damage Mitigation</a></li>
                            <li><a class="hover:text-[#137fec]" href="/restoration/fire-damage/">Fire & Smoke Restoration</a></li>
                            <li><a class="hover:text-[#137fec]" href="/restoration/mold-remediation/">Mold Inspection & Removal</a></li>
                            <li><a class="hover:text-[#137fec]" href="/restoration/storm-damage/">Storm Damage Repair</a></li>
                            <li><a class="hover:text-[#137fec]" href="/commercial/">Commercial Services</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold text-lg mb-6">Company</h4>
                        <ul class="space-y-3 text-sm text-slate-400">

                            <li><a class="hover:text-[#137fec]" href="/our-process/">Our Process</a></li>
                            <li><a class="hover:text-[#137fec]" href="/careers/">Careers</a></li>
                            <li><a class="hover:text-[#137fec]" href="/contact/">Contact</a></li>
                            <li><a class="hover:text-[#137fec]" href="/privacy-policy/">Privacy Policy</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold text-lg mb-6">Emergency Contact</h4>
                        <p class="text-slate-400 text-sm mb-4">Available 24 hours a day, 7 days a week for all Florida residents.</p>
                        <a class="flex items-center gap-3 text-2xl font-bold text-[#FF5722] hover:text-white transition-colors mb-2" href="tel:7866022217">
                            <span class="material-symbols-outlined">call</span>
                            (786) 602-2217
                        </a>
                        <p class="text-xs text-slate-500">Live dispatch • 60-min response</p>
                    </div>
                </div>
                <div class="pt-8 border-t border-slate-800 text-center text-slate-500 text-sm">
                    © 2024 Paramount Property Restoration. All rights reserved.
                </div>
            </div>
        </footer>
        
        <!-- Floating Mobile CTA -->
        <div class="fixed bottom-6 right-6 z-50 lg:hidden">
            <a class="flex items-center justify-center w-14 h-14 bg-[#FF5722] text-white rounded-full shadow-2xl animate-bounce" href="tel:7866022217">
                <span class="material-symbols-outlined text-2xl">phone_in_talk</span>
            </a>
        </div>
    </div>
</body>
</html>
