---
import MainLayout from '../layouts/MainLayout.astro';

const title = "Mold Testing Services | Paramount";
const description = "Professional mold testing and inspection services in Florida. Accurate results and certified inspectors.";
---

<MainLayout title={title} description={description}>
    <section class="min-h-[60vh] flex items-center justify-center bg-gray-50 dark:bg-gray-900">
        <div class="text-center px-4">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Mold Testing Services</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">Comprehensive mold inspection and air quality testing coming soon.</p>
            <a href="/contact/" class="inline-block bg-[#f97316] hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition-colors">
                Contact Us for Immediate Service
            </a>
        </div>
    </section>
</MainLayout>
