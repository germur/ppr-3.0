---
import SEO from '../components/common/SEO.astro';
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
---
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WG5DT6GN');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Terms of Service | Paramount</title>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet"/>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <style>
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-[#f6f7f8] dark:bg-[#101922] font-sans text-slate-900 dark:text-slate-100 transition-colors duration-200 group/design-root overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WG5DT6GN"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Top Navigation -->
    <Header />

    <!-- Main Content Layout -->
    <div class="flex-grow w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-16">
            <!-- Side Navigation (Sticky Sidebar) -->
            <aside class="hidden lg:block w-64 flex-shrink-0">
                <div class="sticky top-24 flex flex-col gap-6">
                    <div class="flex flex-col gap-4 p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm">
                        <h3 class="text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider px-3">On this page</h3>
                        <nav class="flex flex-col gap-1">
                            <a class="group flex items-center gap-3 px-3 py-2 rounded-lg bg-[#137fec]/10 text-[#137fec] dark:bg-[#137fec]/20 dark:text-blue-300 transition-colors" href="#acceptance">
                                <span class="material-symbols-outlined text-[18px]">gavel</span>
                                <span class="text-sm font-medium">Acceptance</span>
                            </a>
                            <a class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors" href="#services">
                                <span class="material-symbols-outlined text-[18px]">design_services</span>
                                <span class="text-sm font-medium">Services Provided</span>
                            </a>
                            <a class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors" href="#estimates">
                                <span class="material-symbols-outlined text-[18px]">request_quote</span>
                                <span class="text-sm font-medium">Estimates</span>
                            </a>
                            <a class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors" href="#intellectual">
                                <span class="material-symbols-outlined text-[18px]">copyright</span>
                                <span class="text-sm font-medium">Intellectual Property</span>
                            </a>
                            <a class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors" href="#liability">
                                <span class="material-symbols-outlined text-[18px]">security</span>
                                <span class="text-sm font-medium">Liability</span>
                            </a>
                            <a class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors" href="#governing">
                                <span class="material-symbols-outlined text-[18px]">balance</span>
                                <span class="text-sm font-medium">Governing Law</span>
                            </a>
                        </nav>
                    </div>
                    
                    <!-- Support Card -->
                    <div class="p-5 rounded-xl bg-gradient-to-br from-[#137fec] to-[#0f66bd] text-white shadow-lg">
                        <div class="flex flex-col gap-3">
                            <span class="material-symbols-outlined text-3xl">support_agent</span>
                            <div>
                                <h4 class="font-bold text-lg">Need Help?</h4>
                                <p class="text-sm text-white/90 mt-1">Contact our legal team if you have specific questions about these terms.</p>
                            </div>
                            <a class="mt-2 inline-flex items-center justify-center px-4 py-2 rounded-lg bg-white/20 hover:bg-white/30 text-sm font-semibold transition-colors" href="#contact">
                                Contact Support
                            </a>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 max-w-[800px]">
                <!-- Page Heading -->
                <div class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800">
                    <div class="flex flex-col gap-4">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 w-fit">
                            <span class="size-2 rounded-full bg-green-500"></span>
                            <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wide">Legal Document</span>
                        </div>
                        <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight">Terms of Service</h1>
                        <p class="text-slate-500 dark:text-slate-400 text-lg">
                            Last Updated: <span class="font-medium text-slate-700 dark:text-slate-300">October 24, 2023</span>
                        </p>
                    </div>
                </div>

                <!-- Legal Content Body -->
                <div class="prose prose-lg dark:prose-invert max-w-none text-slate-600 dark:text-slate-300">
                    <p class="lead text-xl leading-relaxed text-slate-700 dark:text-slate-300 mb-12">
                        Welcome to Paramount Property Restoration. By accessing our website, engaging our services, or requesting an estimate, you agree to comply with and be bound by the following terms and conditions of use. Please review these terms carefully.
                    </p>
                    
                    <!-- Section 1 -->
                    <div class="scroll-mt-32 mb-12" id="acceptance">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex items-center justify-center size-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-700">1</div>
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white m-0">Acceptance of Terms</h2>
                        </div>
                        <div class="pl-11">
                            <p class="leading-7">
                                By accessing and using the Paramount Property Restoration website, you accept and agree to be bound by the terms and provision of this agreement. If you do not agree to abide by these terms, please do not use this service. We reserve the right to modify these terms at any time, and such modifications shall be effective immediately upon posting.
                            </p>
                        </div>
                    </div>

                    <!-- Section 2 -->
                    <div class="scroll-mt-32 mb-12" id="services">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex items-center justify-center size-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-700">2</div>
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white m-0">Services Provided</h2>
                        </div>
                        <div class="pl-11">
                            <p class="mb-4 leading-7">
                                Paramount Property Restoration specializes in restoration, remodeling, and commercial services. While we strive to describe our services accurately on this website, we do not warrant that the service descriptions or other content of this site is accurate, complete, reliable, current, or error-free.
                            </p>
                            <ul class="list-disc pl-5 space-y-2 mb-4">
                                <li><strong>Restoration Services:</strong> Water damage, fire damage, and mold remediation.</li>
                                <li><strong>General Contracting:</strong> Residential and commercial remodeling.</li>
                                <li><strong>Consultation:</strong> Professional assessments and property evaluations.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Section 3 -->
                    <div class="scroll-mt-32 mb-12" id="estimates">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex items-center justify-center size-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-700">3</div>
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white m-0">Estimates & Quotes</h2>
                        </div>
                        <div class="pl-11">
                            <div class="p-6 rounded-lg bg-orange-50 dark:bg-orange-900/10 border-l-4 border-[#fb923c] mb-4">
                                <p class="text-orange-900 dark:text-orange-100 font-medium text-sm leading-6">
                                    <strong>Important Note:</strong> Any online estimates provided through our website tools are preliminary and for informational purposes only.
                                </p>
                            </div>
                            <p class="leading-7">
                                A final, binding quote can only be provided after an on-site inspection by one of our certified professionals. Unforeseen conditions discovered during the actual work may result in a change order or price adjustment, which will be communicated and agreed upon before proceeding.
                            </p>
                        </div>
                    </div>

                    <!-- Section 4 -->
                    <div class="scroll-mt-32 mb-12" id="intellectual">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex items-center justify-center size-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-700">4</div>
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white m-0">Intellectual Property</h2>
                        </div>
                        <div class="pl-11">
                            <p class="leading-7">
                                The content, organization, graphics, design, compilation, magnetic translation, digital conversion and other matters related to the Site are protected under applicable copyrights, trademarks and other proprietary (including but not limited to intellectual property) rights. The copying, redistribution, use or publication by you of any such matters or any part of the Site is strictly prohibited.
                            </p>
                        </div>
                    </div>

                    <!-- Section 5 -->
                    <div class="scroll-mt-32 mb-12" id="liability">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex items-center justify-center size-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-700">5</div>
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white m-0">Limitation of Liability</h2>
                        </div>
                        <div class="pl-11">
                            <p class="leading-7">
                                In no event shall Paramount Property Restoration be liable for any special, incidental, indirect, or consequential damages of any kind whatsoever resulting from loss of use, data, or profits, whether or not advised of the possibility of damage, and on any theory of liability, arising out of or in connection with the use or performance of this information.
                            </p>
                        </div>
                    </div>

                    <!-- Section 6 -->
                    <div class="scroll-mt-32 mb-12" id="governing">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex items-center justify-center size-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-700">6</div>
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white m-0">Governing Law</h2>
                        </div>
                        <div class="pl-11">
                            <p class="leading-7">
                                By accessing this website, you agree that the statutes and laws of the State of Florida, without regard to the conflict of laws and the United Nations Convention on the International Sales of Goods, will apply to all matters relating to the use of this website and the purchase of any available products or services through this site.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Contact CTA Box -->
                <div class="mt-16 p-8 rounded-2xl bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                        <div class="flex-1">
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Questions about our Terms?</h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm">
                                If you have any questions regarding these Terms of Service, please contact us at:
                            </p>
                            <div class="mt-4 flex flex-col gap-2">
                                <div class="flex items-center gap-2 text-sm font-medium text-slate-800 dark:text-slate-200">
                                    <span class="material-symbols-outlined text-[#137fec] text-[20px]">mail</span>
                                    <span>legal@paramountrestoration.com</span>
                                </div>
                                <div class="flex items-center gap-2 text-sm font-medium text-slate-800 dark:text-slate-200">
                                    <span class="material-symbols-outlined text-[#137fec] text-[20px]">location_on</span>
                                    <span>10890 NW 17th St Suite 138, Miami, FL 33172</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            <button class="bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-600 text-slate-900 dark:text-white font-semibold py-2.5 px-6 rounded-lg transition-colors shadow-sm">
                                Contact Us
                            </button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Footer -->
    <Footer />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    const id = entry.target.getAttribute('id');
                    if (entry.intersectionRatio > 0) {
                        document.querySelector(`nav a[href="#${id}"]`)?.classList.add('bg-[#137fec]/10', 'text-[#137fec]', 'dark:bg-[#137fec]/20', 'dark:text-blue-300');
                        document.querySelector(`nav a[href="#${id}"]`)?.classList.remove('hover:bg-slate-100', 'dark:hover:bg-slate-700', 'text-slate-600', 'dark:text-slate-400');
                    } else {
                        document.querySelector(`nav a[href="#${id}"]`)?.classList.remove('bg-[#137fec]/10', 'text-[#137fec]', 'dark:bg-[#137fec]/20', 'dark:text-blue-300');
                        document.querySelector(`nav a[href="#${id}"]`)?.classList.add('hover:bg-slate-100', 'dark:hover:bg-slate-700', 'text-slate-600', 'dark:text-slate-400');
                    }
                });
            }, {
                rootMargin: '-20% 0px -50% 0px'
            });

            // Track all sections that have an `id` applied
            document.querySelectorAll('div[id]').forEach((section) => {
                observer.observe(section);
            });
        });
    </script>
</body>
</html>
