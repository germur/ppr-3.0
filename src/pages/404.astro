
---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Page Not Found | Paramount Property Restoration" description="The page you are looking for does not exist. Return to our homepage or contact us for emergency restoration services.">
  <div class="flex min-h-[60vh] items-center justify-center px-4 py-20 text-center">
    <div class="flex max-w-xl flex-col items-center gap-6">
      <div class="rounded-full bg-gray-100 p-6 dark:bg-gray-800">
        <span class="material-symbols-outlined text-6xl text-primary">broken_image</span>
      </div>
      
      <h1 class="text-4xl font-bold tracking-tight text-[#111418] dark:text-white sm:text-5xl">
        Page Not Found
      </h1>
      
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Sorry, we couldn't find the page you're looking for. It might have been moved or deleted during our site upgrades.
      </p>

      <div class="mt-4 flex flex-wrap justify-center gap-4">
        <a 
          href="/" 
          class="flex h-12 min-w-[160px] cursor-pointer items-center justify-center rounded-lg bg-primary px-6 text-base font-bold text-white shadow-lg transition-all hover:bg-blue-700"
        >
          Go Home
        </a>
        <a 
          href="/contact/" 
          class="flex h-12 min-w-[160px] cursor-pointer items-center justify-center rounded-lg border border-gray-200 bg-white px-6 text-base font-bold text-[#111418] hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700"
        >
          Contact Us
        </a>
      </div>

      <div class="mt-12 w-full border-t border-gray-200 pt-8 dark:border-gray-800">
        <p class="mb-4 text-sm font-bold uppercase tracking-wider text-gray-500">Popular Services</p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-primary">
          <a href="/restoration/water-damage/" class="hover:underline">Water Damage</a>
          <a href="/restoration/fire-damage/" class="hover:underline">Fire Damage</a>
          <a href="/restoration/mold-remediation/" class="hover:underline">Mold Remediation</a>
          <a href="/restoration/storm-damage/" class="hover:underline">Storm Damage</a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
