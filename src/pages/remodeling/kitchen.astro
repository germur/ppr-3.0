---
import RemodelingLayout from '../../layouts/RemodelingLayout.astro';

const pageTitle = "Kitchen Remodeling Florida - Paramount Property Restoration";
import { kitchenRemodelingFAQs } from '../../data/restoration-faqs';
---

<RemodelingLayout title={pageTitle}>
    <main class="flex flex-col">
        <!-- Hero Section -->
        <section class="relative w-full py-12 lg:py-20 overflow-hidden bg-white dark:bg-[#101822]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <!-- Hero Content -->
                    <div class="flex flex-col gap-6 order-2 lg:order-1">
                        <div class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 dark:bg-blue-900/30 px-3 py-1 text-xs font-semibold text-[#1162d4] dark:text-blue-300 border border-blue-100 dark:border-blue-800">
                            <span class="material-symbols-outlined text-[16px]">verified</span>
                            Premier Remodeling Experts
                        </div>
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight text-[#111418] dark:text-white">
                            Custom <span class="text-[#1162d4]">Kitchen Remodeling</span> & Renovation Services
                        </h1>
                        <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-xl">
                            Transform the heart of your home with Florida’s premier remodeling experts. From open-concept layouts perfect for entertaining to storm-resilient materials that withstand humidity, we design kitchens that blend luxury with functionality. Whether you need a chef-style kitchen in Miami or a modern family space in Kissimmee, we manage the entire project from design to permitting.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 mt-2">
                            <a href="/contact/" class="flex items-center justify-center rounded-lg bg-[#f97316] hover:bg-[#ea580c] text-white h-12 px-8 text-base font-bold transition-all shadow-lg shadow-orange-500/20">
                                Schedule a Design Consultation
                            </a>
                            <a href="#portfolio" class="flex items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#1a2432] text-[#111418] dark:text-white h-12 px-6 text-base font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
                                View Portfolio
                            </a>
                        </div>
                    </div>
                     <!-- Hero Image - Keeping same image as it's high quality -->
                     <div class="order-1 lg:order-2 relative group">
                        <div class="absolute -inset-1 bg-gradient-to-r from-[#1162d4] to-[#f97316] rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
                        <div class="relative w-full aspect-[4/3] sm:aspect-video lg:aspect-square xl:aspect-[4/3] bg-gray-200 rounded-xl overflow-hidden shadow-2xl">
                            <img alt="Bright modern kitchen with white island and wooden stools" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB84zNki7ECfo-eN9s2sM7KbPMIdkP1D5n_26gUPtsjyebAsrGsgdUHh2S5RjZuRb-7UmHgdyOszUIoodSYtCjXbKGL0OejjZcbhRFl11P-UNK5Xeme0f0igHcCd6-BW_C7C_HLwUEnrXxd9MD54ODsA7vln1trS9fe3uP8UqfNYeB0b-GyTSEBOzRZnjkWdJ4RSH3q1ibbOZRlhtb0vx7QrtQ1SJmqnNKZaazxb-4TVlpIM1UEQYyv0h5TzuLPOTLrtn23vZCaBq6i" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2025 Design Trends -->
        <section class="py-16 lg:py-24 bg-[#f6f7f8] dark:bg-[#101922]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                 <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-4">2025 Design Trends We Build</h2>
                    <p class="text-gray-600 dark:text-gray-300">Modern efficiency meets resilient luxury.</p>
                </div>
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Trend 1 -->
                    <div class="bg-white dark:bg-[#1a2432] p-8 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-3 mb-4">
                             <span class="material-symbols-outlined text-[#1162d4] text-3xl">smart_toy</span>
                             <h3 class="text-xl font-bold text-[#111418] dark:text-white">Smart Kitchens</h3>
                        </div>
                        <p class="text-gray-600 dark:text-gray-400">Integration of touchless fixtures and AI-powered appliances for modern efficiency.</p>
                    </div>
                     <!-- Trend 2 -->
                     <div class="bg-white dark:bg-[#1a2432] p-8 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-3 mb-4">
                             <span class="material-symbols-outlined text-[#1162d4] text-3xl">deck</span>
                             <h3 class="text-xl font-bold text-[#111418] dark:text-white">Open-Concept Layouts</h3>
                        </div>
                        <p class="text-gray-600 dark:text-gray-400">Removing walls to connect kitchen and living areas, maximizing natural light.</p>
                    </div>
                     <!-- Trend 3 -->
                     <div class="bg-white dark:bg-[#1a2432] p-8 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-3 mb-4">
                             <span class="material-symbols-outlined text-[#1162d4] text-3xl">shield</span>
                             <h3 class="text-xl font-bold text-[#111418] dark:text-white">Resilient Materials</h3>
                        </div>
                        <p class="text-gray-600 dark:text-gray-400">Use of quartz and non-porous surfaces that resist mold and humidity typical of the Florida climate.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Our Turnkey Process -->
        <section class="py-16 lg:py-24 bg-white dark:bg-[#0b1118]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="mb-16 md:text-center">
                    <span class="text-[#1162d4] font-bold tracking-wider uppercase text-sm">Transparent Journey</span>
                    <h2 class="text-3xl font-bold tracking-tight text-[#111418] dark:text-white sm:text-4xl mt-2">Our Turnkey Process</h2>
                </div>
                <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8">
                     <!-- Connector Line (Desktop) -->
                     <div class="hidden md:block absolute top-8 left-[16.5%] right-[16.5%] h-0.5 bg-gray-200 dark:bg-gray-700 -z-10"></div>
                     
                     <!-- Step 1 -->
                     <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-[#1162d4] text-[#1162d4] flex items-center justify-center shadow-lg mb-6 group-hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined text-3xl">view_in_ar</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">1. 3D Visualization</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">See your new kitchen before we lay a single tile.</p>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-[#1162d4] text-[#1162d4] flex items-center justify-center shadow-lg mb-6 group-hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined text-3xl">gavel</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">2. Permitting</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">We handle all HOA and city permits.</p>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-[#1162d4] text-[#1162d4] flex items-center justify-center shadow-lg mb-6 group-hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined text-3xl">construction</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">3. Construction</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Managed by licensed general contractors.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Use existing portfolio section but slightly compressed to save space if needed, keeping it as is for now as it adds value -->
        <section id="portfolio" class="py-16 bg-[#f6f7f8] dark:bg-[#101922]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                     <h2 class="text-3xl font-bold tracking-tight text-[#111418] dark:text-white sm:text-4xl">Featured Kitchens</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-auto md:h-[400px]">
                     <div class="group relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Luxury open concept kitchen" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDZCBnNamDCMPuNNdsbQSOzE0X6MIwDS33z2c_q6wakkmRlyXZ6xBFFY-VEC8yZCUWU_pJAqodqw1wWmbMI9QvAeCvN2qdrj7UhXIgveKzorgOxkc88owCuepzEQ4uyaUGB1o_ohq-2PZ85TzL7FVp_PMFYFHBBFgPl33F4P4-ZZu7RlCEPBTpU4_gruiUBveY5RlQl601LSxCTkzyLdOyOYdLLW2xrkmdeQD7Q4VgdaoEfYUO8pMdpBYLr5B-EvpmC0DyIfKqzz7zv" />
                     </div>
                     <div class="group relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Modern appliances" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD6Q_H6wmOAyahepJVo7Niv047DUNRpYzZIwpC-gu3wGWBQZP3unGooCe4xDaspSAJUft_OM2qh7FjW9-J8o3ELMTu9tFQ9MaynPJ3YTxvZYgr_WtMQREBTceolPmyUhC62xFwgZhzkRRHCTi0R1jIKUi8mP8sZnYdMn3ZUm3WTH-aV4vU1TFXeeJq5w39Up9LjKAT7Sji0fU5SMmze0YzmCZRN-KaNG2bZVyRnkPY3yloBXLMsQkS7ZWN-5CukO-E082AQyVhgU1sJ" />
                     </div>
                     <div class="group relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Marble countertops" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuI743BFRk8O0ZuoUxuH9AC03EACxQCcWN8F8fUAnTXqVy8qlwPdf03jyL0BAbCBjMJLkfoVnjgKfNjepRsW_jAz5bLzWh1hiuAJ6C-RQ--NtzuVNk3bwNQM2FflVbwjmBC1SpMhJuyFIWNllR8gJXAMyRt88fFJjo07OKzdKo6oBCUeLSxR3piJPcYaNjD3u98ntwlNQM1YBUDNe_SA54laY5TIfLkF0UYLzplYFprH2ARal1aNvHVhXXLgVVA5ylm6Y7RTGE6eKs" />
                     </div>
                </div>
            </div>
        </section>

        <!-- Kitchen FAQ Section -->
        <section class="py-16 bg-white dark:bg-[#0b1118]">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold text-[#111418] dark:text-white">Common Questions</h2>
                </div>
                <div class="flex flex-col gap-3">
                    {kitchenRemodelingFAQs.map((item) => (
                    <details class="group bg-[#f6f7f8] dark:bg-[#1a2432] border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
                        <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                        <span class="text-base font-bold text-[#111418] dark:text-white group-hover:text-[#1162d4] transition-colors pr-4">
                            {item.question}
                        </span>
                        <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-white dark:bg-gray-800 text-gray-400 group-open:bg-[#1162d4] group-open:text-white transition-all duration-300">
                            <span class="material-symbols-outlined text-xl group-open:hidden">add</span>
                            <span class="material-symbols-outlined text-xl hidden group-open:block">remove</span>
                        </span>
                        </summary>
                        <div class="px-5 pb-5 text-gray-600 dark:text-gray-400 leading-relaxed animate-fade-in text-sm">
                        {item.answer}
                        </div>
                    </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- Service Areas (Internal Linking) -->
        <section class="py-16 bg-white dark:bg-[#101822] border-t border-gray-100 dark:border-gray-800">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-6">Remodeling Services Available In</h3>
                <div class="flex flex-wrap gap-3">
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/central-florida/orlando/">Orlando</a>
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/south-florida/miami/">Miami</a>
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/tampa-bay/tampa/">Tampa</a>
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/south-florida/fort-lauderdale/">Fort Lauderdale</a>
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/southwest-florida/fort-myers/">Fort Myers</a>
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/southwest-florida/naples/">Naples</a>
                    <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/tampa-bay/sarasota/">Sarasota</a>
                     <a class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:border-[#1162d4] hover:text-[#1162d4] transition-colors shadow-sm" href="/service-areas/">View All Locations</a>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-20 bg-white dark:bg-[#101822] border-t border-gray-200 dark:border-gray-800">
            <div class="max-w-4xl mx-auto px-4 text-center">
                <h2 class="text-3xl sm:text-4xl font-black text-[#111418] dark:text-white mb-6">Ready for Your Dream Kitchen?</h2>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/contact/" class="flex items-center justify-center rounded-lg bg-[#f97316] hover:bg-[#ea580c] text-white h-14 px-8 text-lg font-bold transition-all shadow-xl shadow-orange-500/20">
                        Schedule a Design Consultation
                    </a>
                    <a href="#portfolio" class="flex items-center justify-center rounded-lg border-2 border-[#1162d4] text-[#1162d4] hover:bg-[#1162d4] hover:text-white h-14 px-8 text-lg font-bold transition-all">
                        View Portfolio
                    </a>
                </div>
            </div>
        </section>
    </main>
</RemodelingLayout>
