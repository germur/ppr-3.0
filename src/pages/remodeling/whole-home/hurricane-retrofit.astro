---
import MainLayout from '../../../layouts/MainLayout.astro';

const seoTitle = "Hurricane Retrofit Services | My Safe Florida Home Contractor";
const seoDescription = "Strengthen your home against Cat-5 storms and lower your insurance premiums by up to 40%. Authorized My Safe Florida Home contractor.";
---

<MainLayout title={seoTitle} description={seoDescription}>
    <!-- Custom Styles for this specific landing page -->
    <style>
        /* Custom scrollbar for cleaner look */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }
        /* Map custom colors from user design if not in global config */
        .text-primary { color: #197fe6; }
        .bg-primary { background-color: #197fe6; }
        .border-primary { border-color: #197fe6; }
        .hover\:bg-primary:hover { background-color: #197fe6; }
        .hover\:text-primary:hover { color: #197fe6; }
        .hover\:border-primary:hover { border-color: #197fe6; }
        
        .text-primary-dark { color: #1466b8; }
        .bg-primary-dark { background-color: #1466b8; }
        .hover\:bg-primary-dark:hover { background-color: #1466b8; }

        .text-accent { color: #f97316; }
        .bg-accent { background-color: #f97316; }
        .border-accent { border-color: #f97316; }

        .bg-surface-light { background-color: #f8fafc; }
        .bg-surface-dark { background-color: #1a2430; }
        
        .font-display { font-family: 'Inter', sans-serif; }
    </style>

    <div class="bg-white dark:bg-[#111921] text-[#111418] dark:text-white font-display overflow-x-hidden antialiased flex flex-col min-h-screen transition-colors duration-200">
        <!-- Sticky Mobile/Desktop CTA -->
        <div class="fixed bottom-0 left-0 w-full z-50 p-4 bg-white/90 dark:bg-[#111921]/90 backdrop-blur-md border-t border-gray-200 dark:border-gray-700 md:w-auto md:right-8 md:left-auto md:bottom-8 md:rounded-xl md:shadow-2xl md:border-none">
            <div class="flex items-center gap-4 justify-between md:justify-start">
                <div class="hidden md:block">
                    <p class="text-sm font-bold text-gray-900 dark:text-white">Protect Your Home</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Get 40% off premiums</p>
                </div>
                <button class="w-full md:w-auto flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold py-3 px-6 rounded-lg transition-colors shadow-lg shadow-[#197fe6]/30">
                    <span class="material-symbols-outlined text-[20px]">security</span>
                    <span>Get Wind Mitigation Quote</span>
                </button>
            </div>
        </div>



        <!-- Hero Section -->
        <section class="relative overflow-hidden bg-white dark:bg-[#111921] pt-12 pb-16 lg:pt-24 lg:pb-32">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
                    <!-- Text Content -->
                    <div class="flex flex-col gap-6 max-w-2xl">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 w-fit border border-accent/20">
                            <span class="material-symbols-outlined text-accent text-sm">verified_user</span>
                            <span class="text-accent text-xs font-bold uppercase tracking-wide">Authorized FL Contractor</span>
                        </div>
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#111418] dark:text-white leading-[1.1] tracking-tight">
                            Hurricane Retrofit Services & <span class="text-primary">My Safe Florida Home</span> Contractor
                        </h1>
                        <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-lg">
                            Strengthen your home against Cat-5 storms while lowering insurance premiums by up to 40%. Secure your family and your investment.
                        </p>
                        <div class="flex flex-wrap gap-4 mt-2">
                            <button class="flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white text-base font-bold h-12 px-8 rounded-lg transition-colors shadow-lg shadow-primary/20">
                                Apply for Grant Match
                                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                            </button>
                            <button class="flex items-center justify-center gap-2 bg-surface-light dark:bg-surface-dark hover:bg-gray-200 dark:hover:bg-gray-700 text-[#111418] dark:text-white border border-gray-200 dark:border-gray-700 text-base font-bold h-12 px-8 rounded-lg transition-colors">
                                Learn More
                            </button>
                        </div>
                        <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mt-4">
                            <div class="flex -space-x-2">
                                <div class="size-8 rounded-full bg-gray-200 dark:bg-gray-700 border-2 border-white dark:border-[#111921] bg-cover" data-alt="User portrait" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuB8zA7ef072YrHB-tXSBRRupRt5y9113ofYhuNI1-XaQsA_0BRrRH6mJUqPeW-klc6h_SJLn1fHS9C2wZgrk5XObKdsFsGlxyq-rQzrik7dECDjZrx8zdg8tY05oqWa4WcBClEiH6Tpq4fxj7bBPrQvhCSrmL13M67iClH-rAcJYK8pGFHOCanFvA66uLk7xvx1qZ-xf6o4WqzrLlS9XWFccCIpqeatT02DI0-ZG822_RdC72ACAEzBv6vyjBO7XBcNSquPyZeTBtHK')"></div>
                                <div class="size-8 rounded-full bg-gray-200 dark:bg-gray-700 border-2 border-white dark:border-[#111921] bg-cover" data-alt="User portrait" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCgzWEU6qqa4S_p9JS_eot7cBitpPfHZxZ-zCP5kG2d80FPwMQJpu-ZepEF3pxlwKzLxQFKpJpN6gy2hhqr0UgNCwO6lNkKCj4A6dpgfOpRNqXY7UGjPPv_2RhCqca92T7iuZBQLiqj2phzD_9eH_8IV9ySW1sPhcLaIHJhCngo0JRXpN-ijrufzJtsE96uvMDGt3n1v9UL14gEjwmE9zV8tOeG75R-MvJhi29ZKtQPuP3sNTaZBcLz_Iw3244VBuhWwgDVkbnSAQ5y')"></div>
                                <div class="size-8 rounded-full bg-gray-200 dark:bg-gray-700 border-2 border-white dark:border-[#111921] bg-cover" data-alt="User portrait" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAOGHzeu4ZT8sOqzlH17IyYqF9YWyFAncVC0A8ePB17wzK4Nq3-RpfEiV9HylDZ3GpxyBlFJ_5C3o_Hjr_aeRJiPwx9RkiuxhnlFGUf3ivnRtJRo6GK8ji80Y9-xGHF4IOyCBmJr7EuQhyPfs-EHcWJdbEENKFycWn5j2_TOlcI60OejEOLjncmJq8CpOmO9pTl7C5UEvCAxYD5iy_68Gx0xinQgGrTaDH7HcLJnijOlxtdk6SvAcF6YUmWGpGhl9YrNn8CfUcyQ8Jq')"></div>
                            </div>
                            <p>Trusted by <span class="font-bold text-[#111418] dark:text-white">2,000+</span> Florida Homeowners</p>
                        </div>
                    </div>
                    <!-- Visual Content -->
                    <div class="relative">
                        <!-- Main Image -->
                        <div class="rounded-2xl overflow-hidden shadow-2xl relative aspect-[4/3] bg-gray-100 dark:bg-gray-800">
                            <div class="absolute inset-0 bg-cover bg-center" data-alt="A modern, sturdy Florida home with reinforced windows and roof against a blue sky" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCpJenwlc0YQDaBBS6PGX73lzGUHX05-8z6TaTCIz1BMMWulOcYbeu8b26dYlqMEuMlQSv7M0I53QOagkd0A0SzeAOufNwtkl_S1e2sem8MIj_21Wd9_oPli-zx0FLScI5uYVGshYFNHMtsJFR1cRMavZAKw98-iHrDLqwnEDOoHWLnh1Gwg6Y7dgvZ_pcvYWN4jExBHqv2vQcV41efpN766NXgidSc1P2A5YDyj42wPQBu1JGDw983vX0eezJdCYy5wlUmZhaTfVXQ')"></div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                            <div class="absolute bottom-6 left-6 text-white">
                                <p class="font-bold text-lg">Fortified & Secure</p>
                                <p class="text-sm opacity-90">Ready for any season</p>
                            </div>
                        </div>
                        <!-- Floating Card: Economics -->
                        <div class="absolute -bottom-6 -right-4 lg:-left-12 lg:right-auto bg-white dark:bg-surface-dark p-5 rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-gray-100 dark:border-gray-700 w-[280px]">
                            <div class="flex items-center justify-between mb-4">
                                <p class="text-sm font-semibold text-gray-500 dark:text-gray-400">Annual Savings</p>
                                <span class="material-symbols-outlined text-green-500">trending_down</span>
                            </div>
                            <div class="flex items-baseline gap-1 mb-2">
                                <span class="text-3xl font-black text-[#111418] dark:text-white">$1,400</span>
                                <span class="text-sm font-medium text-gray-500">/yr avg</span>
                            </div>
                            <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-2 mb-2">
                                <div class="bg-green-500 h-2 rounded-full" style="width: 40%"></div>
                            </div>
                            <p class="text-xs text-green-600 dark:text-green-400 font-bold">40% Insurance Reduction</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Economics of Resilience Section -->
        <section class="py-16 bg-surface-light dark:bg-surface-dark border-y border-gray-100 dark:border-gray-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-12 gap-12">
                    <!-- Left: Content -->
                    <div class="lg:col-span-5 flex flex-col justify-center">
                        <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-4">The Economics of Resilience</h2>
                        <p class="text-gray-600 dark:text-gray-300 mb-6">
                            Retrofitting isn't just about safety—it's a smart financial move. Florida law requires insurance companies to offer discounts for wind mitigation features.
                        </p>
                        <div class="space-y-4">
                            <div class="flex gap-4">
                                <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-primary">price_check</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-[#111418] dark:text-white">Mandated Discounts</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Statute 627.0629 guarantees savings for secured roofs and openings.</p>
                                </div>
                            </div>
                            <div class="flex gap-4">
                                <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-primary">real_estate_agent</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-[#111418] dark:text-white">Increased Home Value</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Fortified homes sell faster and for a premium in hurricane-prone zones.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Right: Calculator Card -->
                    <div class="lg:col-span-7">
                        <div class="bg-white dark:bg-[#111921] rounded-2xl p-6 md:p-8 shadow-xl border border-gray-100 dark:border-gray-700">
                            <div class="flex items-center gap-2 mb-6">
                                <span class="material-symbols-outlined text-primary">calculate</span>
                                <h3 class="text-xl font-bold text-[#111418] dark:text-white">Insurance Savings Estimator</h3>
                            </div>
                            <!-- Input -->
                            <div class="mb-8">
                                <div class="flex justify-between mb-2">
                                    <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Current Annual Premium</label>
                                    <span class="text-sm font-bold text-[#111418] dark:text-white">$3,500</span>
                                </div>
                                <input class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-primary" max="10000" min="1000" type="range" value="3500"/>
                                <div class="flex justify-between mt-2 text-xs text-gray-400">
                                    <span>$1k</span>
                                    <span>$10k</span>
                                </div>
                            </div>
                            <!-- Results Grid -->
                            <div class="grid sm:grid-cols-2 gap-4">
                                <div class="p-4 rounded-xl bg-surface-light dark:bg-surface-dark border border-gray-100 dark:border-gray-700">
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Estimated Savings</p>
                                    <p class="text-3xl font-bold text-green-600 dark:text-green-400">$1,400</p>
                                    <p class="text-xs font-medium text-green-600/80 dark:text-green-400/80 mt-1">Per Year</p>
                                </div>
                                <div class="p-4 rounded-xl bg-surface-light dark:bg-surface-dark border border-gray-100 dark:border-gray-700">
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">10-Year ROI</p>
                                    <p class="text-3xl font-bold text-[#111418] dark:text-white">$14,000</p>
                                    <p class="text-xs font-medium text-gray-400 mt-1">Plus energy savings</p>
                                </div>
                            </div>
                            <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
                                <p class="text-xs text-gray-400 text-center italic">*Estimates based on average wind mitigation credits in Florida. Actual savings may vary.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Core Services Section -->
        <section class="py-16 lg:py-24 bg-white dark:bg-[#111921]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-4">Fortification Upgrades</h2>
                    <p class="text-gray-600 dark:text-gray-300">
                        Comprehensive hardening solutions designed to meet the strictest Miami-Dade building codes.
                    </p>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Service 1 -->
                    <div class="group p-6 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-gray-700 hover:border-primary dark:hover:border-primary hover:shadow-lg transition-all">
                        <div class="size-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">window</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Impact Windows & Doors</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Replace standard glass with missile-impact rated barriers that deter intruders and storms.</p>
                    </div>
                    <!-- Service 2 -->
                    <div class="group p-6 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-gray-700 hover:border-primary dark:hover:border-primary hover:shadow-lg transition-all">
                        <div class="size-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">link</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Roof-to-Wall Connections</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Install hurricane clips or straps to prevent roof uplift during high-velocity wind events.</p>
                    </div>
                    <!-- Service 3 -->
                    <div class="group p-6 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-gray-700 hover:border-primary dark:hover:border-primary hover:shadow-lg transition-all">
                        <div class="size-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">water_drop</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Secondary Water Resistance</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Self-adhering polymer modified bitumen (SWR) underlayment to seal the roof deck.</p>
                    </div>
                    <!-- Service 4 -->
                    <div class="group p-6 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-gray-700 hover:border-primary dark:hover:border-primary hover:shadow-lg transition-all">
                        <div class="size-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">garage_home</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Garage Door Bracing</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Reinforce the largest opening in your home to prevent pressure buildup and structural failure.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Grant Program Section -->
        <section class="py-16 bg-surface-light dark:bg-surface-dark">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="bg-white dark:bg-[#111921] rounded-3xl overflow-hidden shadow-sm border border-gray-200 dark:border-gray-700">
                    <div class="grid lg:grid-cols-2">
                        <div class="p-8 lg:p-12 flex flex-col justify-center">
                            <div class="inline-flex items-center gap-2 mb-4 text-primary font-bold">
                                <span class="material-symbols-outlined">verified</span>
                                <span>Authorized Contractor</span>
                            </div>
                            <h2 class="text-3xl font-black text-[#111418] dark:text-white mb-4">
                                My Safe Florida Home Grant
                            </h2>
                            <p class="text-gray-600 dark:text-gray-300 mb-8 text-lg">
                                The state of Florida offers a <strong>$2-for-$1 matching grant</strong> up to <strong>$10,000</strong> for eligible homeowners. We navigate the paperwork so you get the maximum reimbursement.
                            </p>
                            <!-- Timeline -->
                            <div class="space-y-6">
                                <div class="flex gap-4">
                                    <div class="flex flex-col items-center">
                                        <div class="size-8 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">1</div>
                                        <div class="w-px h-full bg-gray-200 dark:bg-gray-700 my-1"></div>
                                    </div>
                                    <div class="pb-6">
                                        <h4 class="font-bold text-[#111418] dark:text-white">Apply for Inspection</h4>
                                        <p class="text-sm text-gray-500">Free wind mitigation inspection by the state.</p>
                                    </div>
                                </div>
                                <div class="flex gap-4">
                                    <div class="flex flex-col items-center">
                                        <div class="size-8 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">2</div>
                                        <div class="w-px h-full bg-gray-200 dark:bg-gray-700 my-1"></div>
                                    </div>
                                    <div class="pb-6">
                                        <h4 class="font-bold text-[#111418] dark:text-white">Select Paramount</h4>
                                        <p class="text-sm text-gray-500">Choose us from the authorized contractor list.</p>
                                    </div>
                                </div>
                                <div class="flex gap-4">
                                    <div class="flex flex-col items-center">
                                        <div class="size-8 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">3</div>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-[#111418] dark:text-white">Retrofit & Reimburse</h4>
                                        <p class="text-sm text-gray-500">We complete the work, and you get paid back.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-8 pt-4">
                                <button class="w-full sm:w-auto bg-primary text-white font-bold py-3 px-6 rounded-lg hover:bg-primary-dark transition-colors">
                                    Check Grant Eligibility
                                </button>
                            </div>
                        </div>
                        <div class="bg-gray-100 dark:bg-gray-800 relative min-h-[400px]">
                            <div class="absolute inset-0 bg-cover bg-center" data-alt="Contractor reviewing blueprints on a construction site with a homeowner" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDgF0ggAU8dqmWnd6Js1p0BGeLOo0xC-z-aE1UnuAKwSc1ojt0GMV-shhyYeUuDSInXzzPMUL2h704G-aGPWJ39-p8FE6WpcpIDcsgKfxZ561I9sQzStqve_sKBmA8gUQWVT6ytyYSXpR-hzGhWqMM7zuY0GtCX0Us_N34H7hwaaa-R2FN-EeZbpIV79wJfF4pA1krtLJY5796ULnyIe9R5skF393xgXMAE-IH3M0ap14SO_Btma_PlNjjRydIGc01zqAE70vlSflyZ')"></div>
                            <!-- Decorative overlay -->
                            <div class="absolute inset-0 bg-primary/20 mix-blend-multiply"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cross-Sell Banner -->
        <section class="bg-[#111921] text-white py-12 relative overflow-hidden">
            <!-- Abstract background pattern -->
            <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/20 to-transparent"></div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="flex flex-col md:flex-row items-center justify-between gap-8">
                    <div>
                        <div class="inline-block px-3 py-1 rounded bg-green-500/20 text-green-400 text-xs font-bold mb-3">
                            ENERGY EFFICIENCY
                        </div>
                        <h3 class="text-2xl font-bold mb-2">Looking for energy independence?</h3>
                        <p class="text-gray-400 max-w-xl">Combine your wind retrofit with our Net-Zero solutions. Solar integration, insulation, and high-efficiency HVAC upgrades available.</p>
                    </div>
                    <button class="shrink-0 flex items-center gap-2 bg-white text-[#111418] font-bold py-3 px-6 rounded-lg hover:bg-gray-100 transition-colors">
                        Explore Net-Zero Retrofit
                        <span class="material-symbols-outlined text-primary">solar_power</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Social Proof / Testimonials -->
        <section class="py-16 lg:py-24 bg-white dark:bg-[#111921]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between mb-12">
                    <h2 class="text-2xl font-bold text-[#111418] dark:text-white">Trusted by Neighbors</h2>
                    <div class="flex gap-2">
                        <button class="size-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-800">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </button>
                        <button class="size-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-800">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>
                </div>
                <div class="grid md:grid-cols-3 gap-6">
                    <!-- Review 1 -->
