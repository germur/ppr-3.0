---
import Header from "../../../components/common/Header.astro";

import MainLayout from "../../../layouts/MainLayout.astro";

const pageTitle = "Custom Kitchen Remodeling | Paramount";
const metaDesc =
    "Blending culinary function with coastal luxury. Expert craftsmanship designed specifically for Florida homes. Fully insured.";

const kitchenSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Custom Kitchen Remodeling",
    provider: {
        "@type": "GeneralContractor",
        name: "Paramount Property Restoration",
        url: "https://paramountpropertyrestoration.com",
    },
    areaServed: "Florida",
    description: metaDesc,
    serviceType: "Residential Remodeling",
};
---

<MainLayout
    title={pageTitle}
    description={metaDesc}
    customSchema={kitchenSchema}
    hideHeader={true}
    hideFooter={false}
    breadcrumbItems={[
        { label: "Home", href: "/" },
        { label: "Remodeling", href: "/remodeling/" },
        { label: "Kitchen", href: "/remodeling/kitchen/" },
    ]}
>
    <!-- Inject Fonts into Head -->
    <fragment slot="head">
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
    </fragment>

    <!-- Sticky Nav Wrapper -->
    <div class="sticky top-0 z-50 font-['Plus_Jakarta_Sans']">
        <!-- Sticky Bar -->
        <div
            class="bg-[#d97706] text-white px-4 py-2 text-center text-sm font-medium flex items-center justify-center gap-4 flex-wrap shadow-md border-b border-amber-600 relative z-[51]"
        >
            <span class="flex items-center gap-2">
                <span class="material-symbols-outlined text-white text-[18px]"
                    >design_services</span
                >
                Dreaming of a new kitchen? <span class="font-bold"
                    >Get a Free 3D Design Consultation.</span
                >
            </span>
            <a
                href="tel:7866022217"
                class="bg-white text-[#d97706] hover:bg-amber-50 px-4 py-1 rounded text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1"
            >
                Schedule Now
                <span class="material-symbols-outlined text-[14px]"
                    >calendar_today</span
                >
            </a>
        </div>

        <!-- Global Header -->
        <Header theme="light" sticky={false} />
    </div>

    <!-- Local Styles -->
    <style>
        .font-display {
            font-family: "Plus Jakarta Sans", sans-serif;
        }
        .font-body {
            font-family: "Noto Sans", sans-serif;
        }
        /* Override primary color locally for this page */
        .text-primary,
        .bg-primary,
        .border-primary,
        .hover\:bg-primary:hover,
        .hover\:text-primary:hover,
        .group-hover\:bg-primary:hover {
            --tw-text-opacity: 1;
            color: rgba(217, 119, 6, var(--tw-text-opacity)); /* Amber 600 */
        }
        .bg-primary {
            background-color: #d97706;
        }
        .border-primary {
            border-color: #d97706;
        }
        /* Accent Color - Slate for contrast with Amber */
        .text-accent,
        .bg-accent {
            color: #475569;
        }
        .bg-accent {
            background-color: #475569;
        }

        /* Custom Button Override */
        .btn-amber {
            background-color: #d97706;
            color: white;
        }
        .btn-amber:hover {
            background-color: #b45309;
        }
    </style>

    <!-- Hero Section -->
    <section
        class="relative flex flex-col items-center justify-center min-h-[600px] w-full bg-cover bg-center bg-no-repeat font-display"
        data-alt="Modern luxury kitchen with large island, white marble countertops, and open plan design overlooking a sunny Florida patio"
        style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuA0a7iSaNKNsXGrB0k-u_kR5GgqHqmcV61LNkPjcCV2gXc7MJPK4WXBsS1wGLCtwOXVYGndqkyzgP9X7CzXmxEbOlQ7aFjBgN-7hh8d9GSl38VvBpwo6q5FimP6TA4qHjJ8vhmEd_4F_i6jTqFy_XlVnoFimL_rvNX0Y4CNbaY3CnSavP5fMcLRaHrExmUoxattuI8Zp18WU4MY2WoDKeNcrkzF2qUyeYTY7F7flG9Mdq9odCeN-s-te-X0DP5rtOeF59-9TLEQoWBP");'
    >
        <div
            class="container mx-auto px-4 py-20 flex flex-col items-center text-center max-w-4xl z-10"
        >
            <div
                class="bg-white/10 backdrop-blur-md p-8 md:p-12 rounded-2xl border border-white/20 shadow-2xl animate-fade-in-up"
            >
                <span
                    class="inline-block py-1 px-3 rounded-full bg-[#d97706]/90 text-white text-xs font-bold uppercase tracking-wider mb-4 border border-white/20"
                    >Florida's Premier Design-Build</span
                >
                <h1
                    class="text-white text-4xl md:text-6xl font-black leading-tight tracking-tight mb-6 drop-shadow-lg"
                >
                    Custom Kitchen Remodeling & Design-Build Services
                </h1>
                <p
                    class="text-white/90 text-lg md:text-xl font-medium leading-relaxed mb-8 max-w-2xl mx-auto drop-shadow-md font-body"
                >
                    Blending culinary function with coastal luxury. Expert
                    craftsmanship designed specifically for Florida homes.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button
                        class="flex items-center justify-center rounded-lg h-12 px-8 bg-[#d97706] hover:bg-amber-700 text-white text-base font-bold transition-all shadow-lg hover:shadow-orange-500/30 transform hover:-translate-y-1"
                    >
                        Get a Free Design Consultation
                    </button>
                    <button
                        class="flex items-center justify-center rounded-lg h-12 px-8 bg-white/20 hover:bg-white/30 backdrop-blur text-white border border-white/50 text-base font-bold transition-all"
                    >
                        View Portfolio
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Information Gain: Engineered for Florida -->
    <section class="py-16 md:py-24 bg-white font-display">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <h2
                        class="text-[#111418] text-3xl md:text-4xl font-bold leading-tight mb-6"
                    >
                        Engineered for Florida Living: <span
                            class="text-[#d97706]">Beauty Meets Resilience</span
                        >
                    </h2>
                    <p
                        class="text-[#617289] text-lg leading-relaxed mb-8 font-body"
                    >
                        Our kitchens are not just beautiful; they are
                        technically designed to withstand the unique challenges
                        of the Florida climate while maintaining luxury
                        aesthetics. We go beyond the surface to ensure
                        longevity.
                    </p>
                    <div
                        class="flex gap-4 items-center p-4 bg-amber-50 rounded-lg border-l-4 border-[#d97706]"
                    >
                        <span
                            class="material-symbols-outlined text-[#d97706] text-3xl"
                            >verified_user</span
                        >
                        <div>
                            <h4 class="font-bold text-[#111418]">
                                Licensed & Insured
                            </h4>
                            <p class="text-sm text-[#617289]">
                                State-Certified General Contractor
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex-1 grid gap-6">
                    <!-- Feature 1 -->
                    <div
                        class="flex gap-5 p-5 rounded-xl border border-[#dbe0e6] bg-white shadow-sm hover:shadow-md transition-shadow group"
                    >
                        <div
                            class="size-12 rounded-full bg-amber-100 flex items-center justify-center text-[#d97706] shrink-0 group-hover:bg-[#d97706] group-hover:text-white transition-colors"
                        >
                            <span class="material-symbols-outlined"
                                >humidity_percentage</span
                            >
                        </div>
                        <div>
                            <h3 class="text-[#111418] text-lg font-bold mb-2">
                                Moisture Resistance
                            </h3>
                            <p
                                class="text-[#617289] text-sm leading-relaxed font-body"
                            >
                                High-grade marine-ply cabinetry and non-porous
                                surfaces selected to resist humidity and prevent
                                warping in coastal environments.
                            </p>
                        </div>
                    </div>
                    <!-- Feature 2 -->
                    <div
                        class="flex gap-5 p-5 rounded-xl border border-[#dbe0e6] bg-white shadow-sm hover:shadow-md transition-shadow group"
                    >
                        <div
                            class="size-12 rounded-full bg-amber-100 flex items-center justify-center text-[#d97706] shrink-0 group-hover:bg-[#d97706] group-hover:text-white transition-colors"
                        >
                            <span class="material-symbols-outlined">storm</span>
                        </div>
                        <div>
                            <h3 class="text-[#111418] text-lg font-bold mb-2">
                                Storm Readiness
                            </h3>
                            <p
                                class="text-sm leading-relaxed font-body font-bold text-[#d97706]"
                            >
                                Structural reinforcements behind cabinetry and
                                impact-rated window integrations ensuring your
                                kitchen investment is hurricane-safe.
                            </p>
                        </div>
                    </div>
                    <!-- Feature 3 -->
                    <div
                        class="flex gap-5 p-5 rounded-xl border border-[#dbe0e6] bg-white shadow-sm hover:shadow-md transition-shadow group"
                    >
                        <div
                            class="size-12 rounded-full bg-amber-100 flex items-center justify-center text-[#d97706] shrink-0 group-hover:bg-[#d97706] group-hover:text-white transition-colors"
                        >
                            <span class="material-symbols-outlined">air</span>
                        </div>
                        <div>
                            <h3 class="text-[#111418] text-lg font-bold mb-2">
                                Cooling Flow
                            </h3>
                            <p
                                class="text-[#617289] text-sm leading-relaxed font-body"
                            >
                                Strategic layouts that maximize
                                cross-ventilation and airflow, keeping your
                                culinary space cool even during Florida summers.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bento Grid Features (Updated Colors) -->
    <section class="py-16 bg-[#fffbeb] font-display">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="mb-12 text-center max-w-3xl mx-auto">
                <h2 class="text-[#111418] text-3xl md:text-4xl font-bold mb-4">
                    Complete Kitchen Transformations
                </h2>
                <p class="text-[#617289] text-lg font-body">
                    From structural changes to the finest finishing touches, we
                    handle every aspect of your remodel.
                </p>
            </div>
            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[300px]"
            >
                <!-- Large Item -->
                <div
                    class="md:col-span-2 row-span-1 md:row-span-2 relative group overflow-hidden rounded-2xl"
                >
                    <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                        data-alt="Spacious open concept kitchen layout"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB-a65k0SsbnHziHQApqxI3RHbCDKifVJLRpdqLpiZDVeuQCTKMMLL_jNSA2vF98pJsJmAO-U1r-0G0ThZYI8zSJUnl5NADvWFRV3rdehD6xJBY6MiEKlXvKUbwhg1RhY6xS1oSvZVIOqZn38MDLbtHs4m6k81ll9sztIX3DwJTvMPK_29oUzhOjRidpzH3VuTLSjoXYih2QbtoxOyuWBddY02sWme0SF40w1E3CXq_hAp_tSc70HCR_1x1YwGLsWGiug32Pr9h3VKD");'
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"
                    >
                    </div>
                    <div class="absolute bottom-0 left-0 p-8">
                        <h3 class="text-white text-2xl font-bold mb-2">
                            Open-Concept Layouts
                        </h3>
                        <p class="text-white/80 font-body">
                            Seamless flow for entertaining, removing walls to
                            connect your culinary space with living areas.
                        </p>
                    </div>
                </div>
                <!-- Small Item -->
                <div
                    class="relative group overflow-hidden rounded-2xl bg-white border border-amber-100 p-8 flex flex-col justify-between"
                >
                    <div
                        class="bg-amber-50 size-12 rounded-full flex items-center justify-center text-[#d97706] mb-4"
                    >
                        <span class="material-symbols-outlined">cabin</span>
                    </div>
                    <div>
                        <h3 class="text-[#111418] text-xl font-bold mb-2">
                            Custom Cabinetry
                        </h3>
                        <p class="text-[#617289] text-sm font-body">
                            Maximize space with custom builds designed for your
                            specific storage needs.
                        </p>
                    </div>
                </div>
                <!-- Small Item Image -->
                <div class="relative group overflow-hidden rounded-2xl">
                    <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                        data-alt="Close up of high tech smart refrigerator and voice controlled lighting in kitchen"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAEc6EBPh0FrjBhr2vnSw1xqNr5HxCi0ixlFviWa_qdPgJDwyH_kDOmTLEHk0aGdYjZnV59swUVV5uKN2RDTdzQ3MHfcNcRKPoNe6J79F3aW30QHMqk6vTmMLtCYNMd04zM6YiiFjO0mxXaWpcEkOJ9TzUElR2r7fGpym19RsbK8STCCO9WC21OZiA5xXz5-22O14kTfYRIynTJoqNd58dXk1MaI3xvALKxqzZoklWTtK-0536AuYDt_dTdTJdrXwC37MwTQEfnXjwZ");'
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-black/40 group-hover:bg-black/50 transition-colors"
                    >
                    </div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-white text-xl font-bold mb-1">
                            Smart Kitchen Tech
                        </h3>
                        <p class="text-white/80 text-sm font-body">
                            Integrated smart appliances & lighting.
                        </p>
                    </div>
                </div>
                <!-- Medium Item Wide -->
                <div
                    class="md:col-span-2 relative group overflow-hidden rounded-2xl"
                >
                    <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                        data-alt="Luxury quartz countertop with waterfall edge and gold faucet fixtures"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuD_lNPtFDntKgzGHzRGx9UCLVH472zRFHPPmigN-VJbebE0x-xhHQTgrGARvFqTqdx96DxFjaviySHVSOmdNOcaki8vgvZZjZF4S7mD2SPz4Z6xnx1Xlov8Fj6XacYa33nrQ9nWVfdUnb45ezFrTN6IhboftCftg18MoeEkK6Zh3efDtfc3kUD0gOcfUcbg_2iFEMKx_aAj73e8o3ZwgT29KFueNNqwhoBikxXcQh9Zu1NMBKZAqXpbCYurm-EMPw7gmywKPY-VpQaj");'
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-black/70 to-transparent"
                    >
                    </div>
                    <div class="absolute bottom-0 left-0 p-8 w-full md:w-2/3">
                        <h3 class="text-white text-2xl font-bold mb-2">
                            Premium Countertops
                        </h3>
                        <p class="text-white/80 font-body">
                            Durable quartz, granite, and porcelain surfaces that
                            resist heat and scratching.
                        </p>
                    </div>
                </div>
                <!-- Small Item -->
                <!-- Small Item: Link to Modern Design Page -->
                <a
                    href="/remodeling/kitchen/modern-design/"
                    class="relative group overflow-hidden rounded-2xl bg-[#d97706] flex flex-col items-center justify-center text-center p-6 cursor-pointer hover:bg-amber-700 transition-colors"
                >
                    <h3 class="text-white text-xl font-bold mb-4">
                        View Modern Designs
                    </h3>
                    <div
                        class="bg-white text-[#d97706] rounded-full size-12 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform"
                    >
                        <span class="material-symbols-outlined"
                            >arrow_forward</span
                        >
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Timeline: From 3D Render to Reality -->
    <section class="py-16 md:py-24 bg-white font-display">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="text-center mb-16">
                <span
                    class="text-[#d97706] font-bold tracking-wider uppercase text-sm"
                    >Our Process</span
                >
                <h2 class="text-[#111418] text-3xl md:text-4xl font-bold mt-2">
                    From 3D Render to Reality
                </h2>
                <p class="text-[#617289] mt-4 font-body">
                    Transparent, professional, and code-compliant.
                </p>
            </div>
            <div class="grid grid-cols-[60px_1fr] gap-x-6">
                <!-- Step 1 -->
                <div class="flex flex-col items-center">
                    <div
                        class="size-12 rounded-full bg-amber-50 border-2 border-[#d97706] text-[#d97706] flex items-center justify-center z-10"
                    >
                        <span class="material-symbols-outlined">chat</span>
                    </div>
                    <div class="w-[2px] bg-amber-100 h-full"></div>
                </div>
                <div class="pb-12 pt-2">
                    <h3 class="text-[#111418] text-xl font-bold mb-2">
                        In-Home Consultation
                    </h3>
                    <p class="text-[#617289] font-body">
                        We assess your space, listen to your needs, and discuss
                        budget and timeline. No pressure, just expert advice.
                    </p>
                </div>
                <!-- Step 2 -->
                <div class="flex flex-col items-center">
                    <div
                        class="size-12 rounded-full bg-white border-2 border-gray-200 text-gray-500 flex items-center justify-center z-10 group-hover:border-[#d97706]"
                    >
                        <span class="material-symbols-outlined">view_in_ar</span
                        >
                    </div>
                    <div class="w-[2px] bg-amber-100 h-full"></div>
                </div>
                <div class="pb-12 pt-2">
                    <h3 class="text-[#111418] text-xl font-bold mb-2">
                        3D Design & Material Selection
                    </h3>
                    <p class="text-[#617289] font-body">
                        Visualize your new kitchen with photo-realistic
                        renderings. Select cabinets, tiles, and fixtures in our
                        design studio.
                    </p>
                </div>
                <!-- Step 3 -->
                <div class="flex flex-col items-center">
                    <div
                        class="size-12 rounded-full bg-white border-2 border-gray-200 text-gray-500 flex items-center justify-center z-10"
                    >
                        <span class="material-symbols-outlined">gavel</span>
                    </div>
                    <div class="w-[2px] bg-amber-100 h-full"></div>
                </div>
                <div class="pb-12 pt-2">
                    <h3 class="text-[#111418] text-xl font-bold mb-2">
                        Florida Permitting & HOA
                    </h3>
                    <p class="text-[#617289] font-body">
                        We handle all the red tape. From city permits to condo
                        association approvals, ensuring your renovation is fully
                        compliant.
                    </p>
                </div>
                <!-- Step 4 -->
                <div class="flex flex-col items-center">
                    <div
                        class="size-12 rounded-full bg-white border-2 border-gray-200 text-gray-500 flex items-center justify-center z-10"
                    >
                        <span class="material-symbols-outlined"
                            >construction</span
                        >
                    </div>
                </div>
                <div class="pb-0 pt-2">
                    <h3 class="text-[#111418] text-xl font-bold mb-2">
                        Build & Final Walkthrough
                    </h3>
                    <p class="text-[#617289] font-body">
                        Our skilled tradesmen bring the design to life. We
                        finish with a meticulous walkthrough to ensure every
                        detail is perfect.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-[#d97706] font-display">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <h2 class="text-white text-3xl md:text-5xl font-bold mb-6">
                Ready to Build Your Dream Kitchen?
            </h2>
            <p class="text-white/80 text-lg mb-10 max-w-2xl mx-auto font-body">
                Schedule your complimentary design consultation today and let's
                discuss how we can transform your home.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button
                    class="bg-white text-[#d97706] hover:bg-gray-100 font-bold py-4 px-8 rounded-lg text-lg shadow-xl transition-transform transform hover:-translate-y-1"
                >
                    Get Started Now
                </button>
                <a
                    href="tel:7866022217"
                    class="bg-transparent border-2 border-white text-white font-bold py-4 px-8 rounded-lg text-lg hover:bg-white/10 transition-colors"
                >
                    Call (786) 602-2217
                </a>
            </div>
        </div>
    </section>

    <!-- Programmatic SEO / Local Neighborhoods -->
    <section class="py-12 bg-white border-t border-[#f0f2f4] font-display">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="mb-8">
                <h3 class="text-[#111418] text-xl font-bold mb-2">
                    Serving Your Neighborhood
                </h3>
                <p class="text-sm text-[#617289]">
                    Local kitchen remodeling experts in your area.
                </p>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                <a
                    class="text-[#617289] hover:text-[#d97706] text-sm font-medium transition-colors flex items-center gap-1 group"
                    href="/service-areas/orlando/kitchen-remodeling/"
                >
                    <span
                        class="material-symbols-outlined text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                        >location_on</span
                    >
                    Orlando
                </a>
                <a
                    class="text-[#617289] hover:text-[#d97706] text-sm font-medium transition-colors flex items-center gap-1 group"
                    href="/service-areas/miami/kitchen-remodeling/"
                >
                    <span
                        class="material-symbols-outlined text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                        >location_on</span
                    >
                    Miami
                </a>
                <a
                    class="text-[#617289] hover:text-[#d97706] text-sm font-medium transition-colors flex items-center gap-1 group"
                    href="/service-areas/tampa/kitchen-remodeling/"
                >
                    <span
                        class="material-symbols-outlined text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                        >location_on</span
                    >
                    Tampa
                </a>
                <a
                    class="text-[#617289] hover:text-[#d97706] text-sm font-medium transition-colors flex items-center gap-1 group"
                    href="/service-areas/fort-lauderdale/kitchen-remodeling/"
                >
                    <span
                        class="material-symbols-outlined text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                        >location_on</span
                    >
                    Fort Lauderdale
                </a>
                <a
                    class="text-[#617289] hover:text-[#d97706] text-sm font-medium transition-colors flex items-center gap-1 group"
                    href="/service-areas/naples/kitchen-remodeling/"
                >
                    <span
                        class="material-symbols-outlined text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                        >location_on</span
                    >
                    Naples
                </a>
                <a
                    class="text-[#617289] hover:text-[#d97706] text-sm font-medium transition-colors flex items-center gap-1 group"
                    href="/service-areas/west-palm-beach/kitchen-remodeling/"
