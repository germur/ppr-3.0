---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
    <section class="relative bg-background-light dark:bg-background-dark pt-16 pb-20 lg:pt-24 lg:pb-28 overflow-hidden">
        <div class="absolute inset-0 z-0 opacity-10 dark:opacity-20 pointer-events-none">
            <img alt="Construction background pattern" class="w-full h-full object-cover grayscale" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBHniosOMNlhibcBDjPook-0aCP8Z37iGufFPqtI2MZ2relmuU5KUpRHe2rvJ_x4OqSn9vLc8fz8UaHgqcfrsdffQAJqEOuI5x7iyX-kyo4l3bg28x2ACbTlapVxQJJ0H1vzfx7je6n-iIVGHTLp8s0L9que3SuG32x9nqYHjIEqvjb0XvQN93_zYO3crjEqxS9mp9WDAWJSJX9--19bLqDtJgfv-4oygM6laQqBRKUh9Bmr7so3Bw58f-Cnm7mEFs5zeM6qGb43ip-" />
        </div>
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="inline-block py-1 px-3 rounded-full bg-blue-100 dark:bg-blue-900/30 text-secondary dark:text-blue-300 text-sm font-semibold mb-6 animate-float">
                Serving All of Florida • 24/7 Response
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-gray-900 dark:text-white mb-6">
                Florida’s Trusted General Contractor for <br class="hidden lg:block" />
                <span class="kinetic-text">Restoration & Remodeling</span>
            </h1>
            <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-500 dark:text-gray-400 mb-10">
                From catastrophic storm recovery to luxury kitchen renovations, we rebuild homes and restore peace of mind. Fast response, expert craftsmanship.
            </p>
            <div class="bg-card-light dark:bg-card-dark rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 p-2 max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4">
                <a href="/restoration/water-damage" class="group relative flex flex-col items-center justify-center p-6 rounded-xl border-2 border-red-500/20 hover:border-red-500 bg-red-50 dark:bg-red-900/10 hover:bg-red-100 dark:hover:bg-red-900/20 transition-all duration-300">
                    <div class="absolute top-3 right-3 animate-pulse-slow w-3 h-3 bg-red-500 rounded-full"></div>
                    <span class="material-symbols-outlined text-4xl text-red-600 mb-3 group-hover:scale-110 transition-transform">warning</span>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">I Have an Emergency</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Water, Fire, Mold, or Storm Damage</p>
                    <span class="mt-4 text-xs font-bold text-red-600 uppercase tracking-wide">60 Minute Response →</span>
                </a>
                <a href="/remodeling-services" class="group relative flex flex-col items-center justify-center p-6 rounded-xl border-2 border-blue-500/20 hover:border-blue-500 bg-blue-50 dark:bg-blue-900/10 hover:bg-blue-100 dark:hover:bg-blue-900/20 transition-all duration-300">
                    <span class="material-symbols-outlined text-4xl text-secondary dark:text-blue-400 mb-3 group-hover:scale-110 transition-transform">architecture</span>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">I Want to Remodel</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Kitchens, Baths, & Full Renovations</p>
                    <span class="mt-4 text-xs font-bold text-secondary dark:text-blue-400 uppercase tracking-wide">Schedule Estimate →</span>
                </a>
            </div>
        </div>
    </section>

    <div class="bg-white dark:bg-gray-900 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center justify-center text-center">
                <div class="flex flex-col items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-3xl text-primary">verified_user</span>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">Professional Service<br /><span class="text-xs text-gray-500 font-normal">Satisfaction Guaranteed</span></span>
                </div>

                <div class="flex flex-col items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-3xl text-primary">water_drop</span>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">Industry Standards<br /><span class="text-xs text-gray-500 font-normal">Expert Technicians</span></span>
                </div>
                <div class="flex flex-col items-center justify-center gap-2">
                    <div class="flex text-yellow-400">
                        <span class="material-symbols-outlined text-xl fill-current">star</span>
                        <span class="material-symbols-outlined text-xl fill-current">star</span>
                        <span class="material-symbols-outlined text-xl fill-current">star</span>
                        <span class="material-symbols-outlined text-xl fill-current">star</span>
                        <span class="material-symbols-outlined text-xl fill-current">star</span>
                    </div>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">4.9/5 Stars<br /><span class="text-xs text-gray-500 font-normal">Google Reviews</span></span>
                </div>
                <div class="flex flex-col items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-3xl text-primary">request_quote</span>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">Direct Insurance Billing<br /><span class="text-xs text-gray-500 font-normal">We handle the paperwork</span></span>
                </div>
            </div>
        </div>
    </div>

    <section class="py-20 bg-gray-50 dark:bg-black/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">Our Core Services</h2>
                <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">Comprehensive solutions for every property need.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 grid-rows-auto gap-4 md:gap-6 auto-rows-[200px]">
                <div class="bento-card relative group col-span-1 md:col-span-2 row-span-2 rounded-2xl overflow-hidden bg-card-light dark:bg-card-dark border border-gray-100 dark:border-gray-800">
                    <div class="absolute inset-0 bg-secondary/80 mix-blend-multiply z-10 transition-opacity group-hover:opacity-90"></div>
                    <img alt="Water damage restoration" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCarWEPmHGmtf53_HLApOcJ_cftnucYQ5P0E-qznsEcz_mD6xjvXUomc_nKKDs8MXmMGw7QbfJhkAcBdRoFksqKoCG2euy4mikT-pwdJz1smu0pDVNh88jW6QzgzF5DsKfzKLjOAZywDkkHMb1ZZkgTQiW7ErDmn3bZQ4pQhMkmiUVr_geKKltGA0RXeUB7iV5oqXoWtzIwqYyAtm7ry61-XXjvesp6VqGvYS6_dD4-jC-CC5bLfah7ietFkmF_-jWU7MFVqeDIhsC9" />
                    <div class="relative z-20 p-8 h-full flex flex-col justify-end">
                        <span class="material-symbols-outlined text-4xl text-blue-300 mb-4">water_damage</span>
                        <h3 class="text-2xl font-bold text-white mb-2">Water Damage Restoration</h3>
                        <p class="text-gray-200 mb-4 line-clamp-2">Rapid extraction, drying, and dehumidification to prevent structural damage and mold growth.</p>
                        <a class="inline-flex items-center text-white font-semibold hover:text-primary transition-colors" href="/restoration/water-damage">
                            Learn More <span class="material-symbols-outlined ml-1 text-sm">arrow_forward</span>
                        </a>
                    </div>
                </div>
                <div class="bento-card relative group col-span-1 md:col-span-1 row-span-2 rounded-2xl overflow-hidden bg-card-light dark:bg-card-dark border border-gray-100 dark:border-gray-800">
                    <div class="absolute inset-0 bg-black/40 z-10 transition-opacity group-hover:opacity-30"></div>
                    <img alt="Modern kitchen remodeling" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9pzA7ua1iKrrQE06hNRxJStM7bFCk8sgzpLR0Z_qJjyMT4X0kCRm68oZSd0qU7W5akqeV7vJAe-KbKkQ17-2YTlcnG_WzDRUPURMx4_Jbe00PPA_24EFqUlPRyDZbBj6ZrNFCBXzxGj6IZdFFJ6h99gW-ANrkTYRBOZWN-b4r9clQ-Vh3elU9UFz0vHVH-XPj3l3CsVWO7LKHImvGVFc0TE-A5uVTDNUEGOCjUloKPofAbyHgimYOdp5mEhxQPPzplHFqCKS5zQ4E" />
                    <div class="relative z-20 p-6 h-full flex flex-col justify-between">
                        <div class="bg-primary/90 backdrop-blur-sm w-fit p-2 rounded-lg text-white">
                            <span class="material-symbols-outlined">countertops</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2">Kitchen & Bath Remodeling</h3>
                            <a class="text-sm text-white/90 hover:text-white underline decoration-primary decoration-2 underline-offset-4" href="/remodeling-services/kitchen-remodeling">View Portfolio</a>
                        </div>
                    </div>
                </div>
                <div class="bento-card group col-span-1 rounded-2xl p-6 bg-card-light dark:bg-card-dark border border-gray-100 dark:border-gray-800 hover:border-green-500/30 flex flex-col justify-between">
                    <div class="flex items-start justify-between">
                        <div class="bg-green-100 dark:bg-green-900/30 p-2 rounded-lg text-green-600 dark:text-green-400">
                            <span class="material-symbols-outlined">coronavirus</span>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mt-4">Mold Remediation</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Safe containment & removal protocols.</p>
                    </div>
                </div>
                <a href="/restoration/fire-damage/" class="bento-card group col-span-1 rounded-2xl p-6 bg-card-light dark:bg-card-dark border border-gray-100 dark:border-gray-800 hover:border-red-500/30 flex flex-col justify-between transition-all hover:bg-gray-50 dark:hover:bg-gray-800/50">
                    <div class="flex items-start justify-between">
                        <div class="bg-red-100 dark:bg-red-900/30 p-2 rounded-lg text-red-600 dark:text-red-400">
                            <span class="material-symbols-outlined">local_fire_department</span>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mt-4">Fire & Smoke Repair</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Soot cleaning, odor removal & rebuilding.</p>
                    </div>
                </a>
                <a href="/restoration/storm-damage/" class="bento-card group col-span-1 md:col-span-2 rounded-2xl p-6 bg-gradient-to-br from-secondary to-blue-900 text-white flex flex-row items-center justify-between overflow-hidden relative">
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="material-symbols-outlined text-primary">cyclone</span>
                            <h3 class="text-xl font-bold">Storm Recovery</h3>
                        </div>
                        <p class="text-blue-100 text-sm max-w-xs">Hurricane preparation and post-storm reconstruction services.</p>
                    </div>
                    <div class="absolute right-0 bottom-0 opacity-10">
                        <span class="material-symbols-outlined text-9xl">cyclone</span>
                    </div>
                    <div class="relative z-10 bg-white/10 hover:bg-white/20 p-2 rounded-full backdrop-blur-sm transition-colors">
                        <span class="material-symbols-outlined">arrow_outward</span>
                    </div>
                </a>
                <div class="bento-card group col-span-1 md:col-span-2 rounded-2xl p-6 bg-card-light dark:bg-card-dark border border-gray-100 dark:border-gray-800 flex flex-col justify-center">
                    <div class="flex items-center gap-4">
                        <div class="bg-gray-100 dark:bg-gray-800 p-3 rounded-xl">
                            <span class="material-symbols-outlined text-2xl text-gray-600 dark:text-gray-300">domain</span>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Commercial Services</h3>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Large-loss recovery and tenant build-outs.</p>
                        </div>
                        <a class="ml-auto text-primary text-sm font-semibold hover:underline" href="/commercial">Learn more</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-20 bg-white dark:bg-background-dark overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-primary font-bold tracking-wide uppercase text-sm mb-2">The PPR Advantage</h2>
                    <h3 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl mb-6">Restoring Your Property,<br />Rebuilding Your Life</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-lg mb-8">
                        We understand that property damage is stressful. Our transparent, technology-driven process ensures you're informed every step of the way. We advocate for you with insurance carriers to get the coverage you deserve.
                    </p>
                    <div class="space-y-6">
                        <div class="flex group">
                            <div class="flex-shrink-0 mr-4 flex flex-col items-center">
                                <div class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-primary text-primary font-bold text-sm group-hover:bg-primary group-hover:text-white transition-colors">1</div>
                                <div class="h-full w-0.5 bg-gray-200 dark:bg-gray-700 my-2"></div>
                            </div>
                            <div class="pb-8">
                                <h4 class="text-lg font-bold text-gray-900 dark:text-white">Assessment & Mitigation</h4>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">We arrive within 60 minutes to stop damage and provide a detailed 3D scan of the property.</p>
                            </div>
                        </div>
                        <div class="flex group">
                            <div class="flex-shrink-0 mr-4 flex flex-col items-center">
                                <div class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 font-bold text-sm group-hover:border-primary group-hover:text-primary transition-colors">2</div>
                                <div class="h-full w-0.5 bg-gray-200 dark:bg-gray-700 my-2"></div>
                            </div>
                            <div class="pb-8">
                                <h4 class="text-lg font-bold text-gray-900 dark:text-white">Insurance Negotiation</h4>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">Our specialists submit detailed estimates directly to your adjuster to ensure proper coverage.</p>
                            </div>
                        </div>
                        <div class="flex group">
                            <div class="flex-shrink-0 mr-4 flex flex-col items-center">
                                <div class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 font-bold text-sm group-hover:border-primary group-hover:text-primary transition-colors">3</div>
                                <div class="h-full w-0.5 bg-gray-200 dark:bg-gray-700 my-2"></div>
                            </div>
                            <div class="pb-8">
                                <h4 class="text-lg font-bold text-gray-900 dark:text-white">Restoration & Build-Back</h4>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">Our skilled crews restore your property to pre-loss condition or better, using premium materials.</p>
                            </div>
                        </div>
                        <div class="flex group">
                            <div class="flex-shrink-0 mr-4 flex flex-col items-center">
                                <div class="flex items-center justify-center w-8 h-8 rounded-full border-2 border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 font-bold text-sm group-hover:border-primary group-hover:text-primary transition-colors">4</div>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-gray-900 dark:text-white">Final Walkthrough</h4>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">We ensure 100% satisfaction before closing the project.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <div class="absolute -inset-4 bg-primary/20 rounded-2xl blur-lg transform rotate-2"></div>
                    <img alt="Construction manager reviewing plans" class="relative rounded-2xl shadow-2xl border-4 border-white dark:border-gray-800" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDPatG_fBhAQnrHu1VfGtBqjT36GtqLGma3jbEdNkVjTTG1mVXDiD4NdRHOuMTMSq-edvY-0zesqd_QinN7h3g-Y384fgPAdXB-wugK-x94D3Q5zCRcigzz82TOFqcfLHkOjOkflhh0R3oqaakSOpLWZDkkA0GMYYtBMSI3oOY0BzvQHzl8B5VPtpuMx52ssHohqVDzO__TZwlR_QILw-psHMRY6kyy7mYeJXsmxvNnNAzOf10wYhOd2uCo_UCyDsd-KT4Xt_afEc1C" />
                </div>
            </div>
        </div>
    </section>

    <section class="py-20 bg-background-light dark:bg-background-dark">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Serving Across Florida</h2>
                <p class="mt-4 text-gray-500 dark:text-gray-400">Local teams ready to deploy in your area.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <a class="group relative overflow-hidden rounded-2xl shadow-lg aspect-[4/3]" href="/service-areas/central-florida/">
                    <img alt="Orlando Skyline" class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDrwsTf_fD_31pVlUKUOn2yzyyaghwB5-B0HboNqtAdHF4_fanVrIDK2LSS3OJ4v8kPgSKhbmIbcxmupskkwcgF-pEip2qleXiF83Iw7MbfN-d6NaX6LQ_gIi9llO_fI92N8IXf29tP1xv9wtlgVQSWXEq2SCg5MUjDXOyjDwqKi-nxiCR7J2XgdEoeiTSVDjU1hfeZEoHjEocxDp2i3y9JrCYX6wjeidDul8qgug7dTGZLzV41ZTby2NSHkSRqIjugX6o8kxE1hqOp" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-2xl font-bold text-white mb-1">Central Florida</h3>
                        <p class="text-gray-300 text-sm">Orlando • Kissimmee • Sanford</p>
                    </div>
                </a>
                <a class="group relative overflow-hidden rounded-2xl shadow-lg aspect-[4/3]" href="/service-areas/south-florida/">
                    <img alt="Miami Skyline" class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBYUXQPrWgXjvp_-nbZbJn50P-55Qpr2TqZZ8sZOOIk9QxdwB0D7YCuvV9ANDd_MIJWILr7sEnS8lisU6Uam2ghWw1jO7IBpehlJby_AE4MypZTblUYjxvzmpvQbLy9lFZ0iq7LnO3QidkUBt9TTPqi_GCSRAhr60yQb7kEbVTt0EOFe-XDzP2fmABg5kCjtOUzV2OVW7R8RMI_330RJpv8WysmTIa5udYcjmn_wCWAJx5lTXl-tDDsBTYFrhzjU0xpSbyM2HZhkRmJ" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-2xl font-bold text-white mb-1">South Florida</h3>
                        <p class="text-gray-300 text-sm">Miami • Ft. Lauderdale • West Palm</p>
                    </div>
                </a>
                <a class="group relative overflow-hidden rounded-2xl shadow-lg aspect-[4/3]" href="/service-areas/tampa-bay/">
                    <img alt="Tampa Skyline" class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA25oWGgOb1mkyl-doC8cdqivGEtvrqKlAdBhXGghNycnq-RwywQgLALtZn5N1Zg27IuXtu2jpckDScLheKkL_I8zD4oypXJ9oJEavMzzLtre5fTiW8ni5m-8snriMhPs2PA16_2Qp_vHqiRISi0LM-3lfSibELTX71T_Dg14gInzxMA5i7d-wGICEAeoapuV70Xm06LNdns8QtVk-GsfhD_fMLcKrAJWQzjQzRrWkHtnyADfK5UgEcILPSBoCvniPd5MAgsqttGCTF" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-6">
                        <h3 class="text-2xl font-bold text-white mb-1">Tampa Bay</h3>
                        <p class="text-gray-300 text-sm">Tampa • St. Pete • Clearwater</p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <section class="py-16 bg-card-light dark:bg-card-dark border-t border-gray-200 dark:border-gray-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">Frequently Asked Questions</h2>
            <div class="space-y-4">
                <details class="group bg-background-light dark:bg-background-dark rounded-lg p-4 cursor-pointer">
                    <summary class="flex justify-between items-center font-medium text-gray-900 dark:text-white list-none">
                        <span>How quickly can you respond to water damage in Orlando?</span>
                        <span class="transition group-open:rotate-180">
                            <span class="material-symbols-outlined">expand_more</span>
                        </span>
                    </summary>
                    <p class="text-gray-500 dark:text-gray-400 mt-3 group-open:animate-fadeIn">
                        We offer a 60-minute response time for emergency water damage calls throughout Central Florida. Our local teams are on standby 24/7.
                    </p>
                </details>
                <details class="group bg-background-light dark:bg-background-dark rounded-lg p-4 cursor-pointer">
                    <summary class="flex justify-between items-center font-medium text-gray-900 dark:text-white list-none">
                        <span>Do you work directly with my insurance company?</span>
                        <span class="transition group-open:rotate-180">
                            <span class="material-symbols-outlined">expand_more</span>
                        </span>
                    </summary>
                    <p class="text-gray-500 dark:text-gray-400 mt-3 group-open:animate-fadeIn">
                        Yes, Paramount Property Restoration works with all major insurance carriers in Florida. We use Xactimate software (industry standard) to ensure your claim is accurate and fair.
                    </p>
                </details>
                <details class="group bg-background-light dark:bg-background-dark rounded-lg p-4 cursor-pointer">
                    <summary class="flex justify-between items-center font-medium text-gray-900 dark:text-white list-none">
                        <span>Are you a professional restoration company?</span>
                        <span class="transition group-open:rotate-180">
                            <span class="material-symbols-outlined">expand_more</span>
                        </span>
