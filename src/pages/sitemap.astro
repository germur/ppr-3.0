---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// 1. Fetch Dynamic Data
const cities = await getCollection("cities");
const blogPosts = await getCollection("blog");

// 2. Organize Cities by Region
const citiesByRegion: Record<string, { name: string; url: string }[]> =
  cities.reduce((acc, city) => {
    const region = city.data.region || "Florida";
    // @ts-ignore
    if (!acc[region]) acc[region] = [];
    // @ts-ignore
    acc[region].push({
      name: city.data.name,
      url: `/service-areas/${city.slug}/`,
    });
    return acc;
  }, {});

// Sort regions and cities
const sortedRegions = Object.keys(citiesByRegion).sort();
sortedRegions.forEach((region) => {
  citiesByRegion[region].sort((a, b) => a.name.localeCompare(b.name));
});

// 3. Process Blog Posts (Recent 12)
const recentResources = blogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 12)
  .map((post) => ({
    name: post.data.title,
    url: `/resources/${post.data.subcategory}/${post.slug}/`,
    category: post.data.category,
  }));

// 4. Static Sections
const sitemapSections = [
