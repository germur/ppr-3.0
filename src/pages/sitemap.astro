---

<MainLayout
  title="Sitemap | Paramount"
  description="Complete overview of all pages and services offered by Paramount Property Restoration in Florida."
>
  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white py-20 px-4">
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-r from-slate-900 to-slate-800 opacity-90"
      >
      </div>
      <!-- Abstract background pattern -->
      <svg
        class="absolute w-full h-full opacity-10"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <path d="M0 100 C 20 0 50 0 100 100 Z" fill="currentColor"></path>
      </svg>
    </div>

    <div class="relative max-w-7xl mx-auto text-center z-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Site Map</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        Navigate through all our services, locations, and resources. Find
        exactly what you need to restore or improve your property.
      </p>
    </div>
  </section>

  <div class="bg-white dark:bg-slate-950 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- STATIC MAIN SECTIONS -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 mb-16">
        {
          sitemapSections.map((section) => (
            <div class="bg-gray-50 dark:bg-slate-900 rounded-xl p-8 border border-gray-100 dark:border-slate-800 hover:shadow-lg transition-shadow duration-300">
              <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6 border-b border-gray-200 dark:border-slate-700 pb-2">
                {section.title}
              </h2>
              <ul class="space-y-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      class="flex items-center group text-gray-600 dark:text-gray-400 hover:text-[#136dec] dark:hover:text-[#136dec] transition-colors duration-200"
                    >
                      <span class="material-symbols-outlined text-sm mr-2 opacity-50 group-hover:opacity-100 transition-opacity">
                        arrow_forward_ios
                      </span>
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- DYNAMIC SERVICE AREAS -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <span
            class="p-2 bg-blue-50 dark:bg-blue-900/30 rounded-lg text-[#136dec]"
          >
            <span class="material-symbols-outlined">location_on</span>
          </span>
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
            Service Areas
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {
            sortedRegions.map((region) => (
              <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-100 dark:border-slate-800">
                <h3 class="font-bold text-lg mb-4 text-[#136dec] border-b border-gray-100 dark:border-slate-800 pb-2">
                  {region}
                </h3>
                <ul class="space-y-2">
                  {citiesByRegion[region].map((city) => (
                    <li>
                      <a
                        href={city.url}
                        class="flex items-center text-sm text-gray-600 dark:text-gray-400 hover:text-[#136dec] dark:hover:text-[#136dec] transition-colors"
                      >
                        <span class="material-symbols-outlined text-[4px] mr-2 bg-gray-300 rounded-full text-transparent">
                          circle
                        </span>
                        {city.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <!-- Link to main regions -->
        <div class="mt-4 text-center">
          <a
            href="/service-areas/"
            class="text-sm font-bold text-[#136dec] hover:underline"
            >View Regional Map & Coverage -></a
          >
        </div>
      </div>

      <!-- DYNAMIC RESOURCES -->
      <div>
        <div class="flex items-center gap-3 mb-8">
          <span
            class="p-2 bg-orange-50 dark:bg-orange-900/30 rounded-lg text-[#ea580c]"
          >
            <span class="material-symbols-outlined">article</span>
          </span>
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
            Recent Resources
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            recentResources.map((post) => (
              <a
                href={post.url}
                class="group bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-100 dark:border-slate-800 hover:border-[#ea580c] dark:hover:border-[#ea580c] transition-colors shadow-sm hover:shadow-md"
              >
                <span class="text-xs font-bold text-[#ea580c] uppercase tracking-wider mb-2 block">
                  {post.category}
                </span>
                <h3 class="font-bold text-slate-900 dark:text-white group-hover:text-[#ea580c] transition-colors line-clamp-2">
                  {post.name}
                </h3>
                <div class="mt-4 flex items-center text-xs text-gray-500 font-medium group-hover:text-[#ea580c] transition-colors">
                  Read Guide{" "}
                  <span class="material-symbols-outlined text-sm ml-1">
                    arrow_forward
                  </span>
                </div>
              </a>
            ))
          }
        </div>
        <div class="mt-8 text-center">
          <a
            href="/resources/"
            class="inline-flex items-center justify-center px-6 py-3 border border-slate-200 dark:border-slate-700 text-base font-medium rounded-lg text-slate-700 dark:text-white bg-white dark:bg-slate-800 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
          >
            Browse All Articles
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick CTA -->
  <section
    class="bg-slate-50 dark:bg-slate-950 py-16 border-t border-gray-200 dark:border-slate-800"
  >
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">
        Can't find what you're looking for?
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        Our support team is available 24/7 to answer your questions and provide
        immediate assistance.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-[#136dec] hover:bg-blue-700 transition-colors"
        >
          Contact Support
        </a>
        <a
          href="tel:7866022217"
          class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-slate-600 text-base font-medium rounded-md text-gray-700 dark:text-white bg-white dark:bg-slate-800 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
        >
          Call (786) 602-2217
        </a>
      </div>
    </div>
  </section>
</MainLayout>
