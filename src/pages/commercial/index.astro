---
import CommercialLayout from "../../layouts/CommercialLayout.astro";
---

<CommercialLayout
  title="Commercial Build-Outs & Renovation | Paramount"
  description="Turnkey commercial renovations and tenant improvements delivered on schedule. We specialize in reducing downtime and maximizing ROI."
>
  <!-- Hero Section -->
  <section class="relative bg-[#1a2430] text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div
        class="w-full h-full bg-cover bg-center"
        data-alt="Modern open-concept commercial office space with glass walls"
        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDHo41s7r3ESA3MnMqskJaxuHA6v2qlReGjO0FjsC2Fie0BLl2yI9Bp32N_ejoyegAo08khW8M9dvesWjgPsnL0h9QmCnmV-gdaCXUdpUpwFcxA9jNDLjtAGxuqkFX6Rry5cjSe3YzoZBbe_e8dYLJx_iW53vEv4pvoJTqp7Lo_a8omCvStiBDB29ORElngz5KURpuAeT5ki6lRmk5TTzgcwZCc9g-0v4kEnWJ8XFI2N-_-9B0sP6gzvEm0HMv44DZJmSoMDQxT45IY');"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#0a121e]/95 via-[#0a121e]/80 to-transparent"
      >
      </div>
    </div>
    <div
      class="relative z-10 mx-auto max-w-[1440px] px-4 sm:px-10 py-20 lg:py-32"
    >
      <div class="max-w-2xl flex flex-col gap-6">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 w-fit"
        >
          <span class="material-symbols-outlined text-green-400 text-sm"
            >verified_user</span
          >
          <span class="text-xs font-bold tracking-wide uppercase"
            >Fully Bonded & Insured</span
          >
        </div>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tight"
        >
          Maximize Business Continuity & Square Footage Value
        </h1>
        <p class="text-lg md:text-xl text-gray-300 font-medium max-w-xl">
          Turnkey commercial renovations and tenant improvements delivered on
          schedule. We specialize in reducing downtime and maximizing ROI.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <a
            href="/contact/"
            class="flex items-center justify-center h-14 px-8 rounded-lg bg-[#f97316] hover:bg-orange-600 text-white text-base font-bold tracking-wide shadow-lg shadow-orange-500/20 transition-all transform hover:-translate-y-0.5"
          >
            Request a Commercial Bid
          </a>
          <!-- Added anchor link to projects section if it exists, otherwise generic link -->
          <a
            href="/our-process/"
            class="flex items-center justify-center h-14 px-8 rounded-lg bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/20 text-base font-bold transition-all"
          >
            View Past Projects
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Information Gain Section -->
  <section class="py-16 md:py-24 bg-white dark:bg-[#1a2430] px-4 sm:px-10">
    <div class="mx-auto max-w-[1200px]">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="flex flex-col gap-6">
          <div
            class="flex items-center gap-2 text-[#1269e2] font-bold uppercase tracking-wider text-sm"
          >
            <span class="w-8 h-[2px] bg-[#1269e2]"></span>
            Key Insights
          </div>
          <h2
            class="text-3xl md:text-4xl font-black text-[#111418] dark:text-white leading-tight"
          >
            Florida Commercial Codes: <span class="text-[#1269e2]"
              >Beyond the Basics</span
            >
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            Essential insights for property managers and owners regarding
            Florida's specific commercial requirements. We navigate the red tape
            so you don't have to.
          </p>
        </div>
        <div class="grid gap-4">
          <!-- Insight Card 1 -->
          <div
            class="bg-[#f6f7f8] dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 flex gap-4 transition-all hover:border-[#1269e2]/50 group"
          >
            <div
              class="flex-shrink-0 size-12 rounded-full bg-white dark:bg-gray-700 flex items-center justify-center text-[#1269e2] shadow-sm group-hover:bg-[#1269e2] group-hover:text-white transition-colors"
            >
              <span class="material-symbols-outlined">accessible</span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">
                ADA Compliance Retrofitting
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Navigating complex accessibility requirements (ANSI A117.1) for
                older buildings to ensure full compliance without overspending.
              </p>
            </div>
          </div>
          <!-- Insight Card 2 -->
          <div
            class="bg-[#f6f7f8] dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 flex gap-4 transition-all hover:border-[#1269e2]/50 group"
          >
            <div
              class="flex-shrink-0 size-12 rounded-full bg-white dark:bg-gray-700 flex items-center justify-center text-[#1269e2] shadow-sm group-hover:bg-[#1269e2] group-hover:text-white transition-colors"
            >
              <span class="material-symbols-outlined">storm</span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">
                Hurricane-Rated Storefronts
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Installing high-velocity impact-resistant glazing and structural
                reinforcements mandated for Florida HVHZ zones.
              </p>
            </div>
          </div>
          <!-- Insight Card 3 -->
          <div
            class="bg-[#f6f7f8] dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 flex gap-4 transition-all hover:border-[#1269e2]/50 group"
          >
            <div
              class="flex-shrink-0 size-12 rounded-full bg-white dark:bg-gray-700 flex items-center justify-center text-[#1269e2] shadow-sm group-hover:bg-[#1269e2] group-hover:text-white transition-colors"
            >
              <span class="material-symbols-outlined">speed</span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">
                Permitting Speed Strategies
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Expedited permit processing through our established
                relationships with local building departments.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid (Bento UI) -->
  <section class="py-16 md:py-24 bg-[#f6f7f8] dark:bg-[#101822] px-4 sm:px-10">
    <div class="mx-auto max-w-[1200px]">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2
          class="text-3xl md:text-4xl font-black text-[#111418] dark:text-white mb-4"
        >
          Commercial Services Overview
        </h2>
        <p class="text-gray-600 dark:text-gray-400">
          Comprehensive build-out and renovation solutions tailored for distinct
          commercial sectors.
        </p>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[300px]"
      >
        <!-- Large Card (Span 2 cols on lg) -->
        <div
          class="bento-card relative group rounded-2xl overflow-hidden lg:col-span-2 md:col-span-2 bg-white dark:bg-[#1a2430]"
        >
          <div
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            data-alt="Modern tenant improvement office interior with polished concrete"
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCuFgeNYeicYVzeH_vp4mxtw64mD7SXtwLmcrhBJck845Rrta43vv2dkIoudX9z6SSlMgwKu3WDeZv2OV-skCe4OeRRDdEPN5V2u3n82pdiBjGMUio4cAELFB4qovpVhePxrfG59BJMgeOkeXklHoH57Ei3fKUg0bypKkJMyGG-cD_JJ5TpZP2RQkEAGuMtRizQx78C4FZ49t1BNj7wNHgATzrghHsdCmf4fxRzU3O_jNgLP60FZMeLRolLtDzlZxeUIj0NvzfxmUeG');"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"
            >
            </div>
          </div>
          <div class="relative h-full flex flex-col justify-end p-8">
            <div class="mb-2 p-2 bg-[#1269e2]/90 w-fit rounded-lg text-white">
              <span class="material-symbols-outlined">architecture</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Tenant Improvements (TI)
            </h3>
            <p class="text-gray-200 text-sm max-w-md">
              Customizing spaces for new commercial tenants. From polished
              concrete to custom millwork, we deliver brand-aligned
              environments.
            </p>
          </div>
        </div>
        <!-- Standard Card -->
        <div
          class="bento-card relative group rounded-2xl overflow-hidden bg-white dark:bg-[#1a2430] border border-gray-200 dark:border-gray-700"
        >
          <div
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            data-alt="Empty white box commercial space ready for fit out"
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAeKVWLM1xNyWWLn7TimkIhud-ESAJterXiffQpdN4UcGNuPZZa6VoQQ8XSXVHY9jcV4XLdQJTMvxx8DmM2pkDzr-dSAiCatr6N-gWi9YCYPaTOwm96JEeLdUD7vNbLckseAL3Vmq0jWiEnRVh4uZ3Cvg3DFNaUsBhPcnLjh-7VaEB1dr5PjVFFJBwOLzL5qSi1w_Gapty9szPueM0OjQgyipzDLyO3aGfV9MlzpIkpgxRupNs1ghE9owcS72-TPMRgthRF0WhtsWwr');"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
            >
            </div>
          </div>
          <div class="relative h-full flex flex-col justify-end p-6">
            <div
              class="mb-2 p-2 bg-white/20 backdrop-blur-md w-fit rounded-lg text-white"
            >
              <span class="material-symbols-outlined"
                >check_box_outline_blank</span
              >
            </div>
            <h3 class="text-xl font-bold text-white mb-1">
              White-Box & Vanilla Shell
            </h3>
            <p class="text-gray-300 text-sm">
              Preparing raw spaces for future leasing with clean finishes and
              basic utilities.
            </p>
          </div>
        </div>
        <!-- Standard Card -->
        <div
          class="bento-card relative group rounded-2xl overflow-hidden bg-white dark:bg-[#1a2430] border border-gray-200 dark:border-gray-700"
        >
          <div
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            data-alt="Luxury multi-family apartment complex lobby"
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD26sefAerk5fVUppfQJ5WrK9jB9CdnY4qUetNM5LsG-dwOwjfBOnfaBUVAE7v43-CdO3z7mAnkNjoPGJqA6E4j767uKoOoQg4sOhksfAJBfEm9BWl_OvmAntwPp-UGjeQbMPm3g-53YijcC0wcJEKIqR_JcsledNDSAyckWR0s34q1Nl9mDEX3oQSgaBaMF4gkexGC_s0L4CvWBl03yAlx-kVMBYUywpABFpjU9UzQfzCRlpaGYWabincun93-hMEaxzRIehhB_TDE');"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
            >
            </div>
          </div>
          <div class="relative h-full flex flex-col justify-end p-6">
            <div
              class="mb-2 p-2 bg-white/20 backdrop-blur-md w-fit rounded-lg text-white"
            >
              <span class="material-symbols-outlined">apartment</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-1">
              Multi-Family Capital
            </h3>
            <p class="text-gray-300 text-sm">
              Large-scale upgrades for apartment complexes, lobbies, and common
              areas.
            </p>
          </div>
        </div>
        <!-- Large Card (Span 2 cols on lg) -->
        <div
          class="bento-card relative group rounded-2xl overflow-hidden lg:col-span-2 bg-white dark:bg-[#1a2430] border border-gray-200 dark:border-gray-700"
        >
          <div
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            data-alt="High end restaurant interior renovation"
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCjZz1xhudCkQ6A2eV4izdTZeMZPQvdJUmln722a4QEz36px7SXNFzKHiM0VeGc6WGEoPpnzUgyEoYnGYDpmIXpiiDIvFkXAGkvL1iiptfHpCO0PVbqx8iKOCA9eeI6oNVfbD_w-31KXWej9UnJkeQEdKIgpx5bvqA5Lv_4C9Vhsdqii7ZwRSc42c58N8Pii4CgxzW34ISs4qgu_nxKmMkXbgBgBHaJ1_zWK7oTv9xa4-g9zczGdWY8U5UbwAcznmFlL9kV4Hvsu1Ot');"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"
            >
            </div>
          </div>
          <div class="relative h-full flex flex-col justify-end p-8">
            <div class="mb-2 p-2 bg-[#f97316]/90 w-fit rounded-lg text-white">
              <span class="material-symbols-outlined">storefront</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Retail & Hospitality
            </h3>
            <p class="text-gray-200 text-sm max-w-lg">
              High-traffic renovation for branding updates. We work during
              off-hours to minimize disruption to your customer experience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section
    class="py-16 md:py-24 bg-[#1a2430] text-white px-4 sm:px-10 overflow-hidden relative"
  >
    <!-- Abstract Background Pattern -->
    <div
      class="absolute top-0 right-0 w-1/2 h-full opacity-5 pointer-events-none"
    >
      <span class="material-symbols-outlined text-[400px]">engineering</span>
    </div>
    <div class="mx-auto max-w-[1200px] relative z-10">
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-black mb-4">
          Process: <span class="text-[#f97316]">Speed to Market</span>
        </h2>
        <p class="text-gray-400 max-w-2xl">
          Our systematic approach ensures predictability in budgeting and
          scheduling.
        </p>
      </div>
      <div class="flex flex-col md:flex-row gap-8 relative">
        <!-- Connecting Line (Desktop) -->
        <div
          class="hidden md:block absolute top-8 left-0 w-full h-1 bg-gray-700 z-0"
        >
        </div>
        <!-- Step 1 -->
        <div class="flex-1 relative z-10 group">
          <div
            class="size-16 rounded-full bg-[#1269e2] border-4 border-[#1a2430] flex items-center justify-center text-2xl font-bold mb-6 shadow-lg shadow-blue-500/30 group-hover:scale-110 transition-transform"
          >
            1
          </div>
          <h3 class="text-xl font-bold mb-3">Pre-Construction</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Detailed site analysis, scope definition, value engineering, and
            expedited permitting acquisition.
          </p>
        </div>
        <!-- Step 2 -->
        <div class="flex-1 relative z-10 group">
          <div
            class="size-16 rounded-full bg-gray-700 group-hover:bg-[#f97316] border-4 border-[#1a2430] flex items-center justify-center text-2xl font-bold mb-6 transition-colors shadow-lg"
          >
            2
          </div>
          <h3 class="text-xl font-bold mb-3">Mobilization & Build</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Efficient material procurement, trade coordination, and on-site
            management with daily reporting.
          </p>
        </div>
        <!-- Step 3 -->
        <div class="flex-1 relative z-10 group">
          <div
            class="size-16 rounded-full bg-gray-700 group-hover:bg-[#f97316] border-4 border-[#1a2430] flex items-center justify-center text-2xl font-bold mb-6 transition-colors shadow-lg"
          >
            3
          </div>
          <h3 class="text-xl font-bold mb-3">Inspections & Closeout</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Rigorous final inspections, punch-list completion, and comprehensive
            turnover documentation.
          </p>
        </div>
      </div>
      <div class="mt-16 text-center">
        <a
          class="inline-flex items-center justify-center h-12 px-8 rounded-lg bg-[#1269e2] hover:bg-blue-600 text-white font-bold transition-colors"
          href="/contact/"
        >
          Schedule a Site Walk
          <span class="material-symbols-outlined ml-2">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Local SEO Section -->
  <section
    class="py-16 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800 px-4 sm:px-10"
  >
    <div class="mx-auto max-w-[1200px]">
      <h2 class="text-2xl font-bold text-[#111418] dark:text-white mb-8">
        Commercial Construction Areas
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <!-- SEO Link Item -->
        <a
          class="flex items-center gap-2 p-3 rounded-lg hover:bg-[#f6f7f8] dark:hover:bg-gray-800 transition-colors group"
          href="/service-areas/miami/"
        >
          <span
            class="material-symbols-outlined text-gray-400 group-hover:text-[#1269e2]"
            >location_on</span
          >
          <span
            class="text-sm font-medium text-gray-600 dark:text-gray-300 group-hover:text-[#1269e2]"
            >Miami Commercial Contractors</span
          >
        </a>
        <a
          class="flex items-center gap-2 p-3 rounded-lg hover:bg-[#f6f7f8] dark:hover:bg-gray-800 transition-colors group"
          href="/service-areas/orlando/"
        >
          <span
            class="material-symbols-outlined text-gray-400 group-hover:text-[#1269e2]"
            >location_on</span
          >
          <span
            class="text-sm font-medium text-gray-600 dark:text-gray-300 group-hover:text-[#1269e2]"
            >Orlando Tenant Improvement</span
          >
        </a>
        <a
          class="flex items-center gap-2 p-3 rounded-lg hover:bg-[#f6f7f8] dark:hover:bg-gray-800 transition-colors group"
          href="/service-areas/tampa/"
        >
          <span
            class="material-symbols-outlined text-gray-400 group-hover:text-[#1269e2]"
            >location_on</span
          >
          <span
            class="text-sm font-medium text-gray-600 dark:text-gray-300 group-hover:text-[#1269e2]"
            >Tampa Office Renovation</span
          >
        </a>
        <a
          class="flex items-center gap-2 p-3 rounded-lg hover:bg-[#f6f7f8] dark:hover:bg-gray-800 transition-colors group"
          href="/service-areas/"
        >
          <span
            class="material-symbols-outlined text-gray-400 group-hover:text-[#1269e2]"
            >location_on</span
          >
          <span
            class="text-sm font-medium text-gray-600 dark:text-gray-300 group-hover:text-[#1269e2]"
            >Jacksonville Build-Outs</span
          >
        </a>
        <a
          class="flex items-center gap-2 p-3 rounded-lg hover:bg-[#f6f7f8] dark:hover:bg-gray-800 transition-colors group"
          href="/service-areas/fort-lauderdale/"
        >
          <span
            class="material-symbols-outlined text-gray-400 group-hover:text-[#1269e2]"
            >location_on</span
          >
          <span
            class="text-sm font-medium text-gray-600 dark:text-gray-300 group-hover:text-[#1269e2]"
            >Fort Lauderdale Retail</span
          >
        </a>
        <a
          class="flex items-center gap-2 p-3 rounded-lg hover:bg-[#f6f7f8] dark:hover:bg-gray-800 transition-colors group"
          href="/service-areas/west-palm-beach/"
