---
import ServiceAreaLayout from '../../../../layouts/ServiceAreaLayout.astro';
import { cities, type CityData } from '../../../../data/service-areas';
import { services, type ServiceData } from '../../../../data/services';
import Breadcrumbs from '../../../../components/common/Breadcrumbs.astro';

export async function getStaticPaths() {
  const paths: any[] = [];
  
  // Matrix Generation: All Cities x All Services
  for (const city of cities) {
    for (const service of services) {
      paths.push({
        params: { 
            region: city.region,
            city: city.slug, 
            service: service.slug 
        },
        props: { city, service },
      });
    }
  }
  
  return paths;
}

interface Props {
  city: CityData;
  service: ServiceData;
}

const { city, service } = Astro.props;

// Dynamic Variables Construction
const pageTitle = `${service.name} in ${city.name}, FL | 24/7 Emergency Response`;
const metaDesc = `Looking for ${service.name} in ${city.name}? We are local, experienced, and arrive in 60 mins. Serving ${city.neighborhoods.slice(0, 3).join(", ")} and surrounding ${city.county} areas.`;
const heroH1 = `Expert ${service.name} in ${city.name}, FL`;
const themeColor = service.theme.primary;
const accentColor = service.theme.accent;

// JSON-LD Schema
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": service.name,
  "areaServed": {
    "@type": "City",
    "name": city.name,
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "FL",
      "addressCountry": "US"
    }
  },
  "provider": {
    "@type": "LocalBusiness",
    "name": "Paramount Property Restoration",
    "telephone": city.phone,
    "image": "https://paramountrestoration.com/logo.png", 
    "priceRange": "$$"
  },
  "description": metaDesc
};
---

<ServiceAreaLayout title={pageTitle} themeColor={themeColor} accentColor={accentColor}>
  <!-- Inject JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="layout-container flex flex-col items-center w-full">
    
    <!-- Breadcrumbs -->
    <div class="w-full max-w-[1200px] px-4 pt-4 pb-0">
        <Breadcrumbs 
            items={[
                { label: 'Home', href: '/' },
                { label: 'Service Areas', href: '/service-areas/' },
                { label: city.region.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '), href: `/service-areas/${city.region}/` },
                { label: city.name, href: `/service-areas/${city.region}/${city.slug}/` }, // Link to City Silo (future) or just breadcrumb
                { label: service.name, href: Astro.url.pathname }
            ]}
            themeColor={themeColor}
        />
    </div>

    <!-- Hero Section -->
    <div class="w-full relative">
      <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat" data-alt={`${service.name} in ${city.name}`} style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuCKuY9PlD8cZ07Mu16EMrWZA_N8XUGFfW1vJuYXyWHvS-yXJZ0EyfWbK3CMlkB8qRLgukltToB9jLPWmMhdyqstQlIlrGEM_66hi9jB1o6vZ9MZBBtsjRecAtJJmxsLBV9-elrQNrKqVrP7_MTa-wJuLikbyoli21jaVje7sJlaaoyv2Dazk9ZbB0uKeDgcqIMIxKWiPTnTEj5nVfWoo9AM2rBlZxXrvE3xxDVEyQluq8kTUva11L8IDpo7L9PoFNy--fnKUw9ZZE4B");'>
      </div>
      <div class="relative z-10 w-full flex justify-center px-4 py-20 lg:py-32">
        <div class="max-w-[1200px] w-full flex flex-col md:flex-row items-center gap-10">
          <div class="flex flex-col gap-6 text-left max-w-[640px]">
            <div class="inline-flex items-center gap-2 self-start rounded-full px-3 py-1 text-xs font-bold text-white backdrop-blur-md border border-white/30" style={`background-color: ${themeColor}33`}>
              <span class="material-symbols-outlined text-[16px]">bolt</span>
              24/7 Emergency Service in {city.name}
            </div>
            <h1 class="text-white text-4xl font-black leading-tight tracking-[-0.033em] md:text-5xl lg:text-6xl">
              {heroH1}
            </h1>
            <h2 class="text-gray-200 text-lg font-medium leading-relaxed max-w-[540px]">
              Disaster strikes without warning. Our expert team in {city.name} is ready to respond 24/7 to restore your property fast.
            </h2>
            <div class="flex flex-col sm:flex-row gap-4 mt-4">
              <button class="flex items-center justify-center rounded-lg h-14 px-8 text-white text-base font-bold shadow-lg hover:scale-105 transition-all" style={`background-color: ${accentColor}`}>
                <span class="material-symbols-outlined mr-2">local_shipping</span>
                {city.name} Dispatch: {city.phone}
              </button>
            </div>
          </div>
          <!-- Lead Form -->
          <div class="hidden lg:flex flex-col gap-4 bg-white dark:bg-gray-900 p-6 rounded-xl shadow-2xl max-w-sm w-full border border-gray-100 dark:border-gray-800">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">Request Immediate Callback</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">Enter your details and a technician will call you within 5 minutes.</p>
            <input class="h-12 w-full rounded-lg border border-gray-300 bg-gray-50 px-4 text-sm outline-none focus:ring-2 dark:border-gray-700 dark:bg-gray-800 dark:text-white" style={`--tw-ring-color: ${themeColor}33; border-color: transparent`} placeholder="Full Name" type="text"/>
            <input class="h-12 w-full rounded-lg border border-gray-300 bg-gray-50 px-4 text-sm outline-none focus:ring-2 dark:border-gray-700 dark:bg-gray-800 dark:text-white" style={`--tw-ring-color: ${themeColor}33; border-color: transparent`} placeholder="Phone Number" type="tel"/>
            <button class="h-12 w-full rounded-lg text-white font-bold hover:brightness-90 transition-colors" style={`background-color: ${themeColor}`}>Call Me Back</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Badges -->
    <div class="w-full bg-white dark:bg-[#101822] border-b border-gray-100 dark:border-gray-800 py-6">
      <div class="max-w-[1200px] mx-auto px-4 flex flex-wrap justify-center md:justify-between items-center gap-6 opacity-80">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-2xl" style={`color: ${themeColor}`}>verified_user</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Trusted & Insured in FL</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-2xl" style={`color: ${themeColor}`}>history</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Serving {city.county} since 2010</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-2xl" style={`color: ${themeColor}`}>school</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Industry Certified Technicians</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-2xl" style={`color: ${themeColor}`}>star</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">4.9/5 Rating on Google</span>
        </div>
      </div>
    </div>

    <!-- Local Context Section -->
    <div class="w-full max-w-[1200px] px-4 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-2 font-bold uppercase tracking-wider text-sm" style={`color: ${themeColor}`}>
            <span class="material-symbols-outlined text-lg">location_on</span>
            Local Expertise
          </div>
          <h2 class="text-3xl font-bold text-[#111418] dark:text-white leading-tight">
            Why {city.name} Homeowners Trust Paramount
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            Homes in {city.name} face unique challenges, from the humidity of the {city.county} climate to storm surges typical in Central Florida. Whether you are located near {city.neighborhoods[0]} or closer to {city.landmarks[0] || "downtown"}, our fleet is positioned to reach your doorstep quickly.
          </p>
          <div class="bg-gray-50 dark:bg-gray-800/50 p-6 rounded-xl border border-gray-200 dark:border-gray-800 mt-4">
            <h3 class="font-bold text-[#111418] dark:text-white mb-2">Local Stats for {city.name}</h3>
             <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-2">
                <li><strong>Service Area:</strong> {city.name}, {city.county}</li>
                <li><strong>Common Issues:</strong> Storm Flooding, Mold from Humidity, Pipe Bursts</li>
                <li><strong>Local Zip Codes Served:</strong> {city.zipCodes.slice(0, 5).join(", ")}...</li>
             </ul>
          </div>
        </div>
        <div class="relative w-full h-[400px] rounded-xl overflow-hidden shadow-lg border border-gray-200 dark:border-gray-800">
          <iframe
            width="100%"
            height="100%"
            style="border:0"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://maps.google.com/maps?q=${encodeURIComponent(city.name + ", FL")}&t=&z=13&ie=UTF8&iwloc=&output=embed`}>
          </iframe>
        </div>
      </div>
    </div>

    <!-- Service Breakdown -->
    <div class="w-full bg-[#f6f7f8] dark:bg-gray-900/50 py-16 lg:py-24">
      <div class="max-w-[1200px] mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-4">Our {service.name} Process for {city.name} Residents</h2>
          <p class="text-gray-600 dark:text-gray-300">We follow a strict industry-approved protocol to ensure your property is returned to pre-loss condition quickly and safely.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="bg-white dark:bg-[#101822] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${themeColor}`}></div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-full font-bold text-xl" style={`background-color: ${themeColor}1a; color: ${themeColor}`}>1</span>
              <span class="material-symbols-outlined text-gray-400 text-4xl group-hover:text-current transition-colors" style={`color: ${themeColor}`}>search</span>
            </div>
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3">Rapid Assessment</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              We arrive at your {city.name} property to assess the damage. Using thermal imaging and moisture meters, we identify hidden issues behind walls.
            </p>
          </div>
          <!-- Step 2 -->
          <div class="bg-white dark:bg-[#101822] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
             <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${themeColor}`}></div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-full font-bold text-xl" style={`background-color: ${themeColor}1a; color: ${themeColor}`}>2</span>
              <span class="material-symbols-outlined text-gray-400 text-4xl group-hover:text-current transition-colors" style={`color: ${themeColor}`}>water_drop</span>
            </div>
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3">Mitigation</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              Immediate extraction/stabilization to prevent secondary damage in the Florida heat. We remove standing water immediately.
            </p>
          </div>
          <!-- Step 3 -->
          <div class="bg-white dark:bg-[#101822] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
             <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${themeColor}`}></div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-full font-bold text-xl" style={`background-color: ${themeColor}1a; color: ${themeColor}`}>3</span>
              <span class="material-symbols-outlined text-gray-400 text-4xl group-hover:text-current transition-colors" style={`color: ${themeColor}`}>construction</span>
            </div>
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3">Restoration</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              Bringing your home back to pre-loss condition. From drywall replacement to final painting, we handle the full rebuild in {city.name}.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Section (Localized) -->
    <div class="w-full max-w-[1200px] px-4 py-16 lg:py-24">
      <div class="max-w-3xl mx-auto">
         <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-8 text-center">Frequently Asked Questions in {city.name}</h2>
         <div class="flex flex-col gap-4">
            <details class="group bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 rounded-lg open:ring-2 open:ring-current" style={`color: ${themeColor}`}>
              <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-lg text-[#111418] dark:text-white list-none">
                How quickly can you get to {city.name} for an emergency?
                <span class="material-symbols-outlined transition group-open:rotate-180">expand_more</span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed text-black">
                We have trucks stationed in {city.county} and can typically reach {city.name} addresses within 45-60 minutes.
              </div>
            </details>
             <details class="group bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 rounded-lg open:ring-2 open:ring-current" style={`color: ${themeColor}`}>
              <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-lg text-[#111418] dark:text-white list-none">
                Do you handle permitting for {city.name} reconstruction?
                <span class="material-symbols-outlined transition group-open:rotate-180">expand_more</span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed text-black">
                Yes, as property restoration experts, we handle all necessary permitting with the {city.name} building department.
              </div>
            </details>
         </div>
      </div>
    </div>
    
    <!-- Internal Linking: Horizontal (Same City, Other Services) -->
    <div class="w-full bg-white dark:bg-[#101822] border-t border-gray-100 dark:border-gray-800 py-16">
        <div class="max-w-[1200px] mx-auto px-4">
            <div class="mb-10 text-center md:text-left">
                 <div class="flex items-center gap-2 font-bold uppercase tracking-wider text-sm mb-2" style={`color: ${themeColor}`}>
                    <span class="material-symbols-outlined text-lg">category</span>
                    Comprehensive Care
                </div>
                <h2 class="text-2xl font-bold text-[#111418] dark:text-white">
                    Other Restoration Services in {city.name}
                </h2>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {services.filter(s => s.slug !== service.slug).slice(0, 8).map(s => (
                    <a 
                        href={`/service-areas/${city.region}/${city.slug}/${s.slug}/`}
                        class="flex flex-col p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors group border border-transparent hover:border-gray-200 dark:hover:border-gray-700"
                    >
                         <div class="mb-3 p-2 rounded-lg w-fit transition-colors group-hover:text-white" style={`color: ${s.theme.primary}; background-color: ${s.theme.primary}1a`}>
                             <span class="material-symbols-outlined text-2xl">{s.icon}</span>
                         </div>
                        <span class="font-bold text-gray-900 dark:text-white text-sm group-hover:text-[var(--primary)] transition-colors">
                            {s.name}
                        </span>
                         <span class="text-xs text-gray-500 mt-1">in {city.name}, FL</span>
                    </a>
                ))}
            </div>
        </div>
    </div>

    <!-- Internal Linking: Geo-Clustering (Same Service, Nearby Cities) -->
    <div class="w-full bg-[#f6f7f8] dark:bg-gray-900/50 border-t border-gray-200 dark:border-gray-800 py-16">
        <div class="max-w-[1200px] mx-auto px-4">
             <div class="mb-10 text-center md:text-left">
                 <div class="flex items-center gap-2 font-bold uppercase tracking-wider text-sm mb-2" style={`color: ${themeColor}`}>
                    <span class="material-symbols-outlined text-lg">share_location</span>
                     Service Radius
                </div>
                <h2 class="text-2xl font-bold text-[#111418] dark:text-white">
                    Also Serving Neighbors in {city.county} County
                </h2>
                <p class="text-gray-500 mt-2 text-sm">Our rapid response teams are stationed to cover {city.name} and these nearby communities.</p>
            </div>
             <div class="flex flex-wrap gap-2">
                {cities.filter(c => c.county === city.county && c.slug !== city.slug).map(c => (
                    <a 
                        href={`/service-areas/${c.region}/${c.slug}/${service.slug}/`}
                        class="px-4 py-2 rounded-full bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 text-sm font-medium text-gray-600 dark:text-gray-400 hover:border-[var(--color)] hover:text-[var(--color)] transition-all shadow-sm"
                         style={`--color: ${themeColor}`}
                    >
                        {c.name} {service.name.split(' ').pop()} <!-- Short name e.g. "Orlando Remediation" if needed, just City is cleaner + service context -->
                    </a>
                ))}
                {/* Fallback if no same-county neighbors (unlikely but safe) -> Show same region */}
                 {cities.filter(c => c.county === city.county && c.slug !== city.slug).length === 0 && cities.filter(c => c.region === city.region && c.slug !== city.slug).slice(0,10).map(c => (
                     <a 
                        href={`/service-areas/${c.region}/${c.slug}/${service.slug}/`}
                        class="px-4 py-2 rounded-full bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 text-sm font-medium text-gray-600 dark:text-gray-400 hover:border-[var(--color)] hover:text-[var(--color)] transition-all shadow-sm"
                         style={`--color: ${themeColor}`}
                    >
                        {c.name}
                    </a>
                 ))}
            </div>
        </div>
    </div>

  </main>
</ServiceAreaLayout>
