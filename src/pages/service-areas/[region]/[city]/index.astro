---
import ServiceAreaLayout from '../../../../layouts/ServiceAreaLayout.astro';
import { cities } from '../../../../data/service-areas';
import { services } from '../../../../data/services';
import type { CityData } from '../../../../data/service-areas';
import Breadcrumbs from '../../../../components/common/Breadcrumbs.astro';

export async function getStaticPaths() {
  return cities.map(city => ({
    params: { 
        region: city.region,
        city: city.slug 
    },
    props: { city },
  }));
}

interface Props {
  city: CityData;
}

const { city } = Astro.props;

const pageTitle = `Restoration Experts in ${city.name}, FL | Paramount Property Restoration`;
const metaDesc = `Property Restoration Experts serving ${city.name}, FL. Expert water, fire, and mold restoration services. 24/7 Emergency Dispatch for ${city.county} County.`;
const themeColor = "#0f172a"; // Slate 900 (Neutral/Professional)
---

<ServiceAreaLayout title={pageTitle} description={metaDesc}>
  <main class="layout-container flex flex-col items-center w-full">
    
    <!-- Breadcrumbs -->
    <div class="w-full max-w-[1200px] px-4 pt-4 pb-0">
        <Breadcrumbs 
            items={[
                { label: 'Home', href: '/' },
                { label: 'Service Areas', href: '/service-areas/' },
                { label: city.region.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '), href: `/service-areas/${city.region}/` },
                { label: city.name, href: Astro.url.pathname },
            ]}
        />
    </div>

    <!-- Hero Section -->
    <div class="w-full relative">
      <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat" style='background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.8)), url("https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&q=80");'></div>
      <div class="relative z-10 w-full flex justify-center px-4 py-20 lg:py-32">
        <div class="max-w-[1200px] w-full text-center">
            <h1 class="text-white text-4xl font-black leading-tight md:text-5xl lg:text-6xl mb-6">
              Property Restoration Experts in {city.name}, FL
            </h1>
            <p class="text-gray-200 text-lg md:text-xl max-w-2xl mx-auto mb-10">
              Paramount Property Restoration provides comprehensive disaster recovery and remodeling services for homeowners in {city.name} and throughout {city.county} County.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
               <a href={`tel:${city.phone}`} class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-4 px-8 rounded-lg shadow-lg transition-colors">
                  {city.name} Dispatch: {city.phone}
               </a>
               <a href="#services" class="bg-white/10 backdrop-blur border border-white/30 hover:bg-white/20 text-white font-bold py-4 px-8 rounded-lg transition-colors">
                  View Our Services
               </a>
            </div>
        </div>
      </div>
    </div>

    <!-- Services Grid (The "Hub" Logic) -->
    <section id="services" class="py-16 lg:py-24 bg-white dark:bg-slate-950">
        <div class="max-w-[1200px] mx-auto px-4">
            <div class="text-center mb-16">
                <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Our Expertise</span>
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mt-2">
                    Professional Services for {city.name}
                </h2>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {services.map(service => (
                    <a href={`/service-areas/${city.region}/${city.slug}/${service.slug}/`} class="group block bg-slate-50 dark:bg-slate-900 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                        <div class="p-8">
                            <div class="w-14 h-14 rounded-lg flex items-center justify-center mb-6 transition-colors group-hover:text-white" style={`background-color: ${service.theme.primary}20; color: ${service.theme.primary}`}>
                                <span class="material-symbols-outlined text-3xl group-hover:text-current">{service.icon}</span>
                            </div>
                            <!-- Icon Hover Fix: Make background solid on hover via style injection or just rely on text color -->
                            
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-blue-600 transition-colors">
                                {service.name}
                            </h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4">
                                {service.description}
                            </p>
                            <span class="inline-flex items-center text-sm font-bold text-blue-600 group-hover:underline">
                                Service in {city.name} <span class="material-symbols-outlined text-sm ml-1">arrow_forward</span>
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- Local Info / SEO Block -->
    <section class="py-16 bg-slate-100 dark:bg-slate-900/50">
        <div class="max-w-[1200px] mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
             <div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Serving {city.name} & {city.county} County</h2>
                <div class="prose dark:prose-invert text-slate-600 dark:text-slate-400">
                    <p>
                        From the neighborhoods of <strong>{city.neighborhoods[0]}</strong> to properties near <strong>{city.landmarks[0]}</strong>, Paramount Property Restoration is the trusted restoration company for {city.name}.
                    </p>
                    <p>
                        We understand the specific building codes and environmental challenges in {city.name}. Our local team is ready to deploy 24/7.
                    </p>
                </div>
                <div class="mt-8 grid grid-cols-2 gap-4">
                    <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm">
                        <span class="block text-sm text-slate-500">Service Area</span>
                        <span class="block font-bold text-slate-900 dark:text-white">{city.name}</span>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm">
                        <span class="block text-sm text-slate-500">Zip Codes</span>
                        <span class="block font-bold text-slate-900 dark:text-white">{city.zipCodes[0]}+</span>
                    </div>
                </div>
            </div>
             <div class="h-[400px] rounded-xl overflow-hidden shadow-lg">
                 <iframe
                    width="100%"
                    height="100%"
                    style="border:0"
                    loading="lazy"
                    allowfullscreen
                    src={`https://maps.google.com/maps?q=${encodeURIComponent(city.name + ", FL")}&t=&z=12&ie=UTF8&iwloc=&output=embed`}>
                </iframe>
             </div>
        </div>
    </section>

  </main>
</ServiceAreaLayout>
