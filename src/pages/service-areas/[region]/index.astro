---
import MainLayout from '../../../layouts/MainLayout.astro';
import { regions } from '../../../data/regions';
import type { RegionData } from '../../../data/regions';
import { cities } from '../../../data/service-areas';
import type { CityData } from '../../../data/service-areas';

export async function getStaticPaths() {
  return regions.map(region => ({
    params: { region: region.slug },
    props: { region },
  }));
}

interface Props {
  region: RegionData;
}

const { region } = Astro.props;

// Filter cities for this region
const regionCities = cities.filter(city => city.region === region.slug);

// Group cities by county
const citiesByCounty = regionCities.reduce((acc: Record<string, CityData[]>, city) => {
  if (!acc[city.county]) {
    acc[city.county] = [];
  }
  acc[city.county].push(city);
  return acc;
}, {} as Record<string, CityData[]>);

const counties = Object.keys(citiesByCounty).sort();
const countiesString = counties.join(", ").replace(/, ([^,]*)$/, ' & $1');

// Schema Construction
const containedCities = regionCities.map(city => ({
  "@type": "City",
  "name": city.name
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Property Restoration",
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": region.name,
    "containsPlace": containedCities
  },
  "provider": {
    "@type": "LocalBusiness",
    "name": "Paramount Property Restoration",
    "telephone": "+1-786-602-2217", 
    "image": "https://paramountrestoration.com/logo.png"
  },
  "description": region.introText
};
---

<MainLayout title={region.heroH1} description={region.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Breadcrumbs -->
  <div class="bg-surface-light dark:bg-slate-950 border-b border-slate-100 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-3">
        <div class="flex flex-wrap gap-2 items-center text-sm">
            <a href="/" class="text-slate-500 hover:text-primary transition-colors">Home</a>
            <span class="text-slate-400">/</span>
            <a href="/service-areas" class="text-slate-500 hover:text-primary transition-colors">Locations</a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-900 dark:text-white font-medium">{region.name} Hub</span>
        </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative bg-slate-900 py-16 lg:py-24 overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/80 to-transparent z-10"></div>
        <img src={region.coverImage} alt={`${region.name} skyline`} class="w-full h-full object-cover opacity-60" />
    </div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-20">
        <div class="max-w-2xl flex flex-col gap-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/50 border border-blue-500/30 text-blue-200 text-xs font-semibold w-fit backdrop-blur-md">
                <span class="material-symbols-outlined text-sm">location_on</span>
                {region.heroBadgeText}
            </div>
            <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tight">
                {region.heroH1}
            </h1>
            <p class="text-slate-300 text-lg md:text-xl font-normal leading-relaxed max-w-xl">
                {region.introText}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 mt-4">
                <a href="/contact/" class="flex items-center justify-center gap-2 bg-orange-600 hover:bg-orange-700 text-white px-8 py-4 rounded-lg font-bold text-lg shadow-lg shadow-orange-900/20 transition-all transform hover:scale-[1.02]">
                    <span>Get a Quote in {region.name}</span>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
                <a href="#coverage-map" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 text-white px-6 py-4 rounded-lg font-semibold transition-colors">
                    <span class="material-symbols-outlined">map</span>
                    <span>View Service Map</span>
                </a>
            </div>
            
            <!-- TRUST SIGNALS -->
            <div class="flex items-center gap-6 mt-8 pt-8 border-t border-white/10">
                <div class="flex -space-x-2">
                    <div class="w-10 h-10 rounded-full bg-slate-200 border-2 border-slate-900 flex items-center justify-center text-xs font-bold text-slate-900">4.9</div>
                    <div class="w-10 h-10 rounded-full bg-slate-300 border-2 border-slate-900 flex items-center justify-center text-xs font-bold text-slate-900">G</div>
                    <div class="w-10 h-10 rounded-full bg-slate-400 border-2 border-slate-900 flex items-center justify-center text-xs font-bold text-slate-900">FB</div>
                </div>
                <div class="flex flex-col">
                    <div class="flex text-yellow-400 text-sm">
                        <span class="material-symbols-outlined text-[18px] fill-current">star</span>
                        <span class="material-symbols-outlined text-[18px] fill-current">star</span>
                        <span class="material-symbols-outlined text-[18px] fill-current">star</span>
                        <span class="material-symbols-outlined text-[18px] fill-current">star</span>
                        <span class="material-symbols-outlined text-[18px] fill-current">star</span>
                    </div>
                    <span class="text-slate-400 text-sm">Trusted by 500+ {region.name} Locals</span>
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- Local Reality Section -->
  <section class="py-16 lg:py-24 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div class="flex flex-col gap-6">
                <div class="inline-block text-primary font-bold tracking-wider uppercase text-sm">The Local Reality</div>
                <h2 class="text-slate-900 dark:text-white text-3xl md:text-4xl font-bold leading-tight">
                    Why {region.name} Relies on Paramount
                </h2>
                <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed">
                    Our teams are specifically equipped to handle the unique challenges of the {region.name} environment. We understand what local homes face and adapt our protocols accordingly.
                </p>
                
                <div class="grid sm:grid-cols-2 gap-4 mt-4">
                    {region.localRealityFeatures && region.localRealityFeatures.map(feature => (
                        <div class="bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-800">
                            <div class="text-primary mb-3">
                                <span class="material-symbols-outlined text-3xl">{feature.icon}</span>
                            </div>
                            <h3 class="font-bold text-slate-900 dark:text-white mb-1">{feature.title}</h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400">{feature.description}</p>
                        </div>
                    ))}
                </div>
            </div>
            
            <div class="relative h-full min-h-[400px] rounded-2xl overflow-hidden shadow-2xl">
                <img src={region.localRealityImage} alt={`Restoration team working in ${region.name}`} class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8">
                    <div class="bg-white/95 dark:bg-slate-900/95 backdrop-blur rounded-lg p-4 w-full border-l-4 border-orange-500">
                        <div class="text-sm font-bold text-slate-900 dark:text-white mb-1">24/7 Rapid Response</div>
                        <div class="text-xs text-slate-600 dark:text-slate-400">Average arrival time in {region.name}: &lt; 45 mins</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- Services Coverage Grid -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-slate-900 dark:text-white text-3xl font-bold mb-4">Service Coverage Adapted for {region.name}</h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg">We don't just restore; we adapt. Our services are tailored to the specific building codes and environmental pressures of the {region.name} region.</p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {region.serviceFeatures && region.serviceFeatures.map(feature => (
                <div class="group bg-white dark:bg-slate-950 rounded-xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden border border-slate-100 dark:border-slate-800">
                    <div class="h-48 overflow-hidden bg-slate-200 relative">
                         <img src={feature.image} alt={feature.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <div class="p-6">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="p-2 rounded-lg bg-primary/10 text-primary">
                                <span class="material-symbols-outlined">{feature.icon}</span>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white">{feature.title}</h3>
                        </div>
                        <p class="text-slate-600 dark:text-slate-400 text-sm mb-4">{feature.description}</p>
                        <a href={feature.link} class="inline-flex items-center text-primary font-semibold text-sm hover:underline">
                            Learn more <span class="material-symbols-outlined text-sm ml-1">arrow_forward</span>
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>
  </section>

  <!-- The City Clusters (SEO Engine) -->
  <section class="py-16 lg:py-20 bg-white dark:bg-slate-950" id="coverage-map">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row gap-12">
            <div class="lg:w-1/3 flex flex-col justify-center">
                <div class="inline-block text-orange-600 font-bold tracking-wider uppercase text-sm mb-2">Service Areas</div>
                <h2 class="text-slate-900 dark:text-white text-3xl font-bold mb-6">Our {region.name} Service Network</h2>
                <p class="text-slate-600 dark:text-slate-400 mb-8">
                    We have positioned our response teams across {countiesString} to ensure we can reach any emergency within 45 minutes, traffic permitting. Select your city to see local team details.
                </p>
                <a href="#coverage-map" class="inline-flex items-center justify-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-bold hover:bg-blue-600 transition-colors w-full sm:w-auto">
                    <span class="material-symbols-outlined">map</span>
                    View Coverage Areas
                </a>
            </div>
            
            <div class="lg:w-2/3 grid sm:grid-cols-2 md:grid-cols-3 gap-8">
                {counties.length > 0 ? (
                    counties.map(county => (
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                                <span class="material-symbols-outlined text-primary">location_city</span>
                                <h3 class="font-bold text-lg text-slate-900 dark:text-white">{county}</h3>
                            </div>
                                <ul class="space-y-3">
                                {citiesByCounty[county].map((city, index) => {
                                    // SEO: Varied Anchor Text Strategy
                                    // We cycle through 4 distinct variations to avoid over-optimization
                                    const variations = [
                                        `${city.name} Water Damage`,
                                        `Restoration in ${city.name}`,
                                        `${city.name} Flood Cleanup`,
                                        `Emergency Services ${city.name}`
                                    ];
                                    const anchorText = variations[index % variations.length];

                                    return (
                                    <li>
                                        <a href={`/service-areas/${region.slug}/${city.slug}/`} class="flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-primary transition-colors text-sm">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700 flex-shrink-0"></span>
                                            {anchorText}
                                        </a>
                                    </li>
                                    );
                                })}
                            </ul>
                        </div>
                    ))
                ) : (
                    <p>No cities found for this region.</p>
                )}
            </div>
        </div>
    </div>
  </section>

  <!-- Bottom CTA Bar -->
  <section class="bg-primary py-12 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-white">
            <h2 class="text-2xl font-bold mb-2">Need Restoration Services in {region.name}?</h2>
            <p class="text-blue-100 max-w-xl">Whether it's emergency restoration or a planned remodel, our local team is ready to help you navigate the process.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
            <a href="/contact/" class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg transition-colors whitespace-nowrap text-center">
                Get Your Free Quote
            </a>
            <a href="tel:1-786-602-2217" class="bg-white text-primary hover:bg-slate-100 font-bold py-3 px-8 rounded-lg shadow-lg transition-colors whitespace-nowrap text-center">
                Call (786) 602-2217
            </a>
        </div>
    </div>
  </section>

</MainLayout>
