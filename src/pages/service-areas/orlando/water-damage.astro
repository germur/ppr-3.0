---
import MainLayout from '../../../layouts/MainLayout.astro';
import ServiceHero from '../../../components/service/ServiceHero';
import { MapPin, Clock, ShieldCheck } from 'lucide-react';

export async function getStaticPaths() {
  return [
    { params: { city: 'orlando', service: 'water-damage' } },
  ];
}

const { city, service } = Astro.params;
---

<MainLayout>
    <ServiceHero 
        client:load
        title="Expert Water Damage Restoration in Orlando, FL"
        subtitle="Fast response to flood and leak emergencies across Orange County. On-site in 60 minutes or less."
        image="https://images.unsplash.com/photo-1621905252507-b35492ccba0b?q=80&w=2669&auto=format&fit=crop"
        serviceType="restoration"
    >
        <div slot="extra-content" class="mt-8">
            <a href="tel:7866022217" class="inline-block bg-orange-600 hover:bg-orange-700 text-white px-8 py-3 rounded-lg font-bold w-full md:w-auto text-center">
                Orlando Dispatch: (786) 602-2217
            </a>
        </div>
    </ServiceHero>

    <section class="py-24 bg-slate-50">
        <div class="container mx-auto px-4 max-w-7xl">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                     <span class="text-blue-600 font-bold uppercase tracking-wider text-sm flex items-center gap-2 mb-4">
                        <MapPin size={16} /> Local Expertise
                     </span>
                     <h2 class="text-3xl font-bold mb-6">Why Orlando Homeowners Trust Paramount</h2>
                     <p class="text-slate-600 mb-6">We understand the unique challenges of Orange County's climate. From the humid summers that accelerate mold growth to the sudden tropical storms affecting roofs in Winter Park and Downtown.</p>
                     
                     <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                        <h4 class="font-bold mb-4">Live Dispatch Status</h4>
                        <div class="flex items-center gap-2 text-green-600 text-sm font-semibold">
                            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                            Crews available in Downtown Orlando
                        </div>
                     </div>

                     <ul class="mt-8 space-y-3">
                        <li class="flex items-center gap-3 text-slate-700">
                             <ShieldCheck className="text-green-500" size={20} /> Familiar with Orlando Building Codes
                        </li>
                        <li class="flex items-center gap-3 text-slate-700">
                             <Clock className="text-green-500" size={20} /> Serving Orange County since 2010
                        </li>
                     </ul>
                </div>

                {/* Map Placeholder */}
                <div class="bg-slate-200 rounded-2xl h-[400px] w-full relative overflow-hidden shadow-inner">
                    <img src="https://images.unsplash.com/photo-1569336415962-a4bd9f69cd83?q=80&w=2669&auto=format&fit=crop" class="w-full h-full object-cover opacity-50 grayscale" alt="Orlando Map" />
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span class="bg-white/80 backdrop-blur px-4 py-2 rounded-lg text-sm font-bold shadow-sm">Interactive Map Loading...</span>
                    </div>
                    {/* Pin */}
                    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 -mt-12">
                        <MapPin size={48} className="text-orange-600 drop-shadow-xl" fill="currentColor" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-12 bg-white">
        <div class="container mx-auto px-4">
             <h3 class="font-bold text-lg mb-6 text-slate-400 uppercase tracking-widest text-center">Nearby Service Areas</h3>
             <div class="flex flex-wrap justify-center gap-4">
                 <a href="/service-areas/central-florida/winter-garden/" class="px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 transition-colors text-sm font-medium">Winter Garden</a>
                 <a href="/service-areas/central-florida/sanford/" class="px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 transition-colors text-sm font-medium">Sanford</a>
                 <a href="/service-areas/central-florida/altamonte-springs/" class="px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 transition-colors text-sm font-medium">Altamonte Springs</a>
                 <a href="/service-areas/central-florida/winter-park/" class="px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 transition-colors text-sm font-medium">Winter Park</a>
                 <a href="/service-areas/central-florida/apopka/" class="px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 transition-colors text-sm font-medium">Apopka</a>
                 <a href="/service-areas/central-florida/ocoee/" class="px-4 py-2 rounded-full border border-slate-200 text-slate-600 hover:border-blue-500 hover:text-blue-600 transition-colors text-sm font-medium">Ocoee</a>
             </div>
        </div>
    </section>

</MainLayout>
