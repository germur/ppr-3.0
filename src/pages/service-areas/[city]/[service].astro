---
import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import RemodelingPage from "../../../components/pages/RemodelingPage.astro";

import WaterTemplate from "../../../components/templates/WaterTemplate.astro";
import FireTemplate from "../../../components/templates/FireTemplate.astro";
import MoldTemplate from "../../../components/templates/MoldTemplate.astro";
import StormTemplate from "../../../components/templates/StormTemplate.astro";
import "../../../styles/global.css";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  const services = [
    {
      slug: "water-damage-restoration",
      type: "restoration",
      name: "Water Damage Restoration",
    },
    {
      slug: "fire-damage-restoration",
      type: "restoration",
      name: "Fire Damage Restoration",
    },
    { slug: "mold-remediation", type: "restoration", name: "Mold Remediation" },
    {
      slug: "storm-damage-repair",
      type: "restoration",
      name: "Storm Damage Repair",
    },
    {
      slug: "kitchen-remodeling",
      type: "remodeling",
      name: "Kitchen Remodeling",
    },
    {
      slug: "bathroom-remodeling",
      type: "remodeling",
      name: "Bathroom Remodeling",
    },
    {
      slug: "commercial-renovation",
      type: "commercial",
      name: "Commercial Renovation",
    },
  ] as const;

  return cities.flatMap((city) => {
    return services.map((service) => ({
      params: {
        city: city.slug,
        service: service.slug,
      },
      props: { city, service },
    }));
  });
}

import { cities as cityDataList } from "../../../data/service-areas";
const { city, service } = Astro.props;
const { name: cityName, restoration_pain } = city.data;

// Fallback to data file for neighborhoods since Content Collection schema lacks it
const extendedCity = cityDataList.find((c) => c.slug === city.slug);
const neighborhoods = extendedCity?.neighborhoods || [];

const isRemodeling = service.type === "remodeling";

// ── Thin-content detection: noindex cities with generic placeholder copy ─────
const isThinCity = restoration_pain.length < 200;

// ── SEO title & description per service type ──────────────────────────────────
const SEO_META: Record<string, { title: string; description: string }> = {
  "water-damage-restoration": {
    title: `Water Damage Restoration in ${cityName}, FL | 60-Min Response | Paramount`,
    description: `Emergency water damage restoration in ${cityName}, FL. IICRC-certified, 60-min dispatch, direct insurance billing. Stop mold before it starts — call 24/7.`,
  },
  "fire-damage-restoration": {
    title: `Fire & Smoke Damage Restoration in ${cityName}, FL | Licensed GC | Paramount`,
    description: `Fire damage repair & smoke cleanup in ${cityName}, FL. Board-up, soot removal, full rebuild. Xactimate billing, 60-min response. Licensed contractor CGC #1529606.`,
  },
  "mold-remediation": {
    title: `Mold Remediation in ${cityName}, FL | IICRC Certified | Paramount`,
    description: `Licensed mold remediation in ${cityName}, FL. Florida two-party protocol, IICRC certified, direct insurance billing. Free assessment — 60-min response.`,
  },
  "storm-damage-repair": {
    title: `Storm & Hurricane Damage Repair in ${cityName}, FL | 60-Min Response | Paramount`,
    description: `Storm damage restoration in ${cityName}, FL. Emergency tarping, debris removal & full rebuild. Licensed GC — Xactimate billing, 60-min emergency dispatch.`,
  },
};

const pageMeta = SEO_META[service.slug] ?? {
  title: `${service.name} in ${cityName}, FL | Paramount`,
  description: `Professional ${service.name} in ${cityName}, FL. 24/7 emergency response, licensed & insured. ${restoration_pain.substring(0, 100)}...`,
};
---

{
  isRemodeling ? (
    <RemodelingPage city={city} service={service} noindex={isThinCity} />
  ) : (
    <MainLayout
      title={pageMeta.title}
      description={pageMeta.description}
      city={cityName}
      serviceName={service.name}
      schemaType="Service"
      noindex={isThinCity}
    >
      {service.slug === "water-damage-restoration" && (
        <WaterTemplate city={city} />
      )}
      {service.slug === "fire-damage-restoration" && (
        <FireTemplate city={city} />
      )}
      {service.slug === "mold-remediation" && <MoldTemplate city={city} />}
      {service.slug === "storm-damage-repair" && <StormTemplate city={city} />}

      {/* Neighborhoods SEO Section - Implemented for Longtail "Brickell" Strategy */}
      {neighborhoods.length > 0 && (
        <section class="py-12 bg-gray-50 border-t border-gray-200">
          <div class="container mx-auto px-4 text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">
              Serving All {cityName} Neighborhoods
            </h3>
            <p class="text-gray-700 max-w-3xl mx-auto">
              We are proud to stand as {cityName}'s leading restoration experts,
              serving all local communities including{" "}
              <span class="font-semibold">{neighborhoods.join(", ")}</span> and
              surrounding areas. Whether you are in {neighborhoods[0]} or near{" "}
              {extendedCity?.landmarks?.[0] || "downtown"}, our rapid response
              capability ensures we reach you fast.
            </p>
          </div>
        </section>
      )}
    </MainLayout>
  )
}
