---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const cities = await getCollection('cities');
const validCities = cities.map(c => c.slug);
---

<MainLayout title="Service Areas Hub - Florida | Paramount Property Restoration" description="Serving All of Central & South Florida. 24/7 Emergency Restoration & Luxury Remodeling Experts.">
  
    <!-- Inject specific fonts for this design -->
    <fragment slot="head">
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet"/>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
        <style>
            /* Custom map pin animation */
            @keyframes bounce-sm {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-5px); }
            }
            .animate-bounce-sm {
                animation: bounce-sm 2s infinite;
            }
            /* Font overrides */
            .font-display { font-family: 'Manrope', sans-serif !important; }
            h1, h2, h3, h4, button, input { font-family: 'Manrope', sans-serif; }
        </style>
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "GeneralContractor",
            "name": "Paramount Property Restoration",
            "url": "https://paramountpropertyrestoration.com/service-areas/",
            "areaServed": cities.map(city => ({
                "@type": "City",
                "name": city.data.name,
                "sameAs": `https://en.wikipedia.org/wiki/${city.data.name.replace(' ', '_')}`
            }))
        })} />
    </fragment>

    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden bg-[#f6f7f8] dark:bg-[#101822] text-[#111418] dark:text-white font-display">

        <!-- Hero Section -->
        <section class="relative bg-white dark:bg-[#101822] py-12 lg:py-20 px-4 sm:px-10">
            <div class="mx-auto max-w-[1200px]">
                <div class="flex flex-col gap-10 lg:flex-row lg:items-center">
                    <!-- Hero Content -->
                    <div class="flex flex-col gap-6 lg:w-1/2">
                        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary w-fit">
                            <span class="material-symbols-outlined text-sm">public</span> Service Areas Hub
                        </div>
                        <h1 class="text-[#111418] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em] lg:text-5xl xl:text-6xl">
                            Serving All of Central & South Florida: Restoration & Remodeling Experts
                        </h1>
                        <h2 class="text-gray-600 dark:text-gray-300 text-lg font-normal leading-relaxed max-w-[600px]">
                            Your local partner for rapid disaster recovery and home renovation. We know Florida codes, climate, and communities. From Orlando to Miami, we're ready 24/7.
                        </h2>
                        
                        <!-- Search Bar Logic -->
                        <form id="city-search-form" class="mt-4 flex w-full max-w-[540px] flex-col gap-2 sm:flex-row sm:items-stretch h-auto sm:h-14">
                            <div class="relative flex-1">
                                <div class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-500">
                                    <span class="material-symbols-outlined">search</span>
                                </div>
                                <input id="city-input" list="cities-list" class="h-12 sm:h-full w-full rounded-xl border-none bg-[#f0f2f4] dark:bg-gray-800 dark:text-white pl-11 pr-4 text-sm font-medium focus:ring-2 focus:ring-primary placeholder:text-gray-500" placeholder="Enter your city or zip code..." type="text" />
                                <datalist id="cities-list">
                                    {cities.map(c => <option value={c.data.name} />)}
                                </datalist>
                            </div>
                            <button type="submit" class="h-12 sm:h-full min-w-[140px] rounded-xl bg-primary px-6 text-sm font-bold text-white shadow-lg transition-transform hover:scale-[1.02] hover:bg-blue-700">
                                Find Coverage
                            </button>
                        </form>
                        <div id="search-error" class="text-red-500 text-sm hidden mt-2">City not found. Try 'Naples' or 'Miami'.</div>

                        <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">* Average response time: under 60 minutes for emergency calls.</p>
                    </div>
                    
                    <!-- Map Visual -->
                    <div class="relative min-h-[400px] w-full lg:w-1/2 lg:pl-10">
                        <div class="relative h-full w-full overflow-hidden rounded-2xl bg-slate-100 dark:bg-gray-800 shadow-xl border border-gray-100 dark:border-gray-700 aspect-square lg:aspect-[4/3]">
                            <!-- Abstract Map Background -->
                            <img alt="Map of Florida emphasizing coastal regions" class="absolute inset-0 h-full w-full object-cover opacity-30 dark:opacity-20 mix-blend-overlay" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC5XDWOqguud53-AF4JoXfEwclQJImSitTM8_iGB-Zmp_tGRu2qWBuVUkAJheMGb-r1R8xOoe8mM-DkWrsgQGFGS45v7EhQkIXvW1XXSJBSpGMkUtHnH3I3yteYSkW0XEJ8InDgwBCxz-n-sjsz_uNYLY0ROA3sPx4YcobrTAZrAWoWDs_kFkb-a6ydf3dhy-1AcApLOAHG42v4qZRNnZpsOXSI_7kIXbDaQXt1Dgidg3NaedaOuB3Szv2mXm_4km0eyxniqlccEA0l"/>
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent"></div>
                            
                            <!-- Interactive-looking Map Elements -->
                            <div class="relative h-full w-full p-8">
                                <!-- Orlando Pin -->
                                <a href="/service-areas/orlando/" class="absolute top-[30%] left-[55%] flex flex-col items-center gap-1 group cursor-pointer animate-bounce-sm" style="animation-delay: 0s;">
                                    <div class="flex size-10 items-center justify-center rounded-full bg-white shadow-lg border-2 border-primary text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                                    </div>
                                    <span class="rounded-md bg-white/90 px-2 py-1 text-xs font-bold text-gray-800 shadow-sm backdrop-blur-sm">Orlando</span>
                                </a>
                                <!-- Tampa Pin (Note: User HTML had Tampa, keeping it as placeholder or logic) -->
                                <div class="absolute top-[45%] left-[40%] flex flex-col items-center gap-1 group cursor-pointer animate-bounce-sm" style="animation-delay: 0.5s;">
                                    <div class="flex size-10 items-center justify-center rounded-full bg-white shadow-lg border-2 border-primary text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                                    </div>
                                    <span class="rounded-md bg-white/90 px-2 py-1 text-xs font-bold text-gray-800 shadow-sm backdrop-blur-sm">Tampa</span>
                                </div>
                                <!-- Miami Pin -->
                                <a href="/service-areas/miami/" class="absolute bottom-[15%] right-[25%] flex flex-col items-center gap-1 group cursor-pointer animate-bounce-sm" style="animation-delay: 1s;">
                                    <div class="flex size-10 items-center justify-center rounded-full bg-white shadow-lg border-2 border-primary text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">location_on</span>
                                    </div>
                                    <span class="rounded-md bg-white/90 px-2 py-1 text-xs font-bold text-gray-800 shadow-sm backdrop-blur-sm">Miami</span>
                                </a>
                                <!-- Connecting Lines (SVG) -->
                                <svg class="absolute inset-0 h-full w-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="text-primary/30" d="M 55% 30% Q 45% 40% 40% 45%" fill="none" stroke="currentColor" stroke-dasharray="4 4" stroke-width="2"></path>
                                    <path class="text-primary/30" d="M 40% 45% Q 60% 60% 75% 85%" fill="none" stroke="currentColor" stroke-dasharray="4 4" stroke-width="2"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

<!-- City Directory by Region -->
        <section class="bg-[#f6f7f8] dark:bg-[#0b1118] py-16 px-4 sm:px-10">
            <div class="mx-auto max-w-[1200px]">
                <div class="mb-10 text-center">
                    <h2 class="text-[#111418] dark:text-white text-3xl font-bold leading-tight mb-4">City Directory by Region</h2>
                    <p class="text-gray-500 dark:text-gray-400 text-base max-w-2xl mx-auto">Browse our service locations organized by major Florida regions. New locations are added regularly.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
                    {/* Region: Central Florida */}
                    <div class="group flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
                        <a href="/service-areas/central-florida/" class="mb-4 flex items-center gap-3 hover:opacity-80 transition-opacity">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-primary dark:bg-blue-900/30">
                                <span class="material-symbols-outlined">map</span>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                Central Florida 
                                <span class="material-symbols-outlined text-sm text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all">arrow_forward</span>
                            </h3>
                        </a>
                        <ul class="flex flex-col gap-2">
                            {cities.filter(c => c.data.region === 'Central Florida').length > 0 ? (
                                cities.filter(c => c.data.region === 'Central Florida').map(city => (
                                    <li><a class="flex items-center gap-2 text-sm font-bold text-primary hover:text-blue-700" href={`/service-areas/${city.slug}/`}><span class="material-symbols-outlined text-sm text-secondary">check_circle</span> {city.data.name}</a></li>
                                ))
                            ) : (
                                <li class="text-sm text-gray-400 italic">Coming Soon via pSEO...</li>
                            )}
                        </ul>
                    </div>

                    {/* Region: Tampa Bay & Coast */}
                    <div class="group flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
                        <a href="/service-areas/tampa-bay/" class="mb-4 flex items-center gap-3 hover:opacity-80 transition-opacity">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-primary dark:bg-blue-900/30">
                                <span class="material-symbols-outlined">water_lux</span>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                Tampa Bay & Coast
                                <span class="material-symbols-outlined text-sm text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all">arrow_forward</span>
                            </h3>
                        </a>
                        <ul class="flex flex-col gap-2">
                             {cities.filter(c => c.data.region === 'Tampa Bay & Coast').length > 0 ? (
                                cities.filter(c => c.data.region === 'Tampa Bay & Coast').map(city => (
                                    <li><a class="flex items-center gap-2 text-sm font-bold text-primary hover:text-blue-700" href={`/service-areas/${city.slug}/`}><span class="material-symbols-outlined text-sm text-secondary">check_circle</span> {city.data.name}</a></li>
                                ))
                            ) : (
                                <li class="text-sm text-gray-400 italic">Coming Soon via pSEO...</li>
                            )}
                        </ul>
                    </div>

                    {/* Region: Southwest Florida */}
                    <div class="group flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
                        <a href="/service-areas/southwest-florida/" class="mb-4 flex items-center gap-3 hover:opacity-80 transition-opacity">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-primary dark:bg-blue-900/30">
                                <span class="material-symbols-outlined">wb_sunny</span>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                Southwest Florida
                                <span class="material-symbols-outlined text-sm text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all">arrow_forward</span>
                            </h3>
                        </a>
                        <ul class="flex flex-col gap-2">
                            {cities.filter(c => c.data.region === 'Southwest Florida').length > 0 ? (
                                cities.filter(c => c.data.region === 'Southwest Florida').map(city => (
                                    <li><a class="flex items-center gap-2 text-sm font-bold text-primary hover:text-blue-700" href={`/service-areas/${city.slug}/`}><span class="material-symbols-outlined text-sm text-secondary">check_circle</span> {city.data.name}</a></li>
                                ))
                            ) : (
                                <li class="text-sm text-gray-400 italic">Coming Soon via pSEO...</li>
                            )}
                        </ul>
                    </div>

                    {/* Region: South Florida */}
                    <div class="group flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
                        <a href="/service-areas/south-florida/" class="mb-4 flex items-center gap-3 hover:opacity-80 transition-opacity">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-primary dark:bg-blue-900/30">
                                <span class="material-symbols-outlined">park</span>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                South Florida
                                <span class="material-symbols-outlined text-sm text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all">arrow_forward</span>
                            </h3>
                        </a>
                        <ul class="flex flex-col gap-2">
                            {cities.filter(c => c.data.region === 'South Florida').length > 0 ? (
                                cities.filter(c => c.data.region === 'South Florida').map(city => (
                                    <li><a class="flex items-center gap-2 text-sm font-bold text-primary hover:text-blue-700" href={`/service-areas/${city.slug}/`}><span class="material-symbols-outlined text-sm text-secondary">check_circle</span> {city.data.name}</a></li>
                                ))
                            ) : (
                                <li class="text-sm text-gray-400 italic">Coming Soon via pSEO...</li>
                            )}
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Florida-Specific Construction Expertise -->
        <section class="bg-white dark:bg-background-dark py-16 px-4 sm:px-10">
            <div class="mx-auto max-w-[1200px]">
                <div class="flex flex-col lg:flex-row gap-12 items-center">
                    <div class="lg:w-1/2">
                        <div class="relative h-full w-full rounded-2xl overflow-hidden shadow-xl aspect-video">
                            <img alt="Construction team working on a Florida home exterior" class="object-cover h-full w-full" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD5IElSlDjVLBE7fZclhWir8YAOnMCir_GQcNNjJVj0a8QBNJjuJxnOFTlrYw-1c3rHCTbJSLN3wAtVS-1vRVkRBqdN640l_GFgPPyZWGZyO_weVs_z4C5znOTRUUfQydXscCknu4b9APYm95Pjahs92soikVTXKQp16tNa9UqWV6sAHWY2nCEuFTAGlfOEhIhzAZPUi9hRE2jJXNyd9X89nfMyBTx8G1AEdU_BiikwTRzarQTQBYG6CyZvWcfQCj4GeqFGUXji9ln5"/>
                            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
                                <p class="text-white font-bold text-lg">Trusted by Florida Homeowners since 2005</p>
                            </div>
                        </div>
                    </div>
                    <div class="lg:w-1/2 flex flex-col gap-6">
                        <h2 class="text-[#111418] dark:text-white text-3xl font-bold leading-tight">Why Choose Us in Florida?</h2>
                        <p class="text-gray-600 dark:text-gray-300 text-lg">
                            Florida's climate is unique, and so are its challenges. We don't just fix homes; we fortify them against future threats. Our deep understanding of local building codes ensures your property is restored better than before.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                            <!-- Feature 1 -->
                            <div class="flex items-start gap-3 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
                                <div class="text-primary bg-white dark:bg-gray-700 p-2 rounded-full shadow-sm">
                                    <span class="material-symbols-outlined">cyclone</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-[#111418] dark:text-white">Hurricane Preparedness</h4>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Impact-resistant materials and storm-proof techniques.</p>
                                </div>
                            </div>
                            <!-- Feature 2 -->
                            <div class="flex items-start gap-3 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
                                <div class="text-primary bg-white dark:bg-gray-700 p-2 rounded-full shadow-sm">
                                    <span class="material-symbols-outlined">gavel</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-[#111418] dark:text-white">Local Code Compliance</h4>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Experts in strict Florida building regulations and permitting.</p>
                                </div>
                            </div>
                            <!-- Feature 3 -->
                            <div class="flex items-start gap-3 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
                                <div class="text-primary bg-white dark:bg-gray-700 p-2 rounded-full shadow-sm">
                                    <span class="material-symbols-outlined">humidity_percentage</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-[#111418] dark:text-white">Mold & Humidity Control</h4>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Specialized drying for high-humidity environments.</p>
                                </div>
                            </div>
                            <!-- Feature 4 -->
                            <div class="flex items-start gap-3 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
                                <div class="text-primary bg-white dark:bg-gray-700 p-2 rounded-full shadow-sm">
                                    <span class="material-symbols-outlined">timer</span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-[#111418] dark:text-white">60-Min Rapid Response</h4>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Fastest deployment teams in Central & South Florida.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Summary Grid -->
        <section class="bg-[#101822] text-white py-16 px-4 sm:px-10">
            <div class="mx-auto max-w-[1200px]">
                <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
                    <div>
                        <h2 class="text-3xl font-bold leading-tight mb-2">Our Core Services</h2>
                        <p class="text-gray-400">Comprehensive restoration solutions across the state.</p>
                    </div>
                    <a class="text-white flex items-center gap-2 hover:text-secondary transition-colors font-medium" href="#">
                        View All Services <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <!-- Service 1 -->
                    <a class="group relative flex flex-col items-center justify-center gap-4 rounded-xl bg-gray-800/50 p-8 border border-gray-700 hover:bg-primary hover:border-primary transition-all duration-300" href="/restoration/water-damage/">
                        <span class="material-symbols-outlined text-5xl text-blue-400 group-hover:text-white">water_drop</span>
                        <h3 class="font-bold text-center text-lg">Water Damage</h3>
                    </a>
                    <!-- Service 2 -->
                    <a class="group relative flex flex-col items-center justify-center gap-4 rounded-xl bg-gray-800/50 p-8 border border-gray-700 hover:bg-orange-600 hover:border-orange-600 transition-all duration-300" href="/restoration/fire-damage/">
                        <span class="material-symbols-outlined text-5xl text-orange-400 group-hover:text-white">local_fire_department</span>
                        <h3 class="font-bold text-center text-lg">Fire Restoration</h3>
                    </a>
                    <!-- Service 3 -->
                    <a class="group relative flex flex-col items-center justify-center gap-4 rounded-xl bg-gray-800/50 p-8 border border-gray-700 hover:bg-green-600 hover:border-green-600 transition-all duration-300" href="/restoration/mold-remediation/">
                        <span class="material-symbols-outlined text-5xl text-green-400 group-hover:text-white">coronavirus</span>
                        <h3 class="font-bold text-center text-lg">Mold Remediation</h3>
                    </a>
                    <!-- Service 4 -->
                    <a class="group relative flex flex-col items-center justify-center gap-4 rounded-xl bg-gray-800/50 p-8 border border-gray-700 hover:bg-primary hover:border-primary transition-all duration-300" href="/remodeling/">
                        <span class="material-symbols-outlined text-5xl text-gray-300 group-hover:text-white">construction</span>
                        <h3 class="font-bold text-center text-lg">Remodeling</h3>
                    </a>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="bg-white dark:bg-background-dark py-20 px-4 sm:px-10">
            <div class="mx-auto max-w-[960px] rounded-2xl bg-gradient-to-r from-primary to-blue-600 p-8 md:p-12 text-center text-white shadow-2xl relative overflow-hidden">
                <!-- Background Pattern -->
                <div class="absolute inset-0 opacity-10">
                    <div class="absolute -right-10 -top-10 h-64 w-64 rounded-full bg-white blur-3xl"></div>
                    <div class="absolute -left-10 -bottom-10 h-64 w-64 rounded-full bg-orange-500 blur-3xl"></div>
                </div>
                <div class="relative z-10 flex flex-col items-center gap-6">
                    <h2 class="text-3xl font-black md:text-4xl">Not sure if we cover your area?</h2>
                    <p class="max-w-xl text-lg text-blue-100 font-medium">We travel for large loss projects and serve extended areas upon request. Don't hesitate to reach out.</p>
                    <div class="flex flex-col sm:flex-row gap-4 mt-2">
                        <button class="flex min-w-[200px] cursor-pointer items-center justify-center rounded-xl h-14 px-8 bg-secondary hover:bg-orange-600 text-white text-base font-bold shadow-lg transition-transform hover:scale-105">
                            Free Assessment
                        </button>
                        <button class="flex min-w-[200px] cursor-pointer items-center justify-center rounded-xl h-14 px-8 bg-white/10 hover:bg-white/20 border border-white/30 text-white text-base font-bold backdrop-blur-sm transition-colors">
                            Call (800) 555-0199
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Script for Search Functionality -->
    <script define:vars={{ validCities }}>
        const form = document.getElementById('city-search-form');
        const input = document.getElementById('city-input');
        const errorMsg = document.getElementById('search-error');

        if(form && input && errorMsg) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const city = input.value.trim();
                // Simple slugify that matches standard Astro slug behavior
                const slug = city.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                
                if (validCities.includes(slug)) {
                    window.location.href = `/service-areas/${slug}/`;
                } else {
                    errorMsg.classList.remove('hidden');
                }
            });

            input.addEventListener('input', () => {
                errorMsg.classList.add('hidden');
            });
        }
    </script>
</MainLayout>
