---
import CommercialLayout from '../layouts/CommercialLayout.astro';
---

<CommercialLayout>
    <!-- Hero Section -->
    <section class="relative bg-slate-900">
        <div class="absolute inset-0 z-0">
            <div class="w-full h-full bg-cover bg-center bg-no-repeat" data-alt="large scale commercial construction site with cranes" style="background-image: linear-gradient(rgba(16, 25, 34, 0.7), rgba(16, 25, 34, 0.85)), url('https://lh3.googleusercontent.com/aida-public/AB6AXuDcwXKXNkKR_q88GZd9B5-1Nt7GLApQv_mR5nN6AcL6Nfhps1eic0PuKFFnCLjoY7HY38BoS5fX0DErw0swmMLBqZgXuJGS7G9MbzYD1AP49W-GEgAXUjyI-hWubzznPwfPMqQ6ztkkuTuH0scFOMUuFbyEwTIrWHYnTrg0LJ9wl-QOgBqOpnnASWIKf4lQGdrBq3TqO4BTFVve4i32uXXDjcXAASPLNRCfH8Yp0I_rpcfNfbZdFGkBcR1RjRzA7bQ6ckBCmDhhkK-c');">
            </div>
        </div>
        <div class="relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-8 py-20 md:py-32 flex flex-col justify-center min-h-[600px]">
            <div class="max-w-3xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-wider mb-6 backdrop-blur-sm">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    Available 24/7 Statewide
                </div>
                <h1 class="text-white text-4xl md:text-6xl font-black leading-[1.1] tracking-tight mb-6">
                    Commercial Restoration & Construction Leaders in Florida
                </h1>
                <p class="text-slate-300 text-lg md:text-xl font-normal leading-relaxed mb-10 max-w-2xl">
                    Minimizing business interruption with rapid mobilization, large-loss capacity, and turnkey reconstruction services.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <button class="flex items-center justify-center rounded-lg h-12 px-8 bg-primary hover:bg-blue-600 text-white text-base font-bold transition-colors">
                        Request a Commercial Proposal
                    </button>
                    <button class="flex items-center justify-center rounded-lg h-12 px-8 bg-white/10 hover:bg-white/20 border border-white/20 text-white text-base font-bold backdrop-blur-sm transition-colors">
                        Join Priority Response Program
                    </button>
                </div>
            </div>
        </div>
    </section>
    <!-- Trust & Capacity Signals -->
    <section class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-12">
            <div class="flex flex-col md:flex-row gap-8 items-start md:items-center justify-between mb-10">
                <div class="max-w-xl">
                    <h2 class="text-slate-900 dark:text-white text-2xl md:text-3xl font-bold mb-2">Trust & Capacity Signals</h2>
                    <p class="text-slate-600 dark:text-slate-400">Validating expertise with industry-leading certifications and large-scale fleet capacity.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Signal 1 -->
                <div class="flex flex-col p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 hover:shadow-lg transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-3xl">verified_user</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Trusted & Insured</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Full liability coverage for major commercial projects and high-risk environments.</p>
                </div>
                <!-- Signal 2 -->
                <div class="flex flex-col p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 hover:shadow-lg transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-3xl">workspace_premium</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Industry Certified</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Technicians trained to the highest industry standards for water, fire, and mold.</p>
                </div>
                <!-- Signal 3 -->
                <div class="flex flex-col p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 hover:shadow-lg transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-3xl">health_and_safety</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">OSHA Compliant</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Strict adherence to safety protocols for every job site to protect all stakeholders.</p>
                </div>
                <!-- Signal 4 -->
                <div class="flex flex-col p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 hover:shadow-lg transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-3xl">local_shipping</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Large Fleet Capacity</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Ready to mobilize instantly for large loss events with industrial-grade equipment.</p>
                </div>
            </div>
        </div>
    </section>
    <!-- Commercial Service Clusters -->
    <section class="py-16 md:py-24 bg-white dark:bg-slate-900">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8">
            <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
                <div class="max-w-2xl">
                    <span class="text-primary font-bold tracking-wider uppercase text-sm mb-2 block">Our Expertise</span>
                    <h2 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white leading-tight">Commercial Service Clusters</h2>
                    <p class="mt-4 text-slate-600 dark:text-slate-400 text-lg">Comprehensive solutions for building resilience, maintenance, and recovery.</p>
                </div>
                <a class="text-primary font-bold hover:text-blue-700 flex items-center gap-1 group" href="/commercial/">
                    View All Services
                    <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform text-lg">arrow_forward</span>
                </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Cluster 1 -->
                <article class="flex flex-col h-full bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700 group hover:shadow-md transition-all">
                    <div class="h-60 overflow-hidden relative">
                        <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition-colors z-10"></div>
                        <img alt="industrial hallway flooded with water and drying equipment" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAeWqQQLh5pg1OrWPi4e7sDB77ERl9v8-RjMff1ghmIyMdlxFsSsyPVNRojH-X0GjktZBW1hDCNctfrqCTf_BgncemiYbHK-CkhjWPuPh2rvpfs7CdBGRgUFnqXLBhLCSKkoDUr_wJFl7s4b_r9AJ-jwnaR4fM51khgjhBUJfAQT4L_3yNhnQH4loxiT75hjORgTUXd-xdnuNQV5ZBX88guhtrxMerSqNMkP69a5BsTM8mpLUQoAcEEb0PFvDpBfkmOq-uRSBCE5Tn2" />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Disaster Recovery & Large Loss</h3>
                        <p class="text-slate-600 dark:text-slate-400 mb-6 flex-1">Rapid response for fire, water, and storm damage. We deploy massive resources to mitigate loss and restore operations.</p>
                        <ul class="space-y-2 mb-6">
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Water Mitigation
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Fire & Smoke Restoration
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Storm Damage Cleanup
                            </li>
                        </ul>
                        <button class="w-full py-3 rounded-lg border-2 border-primary text-primary font-bold hover:bg-primary hover:text-white transition-colors">Learn More</button>
                    </div>
                </article>
                <!-- Cluster 2 -->
                <article class="flex flex-col h-full bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700 group hover:shadow-md transition-all">
                    <div class="h-60 overflow-hidden relative">
                        <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition-colors z-10"></div>
                        <img alt="professional commercial cleaning crew in office building" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDkEY2OnGPeJUBLMs45BikDMNohtDA1EcjbpxQ5cDeNgVsqFbC5I_IpOYJkRN0XiOZYvlXG--0KPKRyX3MWw1n1gTkfY_eoKg6C2cIUb27bS-aMvMbZ20DPv2_MyH5zjQsa4rJpWML5nnKRtczwevFcQYSW7RzBM14O9m_NR4o4YdkgxL1pMUEAN1pObF6NXZnZF3_OsAqqXxInQ_4LSJRHNBePkgm3cbNvDADocFBqkNuK5wejJpw11IxXvBANy94T7wMfwfvjHGYc" />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Commercial Cleaning & Janitorial</h3>
                        <p class="text-slate-600 dark:text-slate-400 mb-6 flex-1">Specialized sanitation and maintenance. From post-construction cleanup to scheduled janitorial services.</p>
                        <ul class="space-y-2 mb-6">
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Post-Construction Clean
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Electrostatic Disinfection
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Floor Care & Maintenance
                            </li>
                        </ul>
                        <button class="w-full py-3 rounded-lg border-2 border-primary text-primary font-bold hover:bg-primary hover:text-white transition-colors">Learn More</button>
                    </div>
                </article>
                <!-- Cluster 3 -->
                <article class="flex flex-col h-full bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700 group hover:shadow-md transition-all">
                    <div class="h-60 overflow-hidden relative">
                        <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition-colors z-10"></div>
                        <img alt="modern commercial office build out interior" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDdYBjx2e-qDLUABT8kB52Q4gnk-HEMr1n35ZRFpbsPSEe6yNTP2OYX5l6a96eUFQCsYzC4tIUoXR_hEQShtAMAo-ZY7DPKf65kZPM117PRP62GSCwG3hKJIeKxHJWLMFZyhgy_qRQZRAEUMQad_5i4WPCy3p35_mJ0UUw6L_4KUFx3egZK7zfpEx0oBdDixFeFqJbMdl8gb5eybgPuzzsgdcCRoWrGiTEjv_U28ZuVZV5wtdoEUlmphZCHpSJS8mAX1qhbBfmUo2Oc" />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Construction & Build-Outs</h3>
                        <p class="text-slate-600 dark:text-slate-400 mb-6 flex-1">Turnkey general contracting services. We handle remodeling, tenant improvements, and full-scale reconstruction.</p>
                        <ul class="space-y-2 mb-6">
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Tenant Improvements
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Interior Remodeling
                            </li>
                            <li class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                <span class="material-symbols-outlined text-primary text-lg">check_circle</span> Capital Expenditure Projects
                            </li>
                        </ul>
                        <button class="w-full py-3 rounded-lg border-2 border-primary text-primary font-bold hover:bg-primary hover:text-white transition-colors">Learn More</button>
                    </div>
                </article>
            </div>
        </div>
    </section>
    <!-- Industry Specific Solutions -->
    <section class="py-16 bg-slate-50 dark:bg-slate-900/50">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white mb-4">Industry-Specific Solutions</h2>
                <p class="text-slate-600 dark:text-slate-400 text-lg">We understand the unique operational challenges of different commercial sectors.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <a class="group relative flex flex-col items-center p-8 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg transition-all" href="/commercial/">
                    <div class="w-16 h-16 rounded-full bg-blue-50 dark:bg-slate-700 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-3xl">hotel</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Hospitality</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 text-center">Hotels, Resorts & Restaurants</p>
                </a>
                <a class="group relative flex flex-col items-center p-8 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg transition-all" href="/commercial/">
                    <div class="w-16 h-16 rounded-full bg-blue-50 dark:bg-slate-700 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-3xl">medical_services</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Healthcare</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 text-center">Hospitals, Clinics & Labs</p>
                </a>
                <a class="group relative flex flex-col items-center p-8 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg transition-all" href="/commercial/">
                    <div class="w-16 h-16 rounded-full bg-blue-50 dark:bg-slate-700 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-3xl">apartment</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Property Management</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 text-center">Multifamily, HOAs & Condos</p>
                </a>
                <a class="group relative flex flex-col items-center p-8 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg transition-all" href="/commercial/">
                    <div class="w-16 h-16 rounded-full bg-blue-50 dark:bg-slate-700 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-3xl">factory</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Industrial</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 text-center">Warehouses & Manufacturing</p>
                </a>
            </div>
        </div>
    </section>
    <!-- ERP Lead Magnet (Emergency Ready) -->
    <section class="py-16 md:py-24 bg-primary text-white">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8">
            <div class="flex flex-col lg:flex-row items-center gap-12 rounded-3xl bg-blue-600 p-8 md:p-12 shadow-2xl relative overflow-hidden">
                <!-- Abstract pattern decoration -->
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-500 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-blue-400 rounded-full blur-3xl opacity-30 pointer-events-none"></div>
                <div class="flex-1 relative z-10">
                    <span class="inline-block py-1 px-3 rounded bg-blue-800 text-blue-200 text-xs font-bold uppercase tracking-wider mb-4">Priority Response Program</span>
                    <h2 class="text-3xl md:text-5xl font-black mb-6 leading-tight">Is Your Business Emergency Ready?</h2>
                    <p class="text-blue-100 text-lg md:text-xl mb-8 leading-relaxed max-w-xl">
                        Disasters don't wait. Join our Priority Response Program (ERP) to guarantee rapid mobilization, pre-negotiated rates, and a custom action plan.
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                        <li class="flex items-center gap-2 font-medium"><span class="material-symbols-outlined">bolt</span> Guaranteed Response Time</li>
                        <li class="flex items-center gap-2 font-medium"><span class="material-symbols-outlined">savings</span> Pre-Agreed Pricing</li>
                        <li class="flex items-center gap-2 font-medium"><span class="material-symbols-outlined">description</span> Dedicated Project Manager</li>
                        <li class="flex items-center gap-2 font-medium"><span class="material-symbols-outlined">map</span> Site Specific Planning</li>
                    </ul>
                    <button class="bg-secondary hover:bg-orange-600 text-white font-bold py-4 px-8 rounded-lg text-lg transition-transform hover:-translate-y-1 shadow-lg">
                        Schedule Your Free Site Assessment
                    </button>
                </div>
                <div class="w-full lg:w-1/3 relative z-10">
                    <div class="bg-white rounded-xl p-6 shadow-xl text-slate-900">
                        <h3 class="font-bold text-xl mb-4">Request ERP Info</h3>
                        <div class="flex flex-col gap-4">
                            <input class="w-full h-12 px-4 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="Company Name" type="text" />
                            <input class="w-full h-12 px-4 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="Work Email" type="email" />
                            <input class="w-full h-12 px-4 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="Phone Number" type="tel" />
                            <button class="w-full h-12 bg-primary text-white font-bold rounded-lg hover:bg-blue-700 transition-colors">
                                Get Started
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Case Studies & FAQ -->
    <section class="py-20 bg-white dark:bg-slate-900">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8">
            <!-- Case Studies Row -->
            <div class="mb-20">
                <div class="flex justify-between items-end mb-10">
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Recent Commercial Projects</h2>
                    <a class="text-primary font-bold text-sm hidden sm:block hover:underline" href="/commercial/construction/">View Case Studies</a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Case Study 1 -->
                    <div class="flex flex-col sm:flex-row gap-6 p-4 rounded-xl border border-slate-100 hover:border-slate-300 transition-colors shadow-sm">
                        <div class="w-full sm:w-48 h-48 rounded-lg bg-slate-200 shrink-0 bg-cover bg-center" data-alt="modern hotel lobby after renovation" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBS_a9ebwF6SYzB2Os_yQhnpXEWYtxG64_DbvcbXgA8VC3wd27oJn5YIY4TkpK6I4Ibe35fUy24YUzpMYXZdisHWZQD4xyFr8q1BcJdAy4rGlZZaZN7_E0h7T2Kpt25_LRMNIYIcrzepBG_uk_sIdE7_u7Gs5LbBbtqidXU2joXs1eNbLGBiYnwWGL46y0a9AFbK73w3lQ74sQKuyhqusbQoJ-cqytWxqAXXpBKZFjYRN6FJwhoW_tqnzVcsszsjb59UaF6BkbyGK3Q')"></div>
                        <div class="flex flex-col justify-center">
                            <span class="text-xs font-bold text-secondary uppercase mb-2">Hospitality • Water Damage</span>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">High-Rise Hotel Restoration</h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4">Restored 4 floors of water damage within 48 hours, keeping the hotel operational during peak season.</p>
                            <a class="text-primary font-semibold text-sm hover:underline" href="/commercial/construction/">Read Story →</a>
                        </div>
                    </div>
                    <!-- Case Study 2 -->
                    <div class="flex flex-col sm:flex-row gap-6 p-4 rounded-xl border border-slate-100 hover:border-slate-300 transition-colors shadow-sm">
                        <div class="w-full sm:w-48 h-48 rounded-lg bg-slate-200 shrink-0 bg-cover bg-center" data-alt="large warehouse exterior blue sky" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCEVLvE-K4sT3OP1mtrEvwpXJgBIHOjxRLKmHFTWzQOfYbSb6DiKcHA7l2cmRMTj6jcExLvMckmjzgpl9QkfnIdZTsWbIqLiHesLmCqjTmZwgv3qT4eekUcjhjKFYQA4QsqUOzDtIw2aLMU13lJbGB8UpFF09arLzrxLs84OsOGKerg_UgOE33NCmpQIB7ZIsS-9owHyPZfDl_-LubpaepnUc3859qdu_MT6aHSNceyuUirJfcv1ie5cBzRVDBC4HbOR55Ly5KajwbG')"></div>
                        <div class="flex flex-col justify-center">
                            <span class="text-xs font-bold text-secondary uppercase mb-2">Industrial • Fire</span>
