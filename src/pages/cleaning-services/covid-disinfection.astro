---
import Header from "../../components/common/Header.astro";
import { Image } from "astro:assets";
import covidHeroImg from "../../assets/images/cleaning-services/covid-disinfection-hero.webp";
import MainLayout from "../../layouts/MainLayout.astro";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Commercial Disinfection Services",
    provider: {
        "@type": "LocalBusiness",
        name: "Paramount Property Restoration",
    },
    areaServed: "Florida",
    description:
        "Hospital-grade disinfection and sanitization services for commercial properties. CDC-compliant protocols for COVID-19 and other pathogens.",
    openingHours: "Mo-Su 00:00-24:00",
    availableChannel: {
        "@type": "ServiceChannel",
        serviceUrl: "https://paramountpropertyrestoration.com/contact",
        servicePhone: "+1-786-602-2217",
    },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
        {
            "@type": "Question",
            name: "What chemicals do you use?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "We use EPA-registered hospital-grade disinfectants that are effective against a broad spectrum of bacteria and viruses, including SARS-CoV-2.",
            },
        },
        {
            "@type": "Question",
            name: "Is the process safe for electronics?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes. Our electrostatic spraying technology delivers a fine wrap-around mist that sanitizes surfaces without saturating or damaging sensitive electronics.",
            },
        },
        {
            "@type": "Question",
            name: "Do you offer recurring services?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Absolutely. We can schedule daily, weekly, or monthly disinfection services to maintain a safe environment for your employees and customers.",
            },
        },
    ],
};
---

<MainLayout
    title="Commercial Disinfection Services FL | Paramount"
    description="Certified commercial disinfection and sanitization. Protect your facility with hospital-grade cleaning protocols. 24/7 availability."
    customSchema={[serviceSchema, faqSchema]}
    hideHeader={true}
    hideFooter={false}
    breadcrumbItems={[
        { label: "Home", href: "/" },
        { label: "Cleaning Services", href: "/cleaning-services/" },
        {
            label: "Disinfection",
            href: "/cleaning-services/covid-disinfection/",
        },
    ]}
>
    <!-- Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet"
    />

    <!-- Sticky Nav Wrapper -->
    <div class="sticky top-0 z-50 font-['Inter']">
        <!-- Sticky Bar -->
        <div
            class="bg-[#059669] text-white px-4 py-2 text-center text-sm font-medium flex items-center justify-center gap-4 flex-wrap shadow-md border-b border-emerald-600 relative z-[51]"
        >
            <span class="flex items-center gap-2">
                <span class="material-symbols-outlined text-white text-[18px]"
                    >verified_user</span
                >
                CDC-Compliant & EPA-Registered Protocols.
            </span>
            <a
                href="tel:7866022217"
                class="bg-white text-[#059669] hover:bg-emerald-50 px-4 py-1 rounded text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1"
            >
                Deep Clean Now
                <span class="material-symbols-outlined text-[14px]">call</span>
            </a>
        </div>

        <!-- Global Header -->
        <Header theme="light" sticky={false} />
    </div>

    <!-- Hero Section -->
    <section
        class="relative min-h-[500px] flex items-center justify-center bg-white dark:bg-[#0f172a] overflow-hidden font-['Inter']"
    >
        <div class="absolute inset-0 z-0">
            <!-- Clean abstract background -->
            <div
                class="w-full h-full bg-cover bg-center opacity-10"
                style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBKz3_cg5llk4TCEMyPIkVucDHF5uakCI2eiTM1xjCsbYcojB98uxY0IWuKE66_6-ZC5dDpKot6OJZQEjnFQvlIp4ypcQx_n6sLLkWEGTXI1ihgaw0Fq9_1IoVWcswpyGy8jqgjpIBXIWFlmmoLeBOOxQ-RZZ_b-PprvMWDPeJcmmoZmKOpEGVqsIncHmeETs6lcYcfVVQoGLs8bXRvQRoer8e_5-TMw7EcCwTPbnTbkNV9hu2KzL-8Dp2FVLuJT0Ah9G7wjqe9qpAd');"
            >
            </div>
            <!-- Gradient overlay -->
            <div
                class="absolute inset-0 bg-gradient-to-r from-emerald-50/90 to-white/60 dark:from-[#0f172a]/95 dark:to-[#0f172a]/80"
            >
            </div>
        </div>

        <div
            class="relative z-20 max-w-[1280px] w-full mx-auto px-4 md:px-8 py-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="flex flex-col gap-6">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-sm font-bold uppercase tracking-wide w-fit"
                >
                    <span class="material-symbols-outlined text-[18px]"
                        >health_and_safety</span
                    >
                    Health & Safety First
                </div>
                <h1
                    class="text-slate-900 dark:text-white text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight"
                >
                    Clinical Precision for <br />
                    <span class="text-[#059669]">Your Workplace</span>
                </h1>
                <p
                    class="text-slate-600 dark:text-slate-300 text-lg md:text-xl font-normal leading-relaxed max-w-xl"
                >
                    Protect your employees and visitors with hospital-grade
                    electrostatic disinfection services. Detailed sanitization
                    for every touchpoint.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 mt-4">
                    <a
                        href="tel:7866022217"
                        class="h-14 px-8 rounded-lg bg-[#059669] hover:bg-emerald-700 text-white text-base font-bold shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2"
                    >
                        Get a Quote
                        <span class="material-symbols-outlined"
                            >arrow_forward</span
                        >
                    </a>
                    <a
                        href="#sectors"
                        class="h-14 px-8 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-white text-base font-bold hover:bg-slate-50 dark:hover:bg-white/10 transition-all flex items-center justify-center"
                    >
                        Industries Served
                    </a>
                </div>
            </div>
            <!-- Visual Element -->
            <div class="hidden lg:block relative">
                <div class="relative rounded-2xl overflow-hidden shadow-2xl">
                    <Image
                        src={covidHeroImg}
                        alt="Professional in PPE electrostatic spraying an office"
                        class="object-cover w-full h-full transform transition-transform hover:scale-105 duration-700"
                    />
                    <div
                        class="absolute bottom-6 right-6 bg-white/90 backdrop-blur-sm p-4 rounded-xl shadow-lg border border-emerald-100"
                    >
                        <div class="flex items-center gap-3">
                            <div
                                class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600"
                            >
                                <span class="material-symbols-outlined"
                                    >cleaning_services</span
                                >
                            </div>
                            <div>
                                <p
                                    class="text-xs text-slate-500 font-bold uppercase"
                                >
                                    Coverage
                                </p>
                                <p class="text-slate-900 font-bold">
                                    99.9% Pathogen Removal
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section
        class="py-20 bg-slate-50 dark:bg-[#0b1116] font-['Inter']"
        id="sectors"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left"
            >
                <div
                    class="bg-white dark:bg-[#151f28] p-8 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800"
                >
                    <span
                        class="material-symbols-outlined text-[#059669] text-5xl mb-4"
                        >corporate_fare</span
                    >
                    <h3
                        class="text-xl font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Corporate Offices
                    </h3>
                    <p class="text-slate-600 dark:text-slate-400">
                        Regular sanitization of high-touch areas like keyboards,
                        door handles, and elevators.
                    </p>
                </div>
                <div
                    class="bg-white dark:bg-[#151f28] p-8 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800"
                >
                    <span
                        class="material-symbols-outlined text-[#059669] text-5xl mb-4"
                        >school</span
                    >
                    <h3
                        class="text-xl font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Schools & Education
                    </h3>
                    <p class="text-slate-600 dark:text-slate-400">
                        Safe, non-toxic protocols to keep classrooms healthy and
                        open for learning.
                    </p>
                </div>
                <div
                    class="bg-white dark:bg-[#151f28] p-8 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800"
                >
                    <span
                        class="material-symbols-outlined text-[#059669] text-5xl mb-4"
                        >fitness_center</span
                    >
                    <h3
                        class="text-xl font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Gyms & Spas
                    </h3>
                    <p class="text-slate-600 dark:text-slate-400">
                        Deep cleaning of equipment and locker rooms to prevent
                        staph and MRSA.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-[#059669]">
        <div class="max-w-4xl mx-auto px-4 text-center text-white">
            <h2 class="text-3xl font-bold mb-6">
                Create a healthier environment today.
            </h2>
            <div class="flex justify-center gap-4">
                <a
                    href="tel:7866022217"
                    class="bg-white text-[#059669] px-8 py-3 rounded-lg font-bold hover:bg-emerald-50 transition-colors shadow-lg"
                >
                    Call (786) 602-2217
                </a>
            </div>
        </div>
    </section>
</MainLayout>
