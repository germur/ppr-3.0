---
import Header from '../../components/common/Header.astro';

import MainLayout from '../../layouts/MainLayout.astro';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Commercial Air Duct & HVAC Cleaning Services",
  "provider": {
    "@type": "Organization",
    "name": "Paramount Property Restoration",
    "url": "https://paramountpropertyrestoration.com",
    "logo": "https://paramountpropertyrestoration.com/ppr-icon.png"
  },
  "description": "NADCA-certified commercial air duct and HVAC cleaning services in Florida. Improve indoor air quality and energy efficiency with our negative air pressure protocols.",
  "serviceType": "HVAC Cleaning",
  "areaServed": ["Miami", "Fort Lauderdale", "Orlando", "Tampa", "Jacksonville"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "HVAC Cleaning Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Commercial Air Duct Cleaning"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Coil & Component Cleaning"
        }
      },
       {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Duct Sanitization"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How often should commercial ducts be cleaned?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NADCA recommends inspection every 1-2 years. High-traffic facilities like hospitals or manufacturing plants may require more frequent cleaning. We provide a custom schedule based on your video inspection."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer after-hours services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We understand that downtime costs money. Our teams are available nights and weekends to perform cleaning services when your facility is empty, ensuring zero disruption to your business operations."
      }
    },
    {
      "@type": "Question",
      "name": "Do you use biocides or chemicals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We primarily use physical removal (Source Removal) which is the gold standard. However, if biological growth is detected, we can apply EPA-registered antimicrobial agents with your permission to sanitize the system."
      }
    }
  ]
};
---

<MainLayout 
  title="Commercial Air Duct & HVAC Cleaning Services | Paramount" 
  description="Improve air quality and energy efficiency with professional commercial air duct cleaning. NADCA-certified removal of allergens and debris in Florida."
  customSchema={[customSchema, faqSchema]}
  hideHeader={true}
  hideFooter={false}
  breadcrumbItems={[
    { label: 'Home', href: '/' },
    { label: 'Cleaning Services', href: '/cleaning-services/' },
    { label: 'Air Duct & HVAC', href: '/cleaning-services/air-duct-hvac/' }
  ]}
>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet"/>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <!-- Sticky Wrapper for Notification Bar + Header -->
    <div class="sticky top-0 z-50 font-[Manrope]">
        <!-- Sticky Notification Bar -->
        <div class="bg-[#101922] text-white px-4 py-2 text-center text-sm font-medium flex items-center justify-center gap-4 flex-wrap shadow-md border-b border-white/10 relative z-[51]">
            <span>Improve air quality and reduce energy costs today.</span>
            <button class="bg-[#f97316] hover:bg-orange-600 text-white px-3 py-1 rounded text-xs font-bold uppercase tracking-wider transition-colors">
                Request a Commercial HVAC Inspection
            </button>
        </div>
        
        <!-- Dynamic Global Header (Light Theme) -->
        <Header theme="light" sticky={false} />
    </div>



    <div class="font-[Manrope] text-[#111418] antialiased overflow-x-hidden bg-[#f6f7f8] dark:bg-[#101922]">

        <!-- Hero Section -->
        <section class="relative bg-white dark:bg-[#101922] overflow-hidden">
            <div class="layout-container flex flex-col justify-center py-12 px-4 sm:px-8 lg:px-20 xl:px-40 max-w-[1440px] mx-auto">
                <div class="flex flex-col-reverse lg:flex-row gap-12 items-center">
                    <!-- Text Content -->
                    <div class="flex flex-col gap-6 lg:w-1/2">
                        <div class="flex flex-col gap-4 text-left">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center rounded-full bg-blue-50 dark:bg-blue-900/30 px-2 py-1 text-xs font-medium text-[#137fec] ring-1 ring-inset ring-blue-700/10">Breathe Easier, Save More</span>
                            </div>
                            <h1 class="text-[#111418] dark:text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] tracking-[-0.033em]">
                                Commercial Air Duct & HVAC Cleaning Services
                            </h1>
                            <h2 class="text-[#617589] dark:text-gray-300 text-lg font-normal leading-relaxed">
                                NADCA-certified removal of allergens and debris. Improve IAQ and reduce HVAC strain with our professional cleaning protocols.
                            </h2>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 mt-2">
                            <button class="flex cursor-pointer items-center justify-center rounded-lg h-12 px-6 bg-[#137fec] hover:bg-blue-600 text-white text-base font-bold transition-colors shadow-lg shadow-blue-500/20">
                                Get a Free Video Inspection
                            </button>
                            <button class="flex cursor-pointer items-center justify-center rounded-lg h-12 px-6 bg-white dark:bg-[#1a2632] border border-[#dbe0e6] dark:border-gray-700 text-[#111418] dark:text-white text-base font-bold hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                                View Our Process
                            </button>
                        </div>
                        <!-- Trust Badges -->
                        <div class="flex items-center gap-6 mt-6 pt-6 border-t border-gray-100 dark:border-gray-800">
                            <div class="flex items-center gap-2 opacity-80 grayscale hover:grayscale-0 transition-all">
                                <!-- NADCA Placeholder Badge -->
                                <div class="h-10 w-24 bg-gray-200 dark:bg-gray-700 rounded flex items-center justify-center text-xs font-bold text-gray-500 transform hover:scale-105 transition-transform duration-300">NADCA Certified</div>
                            </div>
                            <div class="flex items-center gap-2 opacity-80 grayscale hover:grayscale-0 transition-all">
                                <!-- OSHA Placeholder Badge -->
                                <div class="h-10 w-20 bg-gray-200 dark:bg-gray-700 rounded flex items-center justify-center text-xs font-bold text-gray-500 transform hover:scale-105 transition-transform duration-300">OSHA Safe</div>
                            </div>
                            <p class="text-sm text-gray-500 font-medium">Trusted by 500+ local businesses</p>
                        </div>
                    </div>
                    <!-- Visual Content (Split Slider) -->
                    <div class="lg:w-1/2 w-full">
                        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl bg-gray-100 group">
                            <!-- Before/After Concept Image -->
                            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="Split view comparison of dirty dusty air duct versus clean shiny metal air duct" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDq2RbtRtHgOx4oblBpk0MIZPZEak0l-Fd1lyq9tSdzzRF6C5jw-75fXhAzDoPDhemijD9TMcf3vnhssPWrAp7HCxPzg_uX9rjgFlI-AsJXqGxGRS_AoIAwX_oVrAnx30B_0rtmjzWlKOMvzzg7fIgzxXhqBu8xb3Eqbo2f9iDXr0_dp_WcZCLzh68zIXx0lxzJqOClBimdkSc1zO6_lo5LzDq_1LWDftVwk-h1Y9IU4HsXOpswbNqoon7hvMWgl3L5N6r3vtOf0p2T');">
                                <div class="absolute inset-0 bg-gradient-to-r from-black/20 to-transparent"></div>
                                <!-- Fake Slider Handle -->
                                <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-white cursor-ew-resize flex items-center justify-center shadow-[0_0_20px_rgba(0,0,0,0.5)] z-20">
                                    <div class="size-8 bg-white rounded-full flex items-center justify-center shadow-lg ring-4 ring-black/10">
                                        <span class="material-symbols-outlined text-[#137fec] text-sm">compare_arrows</span>
                                    </div>
                                </div>
                                <div class="absolute bottom-4 left-4 bg-black/70 text-white px-3 py-1 rounded text-sm font-bold backdrop-blur-sm z-10">BEFORE</div>
                                <div class="absolute bottom-4 right-4 bg-[#137fec]/90 text-white px-3 py-1 rounded text-sm font-bold backdrop-blur-sm z-10">AFTER</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Problem Agitation Section -->
        <section class="py-16 bg-[#f8fafc] dark:bg-[#1a2632]">
            <div class="layout-container px-4 sm:px-8 lg:px-20 xl:px-40 flex justify-center max-w-[1440px] mx-auto">
                <div class="max-w-[960px] w-full flex flex-col gap-10">
                    <div class="flex flex-col gap-4 text-center items-center">
                        <h2 class="text-[#111418] dark:text-white text-3xl sm:text-4xl font-black leading-tight max-w-[720px]">
                            Is Your Building Making People Sick?
                        </h2>
                        <p class="text-[#617589] dark:text-gray-300 text-lg font-normal max-w-[720px]">
                            Poor indoor air quality can lead to 'Sick Building Syndrome', impacting health, productivity, and your bottom line.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Card 1 -->
                        <div class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-gray-700 bg-white dark:bg-[#101922] p-6 hover:shadow-lg transition-shadow group">
                            <div class="size-12 rounded-full bg-red-50 dark:bg-red-900/20 flex items-center justify-center text-red-500 group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-2xl">attach_money</span>
                            </div>
                            <div class="flex flex-col gap-2">
                                <h3 class="text-[#111418] dark:text-white text-lg font-bold">High Energy Bills</h3>
                                <p class="text-[#617589] dark:text-gray-400 text-sm leading-relaxed">Clogged ducts force HVAC systems to work 20-40% harder to maintain temperature, drastically increasing utility costs.</p>
                            </div>
                        </div>
                        <!-- Card 2 -->
                        <div class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-gray-700 bg-white dark:bg-[#101922] p-6 hover:shadow-lg transition-shadow group">
                            <div class="size-12 rounded-full bg-orange-50 dark:bg-orange-900/20 flex items-center justify-center text-orange-500 group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-2xl">sick</span>
                            </div>
                            <div class="flex flex-col gap-2">
                                <h3 class="text-[#111418] dark:text-white text-lg font-bold">Frequent Sick Days</h3>
                                <p class="text-[#617589] dark:text-gray-400 text-sm leading-relaxed">Airborne allergens, bacteria, and mold spores circulate continuously, contributing to respiratory issues and absenteeism.</p>
                            </div>
                        </div>
                        <!-- Card 3 -->
                        <div class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-gray-700 bg-white dark:bg-[#101922] p-6 hover:shadow-lg transition-shadow group">
                            <div class="size-12 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-300 group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-2xl">air</span>
                            </div>
                            <div class="flex flex-col gap-2">
                                <h3 class="text-[#111418] dark:text-white text-lg font-bold">Visible Dust & Debris</h3>
                                <p class="text-[#617589] dark:text-gray-400 text-sm leading-relaxed">Accumulated particulates on vents and furniture are a sign that your filtration system is overwhelmed.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Process Section -->
        <section class="py-20 bg-white dark:bg-[#101922]">
            <div class="layout-container px-4 sm:px-8 lg:px-20 xl:px-40 flex justify-center max-w-[1440px] mx-auto">
                <div class="max-w-[960px] w-full">
                    <div class="mb-12 text-center sm:text-left">
                        <span class="text-[#137fec] font-bold tracking-wider uppercase text-sm">Technical Protocol</span>
                        <h2 class="text-3xl sm:text-4xl font-black text-[#111418] dark:text-white mt-2">Our Process: Negative Air Pressure</h2>
                        <p class="text-[#617589] dark:text-gray-400 mt-4 max-w-2xl">We follow strict NADCA standards to ensure contaminants are captured, not spread.</p>
                    </div>
                    <div class="relative">
                        <!-- Vertical Line -->
                        <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-800 hidden md:block"></div>
                        <div class="flex flex-col gap-12">
                            <!-- Step 1 -->
                            <div class="flex flex-col md:flex-row gap-6 relative group">
                                <div class="hidden md:flex items-center justify-center size-16 rounded-full bg-white dark:bg-[#101922] border-2 border-[#137fec] z-10 shrink-0 shadow-lg group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-[#137fec] text-2xl">videocam</span>
                                </div>
                                <div class="flex-1 bg-white dark:bg-[#1a2632] p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm group-hover:shadow-md transition-all group-hover:-translate-y-1">
                                    <div class="flex items-center gap-3 md:hidden mb-4 text-[#137fec]">
                                        <span class="material-symbols-outlined text-2xl">videocam</span>
                                        <span class="font-bold">Step 01</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-2">Video Inspection</h3>
                                    <p class="text-[#617589] dark:text-gray-400 text-sm">We initiate every project with a robotic camera inspection to assess the contamination level and identify blockages or structural damage before cleaning begins.</p>
                                </div>
                            </div>
                            <!-- Step 2 -->
                            <div class="flex flex-col md:flex-row gap-6 relative group">
                                <div class="hidden md:flex items-center justify-center size-16 rounded-full bg-white dark:bg-[#101922] border-2 border-[#137fec] z-10 shrink-0 shadow-lg group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-[#137fec] text-2xl">cyclone</span>
                                </div>
                                <div class="flex-1 bg-white dark:bg-[#1a2632] p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm group-hover:shadow-md transition-all group-hover:-translate-y-1">
                                    <div class="flex items-center gap-3 md:hidden mb-4 text-[#137fec]">
                                        <span class="material-symbols-outlined text-2xl">cyclone</span>
                                        <span class="font-bold">Step 02</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-2">Negative Pressure Setup</h3>
                                    <p class="text-[#617589] dark:text-gray-400 text-sm">Industrial-grade vacuum units are connected to your main trunk line, creating a vacuum that pulls debris away from living spaces and into our containment system.</p>
                                </div>
                            </div>
                            <!-- Step 3 -->
                            <div class="flex flex-col md:flex-row gap-6 relative group">
                                <div class="hidden md:flex items-center justify-center size-16 rounded-full bg-white dark:bg-[#101922] border-2 border-[#137fec] z-10 shrink-0 shadow-lg group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-[#137fec] text-2xl">cleaning_services</span>
                                </div>
                                <div class="flex-1 bg-white dark:bg-[#1a2632] p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm group-hover:shadow-md transition-all group-hover:-translate-y-1">
                                    <div class="flex items-center gap-3 md:hidden mb-4 text-[#137fec]">
                                        <span class="material-symbols-outlined text-2xl">cleaning_services</span>
                                        <span class="font-bold">Step 03</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-2">Agitation & Removal</h3>
                                    <p class="text-[#617589] dark:text-gray-400 text-sm">Using compressed air whips and rotary brushes, we dislodge stubborn dust cakes from duct walls. The negative pressure immediately sucks this debris out.</p>
                                </div>
                            </div>
                            <!-- Step 4 -->
                            <div class="flex flex-col md:flex-row gap-6 relative group">
                                <div class="hidden md:flex items-center justify-center size-16 rounded-full bg-white dark:bg-[#101922] border-2 border-[#137fec] z-10 shrink-0 shadow-lg group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-[#137fec] text-2xl">grid_view</span>
                                </div>
                                <div class="flex-1 bg-white dark:bg-[#1a2632] p-6 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm group-hover:shadow-md transition-all group-hover:-translate-y-1">
                                    <div class="flex items-center gap-3 md:hidden mb-4 text-[#137fec]">
                                        <span class="material-symbols-outlined text-2xl">grid_view</span>
                                        <span class="font-bold">Step 04</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-2">Coil & Component Cleaning</h3>
                                    <p class="text-[#617589] dark:text-gray-400 text-sm">We finish by cleaning the blower motor, evaporator coil, and drain pan to ensure the entire system operates at peak energy efficiency.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Mold Connection (Cross Sell) -->
        <section class="py-10 bg-[#137fec]/5 dark:bg-[#137fec]/10 border-y border-[#137fec]/10">
            <div class="layout-container px-4 sm:px-8 lg:px-20 xl:px-40 flex justify-center max-w-[1440px] mx-auto">
                <div class="max-w-[960px] w-full flex flex-col md:flex-row items-center gap-8 md:gap-12">
                    <div class="w-full md:w-1/3 aspect-video rounded-lg overflow-hidden relative shadow-lg group cursor-pointer">
                        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" data-alt="Close up of mold spores growing inside a dark ventilation shaft" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBHp3_cg5llk4TCEMyPIkVucDHF5uakCI2eiTM1xjCsbYcojB98uxY0IWuKE66_6-ZC5dDpKot6OJZQEjnFQvlIp4ypcQx_n6sLLkWEGTXI1ihgaw0Fq9_1IoVWcswpyGy8jqgjpIBXIWFlmmoLeBOOxQ-RZZ_b-PprvMWDPeJcmmoZmKOpEGVqsIncHmeETs6lcYcfVVQoGLs8bXRvQRoer8e_5-TMw7EcCwTPbnTbkNV9hu2KzL-8Dp2FVLuJT0Ah9G7wjqe9qpAd');"></div>
                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition-colors">
                            <span class="material-symbols-outlined text-white text-5xl opacity-80 group-hover:scale-110 transition-transform">warning</span>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 text-center md:text-left">
                        <h3 class="text-2xl font-black text-[#111418] dark:text-white">The Mold Connection</h3>
                        <p class="text-[#111418] dark:text-gray-200">
                            Dirty ducts are a breeding ground for mold. Moisture + Dust = Growth. If we detect mold during our inspection, our certified remediation team can handle it seamlessly.
                        </p>
                        <div>
                            <a class="inline-flex items-center gap-2 font-bold text-[#137fec] hover:text-blue-700 transition-colors group" href="/restoration/mold-remediation/">
                                Learn about Mold Remediation
                                <span class="material-symbols-outlined text-sm transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Equipment Showcase -->
        <section class="py-20 bg-white dark:bg-[#101922]">
            <div class="layout-container px-4 sm:px-8 lg:px-20 xl:px-40 flex justify-center max-w-[1440px] mx-auto">
                <div class="max-w-[960px] w-full">
                    <div class="flex flex-col gap-2 mb-10 text-center">
                        <h2 class="text-3xl font-black text-[#111418] dark:text-white">Industrial-Grade Equipment</h2>
                        <p class="text-[#617589] dark:text-gray-400">We don't use shop vacs. We use heavy-duty restoration technology.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Equip 1 -->
                        <div class="group flex flex-col rounded-xl overflow-hidden border border-[#dbe0e6] dark:border-gray-700 bg-[#f6f7f8] dark:bg-[#1a2632] hover:shadow-lg transition-all">
                            <div class="aspect-video w-full bg-gray-200 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="Industrial truck mounted vacuum equipment for HVAC cleaning" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAmxIpDJhi-aW9Em3DePtI3GjSqMx5X2d5UXZjF6niZmbkSiqp06dtVH0_Eol1VxOMb4I1iAIyDx7Nh-2NWAD3jJ3210Nl9vsoUdyy1GEAblvZCX9BPWa63iX_nqKkGEeIsMsa4tLcXxnR2uR4YY7PBsl0APQYpVhDvW9Ux-M4SMKtfintr2ul1SMBCgLTwtxVeLlviQcXXLVhuUZqjot3oGOshNsT9HE-S2Z1y1XHK7--AirOYoy37TLxS0REYg_SIta14QHzSD4X_');"></div>
                            <div class="p-5 flex flex-col gap-2">
                                <h4 class="font-bold text-lg text-[#111418] dark:text-white">Truck-Mounted Vacuums</h4>
                                <p class="text-sm text-[#617589] dark:text-gray-400">Generates 16,000 CFM of suction to remove heavy debris from large commercial systems.</p>
                            </div>
                        </div>
                        <!-- Equip 2 -->
                        <div class="group flex flex-col rounded-xl overflow-hidden border border-[#dbe0e6] dark:border-gray-700 bg-[#f6f7f8] dark:bg-[#1a2632] hover:shadow-lg transition-all">
                            <div class="aspect-video w-full bg-gray-200 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="Robotic air duct cleaning brush system inside a vent" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCil57IizRXvYyDSk7hg7j87tM0222_027bLpUxRd1BxpDzAtD8FL-eHPbgO46fAmP_u5sTTsjw6Ot8qpaXejv3UOLRXkIq_wH5rg5HxN5JbD49GUe8ml7GogT_l945HvOKkbovWLwWnnvsLCfoe4tUp8uLyDBqR58xy7NALpsVdzuoFLmc50oqog3uI8u6VAp53WJ_SEoxns83O9W7draap_c0xq3DnW9aSc0LFGpgWdWbK7Cjl78pA-YhrxlEpMwZKKlPVy_hpTbU');"></div>
                            <div class="p-5 flex flex-col gap-2">
                                <h4 class="font-bold text-lg text-[#111418] dark:text-white">Robotic Brushes</h4>
                                <p class="text-sm text-[#617589] dark:text-gray-400">Remotely operated vehicles to clean hard-to-reach ducts that manual tools can't access.</p>
                            </div>
                        </div>
                        <!-- Equip 3 -->
                        <div class="group flex flex-col rounded-xl overflow-hidden border border-[#dbe0e6] dark:border-gray-700 bg-[#f6f7f8] dark:bg-[#1a2632] hover:shadow-lg transition-all">
