---
import Header from '../../components/common/Header.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import MainLayout from '../../layouts/MainLayout.astro';

// Schema for Graffiti Removal
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Graffiti Removal & Vandalism Restoration",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Paramount Property Restoration"
  },
  "areaServed": "Florida",
  "description": "Professional graffiti removal, pressure washing, and vandalism restoration for commercial and residential properties. 24/7 rapid response.",
  "openingHours": "Mo-Su 00:00-24:00",
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": "https://paramountpropertyrestoration.com/contact",
    "servicePhone": "+1-786-602-2217"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you remove graffiti without damaging the underlying surface?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We use specialized pressure washing and chemical solvents tailored to the specific surface material (brick, glass, concrete, or metal) to ensure the graffiti is removed without harming your property."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly can you respond to vandalism?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer 24/7 emergency response. Rapid removal is crucial to prevent copycat vandalism, so we aim to be on-site within hours of your call."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer anti-graffiti coatings?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we can apply sacrificial or permanent anti-graffiti coatings that make future tag removal significantly easier and cheaper."
      }
    }
  ]
};
---

<MainLayout 
  title="Graffiti Removal & Vandalism Restoration FL | Paramount" 
  description="Rapid graffiti removal and vandalism restoration. Protect your property's image with our 24/7 commercial cleaning services."
  customSchema={[serviceSchema, faqSchema]}
  hideHeader={true}
  hideFooter={false}
  breadcrumbItems={[]}
>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <!-- Sticky Nav Wrapper -->
    <div class="sticky top-0 z-50 font-['Manrope']">
        <!-- Sticky Bar -->
        <div class="bg-[#0f172a] text-white px-4 py-2 text-center text-sm font-medium flex items-center justify-center gap-4 flex-wrap shadow-md border-b border-slate-700 relative z-[51]">
            <span class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[#ef4444] text-[18px]">timer</span>
                Graffiti invites more graffiti. <span class="text-[#ef4444] font-bold">We remove it fast.</span>
            </span>
            <a href="tel:7866022217" class="bg-[#ef4444] hover:bg-red-600 text-white px-4 py-1 rounded text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1">
                Emergency Response
                <span class="material-symbols-outlined text-[14px]">call</span>
            </a>
        </div>

        <!-- Global Header -->
        <Header theme="light" sticky={false} />
    </div>

    <!-- Breadcrumbs -->
    <div class="bg-gray-50 dark:bg-black/20 border-b border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
            <Breadcrumbs items={[
                { label: 'Home', href: '/' },
                { label: 'Cleaning Services', href: '/cleaning-services/' },
                { label: 'Vandalism & Graffiti', href: '/cleaning-services/vandalism-graffiti/' }
            ]} />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="relative min-h-[600px] flex items-center justify-center bg-[#0f172a] overflow-hidden font-['Manrope']">
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-r from-[#0f172a]/95 via-[#0f172a]/80 to-transparent z-10"></div>
            <!-- Background: Concrete wall or urban texture -->
            <div class="w-full h-full bg-cover bg-center opacity-40" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDB4CGLx5YyqOQ4vJ8_g-4aFm2hX3lK9gE7n5X6pY2o5J8w8d0_q1k3z6l9m4n2o7p0_r5s8t1u4v7w_x9y2z5a8b1c4d7e0f3g6h9i2j5k8l1m4n7o0p3q');"></div>
        </div>
        
        <div class="relative z-20 max-w-[1280px] w-full mx-auto px-4 md:px-8 py-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="flex flex-col gap-6">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-sm font-bold uppercase tracking-wide w-fit">
                    <span class="material-symbols-outlined text-[18px]">warning</span>
                    Restore Your Image
                </div>
                <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight">
                    Don't Let Vandalism <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500">Define Your Property</span>
                </h1>
                <p class="text-slate-300 text-lg md:text-xl font-normal leading-relaxed max-w-xl">
                    Rapid, professional graffiti removal and vandalism restoration. We erase the damage so you can keep your business running smoothly.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 mt-4">
                    <a href="tel:7866022217" class="h-14 px-8 rounded-lg bg-[#ef4444] hover:bg-red-600 text-white text-base font-bold shadow-lg shadow-red-900/20 transition-all flex items-center justify-center gap-2">
                        Get It Cleaned Now
                        <span class="material-symbols-outlined">bolt</span>
                    </a>
                    <a href="#process" class="h-14 px-8 rounded-lg bg-white/10 backdrop-blur-sm border border-white/20 text-white text-base font-bold hover:bg-white/20 transition-all flex items-center justify-center">
                        Our Process
                    </a>
                </div>
            </div>
            <!-- Visual Element -->
            <div class="hidden lg:block relative">
                <div class="relative w-full aspect-square max-w-md mx-auto">
                    <div class="absolute inset-0 bg-gradient-to-tr from-red-500/20 to-blue-500/20 rounded-2xl rotate-3 transform transition-transform duration-700 hover:rotate-0"></div>
                    <div class="absolute inset-0 bg-[#1e293b] rounded-2xl shadow-2xl overflow-hidden border border-slate-700 mx-auto transform -rotate-3 hover:rotate-0 transition-transform duration-700">
                        <!-- Before/After Effect (Simulated with image) -->
                         <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCA2s4e6y8q1_5b9d3f7h1j5k9l3m7n1o5p9r3s7t1u5v9w2x4y6z8a0b2c4d6e8f0g2h4i6j8k0l2m4n6o8p0q2r4s6t8u0v2w4x6y8z0a'); opacity: 0.8;"></div>
                         <div class="absolute bottom-0 left-0 right-0 bg-black/80 p-6 backdrop-blur-md">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="text-xs text-slate-400 uppercase tracking-wider mb-1">Response Time</div>
                                    <div class="text-white font-bold text-2xl font-['JetBrains_Mono']">&lt; 24 Hours</div>
                                </div>
                                <div class="h-10 w-px bg-slate-700"></div>
                                <div>
                                    <div class="text-xs text-slate-400 uppercase tracking-wider mb-1">Satisfaction</div>
                                    <div class="text-white font-bold text-2xl font-['JetBrains_Mono']">100%</div>
                                </div>
                            </div>
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Grid -->
    <section class="py-20 bg-slate-50 dark:bg-[#0b1116] font-['Manrope']" id="services">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-extrabold text-[#0f172a] dark:text-white mb-6">Comprehensive Restoration</h2>
                <p class="text-lg text-slate-600 dark:text-slate-400">From spray paint on brick to broken glass cleanup, we handle all forms of property vandalism.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-white dark:bg-[#151f28] rounded-xl p-8 shadow-lg border-b-4 border-red-500 hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-14 h-14 bg-red-100 dark:bg-red-900/30 rounded-lg flex items-center justify-center text-red-600 mb-6">
                        <span class="material-symbols-outlined text-3xl">spray_can</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0f172a] dark:text-white mb-3">Graffiti Removal</h3>
                    <p class="text-slate-600 dark:text-slate-400">Chemical and pressure washing techniques to remove paint from brick, concrete, glass, and metal without ghosting.</p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white dark:bg-[#151f28] rounded-xl p-8 shadow-lg border-b-4 border-orange-500 hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-14 h-14 bg-orange-100 dark:bg-orange-900/30 rounded-lg flex items-center justify-center text-orange-600 mb-6">
                        <span class="material-symbols-outlined text-3xl">pressure</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0f172a] dark:text-white mb-3">Pressure Washing</h3>
                    <p class="text-slate-600 dark:text-slate-400">Hot water pressure cleaning to remove deep-set stains, eggs, and other vandal residue.</p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white dark:bg-[#151f28] rounded-xl p-8 shadow-lg border-b-4 border-blue-500 hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center text-blue-600 mb-6">
                        <span class="material-symbols-outlined text-3xl">shield</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0f172a] dark:text-white mb-3">Protective Coatings</h3>
                    <p class="text-slate-600 dark:text-slate-400">Application of anti-graffiti sacrificial layers to make future cleaning simple and inexpensive.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Us Section (Dark) -->
    <section class="py-20 bg-[#0f172a] text-white font-['Manrope']" id="process">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl font-extrabold mb-6">The "Broken Windows" Theory is Real</h2>
                    <p class="text-lg text-slate-300 mb-8 leading-relaxed">
                        Studies show that visible vandalism invites more crime. A tagged wall that isn't cleaned within 24 hours is highly likely to be tagged again.
                    </p>
                    
                    <ul class="space-y-6">
                        <li class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-500 flex items-center justify-center shrink-0 shadow-lg shadow-red-500/30">
                                <span class="material-symbols-outlined text-white">speed</span>
                            </div>
                            <div>
                                <h4 class="text-xl font-bold mb-1">Rapid Deployment</h4>
                                <p class="text-slate-400">We prioritize vandalism calls. Our goal is to reset your property's appearance before your customers notice.</p>
                            </div>
                        </li>
                        <li class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center shrink-0 shadow-lg shadow-blue-500/30">
                                <span class="material-symbols-outlined text-white">science</span>
                            </div>
                            <div>
                                <h4 class="text-xl font-bold mb-1">Surface-Specific Chemistry</h4>
                                <p class="text-slate-400">We don't just blast everything. We match the solvent to the surface to prevent etching or permanent damage.</p>
                            </div>
                        </li>
                    </ul>

                    <div class="mt-10">
                        <a href="/contact" class="inline-block bg-white text-[#0f172a] px-8 py-4 rounded-lg font-bold hover:bg-slate-100 transition-colors">
                            Schedule Service
                        </a>
                    </div>
                </div>
                <div class="relative">
                    <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-700">
                        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBC2s4e6y8q1_5b9d3f7h1j5k9l3m7n1o5p9r3s7t1u5v9w2x4y6z8a0b2c4d6e8f0g2h4i6j8k0l2m4n6o8p0q2r4s6t8u0v2w4x6y8z0a" alt="Pressure washing graffiti off a brick wall" class="object-cover w-full h-full opacity-60 hover:opacity-100 transition-opacity duration-500">
                    </div>
                    <div class="absolute -bottom-6 -left-6 bg-red-600 p-6 rounded-xl shadow-xl max-w-xs">
                        <p class="font-bold text-xl mb-2">"It looked brand new."</p>
                        <p class="text-sm opacity-90">— Commercial Property Mgr, Orlando</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white dark:bg-[#101c22] font-['Manrope']">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-extrabold text-center text-[#0f172a] dark:text-white mb-12">Common Questions</h2>
            <div class="space-y-4">
                <details class="group bg-slate-50 dark:bg-[#1c2a33] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-[#0f172a] dark:text-white select-none">
                        Will the cleaning damage my brick or paint?
                        <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 dark:text-slate-400 leading-relaxed">
                        Not when done correctly. We determine the exact type of paint used (oil, latex, spray) and the porosity of your surface. We then select the mildest effective solvent and pressure setting to lift the graffiti without eroding the substrate.
                    </div>
                </details>

                <details class="group bg-slate-50 dark:bg-[#1c2a33] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-[#0f172a] dark:text-white select-none">
                        How fast can you get here?
                        <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 dark:text-slate-400 leading-relaxed">
                        For vandalism, we activate our emergency response protocol. We can typically have a team on-site within 2-4 hours to assess and begin remediation, especially for offensive graffiti.
                    </div>
                </details>

                <details class="group bg-slate-50 dark:bg-[#1c2a33] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-[#0f172a] dark:text-white select-none">
                        Is the process eco-friendly?
                        <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 dark:text-slate-400 leading-relaxed">
                        We prioritize biodegradable solvents and have water reclamation systems for sensitive environments to ensure we comply with all local environmental regulations.
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20 bg-[#ef4444] text-white font-['Manrope']">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="text-3xl md:text-5xl font-extrabold mb-6">Stop Vandalism In Its Tracks</h2>
            <p class="text-xl opacity-90 mb-10">Fast removal sends a message: This property is watched, cared for, and secure.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="tel:7866022217" class="bg-white text-red-600 px-8 py-4 rounded-xl font-bold text-lg shadow-xl hover:bg-slate-100 transition-colors">
                    Call (786) 602-2217
                </a>
                <a href="/contact" class="bg-red-700 text-white px-8 py-4 rounded-xl font-bold text-lg border border-red-400 hover:bg-red-800 transition-colors">
                    Request Online
                </a>
            </div>
        </div>
    </section>
</MainLayout>
