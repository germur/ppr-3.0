---
import InsuranceLayout from "../layouts/InsuranceLayout.astro";

const pageTitle =
    "Insurance Claims Assistance - Paramount Property Restoration";
---

<InsuranceLayout
    title="Property Insurance Claim Assistance | Direct Billing FL"
    description="Stress-free insurance claims. We document damage, use Xactimate pricing, and bill your carrier directly so you can focus on recovery."
>
    <main class="flex-1">
        <!-- Hero Section -->
        <section class="bg-white dark:bg-[#111418]">
            <div class="max-w-[1280px] mx-auto px-6 py-12 lg:py-20">
                <div
                    class="flex flex-col-reverse lg:flex-row gap-12 items-center"
                >
                    <!-- Text Content -->
                    <div
                        class="flex flex-col gap-6 flex-1 text-center lg:text-left"
                    >
                        <h1
                            class="text-[#111418] dark:text-white text-4xl lg:text-6xl font-black leading-tight tracking-[-0.033em]"
                        >
                            Navigating Your Insurance Claim So You Don't Have To
                        </h1>
                        <h2
                            class="text-[#617289] dark:text-gray-300 text-lg font-normal leading-relaxed max-w-2xl mx-auto lg:mx-0"
                        >
                            Comprehensive documentation. Full coverage advocacy.
                            We speak the insurance language for you to ensure
                            you get what you're owed.
                        </h2>
                        <div
                            class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4"
                        >
                            <a
                                href="/contact/"
                                class="flex cursor-pointer items-center justify-center rounded-lg h-12 px-8 bg-[#ea580c] hover:bg-orange-700 text-white text-base font-bold shadow-lg transition-colors"
                            >
                                <span>Get a Free Insurance Assessment</span>
                            </a>
                            <a
                                href="#process"
                                class="flex cursor-pointer items-center justify-center rounded-lg h-12 px-8 bg-[#f0f2f4] hover:bg-gray-200 text-[#111418] text-base font-bold transition-colors"
                            >
                                <span>How It Works</span>
                            </a>
                        </div>
                        <!-- Trust Signals -->
                        <div
                            class="mt-8 pt-8 border-t border-gray-100 dark:border-gray-800"
                        >
                            <p
                                class="text-sm font-medium text-gray-500 mb-4 uppercase tracking-wider"
                            >
                                Trusted by major carriers in Florida
                            </p>
                            <div
                                class="flex flex-wrap gap-8 justify-center lg:justify-start opacity-60 grayscale"
                            >
                                <!-- Simple SVG Placeholders for Logos -->
                                <div
                                    class="h-8 w-24 bg-gray-300 dark:bg-gray-600 rounded"
                                    title="Insurance Carrier Logo"
                                >
                                </div>
                                <div
                                    class="h-8 w-24 bg-gray-300 dark:bg-gray-600 rounded"
                                    title="Insurance Carrier Logo"
                                >
                                </div>
                                <div
                                    class="h-8 w-24 bg-gray-300 dark:bg-gray-600 rounded"
                                    title="Insurance Carrier Logo"
                                >
                                </div>
                                <div
                                    class="h-8 w-24 bg-gray-300 dark:bg-gray-600 rounded"
                                    title="Insurance Carrier Logo"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Hero Image -->
                    <div class="w-full lg:w-1/2">
                        <div
                            class="aspect-video lg:aspect-square w-full bg-gray-100 rounded-xl overflow-hidden shadow-2xl relative"
                        >
                            <div
                                class="absolute inset-0 bg-cover bg-center"
                                data-alt="Professional shaking hands with a homeowner over documents"
                                style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCywnTwxOqRsQJN3MT9n5w-3e95lpLvqByhvvkBKNyj_nxSf7H5eDV1vne6UcCxf6_j7ZDKAMmnyw0H62inQEsZ4o6LmkwqqdtnYc6r7DG_1Xd9yDSXg8QUQY_RfyhD7tMbJdWv6JoAT-IMcS7VFpc-vpGjshcX4VPYuVxOHpM4Ril5GlzHMdH7WiLL1_IH9vms8_gphgJIr8AeKBlogEUKMquyKrbYfKY_kN6ddv0ic-lcCeY9SxqiQnl-5LaGC4jJIueUncln8TPo');"
                            >
                            </div>
                            <!-- Gradient Overlay -->
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
                            >
                            </div>
                            <div
                                class="absolute bottom-6 left-6 text-white max-w-xs"
                            >
                                <div class="flex items-center gap-2 mb-2">
                                    <span
                                        class="material-symbols-outlined text-[#ea580c]"
                                        >verified_user</span
                                    >
                                    <span class="font-bold">Claim Approved</span
                                    >
                                </div>
                                <p class="text-sm opacity-90">
                                    We've helped over 500 Florida homeowners
                                    maximize their settlements.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Bento Grid Features (Hidden Value) -->
        <section class="bg-[#f6f7f8] dark:bg-[#1a222c] py-16 lg:py-24">
            <div class="max-w-[1280px] mx-auto px-6">
                <div
                    class="flex flex-col gap-4 mb-12 text-center max-w-3xl mx-auto"
                >
                    <h2
                        class="text-[#111418] dark:text-white text-3xl lg:text-4xl font-black leading-tight"
                    >
                        Hidden Value: Why Choose PPR?
                    </h2>
                    <p class="text-[#617289] dark:text-gray-300 text-lg">
                        We offer more than just repairs; we offer claim security
                        and expert navigation through the red tape.
                    </p>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
                >
                    <!-- Card 1 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-[#293038] bg-white dark:bg-[#111418] p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-[#1162d4]/10 flex items-center justify-center text-[#1162d4]"
                        >
                            <span class="material-symbols-outlined"
                                >calculate</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#111418] dark:text-white text-lg font-bold"
                            >
                                Xactimate Estimates
                            </h3>
                            <p
                                class="text-[#617289] dark:text-gray-400 text-sm leading-relaxed"
                            >
                                We use industry-standard pricing software that
                                carriers respect, ensuring line-item accuracy.
                            </p>
                        </div>
                    </div>
                    <!-- Card 2 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-[#293038] bg-white dark:bg-[#111418] p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-[#1162d4]/10 flex items-center justify-center text-[#1162d4]"
                        >
                            <span class="material-symbols-outlined"
                                >credit_card</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#111418] dark:text-white text-lg font-bold"
                            >
                                Direct Billing
                            </h3>
                            <p
                                class="text-[#617289] dark:text-gray-400 text-sm leading-relaxed"
                            >
                                We bill the insurance company directly. You
                                shouldn't have to carry the financial burden.
                            </p>
                        </div>
                    </div>
                    <!-- Card 3 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-[#293038] bg-white dark:bg-[#111418] p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-[#1162d4]/10 flex items-center justify-center text-[#1162d4]"
                        >
                            <span class="material-symbols-outlined"
                                >photo_camera</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#111418] dark:text-white text-lg font-bold"
                            >
                                Documentation Specialists
                            </h3>
                            <p
                                class="text-[#617289] dark:text-gray-400 text-sm leading-relaxed"
                            >
                                Dedicated photo & video evidence experts to
                                prove your loss beyond a shadow of a doubt.
                            </p>
                        </div>
                    </div>
                    <!-- Card 4 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-[#dbe0e6] dark:border-[#293038] bg-white dark:bg-[#111418] p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-[#1162d4]/10 flex items-center justify-center text-[#1162d4]"
                        >
                            <span class="material-symbols-outlined">shield</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#111418] dark:text-white text-lg font-bold"
                            >
                                Denials Prevention
                            </h3>
                            <p
                                class="text-[#617289] dark:text-gray-400 text-sm leading-relaxed"
                            >
                                Expert navigation to avoid common pitfalls,
                                keywords, and errors that lead to claim
                                rejection.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Did You Know? Callout -->
        <section class="bg-white dark:bg-[#111418] py-16">
            <div class="max-w-[1280px] mx-auto px-6">
                <div
                    class="rounded-2xl bg-gradient-to-r from-[#111418] to-[#1e2a38] text-white overflow-hidden relative shadow-2xl"
                >
                    <div
                        class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none"
                    >
                        <span
                            class="material-symbols-outlined text-[200px] leading-none text-[#ea580c]"
                            >gavel</span
                        >
                    </div>
                    <div
                        class="relative z-10 flex flex-col md:flex-row gap-8 p-10 lg:p-14 items-center"
                    >
                        <div class="flex-1 flex flex-col gap-6">
                            <div
                                class="inline-flex items-center gap-2 text-[#ea580c] font-bold tracking-wider uppercase text-sm"
                            >
                                <span class="material-symbols-outlined text-lg"
                                    >lightbulb</span
                                >
                                Did You Know?
                            </div>
                            <h2
                                class="text-3xl lg:text-4xl font-bold leading-tight"
                            >
                                You Have the Right to Choose Your Contractor
                            </h2>
                            <p
                                class="text-gray-300 text-lg leading-relaxed max-w-xl"
                            >
                                Don't let the insurance company dictate who
                                repairs your home. Under the law, the choice is
                                yours. Preferred vendor programs often
                                prioritize speed and cost-savings for the
                                insurer over the quality of your restoration.
                            </p>
                            <div class="pt-2">
                                <a
                                    class="inline-flex items-center text-white font-bold border-b-2 border-[#ea580c] hover:text-[#ea580c] transition-colors"
                                    href="/resources/"
                                >
                                    Read more about your homeowner rights
                                    <span
                                        class="material-symbols-outlined ml-2 text-sm"
                                        >arrow_forward</span
                                    >
                                </a>
                            </div>
                        </div>
                        <div
                            class="w-full md:w-1/3 aspect-[4/3] rounded-lg overflow-hidden border-4 border-white/10 shadow-lg"
                        >
                            <div
                                class="w-full h-full bg-cover bg-center"
                                data-alt="Close up of a legal document and house keys"
                                style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCTksd7caH8ZGbCusiJfONgdX_sS18GF-lHCV9ZBJlGj7IXFMak8z5PJeMug-SUigUzw7K0KGFtMXaJGM8iLuXiqdOmb55SUXWsFGHpnNn3p_EK7WzcfCYj75pHFixfSMbWHSQvgpAb97LP0nCIlcH5m8Dl5W0AZjxHQ3qT1MLvIIvBvThBy6wfiSVWwGCEkv5GFSug5HTBD3NyT7EaJBEr4fD54bN7SbnUvr7sWSyJulT3OJ7kLFISkYh_Se3QltoXGbKYF9UKyrFy');"
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Process Timeline -->
        <section
            id="process"
            class="bg-[#f6f7f8] dark:bg-[#1a222c] py-16 lg:py-24"
        >
            <div class="max-w-[1000px] mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-[#111418] dark:text-white text-3xl font-black mb-4"
                    >
                        The Claims Process Roadmap
                    </h2>
                    <p class="text-[#617289] dark:text-gray-300">
                        We handle the heavy lifting from day one until the final
                        coat of paint.
                    </p>
                </div>

                <div class="relative">
                    <!-- Vertical Line -->
                    <!-- Desktop: Perfectly Centered -->
                    <div
                        class="hidden md:block absolute left-1/2 top-0 bottom-0 w-[2px] -ml-[1px] bg-[#dbe0e6] dark:bg-[#293038]"
                    >
                    </div>
                    <!-- Mobile: Aligned to Icon Center (28px from left) -->
                    <div
                        class="md:hidden absolute left-[28px] top-0 bottom-0 w-[2px] -ml-[1px] bg-[#dbe0e6] dark:bg-[#293038]"
                    >
                    </div>

                    <!-- Step 1: Assessment (Left on Desktop) -->
                    <div
                        class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-x-6 md:gap-x-0 items-center mb-12"
                    >
                        <!-- Icon (Mobile: Col 1, Desktop: Col 2) -->
                        <div
                            class="col-start-1 md:col-start-2 relative z-10 flex items-center justify-center size-14 rounded-full bg-[#1162d4] text-white border-4 border-white dark:border-[#1a222c] shrink-0 mx-auto"
                        >
                            <span class="material-symbols-outlined"
                                >assignment</span
                            >
                        </div>
                        <!-- Text (Mobile: Col 2, Desktop: Col 1) -->
                        <div
                            class="col-start-2 md:col-start-1 row-start-1 md:pr-12 md:text-right"
                        >
                            <h3
                                class="text-xl font-bold text-[#111418] dark:text-white"
                            >
                                Assessment & Documentation
                            </h3>
                            <p class="text-[#617289] dark:text-gray-400 mt-2">
                                We conduct a thorough inspection, capturing
                                every detail of the damage to build a
                                bulletproof case.
                            </p>
                        </div>
                        <!-- Empty (Desktop: Col 3) -->
                        <div class="hidden md:block md:col-start-3"></div>
                    </div>

                    <!-- Step 2: Emergency Mitigation (Right on Desktop) -->
                    <div
                        class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-x-6 md:gap-x-0 items-center mb-12"
                    >
                        <!-- Icon (Mobile: Col 1, Desktop: Col 2) -->
                        <div
                            class="col-start-1 md:col-start-2 relative z-10 flex items-center justify-center size-14 rounded-full bg-white dark:bg-[#293038] text-[#1162d4] border-4 border-[#1162d4]/20 shrink-0 mx-auto"
                        >
                            <span class="material-symbols-outlined"
                                >water_drop</span
                            >
                        </div>
                        <!-- Empty (Desktop: Col 1) -->
                        <div class="hidden md:block md:col-start-1"></div>
                        <!-- Text (Mobile: Col 2, Desktop: Col 3) -->
                        <div
                            class="col-start-2 md:col-start-3 row-start-1 md:pl-12 md:text-left"
                        >
                            <h3
                                class="text-xl font-bold text-[#111418] dark:text-white"
                            >
                                Emergency Mitigation
                            </h3>
                            <p class="text-[#617289] dark:text-gray-400 mt-2">
                                Immediate action to stop further damage, remove
                                water, and secure the property.
                            </p>
                        </div>
                    </div>

                    <!-- Step 3: Claim Filing (Left on Desktop) -->
                    <div
                        class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-x-6 md:gap-x-0 items-center mb-12"
                    >
                        <!-- Icon (Mobile: Col 1, Desktop: Col 2) -->
                        <div
                            class="col-start-1 md:col-start-2 relative z-10 flex items-center justify-center size-14 rounded-full bg-white dark:bg-[#293038] text-[#1162d4] border-4 border-[#1162d4]/20 shrink-0 mx-auto"
                        >
                            <span class="material-symbols-outlined"
                                >upload_file</span
                            >
                        </div>
                        <!-- Text (Mobile: Col 2, Desktop: Col 1) -->
                        <div
                            class="col-start-2 md:col-start-1 row-start-1 md:pr-12 md:text-right"
                        >
                            <h3
                                class="text-xl font-bold text-[#111418] dark:text-white"
                            >
                                Claim Filing
                            </h3>
                            <p class="text-[#617289] dark:text-gray-400 mt-2">
                                We prepare and submit the Xactimate estimate and
                                supporting evidence directly to your carrier.
                            </p>
                        </div>
                        <!-- Empty (Desktop: Col 3) -->
                        <div class="hidden md:block md:col-start-3"></div>
                    </div>

                    <!-- Step 4: Negotiation (Right on Desktop) -->
                    <div
                        class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-x-6 md:gap-x-0 items-center mb-12"
                    >
                        <!-- Icon (Mobile: Col 1, Desktop: Col 2) -->
                        <div
                            class="col-start-1 md:col-start-2 relative z-10 flex items-center justify-center size-14 rounded-full bg-white dark:bg-[#293038] text-[#1162d4] border-4 border-[#1162d4]/20 shrink-0 mx-auto"
                        >
                            <span class="material-symbols-outlined"
                                >handshake</span
                            >
                        </div>
                        <!-- Empty (Desktop: Col 1) -->
                        <div class="hidden md:block md:col-start-1"></div>
                        <!-- Text (Mobile: Col 2, Desktop: Col 3) -->
                        <div
                            class="col-start-2 md:col-start-3 row-start-1 md:pl-12 md:text-left"
                        >
                            <h3
                                class="text-xl font-bold text-[#111418] dark:text-white"
                            >
                                Negotiation & Adjustment
                            </h3>
                            <p class="text-[#617289] dark:text-gray-400 mt-2">
                                Our specialists meet with the adjuster to defend
                                the estimate and ensure full coverage.
                            </p>
                        </div>
                    </div>

                    <!-- Step 5: Reconstruction (Left on Desktop) -->
                    <div
                        class="grid grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] gap-x-6 md:gap-x-0 items-center"
                    >
                        <!-- Icon (Mobile: Col 1, Desktop: Col 2) -->
                        <div
                            class="col-start-1 md:col-start-2 relative z-10 flex items-center justify-center size-14 rounded-full bg-white dark:bg-[#293038] text-[#1162d4] border-4 border-[#1162d4]/20 shrink-0 mx-auto"
                        >
                            <span class="material-symbols-outlined"
                                >construction</span
                            >
                        </div>
                        <!-- Text (Mobile: Col 2, Desktop: Col 1) -->
                        <div
                            class="col-start-2 md:col-start-1 row-start-1 md:pr-12 md:text-right"
                        >
                            <h3
                                class="text-xl font-bold text-[#111418] dark:text-white"
                            >
                                Reconstruction
                            </h3>
                            <p class="text-[#617289] dark:text-gray-400 mt-2">
                                Once approved, we restore your property to
                                pre-loss condition (or better).
                            </p>
                        </div>
                        <!-- Empty (Desktop: Col 3) -->
                        <div class="hidden md:block md:col-start-3"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="bg-white dark:bg-[#111418] py-16 lg:py-24">
            <div class="max-w-[800px] mx-auto px-6">
                <div class="text-center mb-12">
                    <h2
                        class="text-[#111418] dark:text-white text-3xl font-black mb-4"
                    >
                        Frequently Asked Questions
                    </h2>
                    <p class="text-[#617289] dark:text-gray-300">
                        Common concerns about the insurance process.
                    </p>
                </div>
                <div class="flex flex-col gap-4">
                    <!-- Q1 -->
                    <details
                        class="group bg-[#f6f7f8] dark:bg-[#1a222c] rounded-lg overflow-hidden"
                    >
                        <summary
                            class="flex cursor-pointer items-center justify-between p-6 font-bold text-[#111418] dark:text-white list-none"
                        >
                            <span>Will filing a claim increase my premium?</span
                            >
                            <span
                                class="material-symbols-outlined transition group-open:rotate-180"
                                >expand_more</span
                            >
                        </summary>
                        <div
                            class="px-6 pb-6 pt-0 text-[#617289] dark:text-gray-300 leading-relaxed border-t border-transparent group-open:border-gray-200 dark:group-open:border-gray-700 group-open:pt-4"
                        >
                            Generally, insurance companies cannot raise your
                            rates for filing a single claim for damage that was
                            sudden and accidental (like a storm). However, rates
                            are determined by region and risk history. We
                            recommend a free assessment first to determine if
                            the damage exceeds your deductible significantly
                            enough to warrant a claim.
                        </div>
                    </details>
                    <!-- Q2 -->
                    <details
                        class="group bg-[#f6f7f8] dark:bg-[#1a222c] rounded-lg overflow-hidden"
                    >
                        <summary
                            class="flex cursor-pointer items-center justify-between p-6 font-bold text-[#111418] dark:text-white list-none"
                        >
                            <span
                                >What if the insurance check isn't enough to
                                cover repairs?</span
                            >
                            <span
                                class="material-symbols-outlined transition group-open:rotate-180"
                                >expand_more</span
                            >
                        </summary>
                        <div
                            class="px-6 pb-6 pt-0 text-[#617289] dark:text-gray-300 leading-relaxed border-t border-transparent group-open:border-gray-200 dark:group-open:border-gray-700 group-open:pt-4"
                        >
                            This is very common. The initial check is often an
                            undisputed amount based on the adjuster's first
                            look. We file a "supplement" with detailed evidence
                            for the additional funds needed to complete the work
                            properly. You should never have to pay out of pocket
                            for covered losses (other than your deductible).
                        </div>
                    </details>
                    <!-- Q3 -->
                    <details
                        class="group bg-[#f6f7f8] dark:bg-[#1a222c] rounded-lg overflow-hidden"
                    >
                        <summary
                            class="flex cursor-pointer items-center justify-between p-6 font-bold text-[#111418] dark:text-white list-none"
                        >
                            <span
                                >Do I have to use the insurance company's
                                recommended vendor?</span
                            >
                            <span
                                class="material-symbols-outlined transition group-open:rotate-180"
                                >expand_more</span
                            >
                        </summary>
                        <div
                            class="px-6 pb-6 pt-0 text-[#617289] dark:text-gray-300 leading-relaxed border-t border-transparent group-open:border-gray-200 dark:group-open:border-gray-700 group-open:pt-4"
                        >
                            No. You have the legal right to hire the contractor
                            of your choice. While preferred vendors may promise
                            speed, they work for the insurance company. We work
                            for you to ensure the job is done right, not just
                            cheaply.
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="bg-[#1162d4] py-12">
            <div class="max-w-[1280px] mx-auto px-6 text-center">
                <h2 class="text-white text-2xl lg:text-3xl font-bold mb-6">
                    Don't Navigate This Alone. Get Expert Help Today.
                </h2>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a
                        href="/contact/"
