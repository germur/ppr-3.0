---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Our Process | Paramount Property Restoration">
  <div class="py-20 px-6 max-w-4xl mx-auto text-center">
    <h1 class="text-4xl font-bold mb-6 text-gray-900 dark:text-white">Our Restoration Process</h1>
    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
      We follow a proven, industry-standard process to ensure your property is restored quickly and correctly.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      <div class="p-6 border border-gray-200 dark:border-gray-800 rounded-lg">
        <div class="text-2xl font-bold text-blue-600 mb-2">01</div>
        <h3 class="font-bold text-lg mb-2 dark:text-white">Inspection</h3>
        <p class="text-gray-500 text-sm">Thorough assessment of the damage.</p>
      </div>
      <div class="p-6 border border-gray-200 dark:border-gray-800 rounded-lg">
        <div class="text-2xl font-bold text-blue-600 mb-2">02</div>
        <h3 class="font-bold text-lg mb-2 dark:text-white">Mitigation</h3>
        <p class="text-gray-500 text-sm">Stopping the damage from spreading.</p>
      </div>
      <div class="p-6 border border-gray-200 dark:border-gray-800 rounded-lg">
        <div class="text-2xl font-bold text-blue-600 mb-2">03</div>
        <h3 class="font-bold text-lg mb-2 dark:text-white">Restoration</h3>
        <p class="text-gray-500 text-sm">Rebuilding and returning to pre-loss condition.</p>
      </div>
    </div>
  </div>
</MainLayout>
