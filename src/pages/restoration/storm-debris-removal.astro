---
import StormDebrisLayout from '../../layouts/StormDebrisLayout.astro';
---

<StormDebrisLayout>
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
        <div class="layout-container px-4 md:px-10 py-10 md:py-16 mx-auto max-w-[1280px]">
            <div class="grid lg:grid-cols-2 gap-10 items-center">
                <div class="flex flex-col gap-6 order-2 lg:order-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 text-xs font-bold w-fit">
                        <span class="material-symbols-outlined text-[16px]">emergency_home</span>
                        Emergency Services Available 24/7
                    </div>
                    <h1 class="text-[#111418] dark:text-white text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-[-0.033em]">
                        Storm Debris Removal Help When You Need It Most
                    </h1>
                    <p class="text-[#60758a] dark:text-gray-300 text-lg leading-relaxed max-w-xl">
                        We deploy heavy machinery immediately to clear hazards and restore access to your property. Professional, experienced, and ready to mobilize to get your life back to normal.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 mt-2">
                        <a href="/contact/" class="flex items-center justify-center rounded-lg h-12 px-6 bg-[#f97316] hover:bg-orange-600 text-white text-base font-bold leading-normal transition-all shadow-lg shadow-[#f97316]/20">
                            <span class="material-symbols-outlined mr-2">calendar_clock</span>
                            Schedule Debris Removal
                        </a>
                        <a href="#process" class="flex items-center justify-center rounded-lg h-12 px-6 bg-white dark:bg-[#1a2632] border border-gray-200 dark:border-gray-700 text-[#111418] dark:text-white text-base font-bold leading-normal hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
                            How It Works
                        </a>
                    </div>
                    <div class="flex items-center gap-6 mt-4 text-sm text-[#60758a] dark:text-gray-400 font-medium">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-green-500">verified</span>
                            Expert Team
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-green-500">verified</span>
                            Local Crews
                        </div>
                    </div>
                </div>
                <div class="relative order-1 lg:order-2">
                    <div class="aspect-video w-full rounded-2xl overflow-hidden shadow-2xl relative z-10 bg-gray-200 dark:bg-gray-800">
                        <div class="w-full h-full bg-cover bg-center" data-alt="Heavy machinery clearing fallen trees and storm debris from a residential road" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAN2U75lINqgqZItUIPBO8ZaInKHdsKlJ4gK9GJylHQX9lp4tr7gu-WR31wxAAZ_aaNwY3C5GOep2mk6XZWRpgDqzQErowUhgJG6Mu6HSY8By7Fk8hdAIbZ5_EpU32ds58p-QZZbVwsxL4QwDyp2TNklOOOyqwOJtIroVpOcZggexRFypJHkfF8e8N6v5KQa3zls7fM5QoZg6S7dNWkAGxo5WY3_9dfzR-BGDtIbbhmoriwRr-94FFOoIvJZDAnrnrkBgHSzFwNCogn');"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                        <div class="absolute bottom-4 left-4 text-white">
                            <div class="flex items-center gap-2 bg-black/60 backdrop-blur-sm px-3 py-1.5 rounded-lg">
                                <span class="material-symbols-outlined text-[#f97316] text-sm">engineering</span>
                                <span class="text-xs font-bold">Equipment On Standby</span>
                            </div>
                        </div>
                    </div>
                    <!-- Decoration -->
                    <div class="absolute -bottom-6 -right-6 w-2/3 h-2/3 bg-[#0d7ff2]/10 rounded-2xl -z-0"></div>
                    <div class="absolute -top-6 -left-6 w-2/3 h-2/3 bg-[#f97316]/10 rounded-2xl -z-0"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bento Grid: What We Clear -->
    <section class="py-16 md:py-24 bg-white dark:bg-[#1a2632]">
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[1280px]">
            <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
                <div class="max-w-2xl">
                    <h2 class="text-[#111418] dark:text-white text-3xl font-bold leading-tight tracking-[-0.015em] mb-3">What We Clear: Debris Categories</h2>
                    <p class="text-[#60758a] dark:text-gray-400">Our teams are equipped to handle all types of storm aftermath, separating hazardous materials from general debris for safe disposal.</p>
                </div>
                <a class="text-[#0d7ff2] font-bold hover:underline flex items-center gap-1 whitespace-nowrap" href="/restoration/storm-damage/">
                    View Full List <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card 1: Vegetative (Large feature) -->
                <div class="lg:col-span-2 group relative overflow-hidden rounded-xl bg-[#f5f7f8] dark:bg-[#232e3a] shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow">
                    <div class="flex flex-col md:flex-row h-full">
                        <div class="p-6 md:p-8 flex flex-col justify-between flex-1 gap-6">
                            <div>
                                <div class="size-12 rounded-lg bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 flex items-center justify-center mb-4">
                                    <span class="material-symbols-outlined">forest</span>
                                </div>
                                <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-2">Vegetative Hazards</h3>
                                <p class="text-[#60758a] dark:text-gray-300 text-sm leading-relaxed mb-4">
                                    We handle large-scale organic removal including fallen trees, large limbs, heavy brush, and root balls that block driveways or pose structural threats.
                                </p>
                                <ul class="text-sm text-[#60758a] dark:text-gray-300 space-y-2">
                                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-500 text-base">check_circle</span> Tree trunks & stumps</li>
                                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-500 text-base">check_circle</span> Scattered branches</li>
                                </ul>
                            </div>
                            <a href="/restoration/storm-damage/" class="text-[#0d7ff2] font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all w-fit">
                                Learn More <span class="material-symbols-outlined text-base">arrow_forward</span>
                            </a>
                        </div>
                        <div class="w-full md:w-2/5 min-h-[200px] md:min-h-full bg-cover bg-center" data-alt="Worker cutting a fallen tree with a chainsaw" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAGA22aTRQGDDonnOrOpOVz2IOOCqrVhq_8TBAPDELOHvuknp33Bk2YbvSoy4-r-w7fotHdkmvVyKLNymqNmbeVYR65fCyBEJjftFtO7FiPYimm1paNJKDVXJOwnlKM2tL9SMcCw9vSRXVV7inGX0D2xjr4eChwh86xVwoNb9HgFka74SDVLNDn0G4j0vqFRVO43gjHHEEuNRz53nAqQM_NRKbo5s1FjnK2Hgv5FlySVXhzAQQYuy76_9S43JGdYEANHLfjXHD2OIIR');"></div>
                    </div>
                </div>
                <!-- Card 2: Construction -->
                <div class="group relative overflow-hidden rounded-xl bg-[#f5f7f8] dark:bg-[#232e3a] shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow flex flex-col">
                    <div class="h-48 bg-cover bg-center" data-alt="Pile of construction debris and wood planks" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuADmNVnsDNYQKQnAt6oL8fYjqwHaN1ffawI-mFa3VLBmwjVGtQ2tQBE5_4_GZTkz9RforAYqzfkkLcrBOy2ZCNgn5MV6khkc5RWKGvTNoCzR3eklW_Ntcr7W9ev6q_ZeM_za-p6MM2vcSLF3Acua_jAcyMB2p4uc0yNHN4xeydMVxDa4_nvzK7hiKOY1e2hGw3H8fAWJRjJSW-4HrXAX56ixPpUSJgDkmCCN8KbUt9H_l7WW2Mcl6ScntRpnyYwkk5AJ304-ws6pP91');"></div>
                    <div class="p-6 flex flex-col flex-1">
                        <div class="size-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined">foundation</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Construction & Structural</h3>
                        <p class="text-[#60758a] dark:text-gray-300 text-sm mb-4 flex-1">
                            Safe removal of siding, roofing materials, damaged drywall, shattered glass, and wrecked fencing.
                        </p>
                        <a class="inline-flex items-center justify-center rounded-lg h-8 px-4 bg-[#f0f2f5] dark:bg-gray-700 text-[#111418] dark:text-white text-xs font-bold transition-colors hover:bg-gray-200 dark:hover:bg-gray-600" href="/restoration/storm-damage/">
                            Details
                        </a>
                    </div>
                </div>
                <!-- Card 3: Hazardous -->
                <div class="group relative overflow-hidden rounded-xl bg-[#f5f7f8] dark:bg-[#232e3a] shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow flex flex-col">
                    <div class="p-6 flex flex-col h-full">
                        <div class="size-10 rounded-lg bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 flex items-center justify-center mb-4">
                            <span class="material-symbols-outlined">warning</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Hazardous Items</h3>
                        <p class="text-[#60758a] dark:text-gray-300 text-sm mb-4 flex-1">
                            Careful separation and disposal of white goods (appliances), electronics, and potential chemical hazards.
                        </p>
                        <div class="bg-orange-50 dark:bg-orange-900/10 border border-orange-100 dark:border-orange-800 rounded p-3 text-xs text-orange-800 dark:text-orange-200">
                            <strong>Safety Note:</strong> Do not touch leaking containers or downed power lines.
                        </div>
                    </div>
                </div>
                <!-- Card 4: Action/Call -->
                <div class="lg:col-span-2 bg-[#0d7ff2] text-white rounded-xl p-8 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="relative z-10 flex-1">
                        <h3 class="text-2xl font-bold mb-2">Unsure what type of debris you have?</h3>
                        <p class="text-blue-100 mb-0">Our site assessment team can identify hazards and provide a custom clearance plan.</p>
                    </div>
                    <div class="relative z-10">
                        <a href="/contact/" class="whitespace-nowrap bg-white text-[#0d7ff2] hover:bg-blue-50 px-6 py-3 rounded-lg font-bold shadow-lg transition-colors flex items-center justify-center">
                            Get a Free Assessment
                        </a>
                    </div>
                    <!-- Background pattern -->
                    <div class="absolute right-0 top-0 h-full w-1/2 opacity-10 pointer-events-none">
                        <svg class="h-full w-full" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                            <path d="M44.7,-76.4C58.9,-69.2,71.8,-59.1,79.6,-46.9C87.4,-34.7,90.1,-20.4,88.9,-6.5C87.8,7.4,82.8,20.9,75.3,33.3C67.8,45.7,57.8,57,46.2,65.3C34.6,73.6,21.4,79,8,79.4C-5.4,79.9,-19.1,75.4,-31.6,68.6C-44.1,61.8,-55.4,52.7,-64.5,41.6C-73.6,30.5,-80.5,17.4,-82.1,3.6C-83.7,-10.2,-80,-24.7,-72.1,-37.1C-64.2,-49.5,-52.1,-59.8,-39.2,-67.7C-26.3,-75.6,-12.6,-81.1,0.6,-82.1C13.8,-83.1,27.6,-79.6,40.5,-73.2L44.7,-76.4Z" fill="#FFFFFF" transform="translate(100 100)"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section id="process" class="py-16 md:py-24 bg-[#f5f7f8] dark:bg-[#101922] relative">
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[1280px]">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-[#0d7ff2] font-bold tracking-wider uppercase text-sm mb-2 block">Our Workflow</span>
                <h2 class="text-[#111418] dark:text-white text-3xl font-bold mb-4">The Process: Clearing the Way for Recovery</h2>
                <p class="text-[#60758a] dark:text-gray-400">We follow a strict safety and logistical protocol to ensure your property is cleared efficiently without causing further damage.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
                <!-- Connector Line (Desktop) -->
                <div class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-gray-200 dark:bg-gray-700 -z-0"></div>
                <!-- Step 1 -->
                <div class="relative z-10 flex flex-col items-center text-center">
                    <div class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-[#0d7ff2] flex items-center justify-center mb-6 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-[#0d7ff2]">search_check</span>
                    </div>
                    <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">1. Assessment</h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">We inspect the site for hidden hazards like downed lines or unstable structures.</p>
                </div>
                <!-- Step 2 -->
                <div class="relative z-10 flex flex-col items-center text-center">
                    <div class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-gray-200 dark:border-gray-700 flex items-center justify-center mb-6 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-[#60758a] dark:text-gray-400">category</span>
                    </div>
                    <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">2. Sorting</h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">Debris is separated into categories (vegetative, construction, white goods) for disposal.</p>
                </div>
                <!-- Step 3 -->
                <div class="relative z-10 flex flex-col items-center text-center">
                    <div class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-gray-200 dark:border-gray-700 flex items-center justify-center mb-6 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-[#60758a] dark:text-gray-400">agriculture</span>
                    </div>
                    <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">3. Removal</h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">Heavy machinery (skid steers, grapple trucks) loads and hauls material away.</p>
                </div>
                <!-- Step 4 -->
                <div class="relative z-10 flex flex-col items-center text-center">
                    <div class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-gray-200 dark:border-gray-700 flex items-center justify-center mb-6 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-[#60758a] dark:text-gray-400">recycling</span>
                    </div>
                    <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">4. Disposal</h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">All materials are disposed of responsibly at certified local facilities.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Insurance Context -->
    <section class="py-16 bg-blue-50 dark:bg-[#15202b] border-y border-blue-100 dark:border-blue-900/30">
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[1280px]">
            <div class="flex flex-col lg:flex-row gap-12 items-center">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-bold w-fit mb-4">
                        <span class="material-symbols-outlined text-[16px]">policy</span>
                        Insurance Assistance
                    </div>
                    <h2 class="text-[#111418] dark:text-white text-3xl font-bold mb-4">Debris Removal Coverage</h2>
                    <p class="text-[#60758a] dark:text-gray-300 mb-6 text-lg">
                        Understanding your policy can be confusing during a crisis. Most standard homeowner policies (HO-3) include a provision for debris removal, but specifics vary.
                    </p>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-white dark:bg-[#1e2a36] p-4 rounded-lg shadow-sm border-l-4 border-green-500">
                            <h4 class="font-bold text-[#111418] dark:text-white mb-2 flex items-center gap-2">
                                <span class="material-symbols-outlined text-green-500">check_circle</span> Typically Covered
                            </h4>
                            <p class="text-sm text-[#60758a] dark:text-gray-400">Removal of trees that have fallen on covered structures (house, garage) or block driveways.</p>
                        </div>
                        <div class="bg-white dark:bg-[#1e2a36] p-4 rounded-lg shadow-sm border-l-4 border-orange-500">
                            <h4 class="font-bold text-[#111418] dark:text-white mb-2 flex items-center gap-2">
                                <span class="material-symbols-outlined text-orange-500">info</span> Often Excluded
                            </h4>
                            <p class="text-sm text-[#60758a] dark:text-gray-400">Trees that fall in the yard without damaging structures or blocking access (varies by carrier).</p>
                        </div>
                    </div>
                    <a href="/contact/" class="mt-8 text-[#0d7ff2] font-bold hover:underline flex items-center gap-1">
                        Speak to an Insurance Specialist <span class="material-symbols-outlined text-sm">arrow_outward</span>
                    </a>
                </div>
                <div class="w-full lg:w-1/3">
                    <div class="bg-white dark:bg-[#1e2a36] p-6 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700">
                        <h3 class="font-bold text-lg mb-4 text-[#111418] dark:text-white">Need Documentation?</h3>
                        <p class="text-sm text-[#60758a] dark:text-gray-400 mb-6">We provide detailed itemized invoices and photos required by adjusters to process your claim faster.</p>
                        <div class="flex flex-col gap-3">
                            <a href="/contact/" class="w-full h-10 bg-[#111418] dark:bg-white text-white dark:text-[#111418] font-bold text-sm rounded hover:opacity-90 transition-opacity flex items-center justify-center">
                                Get Insurance Guide
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-16 bg-white dark:bg-[#1a2632]">
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[960px]">
            <h2 class="text-[#111418] dark:text-white text-3xl font-bold mb-10 text-center">Debris Removal FAQ</h2>
            <div class="space-y-4">
                <!-- FAQ Item 1 -->
                <details class="group bg-[#f5f7f8] dark:bg-[#101922] rounded-lg p-4 [&_summary::-webkit-details-marker]:hidden open:ring-1 open:ring-[#0d7ff2]/20">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-[#111418] dark:text-white font-bold text-lg">
                        <h3 class="text-base sm:text-lg">Do I need to be home for the pickup?</h3>
                        <span class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-[#111418] dark:text-white sm:p-3 group-open:-rotate-180 transition-transform">
                            <span class="material-symbols-outlined">expand_more</span>
                        </span>
                    </summary>
                    <p class="mt-4 leading-relaxed text-[#60758a] dark:text-gray-300 text-sm sm:text-base">
                        In most cases, no. As long as our crews have clear access to the debris piles, we can perform the removal while you tend to other matters. We will send photo confirmation once the job is complete.
                    </p>
                </details>
                <!-- FAQ Item 2 -->
                <details class="group bg-[#f5f7f8] dark:bg-[#101922] rounded-lg p-4 [&_summary::-webkit-details-marker]:hidden open:ring-1 open:ring-[#0d7ff2]/20">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-[#111418] dark:text-white font-bold text-lg">
                        <h3 class="text-base sm:text-lg">Will you take the tree trunk or just branches?</h3>
                        <span class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-[#111418] dark:text-white sm:p-3 group-open:-rotate-180 transition-transform">
                            <span class="material-symbols-outlined">expand_more</span>
                        </span>
                    </summary>
                    <p class="mt-4 leading-relaxed text-[#60758a] dark:text-gray-300 text-sm sm:text-base">
                        We remove everything. Our heavy grappling equipment can handle massive trunks, root balls, and piles of brush. We ensure the area is raked and swept clean after removal.
                    </p>
                </details>
                <!-- FAQ Item 3 -->
                <details class="group bg-[#f5f7f8] dark:bg-[#101922] rounded-lg p-4 [&_summary::-webkit-details-marker]:hidden open:ring-1 open:ring-[#0d7ff2]/20">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-[#111418] dark:text-white font-bold text-lg">
                        <h3 class="text-base sm:text-lg">How quickly can you get here?</h3>
                        <span class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-[#111418] dark:text-white sm:p-3 group-open:-rotate-180 transition-transform">
                            <span class="material-symbols-outlined">expand_more</span>
                        </span>
                    </summary>
                    <p class="mt-4 leading-relaxed text-[#60758a] dark:text-gray-300 text-sm sm:text-base">
                        During storm events, we operate 24/7. Priority is given to hazards blocking access or posing immediate danger. We typically schedule assessments within 24 hours of your call.
                    </p>
                </details>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20 bg-[#111418] text-white text-center px-4">
        <div class="max-w-2xl mx-auto">
            <h2 class="text-3xl font-bold mb-4">Restore Safety to Your Property Today</h2>
            <p class="text-gray-400 mb-8">Don't risk injury trying to move heavy debris yourself. Let our experts handle the heavy lifting.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="/contact/" class="bg-[#0d7ff2] hover:bg-blue-600 text-white px-8 py-3 rounded-lg font-bold text-lg transition-colors flex items-center justify-center">
                    Request Pickup
                </a>
                <a href="tel:7866022217" class="bg-transparent border border-gray-600 hover:bg-gray-800 text-white px-8 py-3 rounded-lg font-bold text-lg transition-colors flex items-center justify-center">
                    Call (786) 602-2217
                </a>
            </div>
        </div>
    </section>
</StormDebrisLayout>
