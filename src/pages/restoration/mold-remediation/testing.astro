---
import MainLayout from "../../../layouts/MainLayout.astro";

const seoTitle =
    "Certified Mold Testing & Air Quality Lab Analysis | Paramount";
const seoDescription =
    "Don't guess with your health. Get court-admissible lab reports identifying spore types and toxicity levels within 48 hours. Certified Industrial Hygienist protocols.";
---

<MainLayout title={seoTitle} description={seoDescription}>
    <!-- Custom Styles for this specific landing page -->
    <style>
        /* Custom scrollbar for clean look */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
        /* Hide scrollbar for timeline */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .font-display {
            font-family: "Space Grotesk", sans-serif;
        }
        .font-body {
            font-family: "Noto Sans", sans-serif;
        }
    </style>

    <div
        class="bg-[#f8fafc] dark:bg-[#111921] text-[#111418] dark:text-gray-100 font-display transition-colors duration-200"
    >
        <main class="w-full flex flex-col items-center">
            <!-- Hero Section -->
            <section
                class="w-full max-w-[1280px] px-4 sm:px-6 lg:px-8 py-12 lg:py-20"
            >
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <!-- Hero Content -->
                    <div class="flex flex-col gap-6 order-2 lg:order-1">
                        <div
                            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#197fe6]/10 border border-[#197fe6]/20 w-fit"
                        >
                            <span
                                class="material-symbols-outlined text-[#197fe6] text-sm"
                                >science</span
                            >
                            <span
                                class="text-[#197fe6] text-xs font-bold uppercase tracking-wide"
                                >Scientific Certainty</span
                            >
                        </div>
                        <h1
                            class="text-4xl lg:text-6xl font-black text-[#111418] dark:text-white leading-[1.1] tracking-tight"
                        >
                            Certified Mold Testing & Air Quality Lab Analysis
                        </h1>
                        <p
                            class="text-lg text-slate-600 dark:text-slate-400 font-normal leading-relaxed max-w-xl font-body"
                        >
                            Scientific certainty. Court-admissible lab reports.
                            Don't rely on guesswork when your health and
                            property are at risk.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 mt-2">
                            <button
                                class="flex items-center justify-center h-12 px-6 rounded-lg bg-[#197fe6] hover:bg-blue-600 text-white font-bold text-base transition-colors shadow-lg shadow-[#197fe6]/25"
                            >
                                Schedule Air Quality Test
                            </button>
                            <button
                                class="flex items-center justify-center h-12 px-6 rounded-lg bg-white dark:bg-[#1a2430] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-bold text-base hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
                            >
                                View Sample Report
                            </button>
                        </div>
                        <!-- Trust Badges -->
                        <div
                            class="flex flex-wrap items-center gap-6 mt-6 pt-6 border-t border-slate-100 dark:border-slate-800"
                        >
                            <div
                                class="flex items-center gap-2 text-slate-500 dark:text-slate-400"
                            >
                                <span
                                    class="material-symbols-outlined text-green-600"
                                    >verified_user</span
                                >
                                <span class="text-xs font-bold uppercase"
                                    >AIHA-LAP Accredited Labs</span
                                >
                            </div>
                            <div
                                class="flex items-center gap-2 text-slate-500 dark:text-slate-400"
                            >
                                <span
                                    class="material-symbols-outlined text-blue-600"
                                    >gavel</span
                                >
                                <span class="text-xs font-bold uppercase"
                                    >SB 2A Compliant</span
                                >
                            </div>
                            <div
                                class="flex items-center gap-2 text-slate-500 dark:text-slate-400"
                            >
                                <span
                                    class="material-symbols-outlined text-[#f59e0b]"
                                    >shield</span
                                >
                                <span class="text-xs font-bold uppercase"
                                    >Florida Licensed</span
                                >
                            </div>
                        </div>
                    </div>
                    <!-- Hero Image -->
                    <div class="relative order-1 lg:order-2">
                        <div
                            class="absolute -inset-4 bg-gradient-to-tr from-[#197fe6]/20 to-transparent rounded-2xl blur-xl opacity-70"
                        >
                        </div>
                        <div
                            class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3] group"
                        >
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10"
                            >
                            </div>
                            <img
                                alt="Technician in white PPE suit using a yellow air sampling device in a modern living room"
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                src="/assets/images/restoration/mold-remediation/mold-testing-ppe.webp"
                            />
                            <div class="absolute bottom-6 left-6 z-20">
                                <div
                                    class="bg-white/90 dark:bg-black/80 backdrop-blur px-4 py-2 rounded-lg border border-white/20"
                                >
                                    <p
                                        class="text-xs font-bold text-[#197fe6] uppercase mb-1"
                                    >
                                        Live Analysis
                                    </p>
                                    <div class="flex items-end gap-2">
                                        <span
                                            class="text-2xl font-bold text-[#111418] dark:text-white"
                                            >1,240</span
                                        >
                                        <span
                                            class="text-xs font-medium text-slate-500 mb-1"
                                            >spores/m³</span
                                        >
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Why Test Section -->
            <section
                class="w-full bg-white dark:bg-[#1a2430] border-y border-slate-100 dark:border-slate-800 py-16 lg:py-24"
            >
                <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col md:flex-row gap-12 items-start">
                        <div class="w-full md:w-1/3 flex flex-col gap-4">
                            <h2
                                class="text-3xl lg:text-4xl font-black text-[#111418] dark:text-white leading-tight"
                            >
                                Why Visual Inspection Isn't Enough
                            </h2>
                            <p
                                class="text-slate-600 dark:text-slate-400 text-base leading-relaxed font-body"
                            >
                                Mold spores are microscopic. What looks like
                                "just a stain" could be a toxic colony. Our lab
                                analysis provides the data you need for health
                                and legal certainty.
                            </p>
                            <a
                                class="text-[#197fe6] font-bold text-sm hover:underline mt-2 inline-flex items-center gap-1"
                                href="#"
                            >
                                Learn more about mold types
                                <span
                                    class="material-symbols-outlined text-[16px]"
                                    >arrow_forward</span
                                >
                            </a>
                        </div>
                        <div
                            class="w-full md:w-2/3 grid grid-cols-1 sm:grid-cols-3 gap-6"
                        >
                            <!-- Card 1 -->
                            <div
                                class="bg-white dark:bg-[#111921] p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow group"
                            >
                                <div
                                    class="size-12 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-[#197fe6] mb-4 group-hover:bg-[#197fe6] group-hover:text-white transition-colors"
                                >
                                    <span
                                        class="material-symbols-outlined text-[28px]"
                                        >biotech</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                                >
                                    Hidden Mold
                                </h3>
                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed"
                                >
                                    Detect invisible airborne spores and
                                    mycelium networks behind walls that visual
                                    checks miss completely.
                                </p>
                            </div>
                            <!-- Card 2 -->
                            <div
                                class="bg-white dark:bg-[#111921] p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow group"
                            >
                                <div
                                    class="size-12 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-[#197fe6] mb-4 group-hover:bg-[#197fe6] group-hover:text-white transition-colors"
                                >
                                    <span
                                        class="material-symbols-outlined text-[28px]"
                                        >gavel</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                                >
                                    Legal Proof
                                </h3>
                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed"
                                >
                                    Official 3rd-party lab reports compliant
                                    with SB 2A for insurance claims and landlord
                                    disputes.
                                </p>
                            </div>
                            <!-- Card 3 -->
                            <div
                                class="bg-white dark:bg-[#111921] p-6 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow group"
                            >
                                <div
                                    class="size-12 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-[#197fe6] mb-4 group-hover:bg-[#197fe6] group-hover:text-white transition-colors"
                                >
                                    <span
                                        class="material-symbols-outlined text-[28px]"
                                        >pulmonology</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                                >
                                    Health Risks
                                </h3>
                                <p
                                    class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed"
                                >
                                    Identify specific toxicity levels and
                                    allergen risks to protect asthmatic and
                                    immunocompromised family members.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Service Tiers (Bento Grid) -->
            <section
                id="lab-analysis"
                class="w-full max-w-[1280px] px-4 sm:px-6 lg:px-8 py-16 lg:py-24"
            >
                <div class="text-center mb-12">
                    <span
                        class="text-[#197fe6] font-bold text-sm tracking-widest uppercase mb-2 block"
                        >Our Protocols</span
                    >
                    <h2
                        class="text-3xl lg:text-4xl font-black text-[#111418] dark:text-white"
                    >
                        Advanced Testing Methodologies
                    </h2>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-6 h-auto md:h-[600px]"
                >
                    <!-- Main Feature: Air Sampling -->
                    <div
                        class="md:col-span-2 md:row-span-2 relative group rounded-2xl overflow-hidden shadow-lg border border-slate-200 dark:border-slate-700"
                    >
                        <div
                            class="absolute inset-0 bg-slate-900/40 group-hover:bg-slate-900/30 transition-colors z-10"
                        >
                        </div>
                        <img
                            alt="Scientific air cassette sampler connected to pump on tripod in sterile room"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            src="/assets/images/restoration/mold-remediation/mold-testing-sampler.webp"
                        />
                        <div
                            class="absolute bottom-0 left-0 p-8 z-20 w-full bg-gradient-to-t from-black/80 to-transparent"
                        >
                            <div
                                class="bg-[#197fe6]/90 text-white text-xs font-bold px-3 py-1 rounded w-fit mb-3"
                            >
                                Gold Standard
                            </div>
                            <h3 class="text-2xl font-bold text-white mb-2">
                                Air Quality Spore Trap Analysis
                            </h3>
                            <p
                                class="text-slate-200 text-sm max-w-lg font-body"
                            >
                                Captures airborne particulates including mold
                                spores, pollen, and dander. We compare indoor
                                air samples against an outdoor control to
                                scientifically determine amplification.
                            </p>
                        </div>
                    </div>
                    <!-- Secondary Feature: Swabs -->
                    <div
                        class="md:col-span-1 md:row-span-1 relative group rounded-2xl overflow-hidden shadow-lg border border-slate-200 dark:border-slate-700"
                    >
                        <div
                            class="absolute inset-0 bg-slate-900/50 group-hover:bg-slate-900/40 transition-colors z-10"
                        >
                        </div>
                        <img
                            alt="Gloved hand using tape lift method on surface wall texture"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            src="/assets/images/restoration/mold-remediation/mold-testing-tape-lift.webp"
                        />
                        <div class="absolute bottom-0 left-0 p-6 z-20">
                            <h3 class="text-xl font-bold text-white mb-1">
                                Surface Tape Lifts & Swabs
                            </h3>
                            <p class="text-slate-200 text-xs font-body">
                                Direct microscopic examination to identify genus
                                and growth stage of visible colonies.
                            </p>
                        </div>
                    </div>
                    <!-- Tertiary Feature: Thermal/Moisture -->
                    <div
                        class="md:col-span-1 md:row-span-1 relative group rounded-2xl overflow-hidden shadow-lg border border-slate-200 dark:border-slate-700 bg-slate-900"
                    >
                        <div class="absolute inset-0 bg-slate-900/30 z-10">
                        </div>
                        <img
                            alt="Thermal imaging camera screen showing blue and orange heat map of a wall leak"
                            class="w-full h-full object-cover opacity-80"
                            src="/assets/images/restoration/mold-remediation/mold-testing-thermal.webp"
                        />
                        <div class="absolute top-6 right-6 z-20 text-white/20">
                            <span class="material-symbols-outlined text-4xl"
                                >water_drop</span
                            >
                        </div>
                        <div class="absolute bottom-0 left-0 p-6 z-20">
                            <h3 class="text-xl font-bold text-white mb-1">
                                Moisture Mapping
                            </h3>
                            <p class="text-slate-200 text-xs font-body">
                                Thermal imaging to locate the water source
                                feeding the mold growth.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Process Timeline -->
            <section
                class="w-full bg-slate-50 dark:bg-slate-900 py-16 lg:py-24"
            >
                <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-16">
                        <h2
                            class="text-3xl font-black text-[#111418] dark:text-white"
                        >
                            From Inspection to Results
                        </h2>
                        <p class="text-slate-500 mt-2">
                            Turnaround time: 24-48 hours
                        </p>
                    </div>
                    <div class="relative">
                        <!-- Connector Line (Desktop) -->
                        <div
                            class="hidden md:block absolute top-1/2 left-0 w-full h-1 bg-slate-200 dark:bg-slate-700 -translate-y-1/2 z-0"
                        >
                        </div>
                        <div
                            class="grid grid-cols-1 md:grid-cols-5 gap-8 relative z-10"
                        >
                            <!-- Step 1 -->
                            <div
                                class="flex flex-col items-center text-center group"
                            >
                                <div
                                    class="size-16 rounded-full bg-white dark:bg-[#1a2430] border-4 border-[#197fe6] shadow-lg flex items-center justify-center text-[#197fe6] mb-4 relative z-10 group-hover:scale-110 transition-transform"
                                >
                                    <span class="material-symbols-outlined"
                                        >person_pin_circle</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white"
                                >
                                    Site Visit
                                </h3>
                                <p class="text-xs text-slate-500 mt-2 px-2">
                                    Technician arrives for visual assessment.
                                </p>
                            </div>
                            <!-- Step 2 -->
                            <div
                                class="flex flex-col items-center text-center group"
                            >
                                <div
                                    class="size-16 rounded-full bg-white dark:bg-[#1a2430] border-4 border-slate-200 dark:border-slate-600 shadow flex items-center justify-center text-slate-400 mb-4 relative z-10 group-hover:border-[#197fe6] group-hover:text-[#197fe6] transition-colors"
                                >
                                    <span class="material-symbols-outlined"
                                        >science</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white"
                                >
                                    Collection
                                </h3>
                                <p class="text-xs text-slate-500 mt-2 px-2">
                                    Air and surface samples gathered.
                                </p>
                            </div>
                            <!-- Step 3 -->
                            <div
                                class="flex flex-col items-center text-center group"
                            >
                                <div
                                    class="size-16 rounded-full bg-white dark:bg-[#1a2430] border-4 border-slate-200 dark:border-slate-600 shadow flex items-center justify-center text-slate-400 mb-4 relative z-10 group-hover:border-[#197fe6] group-hover:text-[#197fe6] transition-colors"
                                >
                                    <span class="material-symbols-outlined"
                                        >local_shipping</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white"
                                >
                                    Transport
                                </h3>
                                <p class="text-xs text-slate-500 mt-2 px-2">
                                    Cold-chain delivery to AIHA lab.
                                </p>
                            </div>
                            <!-- Step 4 -->
                            <div
                                class="flex flex-col items-center text-center group"
                            >
                                <div
                                    class="size-16 rounded-full bg-white dark:bg-[#1a2430] border-4 border-slate-200 dark:border-slate-600 shadow flex items-center justify-center text-slate-400 mb-4 relative z-10 group-hover:border-[#197fe6] group-hover:text-[#197fe6] transition-colors"
                                >
                                    <span class="material-symbols-outlined"
                                        >magnification_small</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white"
                                >
                                    Lab Analysis
                                </h3>
                                <p class="text-xs text-slate-500 mt-2 px-2">
                                    Microbiologist incubation & count.
                                </p>
                            </div>
                            <!-- Step 5 -->
                            <div
                                class="flex flex-col items-center text-center group"
                            >
                                <div
                                    class="size-16 rounded-full bg-white dark:bg-[#1a2430] border-4 border-slate-200 dark:border-slate-600 shadow flex items-center justify-center text-slate-400 mb-4 relative z-10 group-hover:border-[#197fe6] group-hover:text-[#197fe6] transition-colors"
                                >
                                    <span class="material-symbols-outlined"
                                        >description</span
                                    >
                                </div>
                                <h3
                                    class="text-lg font-bold text-[#111418] dark:text-white"
                                >
                                    Report
                                </h3>
                                <p class="text-xs text-slate-500 mt-2 px-2">
                                    Digital delivery of certified results.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Legal / Insurance Block -->
            <section class="w-full max-w-[1280px] px-4 sm:px-6 lg:px-8 py-12">
                <div
                    class="bg-gradient-to-br from-[#197fe6] to-blue-700 rounded-2xl p-8 lg:p-12 text-white shadow-2xl relative overflow-hidden"
                >
                    <!-- Background Decoration -->
                    <div
                        class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-white/10 rounded-full blur-3xl"
                    >
                    </div>
                    <div
                        class="relative z-10 flex flex-col md:flex-row gap-8 items-center justify-between"
                    >
                        <div class="flex-1">
                            <div
                                class="flex items-center gap-2 mb-4 text-blue-200"
                            >
                                <span class="material-symbols-outlined"
                                    >policy</span
                                >
                                <span
                                    class="text-xs font-bold uppercase tracking-wider"
                                    >SB 2A Compliance</span
                                >
                            </div>
                            <h2 class="text-3xl font-black mb-4">
                                Insurance Claims & Litigation Ready
                            </h2>
                            <p
                                class="text-blue-100 text-lg leading-relaxed font-body max-w-2xl"
                            >
                                Under Florida Senate Bill 2A, insurance carriers
                                often require proof of damage from a licensed
                                third party. Our reports are designed to meet
                                these stringent requirements, providing the
                                leverage you need for your claim.
                            </p>
                        </div>
                        <div class="flex-shrink-0">
                            <a
                                href="tel:7866022217"
                                class="bg-white text-[#197fe6] hover:bg-slate-100 font-bold py-3 px-8 rounded-lg shadow-lg transition-colors flex items-center gap-2"
                            >
                                <span class="material-symbols-outlined"
                                    >call</span
                                >
                                Speak to an Expert
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FAQ Section -->
            <section class="w-full max-w-[960px] px-4 sm:px-6 lg:px-8 py-16">
                <h2
                    class="text-3xl font-bold text-center text-[#111418] dark:text-white mb-10"
                >
                    Common Questions
                </h2>
                <div class="flex flex-col gap-4">
                    <!-- FAQ Item 1 -->
                    <details
                        class="group bg-white dark:bg-[#1a2430] border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden"
                    >
                        <summary
                            class="flex justify-between items-center font-bold cursor-pointer list-none p-5 text-lg text-[#111418] dark:text-white select-none"
                        >
                            <span
                                >Do I really need a test if I can see the mold?</span
                            >
                            <span class="transition group-open:rotate-180">
                                <span class="material-symbols-outlined"
                                    >expand_more</span
                                >
                            </span>
                        </summary>
                        <div
                            class="text-slate-600 dark:text-slate-400 font-body px-5 pb-5 leading-relaxed"
                        >
                            Yes. While visible mold confirms presence, testing
                            identifies the <strong>species</strong> (some are toxic,
                            some are allergenic) and measures the <strong
                                >spore count</strong
                            > in the air, which is critical for determining how far
                            the contamination has spread beyond the visible area.
                        </div>
                    </details>
                    <!-- FAQ Item 2 -->
                    <details
                        class="group bg-white dark:bg-[#1a2430] border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden"
                    >
                        <summary
                            class="flex justify-between items-center font-bold cursor-pointer list-none p-5 text-lg text-[#111418] dark:text-white select-none"
                        >
                            <span>Are home DIY test kits accurate?</span>
                            <span class="transition group-open:rotate-180">
                                <span class="material-symbols-outlined"
                                    >expand_more</span
                                >
                            </span>
                        </summary>
                        <div
                            class="text-slate-600 dark:text-slate-400 font-body px-5 pb-5 leading-relaxed"
                        >
                            Generally, no. Petri dish kits from hardware stores
                            settle spores via gravity, which is scientifically
                            inaccurate for measuring airborne concentration.
                            They almost always grow mold because mold is
                            everywhere. Our pump-driven tests measure volume of
                            air to give a precise comparison against outdoor
                            baselines.
                        </div>
                    </details>
                    <!-- FAQ Item 3 -->
                    <details
                        class="group bg-white dark:bg-[#1a2430] border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden"
                    >
                        <summary
