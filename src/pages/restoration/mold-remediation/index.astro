---
import { getEntry } from "astro:content";
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import FeatureGrid from "../../../components/service/FeatureGrid.astro";
import FAQAccordion from "../../../components/ui/FAQAccordion";
import {
    FaMicroscope,
    FaShieldAlt,
    FaPumpSoap,
    FaTint,
    FaTools,
} from "react-icons/fa";

import { generateServiceSchema } from "../../../utils/schemaGenerator";
import blackMoldHero from "../../../assets/images/restoration/black_mold_hero_tyvek_1767627549165.png";

// Fetch content
const entry = await getEntry("services", "mold-remediation");
if (!entry) {
    throw new Error("Service page content not found");
}
const { Content } = await entry.render();
const {
    title,

    pageTitle,
    pageDescription,
    features,
    faqs,
    heroImage: heroImageKey,
} = entry.data;

// Image map
const imageMap: Record<string, ImageMetadata> = {
    "mold-remediation": blackMoldHero,
};
const finalHeroImage =
    imageMap[heroImageKey || "mold-remediation"] || blackMoldHero;

// Icon map
const iconMap: Record<string, any> = {
    FaMicroscope,
    FaShieldAlt,
    FaPumpSoap,
    FaTint,
    FaTools,
};

// Map features
const mappedFeatures = features.map((f) => ({
    ...f,
    icon: iconMap[f.icon] || FaTools,
}));

const schema = generateServiceSchema({
    url: "https://paramountpropertyrestoration.com/restoration/mold-remediation/",
    image: blackMoldHero.src,
    description: pageDescription,
    serviceType: "Mold Remediation",
    services: [
        { name: "Mold Inspection" },
        { name: "Mold Removal" },
        { name: "Black Mold Treatment" },
    ],
});
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage={finalHeroImage}
    themeColor="teal"
    schema={schema}
>
    <!-- Features Grid -->
    <FeatureGrid title={title} features={mappedFeatures} />

    <!-- Content Section (Hidden Dangers, etc) -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <Content />
    </section>

    <!-- Services Cluster & FAQ -->
    <section class="py-16 bg-white border-t border-slate-100">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-3 gap-12">
                <!-- Services Cluster -->
                <div class="lg:col-span-1">
                    <h3 class="text-xl font-bold text-[#0f172a] mb-6">
                        Specialized Services
                    </h3>
                    <div class="flex flex-col gap-2">
                        <a
                            href="/restoration/mold-remediation/black-mold-removal/"
                            class="group flex items-center justify-between p-3 rounded-lg hover:bg-[#f6f8f8] transition-colors border border-transparent hover:border-slate-100"
                        >
                            <span
                                class="text-slate-700 font-medium group-hover:text-[#11d4c4] transition-colors"
                                >Black Mold Removal</span
                            >
                            <span
                                class="material-symbols-outlined text-slate-300 group-hover:text-[#11d4c4]"
                                >chevron_right</span
                            >
                        </a>
                        <a
                            href="/restoration/mold-remediation/attic-removal/"
                            class="group flex items-center justify-between p-3 rounded-lg hover:bg-[#f6f8f8] transition-colors border border-transparent hover:border-slate-100"
                        >
                            <span
                                class="text-slate-700 font-medium group-hover:text-[#11d4c4] transition-colors"
                                >Attic & Crawlspace Remediation</span
                            >
                            <span
                                class="material-symbols-outlined text-slate-300 group-hover:text-[#11d4c4]"
                                >chevron_right</span
                            >
                        </a>
                        <a
                            href="/cleaning-services/air-duct-hvac/"
                            class="group flex items-center justify-between p-3 rounded-lg hover:bg-[#f6f8f8] transition-colors border border-transparent hover:border-slate-100"
                        >
                            <span
                                class="text-slate-700 font-medium group-hover:text-[#11d4c4] transition-colors"
                                >HVAC & Duct Cleaning</span
                            >
                            <span
                                class="material-symbols-outlined text-slate-300 group-hover:text-[#11d4c4]"
                                >chevron_right</span
                            >
                        </a>
                        <a
                            href="/restoration/water-damage/"
                            class="group flex items-center justify-between p-3 rounded-lg hover:bg-[#f6f8f8] transition-colors border border-transparent hover:border-slate-100"
                        >
                            <span
                                class="text-slate-700 font-medium group-hover:text-[#11d4c4] transition-colors"
                                >Water Damage Restoration</span
                            >
                            <span
                                class="material-symbols-outlined text-slate-300 group-hover:text-[#11d4c4]"
                                >chevron_right</span
                            >
                        </a>
                        <a
                            href="/commercial/"
                            class="group flex items-center justify-between p-3 rounded-lg hover:bg-[#f6f8f8] transition-colors border border-transparent hover:border-slate-100"
                        >
                            <span
                                class="text-slate-700 font-medium group-hover:text-[#11d4c4] transition-colors"
                                >Commercial Sanitization</span
                            >
                            <span
                                class="material-symbols-outlined text-slate-300 group-hover:text-[#11d4c4]"
                                >chevron_right</span
                            >
                        </a>
                    </div>
                </div>
                <!-- FAQ -->
                <div class="lg:col-span-2">
                    <h3 class="text-xl font-bold text-[#0f172a] mb-6">
                        Frequently Asked Questions
                    </h3>
                    <div class="flex flex-col gap-3">
                        <FAQAccordion client:visible items={faqs} />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- City-Service Internal Links -->
    <section class="py-16 bg-[#f6f8f8] border-t border-slate-200">
        <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <h2 class="text-2xl font-bold text-[#0f172a]">Mold Remediation by City</h2>
