---
import MainLayout from '../../../../../layouts/MainLayout.astro';

const seoTitle = "Whole-Home Dehumidifier Installation | Paramount";
const seoDescription = "Professional dehumidifier installation services.";
---

<MainLayout title={seoTitle} description={seoDescription}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-4xl md:text-5xl font-display font-bold text-slate-900 mb-4">
      Whole-Home Dehumidifier Installation
    </h1>
    <div class="p-6 bg-yellow-50 border border-yellow-200 rounded-lg max-w-lg">
      <span class="font-bold text-yellow-800">Awaiting Content Integration</span>
      <p class="text-sm text-yellow-700 mt-2">
        This URL is active. Ready for HTML/Tailwind content injection from User.
      </p>
    </div>
  </div>
</MainLayout>
