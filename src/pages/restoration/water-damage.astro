---
import OrlandoWaterLayout from '../../layouts/OrlandoWaterLayout.astro';

const pageTitle = "Water Damage Restoration Orlando - Paramount Property Restoration";
---

<OrlandoWaterLayout title={pageTitle}>
  <main class="layout-container flex flex-col items-center w-full">
    <!-- Hero Section -->
    <div class="w-full relative">
      <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat" data-alt="Restoration team extracting water from a flooded living room" style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuCKuY9PlD8cZ07Mu16EMrWZA_N8XUGFfW1vJuYXyWHvS-yXJZ0EyfWbK3CMlkB8qRLgukltToB9jLPWmMhdyqstQlIlrGEM_66hi9jB1o6vZ9MZBBtsjRecAtJJmxsLBV9-elrQNrKqVrP7_MTa-wJuLikbyoli21jaVje7sJlaaoyv2Dazk9ZbB0uKeDgcqIMIxKWiPTnTEj5nVfWoo9AM2rBlZxXrvE3xxDVEyQluq8kTUva11L8IDpo7L9PoFNy--fnKUw9ZZE4B");'>
      </div>
      <div class="relative z-10 w-full flex justify-center px-4 py-20 lg:py-32">
        <div class="max-w-[1200px] w-full flex flex-col md:flex-row items-center gap-10">
          <div class="flex flex-col gap-6 text-left max-w-[640px]">
            <div class="inline-flex items-center gap-2 self-start rounded-full bg-blue-500/20 px-3 py-1 text-xs font-bold text-blue-100 backdrop-blur-md border border-blue-400/30">
              <span class="material-symbols-outlined text-[16px]">bolt</span>
              24/7 Emergency Service in Orlando
            </div>
            <h1 class="text-white text-4xl font-black leading-tight tracking-[-0.033em] md:text-5xl lg:text-6xl">
              Expert Water Damage Restoration in Orlando, FL
            </h1>
            <h2 class="text-gray-200 text-lg font-medium leading-relaxed max-w-[540px]">
              Fast response to flood and leak emergencies across Orange County. On-site in 60 minutes or less. We handle the insurance paperwork.
            </h2>
            <div class="flex flex-col sm:flex-row gap-4 mt-4">
              <a href="tel:7866022217" class="flex items-center justify-center rounded-lg h-14 px-8 bg-[#f97316] text-white text-base font-bold shadow-lg hover:bg-orange-600 hover:scale-105 transition-all">
                <span class="material-symbols-outlined mr-2">local_shipping</span>
                Orlando Dispatch: (786) 602-2217
              </a>
            </div>
          </div>
          <!-- Optional: Simple Lead Form for Desktop -->
          <div class="hidden lg:flex flex-col gap-4 bg-white dark:bg-gray-900 p-6 rounded-xl shadow-2xl max-w-sm w-full border border-gray-100 dark:border-gray-800">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">Request Immediate Callback</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">Our emergency team is on standby. Click below to connect instantly.</p>
            <a href="/contact/" class="flex items-center justify-center h-12 w-full rounded-lg bg-[#1162d4] text-white font-bold hover:bg-blue-700 transition-colors">
                 Contact Us Now
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Trust Badges -->
    <div class="w-full bg-white dark:bg-[#101822] border-b border-gray-100 dark:border-gray-800 py-6">
      <div class="max-w-[1200px] mx-auto px-4 flex flex-wrap justify-center md:justify-between items-center gap-6 opacity-80">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#1162d4] text-2xl">verified_user</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Trusted FL Professionals</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#1162d4] text-2xl">history</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Serving Orange County since 2010</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#1162d4] text-2xl">school</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Highly Trained Technicians</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#1162d4] text-2xl">star</span>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300">4.9/5 Rating on Google</span>
        </div>
      </div>
    </div>

    <!-- Local Context Section -->
    <div class="w-full max-w-[1200px] px-4 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-2 text-[#1162d4] font-bold uppercase tracking-wider text-sm">
            <span class="material-symbols-outlined text-lg">location_on</span>
            Local Expertise
          </div>
          <h2 class="text-3xl font-bold text-[#111418] dark:text-white leading-tight">
            Why Orlando Homeowners Trust Paramount
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            We understand the unique challenges of Orange County's climate. From the humid summers that accelerate mold growth to the sudden tropical storms affecting roofs in Winter Park and Downtown.
          </p>
          <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed">
            Our restoration fleet is strategically positioned near the I-4 corridor and the 408, allowing us to bypass traffic and reach neighborhoods like Lake Nona, Altamonte Springs, and Dr. Phillips in under 60 minutes. Speed is critical to minimizing water damage.
          </p>
          <ul class="flex flex-col gap-3 mt-2">
            <li class="flex items-center gap-3 text-[#111418] dark:text-white font-medium">
              <span class="material-symbols-outlined text-green-500">check_circle</span>
              Familiar with Orlando Building Codes
            </li>
            <li class="flex items-center gap-3 text-[#111418] dark:text-white font-medium">
              <span class="material-symbols-outlined text-green-500">check_circle</span>
              Direct Billing to Florida Insurers
            </li>
          </ul>
        </div>
        <div class="relative w-full h-[400px] rounded-xl overflow-hidden shadow-lg border border-gray-200 dark:border-gray-800">
          <div class="w-full h-full bg-cover bg-center bg-gray-100" data-alt="Map of Orlando service area showing coverage in Orange County" data-location="Orlando, FL" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDxB6TB2twnATpZSkE1NoASa9xndGk9V07EEGNfpOcF1U-i-F69xsciByCUhtHSUpn3XmymflfxZw3JjA63XXDf7Z0ZwLhh2Z1V90KPjwOi0T8q5d1S9T1xdOPf_edm2TCnH1bC2KBnIPDPMRsWIfqbEiZKaa0rHdQ4fRppjWqy88a1LcSykxrfkrq0GwmOBCR_Bw05gW3-rmOH19NXOLCfv-D8E17rtrmnlzY8S7JSLAMuaF7TTHn2NQyjxqgb3Kg7JmabBQ-Rcadh");'>
            <!-- Abstract representation of map for placeholder -->
            <div class="absolute inset-0 bg-black/10"></div>
            <div class="absolute bottom-4 left-4 right-4 bg-white/90 dark:bg-gray-800/90 backdrop-blur p-4 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 flex items-center gap-4">
              <div class="bg-[#1162d4]/10 p-2 rounded-full text-[#1162d4]">
                <span class="material-symbols-outlined">local_shipping</span>
              </div>
              <div>
                <p class="text-sm font-bold text-gray-900 dark:text-white">Live Dispatch Status</p>
                <p class="text-xs text-green-600 dark:text-green-400 font-bold flex items-center gap-1">
                  <span class="block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                  Crews available in Downtown Orlando
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Service Breakdown -->
    <div class="w-full bg-[#f6f7f8] dark:bg-gray-900/50 py-16 lg:py-24">
      <div class="max-w-[1200px] mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-4">Our Water Restoration Process</h2>
          <p class="text-gray-600 dark:text-gray-300">We follow a strict Industry-approved protocol to ensure your property is returned to pre-loss condition quickly and safely.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="bg-white dark:bg-[#101822] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-full h-1 bg-[#1162d4]"></div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-full bg-[#1162d4]/10 text-[#1162d4] font-bold text-xl">1</span>
              <span class="material-symbols-outlined text-gray-400 text-4xl group-hover:text-[#1162d4] transition-colors">search</span>
            </div>
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3">Rapid Assessment</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              We arrive within 60 minutes to inspect the damage. Using thermal imaging and moisture meters, we identify hidden leaks behind walls and under floors in your Orlando home.
            </p>
          </div>
          <!-- Step 2 -->
          <div class="bg-white dark:bg-[#101822] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-full h-1 bg-[#1162d4]"></div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-full bg-[#1162d4]/10 text-[#1162d4] font-bold text-xl">2</span>
              <span class="material-symbols-outlined text-gray-400 text-4xl group-hover:text-[#1162d4] transition-colors">water_drop</span>
            </div>
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3">Mitigation & Extraction</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              Powerful truck-mounted pumps remove standing water immediately. Industrial-grade dehumidifiers and air movers are set up to dry out the structure and prevent mold growth.
            </p>
          </div>
          <!-- Step 3 -->
          <div class="bg-white dark:bg-[#101822] p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-full h-1 bg-[#1162d4]"></div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-full bg-[#1162d4]/10 text-[#1162d4] font-bold text-xl">3</span>
              <span class="material-symbols-outlined text-gray-400 text-4xl group-hover:text-[#1162d4] transition-colors">construction</span>
            </div>
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3">Complete Restoration</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              From drywall replacement and painting to flooring installation. We handle the full rebuild process and work directly with your insurance adjuster to settle the claim.
            </p>
          </div>
        </div>
        <!-- Insurance Note -->
        <div class="mt-12 bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-lg p-6 flex flex-col sm:flex-row gap-6 items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="bg-white dark:bg-blue-800 p-3 rounded-full shadow-sm text-[#1162d4] dark:text-blue-300">
              <span class="material-symbols-outlined">description</span>
            </div>
            <div>
              <h4 class="font-bold text-[#111418] dark:text-white">Insurance Claims Assistance</h4>
              <p class="text-sm text-gray-600 dark:text-gray-300">We work with all major carriers in Florida to simplify your claim.</p>
            </div>
          </div>
          <a href="/contact/" class="shrink-0 text-[#1162d4] dark:text-blue-300 font-bold text-sm hover:underline">
            Learn about our Insurance Process →
          </a>
        </div>
      </div>
    </div>

    <!-- Nearby Areas & FAQ -->
    <div class="w-full max-w-[1200px] px-4 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-12">
        <!-- Left: FAQ -->
        <div class="lg:col-span-8 flex flex-col gap-8">
          <h2 class="text-3xl font-bold text-[#111418] dark:text-white">Orlando Restoration FAQ</h2>
          <div class="flex flex-col gap-4">
            <!-- FAQ Item 1 -->
            <details class="group bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 rounded-lg open:ring-2 open:ring-[#1162d4]/20">
              <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-lg text-[#111418] dark:text-white list-none">
                How fast can you get to Lake Nona?
                <span class="material-symbols-outlined transition group-open:rotate-180">expand_more</span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed">
                We have trucks stationed throughout Orange County. For the Lake Nona area, our average response time is under 45 minutes, utilizing SR 417 for rapid access.
              </div>
            </details>
            <!-- FAQ Item 2 -->
            <details class="group bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 rounded-lg open:ring-2 open:ring-[#1162d4]/20">
              <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-lg text-[#111418] dark:text-white list-none">
                Do I need a permit from the City of Orlando?
                <span class="material-symbols-outlined transition group-open:rotate-180">expand_more</span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed">
                For standard water mitigation (drying out), no permit is typically required. However, for structural reconstruction, permits may be needed. Paramount handles all permitting with the Orlando permitting department on your behalf.
              </div>
            </details>
            <!-- FAQ Item 3 -->
            <details class="group bg-white dark:bg-[#101822] border border-gray-200 dark:border-gray-800 rounded-lg open:ring-2 open:ring-[#1162d4]/20">
              <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-lg text-[#111418] dark:text-white list-none">
                Do you bill my insurance directly?
                <span class="material-symbols-outlined transition group-open:rotate-180">expand_more</span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed">
                Yes. We use Xactimate pricing software, the industry standard accepted by most insurance companies in Florida. We bill your provider directly so you don't have to pay out of pocket for covered losses.
              </div>
            </details>
          </div>
        </div>
        <!-- Right: Service Areas -->
        <div class="lg:col-span-4 flex flex-col gap-6">
          <div class="bg-gray-50 dark:bg-gray-800/50 p-6 rounded-xl border border-gray-200 dark:border-gray-800">
            <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-4">Nearby Service Areas</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">Paramount Property Restoration serves the entire Greater Orlando metropolitan area.</p>
            <div class="flex flex-wrap gap-2">
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/kissimmee/">Kissimmee</a>
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/sanford/">Sanford</a>
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/winter-garden/">Winter Garden</a>
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/altamonte-springs/">Altamonte Springs</a>
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/winter-park/">Winter Park</a>
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/apopka/">Apopka</a>
              <a class="px-4 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium hover:border-[#1162d4] hover:text-[#1162d4] transition-colors" href="/service-areas/central-florida/ocoee/">Ocoee</a>
            </div>
          </div>
          <div class="bg-[#1162d4]/5 dark:bg-[#1162d4]/10 p-6 rounded-xl border border-[#1162d4]/10">
            <div class="flex flex-col items-center text-center gap-4">
              <div class="p-3 bg-white dark:bg-gray-800 rounded-full shadow-md text-[#f97316]">
                <span class="material-symbols-outlined text-3xl">phone_in_talk</span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-[#111418] dark:text-white">Emergency? Call Now</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">24/7 Live Operator Standing By</p>
              </div>
              <a class="w-full py-3 bg-[#f97316] hover:bg-orange-600 text-white font-bold rounded-lg shadow-md transition-colors" href="tel:7866022217">
                (786) 602-2217
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</OrlandoWaterLayout>
