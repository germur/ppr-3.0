---
import MainLayout from "../../../layouts/MainLayout.astro";
---

<MainLayout
    title="Emergency Water Removal Florida | On-Site in 60 Minutes"
    description="Licensed technicians ready to extract water, prevent mold, and handle your insurance claim. Available 24/7 in Miami, Orlando, Tampa."
    image="/assets/images/restoration/water-damage/water-removal-hero.webp"
    schemaType="Service"
>
    <!-- Sticky Emergency Bar (Page Specific) -->
    <div class="bg-[#f2460d] text-white px-4 py-3 shadow-md">
        <div
            class="max-w-[1200px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left"
        >
            <div class="flex items-center gap-2 animate-pulse">
                <span class="material-symbols-outlined filled">warning</span>
                <span class="font-bold text-sm uppercase tracking-wider"
                    >24/7 Emergency Response Active</span
                >
            </div>
            <a
                href="tel:7866022217"
                class="flex items-center gap-2 font-black text-lg hover:underline decoration-2 underline-offset-4"
            >
                <span class="material-symbols-outlined">call</span>
                (786) 602-2217
            </a>
        </div>
    </div>

    <!-- Hero Section (Panic Button) -->
    <section class="relative bg-[#0b1d3f] text-white overflow-hidden">
        <!-- Background Image with Overlay -->
        <div class="absolute inset-0 z-0">
            <div
                class="absolute inset-0 bg-gradient-to-r from-[#0b1d3f] via-[#0b1d3f]/90 to-[#0b1d3f]/40 z-10"
            >
            </div>
            <div
                class="h-full w-full bg-cover bg-center"
                style="background-image: url('/assets/images/restoration/water-damage/water-removal-hero.webp');"
            >
            </div>
        </div>

        <div
            class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-10 py-16 lg:py-24 grid lg:grid-cols-2 gap-12 items-center"
        >
            <div class="flex flex-col gap-6">
                <div
                    class="inline-flex items-center gap-2 bg-white/10 w-fit px-3 py-1 rounded-full border border-white/20 backdrop-blur-sm"
                >
                    <span
                        class="material-symbols-outlined text-[#f2460d] text-sm"
                        >bolt</span
                    >
                    <span class="text-xs font-bold uppercase tracking-wider"
                        >On-Site in 60 Minutes or Less</span
                    >
                </div>

                <h1
                    class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight shadow-black drop-shadow-lg"
                >
                    Emergency Water Removal in Florida
                </h1>

                <p class="text-lg text-gray-200 max-w-xl leading-relaxed">
                    Don't wait for mold to grow. Our licensed technicians are on
                    standby 24/7. We handle the extraction, drying, and direct
                    insurance billing for you.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <a
                        href="tel:7866022217"
                        class="flex items-center justify-center gap-2 bg-[#f2460d] hover:bg-red-600 text-white px-8 py-4 rounded-lg text-lg font-bold shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 w-full sm:w-auto"
                    >
                        <span class="material-symbols-outlined">call</span>
                        CALL NOW - 60 MIN RESPONSE
                    </a>
                    <a
                        href="#contact"
                        class="flex items-center justify-center gap-2 bg-white text-[#0b1d3f] hover:bg-gray-100 px-8 py-4 rounded-lg text-lg font-bold shadow-lg transition-all w-full sm:w-auto"
                    >
                        Request Callback
                    </a>
                </div>

                <!-- Trust Signals -->
                <div
                    class="flex flex-wrap gap-4 pt-6 text-sm font-medium text-gray-300"
                >
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-green-400"
                            >verified</span
                        >
                        <span>Licensed & Insured</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-green-400"
                            >verified</span
                        >
                        <span>IICRC Certified</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-green-400"
                            >verified</span
                        >
                        <span>Direct Insurance Billing</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-yellow-400"
                            >star</span
                        >
                        <span>4.9/5 Star Reviews</span>
                    </div>
                </div>
            </div>

            <!-- Hero Image/Visual -->
            <div class="hidden lg:block relative h-full min-h-[400px]">
                <div
                    class="absolute right-0 top-1/2 -translate-y-1/2 bg-white p-4 rounded-xl shadow-2xl max-w-sm transform rotate-2"
                >
                    <div
                        class="flex items-center gap-4 mb-4 border-b border-gray-100 pb-4"
                    >
                        <div
                            class="size-12 rounded-full bg-gray-200 overflow-hidden"
                        >
                            <img
                                class="w-full h-full object-cover"
                                alt="Portrait of a restoration technician"
                                src="/assets/images/restoration/water-damage/technician-mike.webp"
                            />
                        </div>
                        <div>
                            <p class="font-bold text-[#0b1d3f]">
                                Technician Mike
                            </p>
                            <p class="text-xs text-gray-500">
                                Just arrived at a site in Miami
                            </p>
                        </div>
                        <div
                            class="ml-auto text-green-500 text-xs font-bold bg-green-50 px-2 py-1 rounded"
                        >
                            ACTIVE
                        </div>
                    </div>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <span
                                class="material-symbols-outlined text-[#f2460d]"
                                >water_drop</span
                            >
                            <p class="text-sm text-gray-600">
                                Water Extraction in progress
                            </p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span
                                class="material-symbols-outlined text-[#0b1d3f]"
                                >humidity_indoor</span
                            >
                            <p class="text-sm text-gray-600">
                                Dehumidifiers deployed
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Answer First: Action Block -->
    <section class="bg-[#f8f6f5] py-12">
        <div class="max-w-[960px] mx-auto px-4 sm:px-10">
            <div
                class="bg-white border-l-8 border-[#f2460d] rounded-r-lg shadow-sm p-8 sm:p-10"
            >
                <div class="flex flex-col gap-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="p-3 bg-red-50 rounded-full text-[#f2460d] shrink-0 hidden sm:flex"
                        >
                            <span class="material-symbols-outlined text-3xl"
                                >emergency_home</span
                            >
                        </div>
                        <div>
                            <h2
                                class="text-2xl sm:text-3xl font-bold text-[#0b1d3f] mb-2"
                            >
                                What to do if you have water damage right now?
                            </h2>
                            <p class="text-gray-600">
                                Follow these immediate safety steps before we
                                arrive to minimize damage and ensure your
                                safety.
                            </p>
                        </div>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-4 mt-2">
                        <div
                            class="flex items-center gap-3 bg-gray-50 p-4 rounded-lg"
                        >
                            <span
                                class="material-symbols-outlined text-[#f2460d]"
                                >power_off</span
                            >
                            <span class="font-semibold text-gray-800"
                                >Turn off electricity to affected areas</span
                            >
                        </div>
                        <div
                            class="flex items-center gap-3 bg-gray-50 p-4 rounded-lg"
                        >
                            <span
                                class="material-symbols-outlined text-[#f2460d]"
                                >valve</span
                            >
                            <span class="font-semibold text-gray-800"
                                >Shut off the main water valve</span
                            >
                        </div>
                        <div
                            class="flex items-center gap-3 bg-gray-50 p-4 rounded-lg"
                        >
                            <span
                                class="material-symbols-outlined text-[#f2460d]"
                                >do_not_step</span
                            >
                            <span class="font-semibold text-gray-800"
                                >Avoid walking on wet carpet</span
                            >
                        </div>
                        <div
                            class="flex items-center gap-3 bg-gray-50 p-4 rounded-lg"
                        >
                            <span
                                class="material-symbols-outlined text-[#f2460d]"
                                >photo_camera</span
                            >
                            <span class="font-semibold text-gray-800"
                                >Take photos of the damage source</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bento Grid Services -->
    <section class="py-16 bg-white">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-10">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h2 class="text-3xl font-bold text-[#0b1d3f] mb-4">
                    Why Choose Paramount Property Restoration?
                </h2>
                <p class="text-gray-600">
                    We bring hospital-grade equipment and certified expertise to
                    save your property from long-term damage.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Card 1 -->
                <div
                    class="bg-gray-50 p-6 rounded-xl hover:shadow-md transition-shadow group"
                >
                    <div
                        class="w-12 h-12 bg-blue-100 text-[#0b1d3f] rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#f2460d] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-2xl"
                            >water_pump</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#0b1d3f] mb-2">
                        Rapid Water Extraction
                    </h3>
                    <p class="text-gray-600 text-sm">
                        Industrial truck-mounted extraction units remove
                        thousands of gallons fast, preventing structural soak.
                    </p>
                </div>
                <!-- Card 2 -->
                <div
                    class="bg-gray-50 p-6 rounded-xl hover:shadow-md transition-shadow group"
                >
                    <div
                        class="w-12 h-12 bg-blue-100 text-[#0b1d3f] rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#f2460d] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-2xl"
                            >request_quote</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#0b1d3f] mb-2">
                        Direct Insurance Billing
                    </h3>
                    <p class="text-gray-600 text-sm">
                        We document everything and bill your insurance directly.
                        You focus on recovery, not paperwork.
                    </p>
                </div>
                <!-- Card 3 -->
                <div
                    class="bg-gray-50 p-6 rounded-xl hover:shadow-md transition-shadow group"
                >
                    <div
                        class="w-12 h-12 bg-blue-100 text-[#0b1d3f] rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#f2460d] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-2xl"
                            >pest_control</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#0b1d3f] mb-2">
                        Mold Prevention
                    </h3>
                    <p class="text-gray-600 text-sm">
                        Immediate application of anti-microbial treatments to
                        stop mold growth before it starts.
                    </p>
                </div>
                <!-- Card 4 -->
                <div
                    class="bg-gray-50 p-6 rounded-xl hover:shadow-md transition-shadow group"
                >
                    <div
                        class="w-12 h-12 bg-blue-100 text-[#0b1d3f] rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#f2460d] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-2xl"
                            >air</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#0b1d3f] mb-2">
                        Structural Drying
                    </h3>
                    <p class="text-gray-600 text-sm">
                        Advanced dehumidification and air movers to dry inside
                        walls, under floors, and cabinets.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Technical Deep Dive: Comparison Table -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-[960px] mx-auto px-4 sm:px-10">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-[#0b1d3f] mb-4">
                    Why Professional Extraction Beats DIY
                </h2>
                <p class="text-gray-600">
                    Think a Shop Vac is enough? Here is the technical
                    difference.
                </p>
            </div>
            <div
                class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200"
            >
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-[#0b1d3f] text-white">
                                <th
                                    class="p-4 text-sm font-bold uppercase tracking-wider w-1/3"
                                    >Feature</th
                                >
                                <th
                                    class="p-4 text-sm font-bold uppercase tracking-wider w-1/3 bg-gray-700/50"
                                    >DIY / Shop Vac</th
                                >
                                <th
                                    class="p-4 text-sm font-bold uppercase tracking-wider w-1/3 bg-[#f2460d]"
                                    >Paramount Professional</th
                                >
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <tr>
                                <td class="p-4 font-semibold text-gray-800"
                                    >Extraction Power</td
                                >
                                <td class="p-4 text-gray-600"
                                    >Surface level only</td
                                >
                                <td class="p-4 text-[#0b1d3f] font-bold"
                                    >Sub-floor & pad penetration</td
                                >
                            </tr>
                            <tr>
                                <td class="p-4 font-semibold text-gray-800"
                                    >Water Removal Rate</td
                                >
                                <td class="p-4 text-gray-600"
                                    >Slow (Manual emptying)</td
                                >
                                <td class="p-4 text-[#0b1d3f] font-bold"
                                    >Continuous Truck-Mount</td
                                >
                            </tr>
                            <tr>
                                <td class="p-4 font-semibold text-gray-800"
                                    >Hidden Moisture Detection</td
                                >
                                <td class="p-4 text-gray-600"
                                    >Guesswork / Visual only</td
                                >
                                <td class="p-4 text-[#0b1d3f] font-bold"
                                    >Thermal Imaging Cameras</td
                                >
                            </tr>
                            <tr>
                                <td class="p-4 font-semibold text-gray-800"
                                    >Mold Risk</td
                                >
                                <td class="p-4 text-red-600 font-bold"
                                    >High (Leftover moisture)</td
                                >
                                <td class="p-4 text-green-600 font-bold"
                                    >Zero (Certified Dry)</td
                                >
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Timeline -->
    <section class="py-16 bg-white">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-10">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl font-bold text-[#0b1d3f] mb-6">
                        The Process: What Happens Next?
                    </h2>
                    <p class="text-gray-600 mb-8">
                        When you call us, we deploy a team immediately. Here is
                        the step-by-step roadmap to restoring your property.
                    </p>
                    <div class="flex flex-col gap-0 relative">
                        <!-- Vertical Line -->
                        <div
                            class="absolute left-6 top-6 bottom-6 w-0.5 bg-gray-200"
                        >
                        </div>
                        <!-- Step 1 -->
                        <div class="relative flex gap-6 pb-8">
                            <div
                                class="z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#0b1d3f] text-white ring-4 ring-white"
                            >
                                <span class="material-symbols-outlined"
                                    >ambulance</span
                                >
                            </div>
                            <div class="pt-1">
                                <h4 class="text-lg font-bold text-[#0b1d3f]">
                                    Arrival & Assessment (60 Mins)
                                </h4>
                                <p class="text-gray-600 text-sm mt-1">
                                    We arrive, identify the water source, and
                                    use thermal cameras to map the moisture
                                    spread.
                                </p>
                            </div>
                        </div>
                        <!-- Step 2 -->
                        <div class="relative flex gap-6 pb-8">
                            <div
                                class="z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#f2460d] text-white ring-4 ring-white"
                            >
                                <span class="material-symbols-outlined"
                                    >plumbing</span
                                >
                            </div>
                            <div class="pt-1">
                                <h4 class="text-lg font-bold text-[#0b1d3f]">
                                    Extraction & Containment
                                </h4>
                                <p class="text-gray-600 text-sm mt-1">
                                    We pump out standing water and remove
                                    unsalvageable materials like soaked carpet
                                    padding.
                                </p>
                            </div>
                        </div>
                        <!-- Step 3 -->
                        <div class="relative flex gap-6 pb-8">
                            <div
                                class="z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white border-2 border-[#0b1d3f] text-[#0b1d3f] ring-4 ring-white"
                            >
                                <span class="material-symbols-outlined"
                                    >wind_power</span
                                >
                            </div>
                            <div class="pt-1">
                                <h4 class="text-lg font-bold text-[#0b1d3f]">
                                    Drying & Dehumidification
                                </h4>
                                <p class="text-gray-600 text-sm mt-1">
                                    Industrial air movers and dehumidifiers run
                                    for 3-5 days to dry the structure
                                    completely.
                                </p>
                            </div>
                        </div>
                        <!-- Step 4 -->
                        <div class="relative flex gap-6">
                            <div
                                class="z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white border-2 border-[#0b1d3f] text-[#0b1d3f] ring-4 ring-white"
                            >
                                <span class="material-symbols-outlined"
                                    >check_circle</span
                                >
                            </div>
                            <div class="pt-1">
                                <h4 class="text-lg font-bold text-[#0b1d3f]">
                                    Monitoring & Restoration
                                </h4>
                                <p class="text-gray-600 text-sm mt-1">
                                    We monitor daily progress and assist with
                                    the remodeling once the area is verified
                                    dry.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div
                    class="relative h-full min-h-[400px] bg-gray-100 rounded-xl overflow-hidden shadow-lg"
                >
                    <div
                        class="absolute inset-0 bg-cover bg-center"
                        style="background-image: url('/assets/images/restoration/water-damage/equipment-action.webp');"
                    >
                    </div>
                    <div
                        class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 to-transparent"
                    >
                        <p class="text-white font-bold text-lg">
                            See our equipment in action
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Local Social Proof & Map -->
    <section class="py-16 bg-[#f8f6f5]">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-10">
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Testimonials -->
                <div class="flex flex-col justify-center">
                    <h2 class="text-3xl font-bold text-[#0b1d3f] mb-8">
                        Trusted by Your Florida Neighbors
                    </h2>
                    <div
                        class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 relative"
                    >
                        <span
                            class="material-symbols-outlined absolute top-6 right-6 text-gray-200 text-6xl"
                            >format_quote</span
                        >
                        <div class="flex text-[#f2460d] mb-4">
                            <span class="material-symbols-outlined text-sm"
                                >star</span
                            >
                            <span class="material-symbols-outlined text-sm"
                                >star</span
                            >
                            <span class="material-symbols-outlined text-sm"
                                >star</span
                            >
                            <span class="material-symbols-outlined text-sm"
                                >star</span
                            >
                            <span class="material-symbols-outlined text-sm"
                                >star</span
                            >
                        </div>
                        <p class="text-gray-700 text-lg italic mb-6">
                            "Woke up to 2 inches of water in my living room at 3
                            AM. Paramount was here by 4 AM. They saved my
                            hardwood floors and handled the insurance claim
                            entirely. Lifesavers."
                        </p>
                        <div class="flex items-center gap-3">
                            <div
                                class="h-10 w-10 rounded-full bg-gray-200 overflow-hidden"
                            >
                                <img
                                    class="object-cover w-full h-full"
                                    alt="Headshot of Sarah M"
                                    src="/assets/images/restoration/water-damage/testimonial-sarah.webp"
                                />
                            </div>
                            <div>
                                <p class="font-bold text-[#0b1d3f]">Sarah M.</p>
                                <p class="text-xs text-gray-500">Miami, FL</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex gap-4 mt-6 items-center">
                        <p class="text-sm font-bold text-gray-500">
                            Rated 4.9/5 on Google
                        </p>
                        <div class="h-px bg-gray-300 flex-1"></div>
                    </div>
                </div>
                <!-- Map -->
                <div
                    class="h-[400px] w-full rounded-xl overflow-hidden shadow-lg relative bg-gray-200"
                >
                    <!-- Placeholder for Map -->
                    <img
                        class="w-full h-full object-cover opacity-80"
                        alt="Map of Florida service areas"
                        src="/assets/images/restoration/water-damage/florida-map.webp"
                    />
                    <div
                        class="absolute inset-0 flex items-center justify-center pointer-events-none"
                    >
                        <div
                            class="bg-white/90 backdrop-blur px-6 py-4 rounded-lg shadow-xl text-center"
                        >
                            <p class="text-[#0b1d3f] font-bold text-lg">
                                Serving South Florida
                            </p>
                            <p class="text-sm text-gray-600">
                                Miami • Fort Lauderdale • West Palm Beach
                            </p>
                            <a
                                href="/service-areas/"
                                class="mt-3 inline-block bg-[#f2460d] text-white text-xs font-bold px-3 py-1.5 rounded uppercase pointer-events-auto hover:bg-opacity-90"
                                >View Coverage Area</a
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white">
        <div class="max-w-[800px] mx-auto px-4 sm:px-10">
            <h2 class="text-3xl font-bold text-[#0b1d3f] text-center mb-10">
                Frequently Asked Questions
            </h2>
            <div class="flex flex-col gap-4">
                <details class="group bg-gray-50 rounded-lg overflow-hidden">
                    <summary
                        class="flex justify-between items-center font-bold text-lg cursor-pointer p-6 text-[#0b1d3f] select-none"
                    >
                        Will my insurance cover water damage?
                        <span
                            class="material-symbols-outlined transition-transform group-open:rotate-180"
                            >keyboard_arrow_down</span
                        >
                    </summary>
                    <div class="px-6 pb-6 text-gray-600">
                        In most cases, yes. Sudden and accidental discharge of
                        water is typically covered by standard homeowner
