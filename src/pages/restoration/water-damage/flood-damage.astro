---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import { generateServiceSchema } from "../../../utils/schemaGenerator";

const pageTitle = "Emergency Flood Damage Cleanup & Sanitization in Florida";
const pageDescription =
    "Expert team in handling contaminated water (Black Water), sewage backups, and storm surge extraction. Immediate dispatch needed to prevent mold and structural rot. 60-Min On-Site.";

import { generateServiceSchema } from "../../../utils/schemaGenerator";

const schema = generateServiceSchema({
    url: "https://paramountpropertyrestoration.com/restoration/water-damage/flood-damage/",
    image: "https://lh3.googleusercontent.com/aida-public/AB6AXuDHaLZIa91nTxLL-ZAQnE76Mcj8KjG3e_TSLo646Waw9pAMXhUOm0OG9PM6dmq_BGE0YMcJeVCjgMF0HBCai-t4Gk-sis157y1xrFocvT3_gGHLFNAN8QnP-Y0HchF4kEznMELp-CoxfLcMSMh-JfzxHWVdo5j39XGOWRniblBIHpmghcabjWAepvw_A5hTKhwLX8eh4n0KLfjQBVhTHwvN6vJMXiY5QoIY7mbNueR9_RYfvE8ENcdlmq13sOQaMEqI5R4E4djAwuiB",
    description: pageDescription,
    serviceType: "Flood Damage Restoration",
    services: [
        { name: "Biohazard Containment" },
        { name: "Industrial Extraction" },
        { name: "Odor Control" },
    ],
});
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage="https://lh3.googleusercontent.com/aida-public/AB6AXuDHaLZIa91nTxLL-ZAQnE76Mcj8KjG3e_TSLo646Waw9pAMXhUOm0OG9PM6dmq_BGE0YMcJeVCjgMF0HBCai-t4Gk-sis157y1xrFocvT3_gGHLFNAN8QnP-Y0HchF4kEznMELp-CoxfLcMSMh-JfzxHWVdo5j39XGOWRniblBIHpmghcabjWAepvw_A5hTKhwLX8eh4n0KLfjQBVhTHwvN6vJMXiY5QoIY7mbNueR9_RYfvE8ENcdlmq13sOQaMEqI5R4E4djAwuiB"
    themeColor="orange"
    schema={schema}
>
    <!-- Trust Indicators -->
    <div class="bg-[#0e2a47] text-white py-4 border-b border-[#061524]">
        <div
            class="max-w-[1200px] mx-auto px-6 flex flex-wrap justify-center gap-8 lg:gap-16 opacity-80 text-sm font-medium uppercase tracking-widest items-center text-center"
        >
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[#f27f0d]"
                    >verified_user</span
                > Restoration Firm
            </div>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[#f27f0d]"
                    >timer</span
                > 60-Min On-Site
            </div>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[#f27f0d]"
                    >shield</span
                > Professional Service
            </div>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[#f27f0d]"
                    >description</span
                > Direct Insurance Billing
            </div>
        </div>
    </div>

    <!-- Main Content Container -->
    <div class="flex grow flex-col items-center">
        <!-- Why Us Section -->
        <section class="w-full max-w-[1200px] px-6 py-16 lg:py-24">
            <div class="flex flex-col gap-12">
                <div class="flex flex-col gap-4 text-center items-center">
                    <h2
                        class="text-[#0e2a47] font-display text-3xl lg:text-4xl font-bold leading-tight max-w-[800px]"
                    >
                        Why Us for Critical Flood Mitigation?
                    </h2>
                    <p
                        class="text-slate-600 text-base lg:text-lg font-normal leading-normal max-w-[720px]"
                    >
                        Floodwater is not just water—it's often a biohazard. Our
                        certified process ensures contamination removal,
                        industrial extraction, and hospital-grade sanitization.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Feature 1 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-red-100 flex items-center justify-center text-red-600"
                        >
                            <span class="material-symbols-outlined text-[28px]"
                                >biotech</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#0e2a47] text-xl font-bold font-display"
                            >
                                Biohazard Containment
                            </h3>
                            <p class="text-slate-600 text-sm leading-relaxed">
                                Immediate isolation of dangerous "Black Water"
                                and sewage to prevent cross-contamination of
                                clean areas.
                            </p>
                        </div>
                    </div>
                    <!-- Feature 2 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-blue-100 flex items-center justify-center text-[#0e2a47]"
                        >
                            <span class="material-symbols-outlined text-[28px]"
                                >water_pump</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#0e2a47] text-xl font-bold font-display"
                            >
                                Industrial Extraction
                            </h3>
                            <p class="text-slate-600 text-sm leading-relaxed">
                                High-volume truck-mounted pumps remove thousands
                                of gallons per hour to minimize structural
                                saturation.
                            </p>
                        </div>
                    </div>
                    <!-- Feature 3 -->
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div
                            class="size-12 rounded-full bg-orange-100 flex items-center justify-center text-[#f27f0d]"
                        >
                            <span class="material-symbols-outlined text-[28px]"
                                >air_purifier_gen</span
                            >
                        </div>
                        <div class="flex flex-col gap-2">
                            <h3
                                class="text-[#0e2a47] text-xl font-bold font-display"
                            >
                                Odor Control
                            </h3>
                            <p class="text-slate-600 text-sm leading-relaxed">
                                Advanced chemical treatments and hydroxyl
                                generators to neutralize pathogens and eliminate
                                persistent smells.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Step-by-Step Protocol (Timeline) -->
        <section
            class="w-full bg-slate-50 py-16 lg:py-24 border-y border-slate-200"
        >
            <div class="max-w-[960px] mx-auto px-6">
                <div class="mb-12 text-center">
                    <span
                        class="text-[#f27f0d] font-bold tracking-wider uppercase text-sm mb-2 block"
                        >The Protocol</span
                    >
                    <h2 class="text-[#0e2a47] font-display text-3xl font-bold">
                        4-Step Flood Recovery Process
                    </h2>
                </div>
                <div class="grid grid-cols-[50px_1fr] gap-x-6">
                    <!-- Step 1 -->
                    <div class="flex flex-col items-center gap-1 pt-2">
                        <div
                            class="size-10 rounded-full bg-white border-2 border-[#f27f0d] text-[#f27f0d] flex items-center justify-center z-10"
                        >
                            <span class="material-symbols-outlined text-[20px]"
                                >security</span
                            >
                        </div>
                        <div class="w-[2px] bg-slate-200 h-full grow"></div>
                    </div>
                    <div class="flex flex-col pb-10">
                        <h3 class="text-[#0e2a47] text-lg font-bold">
                            Safety & Containment
                        </h3>
                        <p class="text-slate-600 text-base mt-1">
                            We immediately secure the property, shut off
                            electrical hazards, and set up containment barriers
                            to stop the spread of contaminants.
                        </p>
                    </div>
                    <!-- Step 2 -->
                    <div class="flex flex-col items-center gap-1">
                        <div class="w-[2px] bg-slate-200 h-8"></div>
                        <div
                            class="size-10 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center z-10"
                        >
                            <span class="material-symbols-outlined text-[20px]"
                                >cyclone</span
                            >
                        </div>
                        <div class="w-[2px] bg-slate-200 h-full grow"></div>
                    </div>
                    <div class="flex flex-col pb-10">
                        <h3 class="text-[#0e2a47] text-lg font-bold">
                            Rapid Extraction
                        </h3>
                        <p class="text-slate-600 text-base mt-1">
                            Powerful submersible pumps and vacuums remove
                            standing water quickly. We lift carpets and padding
                            to inspect subfloors.
                        </p>
                    </div>
                    <!-- Step 3 -->
                    <div class="flex flex-col items-center gap-1">
                        <div class="w-[2px] bg-slate-200 h-8"></div>
                        <div
                            class="size-10 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center z-10"
                        >
                            <span class="material-symbols-outlined text-[20px]"
                                >cleaning_services</span
                            >
                        </div>
                        <div class="w-[2px] bg-slate-200 h-full grow"></div>
                    </div>
                    <div class="flex flex-col pb-10">
                        <h3 class="text-[#0e2a47] text-lg font-bold">
                            Chemical Sanitization
                        </h3>
                        <p class="text-slate-600 text-base mt-1">
                            We apply EPA-registered disinfectants to all
                            affected surfaces to kill bacteria, viruses, and
                            mold spores brought in by floodwater.
                        </p>
                    </div>
                    <!-- Step 4 -->
                    <div class="flex flex-col items-center gap-1 pb-2">
                        <div class="w-[2px] bg-slate-200 h-8"></div>
                        <div
                            class="size-10 rounded-full bg-white border-2 border-slate-300 text-slate-500 flex items-center justify-center z-10"
                        >
                            <span class="material-symbols-outlined text-[20px]"
                                >mode_fan</span
                            >
                        </div>
                    </div>
                    <div class="flex flex-col pb-0">
                        <h3 class="text-[#0e2a47] text-lg font-bold">
                            Structural Drying
                        </h3>
                        <p class="text-slate-600 text-base mt-1">
                            Industrial air movers and dehumidifiers run for days
                            to pull remaining moisture from drywall, wood, and
                            concrete.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Specific Scenarios Cards -->
        <section class="w-full max-w-[1200px] px-6 py-16 lg:py-24">
            <h2
                class="text-[#0e2a47] font-display text-3xl font-bold text-center mb-10"
            >
                Specific Flood Scenarios We Handle
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Scenario 1 -->
                <div
                    class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-all hover:shadow-lg hover:border-[#f27f0d]/30"
                >
                    <div
                        class="h-48 w-full bg-slate-200 bg-cover bg-center"
                        data-alt="Dark stormy ocean waves indicating storm surge threat"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDBrM_1IZf1_PLE-mz64fptOMxgZR3PY-HRCkWjAwHbgucaKRqp6KhkNRZo3Q3d2T6nhEQQUtJVNYtPn-aR1vfjjwSoe03cqKic_I1iQe_kmW0LkLrp0_PzuQSuKxiv76yfT9k8hDyEPd9N90ZK_R5VBemyBKjzgE43k1vU2yiKyVhiDnm1m8nnjRKDP7T-v6u-FgwAKiZXuNvrFgWAlJXgHhHKQUKR5494ObkRdEwXWHhDLg6hNym9n7aYLNgHvLuG3zusWLswtTDx");'
                    >
                    </div>
                    <div class="p-6 flex flex-col gap-3 flex-1">
                        <div
                            class="flex items-center gap-2 text-[#f27f0d] font-bold"
                        >
                            <span class="material-symbols-outlined"
                                >tsunami</span
                            >
                            <span class="text-sm uppercase tracking-wide"
                                >Category 3 Clean</span
                            >
                        </div>
                        <h3
                            class="text-[#0e2a47] text-xl font-bold font-display"
                        >
                            Storm Surge & Flooding
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Saltwater corrosion mitigation and massive water
                            displacement for coastal properties.
                        </p>
                    </div>
                </div>
                <!-- Scenario 2 -->
                <div
                    class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-all hover:shadow-lg hover:border-[#f27f0d]/30"
                >
                    <div
                        class="h-48 w-full bg-slate-200 bg-cover bg-center"
                        data-alt="Plumbing pipes and dark water indicating sewage issues"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuCcaTpXe3i1BaGWB6eqXCuE-JwuCI_PJhFfF3fOV6707mwHJzxnjhwMKdNsizaokxMGtn6Y_pkHe4EHaMK0KUqDCJD8mX16DfKJVQX6xgqW97TLcZNl7eyiGmRAZJ_x8glL6KdKvvIG9kuuORG-2ZDBQNKv5MCuT9UvxEpOwmnscRDUPgux6y3ONCgCNkoa98hJPZ0NVsYWZA_33_FY-5Cn_QNqB4vS4jXOiBy-UPRKoGKfq9xxWqyN3doZRx-Z24lE-GQ_KDSL-yF_");'
                    >
                    </div>
                    <div class="p-6 flex flex-col gap-3 flex-1">
                        <div
                            class="flex items-center gap-2 text-red-600 font-bold"
                        >
                            <span class="material-symbols-outlined"
                                >plumbing</span
                            >
                            <span class="text-sm uppercase tracking-wide"
                                >Category 3 Hazard</span
                            >
                        </div>
                        <h3
                            class="text-[#0e2a47] text-xl font-bold font-display"
                        >
                            Sewage Backups
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Dangerous black water cleanup requiring full PPE and
                            specialized disposal protocols.
                        </p>
                    </div>
                </div>
                <!-- Scenario 3 -->
                <div
                    class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-all hover:shadow-lg hover:border-[#f27f0d]/30"
                >
                    <div
                        class="h-48 w-full bg-slate-200 bg-cover bg-center"
                        data-alt="Flooded basement with concrete walls and water on floor"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBQdgwdIaLwwrgTprY_rFZkmTAOPioI4mBWWkGtcG1vxv6MAyMdj6oLQXkyLbLr8fzeAsst5ltURl2-HANOOmdlsG36yy1lIFcnRYJa-QEXYEXrK2BTW-8fQhLmWE1no4C6TVNhlBVaQz8W6c7Trz9jCnI9Xh14gCkgPrZs9jKcmPuCyw0xgVVIpw6S7BnjuDO-poZGzfNZUJCIHD3SQX6cy8yGUpjfIlYaGmyFwoMTLqHAxCQrN0GnO8i3oRK8fQa68CcJaEz4tsQB");'
                    >
                    </div>
                    <div class="p-6 flex flex-col gap-3 flex-1">
                        <div
                            class="flex items-center gap-2 text-orange-600 font-bold"
                        >
                            <span class="material-symbols-outlined"
                                >foundation</span
                            >
                            <span class="text-sm uppercase tracking-wide"
                                >Structural Risk</span
                            >
                        </div>
                        <h3
                            class="text-[#0e2a47] text-xl font-bold font-display"
                        >
                            Basement Flooding
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Extraction from sub-grade levels and sump pump
                            failure remediation.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Insurance & Documentation -->
        <section class="w-full bg-[#0e2a47] text-white py-16">
            <div
                class="max-w-[1200px] mx-auto px-6 flex flex-col lg:flex-row gap-12 items-center"
            >
                <div class="flex-1 flex flex-col gap-6">
                    <h2 class="text-white font-display text-3xl font-bold">
                        Insurance & Documentation
                    </h2>
                    <p class="text-slate-200 text-lg leading-relaxed">
                        Flood damage claims are different from standard water
                        damage. We understand the specific requirements of flood
                        policies (NFIP) versus private homeowner policies.
                    </p>
                    <ul class="flex flex-col gap-3 text-slate-200">
                        <li class="flex items-center gap-3">
                            <span
                                class="material-symbols-outlined text-[#f27f0d]"
                                >check_circle</span
                            >
                            <span
                                >Detailed photographic documentation of all
                                damage.</span
                            >
                        </li>
                        <li class="flex items-center gap-3">
                            <span
                                class="material-symbols-outlined text-[#f27f0d]"
                                >check_circle</span
                            >
                            <span
                                >Moisture mapping logs to prove extent of
                                saturation.</span
                            >
                        </li>
                        <li class="flex items-center gap-3">
                            <span
                                class="material-symbols-outlined text-[#f27f0d]"
                                >check_circle</span
                            >
                            <span
                                >Direct billing to your insurance carrier.</span
                            >
                        </li>
                    </ul>
                </div>
                <div class="flex-1 w-full lg:max-w-[500px]">
                    <div
                        class="rounded-xl bg-white p-6 text-[#0e2a47] shadow-2xl"
                    >
                        <div class="flex items-start gap-4">
                            <div class="p-3 bg-[#0e2a47]/10 rounded-lg">
                                <span class="material-symbols-outlined text-3xl"
                                    >contact_support</span
                                >
                            </div>
                            <div class="flex flex-col gap-2">
                                <h4 class="font-bold text-lg">
                                    Confused by your coverage?
                                </h4>
                                <p class="text-sm text-slate-600">
                                    We assign a dedicated project manager to
                                    handle the paperwork so you can focus on
                                    your family.
                                </p>
                                <a
                                    href="/contact/"
                                    class="mt-2 text-[#f27f0d] font-bold text-sm flex items-center gap-1 hover:underline"
                                >
                                    Speak to an Insurance Specialist <span
                                        class="material-symbols-outlined text-sm"
                                        >arrow_forward</span
                                    >
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="w-full max-w-[960px] px-6 py-16 mx-auto">
            <h2
                class="text-[#0e2a47] font-display text-3xl font-bold text-center mb-10"
            >
                Flood Cleanup FAQ
            </h2>
            <div class="flex flex-col gap-4">
                <div class="rounded-lg border border-slate-200 p-5 bg-white">
                    <h3
                        class="text-lg font-bold text-[#0e2a47] flex items-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[#f27f0d]"
                            >help</span
                        >
                        Can my carpet be saved after a flood?
                    </h3>
                    <p class="mt-3 text-slate-600">
                        In most cases involving rising floodwater (storm surge,
                        river flooding), carpets and padding cannot be saved.
                        The water is considered Category 3 (contaminated) and
                        porous materials cannot be fully sanitized. We recommend
                        removal to ensure health safety.
                    </p>
                </div>
                <div class="rounded-lg border border-slate-200 p-5 bg-white">
                    <h3
                        class="text-lg font-bold text-[#0e2a47] flex items-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[#f27f0d]"
                            >help</span
                        >
                        How much does extraction cost?
                    </h3>
                    <p class="mt-3 text-slate-600">
                        Costs vary based on the square footage and depth of
                        water. We provide transparent pricing using
                        industry-standard software (Xactimate) that insurance
                        companies recognize, ensuring fair pricing for every
                        line item.
                    </p>
                </div>
                <div class="rounded-lg border border-slate-200 p-5 bg-white">
                    <h3
                        class="text-lg font-bold text-[#0e2a47] flex items-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[#f27f0d]"
                            >help</span
                        >
                        Is mold inevitable after a flood?
                    </h3>
                    <p class="mt-3 text-slate-600">
                        Not if you act fast. Mold begins to grow within 24-48
                        hours. Our rapid structural drying process is designed
                        specifically to beat this clock and prevent mold
                        colonization.
                    </p>
                </div>
            </div>
        </section>
    </div>
</ServiceLayout>
