---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";

const pageTitle =
    "Emergency Ceiling Leak Repair & Restoration | 60-Min Response";
const pageDescription =
    "Don't wait for partial collapse. We identify the source, stop the leak, and restore your property structurally and aesthetically. Call now.";

const schema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Ceiling Leak Repair",
    provider: {
        "@type": "GeneralContractor",
        name: "Paramount Property Restoration",
    },
};
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage="https://lh3.googleusercontent.com/aida-public/AB6AXuBIpYp3k0vjBnJYCkmaPOi2cfpdGCY7tPxPNfThqf5e3_RbyuYqqGFuHy6f-EKkdJMTfgK4B0FDyCgg2__3eotVObq57x3FS1esjX8o24Xf1FdfQdJ7LjOnFESRsV219PLISMm5ALanZANweUffVuKpNHuZO_D90BDS3-XjGXl0fQ98FPjsUnC9H1EhFvbFEozcsjQRB4neY2T_D3BVxzeFN57uvNUg_AhZH5j4Wf0r_OTKaYBVqjfi5fcjEDfveUIrlGKFFiOxkEea"
    themeColor="blue"
    schema={schema}
>
    <!-- Symptom Checker Bento Grid -->
    <section class="bg-[#f6f6f8] py-16 dark:bg-[#101622]">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="mb-10 max-w-2xl">
                <h2
                    class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl"
                >
                    Identify Your Ceiling Damage
                </h2>
                <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
                    Compare your damage to these common symptoms. Visual
                    identification helps us prepare the right equipment before
                    we arrive.
                </p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <!-- Card 1 -->
                <div
                    class="group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-800"
                >
                    <div
                        class="aspect-square w-full overflow-hidden bg-slate-200"
                    >
                        <div
                            class="h-full w-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
                            data-alt="Ceiling with large brown concentric water rings"
                            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAh-sU0EXW-gjLBjcLOd0RVJt82CIJfg14c5UiQ4AfyrTduS3BxpN9oH1rsx1nt1f6-5QA_S1egKVQVfMPXOO9aYwOp87-sVQbNMvubi56q4boI-dkxmKeGfNKKQYNNMiSduzA3MaJbSVP4c8WJCJc0EeYSST-8fhYCDN7tHacf3db-ngJQzccvmRjy86Wn7AzddTwJbJ5Ets6qtKiMzWd3Qh-TgWbYepe81N2RhbwV7YTSWy9wwh2IfDYdEb7C-KDmBmFc-6IT2XJN');"
                        >
                        </div>
                    </div>
                    <div class="flex flex-1 flex-col p-5">
                        <div class="mb-2 flex items-center gap-2">
                            <span
                                class="material-symbols-outlined text-orange-500"
                                >water_drop</span
                            >
                            <h3
                                class="font-bold text-slate-900 dark:text-white"
                            >
                                Brown Rings
                            </h3>
                        </div>
                        <p
                            class="text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                        >
                            Indicates an old or slow leak soaking through
                            drywall layers. The stain is often larger than the
                            visible spot.
                        </p>
                    </div>
                </div>
                <!-- Card 2 -->
                <div
                    class="group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-800"
                >
                    <div
                        class="aspect-square w-full overflow-hidden bg-slate-200"
                    >
                        <div
                            class="h-full w-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
                            data-alt="Drywall ceiling sagging downwards from water weight"
                            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC8Pae11UAFN9VsNECCxpuLIMJyQiV6aV9X38Af9vsNT-fTWFxfxhIE9ILrScsW4TGeE2nql_2Rzc9wLFQyMc5csqrof-m315nh1NHX543j6mKOejAXTXXxcHQdY0L2KW7jcwff0s31yQC_EdbL8Ye1T30VYupL8k8-kRv7k0V7-1hRN4r-o3Hx-BMwvUUGsxoyY_59-9XJtlbVpFtnmO3QtPxk9FM5GbJy51lVuItdTOL_R6CbdNCFtEOu6Xt6J7VTjvRWgXiKlhII');"
                        >
                        </div>
                    </div>
                    <div class="flex flex-1 flex-col p-5">
                        <div class="mb-2 flex items-center gap-2">
                            <span class="material-symbols-outlined text-red-600"
                                >warning</span
                            >
                            <h3
                                class="font-bold text-slate-900 dark:text-white"
                            >
                                Sagging Drywall
                            </h3>
                        </div>
                        <p
                            class="text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                        >
                            <strong>Urgent:</strong> Water is pooling above. The weight
                            load creates a severe risk of ceiling collapse.
                        </p>
                    </div>
                </div>
                <!-- Card 3 -->
                <div
                    class="group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-800"
                >
                    <div
                        class="aspect-square w-full overflow-hidden bg-slate-200"
                    >
                        <div
                            class="h-full w-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
                            data-alt="Paint bubbling and peeling off a wall surface"
                            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCJPQliCtARqn_JW6VznGWj241WM6FtCjRAhegkjVZPCfvzl8YpKaYNuGGeWauLQjri6ZVq4Oy6jX9RAu8hBBD7i9AHiIgPGEvuNZc74L1GMqwjiGasuAB7QI3bTHpdntHreMLG_FwCyitcrGF4MZ7wtWlmwMmUPCSis0gSCGMVTC4d6boh14ULw-LGiZZ7AUDLyBj2n-Affpj9a_GSZmC0KA7Wg3i5xmkeaQyuO2f4qgiy249I_17vLO1kqIi8Np8wim3oq70H209C');"
                        >
                        </div>
                    </div>
                    <div class="flex flex-1 flex-col p-5">
                        <div class="mb-2 flex items-center gap-2">
                            <span
                                class="material-symbols-outlined text-orange-500"
                                >bubble_chart</span
                            >
                            <h3
                                class="font-bold text-slate-900 dark:text-white"
                            >
                                Bubbling Paint
                            </h3>
                        </div>
                        <p
                            class="text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                        >
                            Trapped moisture behind latex paint layers. "Water
                            blisters" should be drained professionally.
                        </p>
                    </div>
                </div>
                <!-- Card 4 -->
                <div
                    class="group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:bg-slate-800"
                >
                    <div
                        class="aspect-square w-full overflow-hidden bg-slate-200"
                    >
                        <div
                            class="h-full w-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
                            data-alt="Dark mold spots growing in the corner of a ceiling"
                            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDMWhWrRwaUPS29nVHadUrkRL4jVwKVi0jeOaMM4OIGJR26gSq1InuBsya5bW--PvtrVPm35T1lcy4IwpJzzfbpKeA1iZtwppfHS9w7QzD87XLEGBxyD03Cs0Ifc3lIp7eQXAid3HTNG24Bx1XTb2JLztbipnBx_l_QWRaHwdWKO8kSIDwT5Q03TCDtT52tORS3r_5hGHzoAgmvxFv6PjNUchvt5APxV8GoT8_kEG8cig8j2Lv3W0QGNgMSv4FtYIavLrPWPcBDQvPI');"
                        >
                        </div>
                    </div>
                    <div class="flex flex-1 flex-col p-5">
                        <div class="mb-2 flex items-center gap-2">
                            <span
                                class="material-symbols-outlined text-purple-500"
                                >coronavirus</span
                            >
                            <h3
                                class="font-bold text-slate-900 dark:text-white"
                            >
                                Mold Corners
                            </h3>
                        </div>
                        <p
                            class="text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                        >
                            Signifies long-standing moisture issues. Requires
                            safe remediation to prevent spore spread.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Technical Process Section -->
    <section class="bg-white py-16 dark:bg-slate-900">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="mb-12 text-center">
                <span
                    class="text-sm font-bold uppercase tracking-wider text-[#135bec] dark:text-[#135bec]"
                    >Our Process</span
                >
                <h2
                    class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl"
                >
                    We Fix the Source, Not Just the Stain
                </h2>
            </div>
            <div class="grid gap-8 md:grid-cols-4">
                <!-- Step 1 -->
                <div class="relative flex flex-col items-center text-center">
                    <div
                        class="mb-4 flex size-16 items-center justify-center rounded-full bg-blue-50 text-3xl font-bold text-[#135bec] dark:bg-blue-900/20 dark:text-blue-400"
                    >
                        1
                    </div>
                    <h3
                        class="mb-2 text-xl font-bold text-slate-900 dark:text-white"
                    >
                        Source ID
                    </h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        We use thermal imaging cameras to locate the exact
                        source of the leak without unnecessary demolition.
                    </p>
                    <!-- Connector Line -->
                    <div
                        class="hidden md:block absolute top-8 left-[60%] w-[80%] border-t-2 border-dashed border-slate-200 dark:border-slate-700"
                    >
                    </div>
                </div>
                <!-- Step 2 -->
                <div class="relative flex flex-col items-center text-center">
                    <div
                        class="mb-4 flex size-16 items-center justify-center rounded-full bg-blue-50 text-3xl font-bold text-[#135bec] dark:bg-blue-900/20 dark:text-blue-400"
                    >
                        2
                    </div>
                    <h3
                        class="mb-2 text-xl font-bold text-slate-900 dark:text-white"
                    >
                        Containment
                    </h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        We set up barriers to prevent water or mold from
                        spreading to unaffected areas of your home.
                    </p>
                    <!-- Connector Line -->
                    <div
                        class="hidden md:block absolute top-8 left-[60%] w-[80%] border-t-2 border-dashed border-slate-200 dark:border-slate-700"
                    >
                    </div>
                </div>
                <!-- Step 3 -->
                <div class="relative flex flex-col items-center text-center">
                    <div
                        class="mb-4 flex size-16 items-center justify-center rounded-full bg-blue-50 text-3xl font-bold text-[#135bec] dark:bg-blue-900/20 dark:text-blue-400"
                    >
                        3
                    </div>
                    <h3
                        class="mb-2 text-xl font-bold text-slate-900 dark:text-white"
                    >
                        Structural Drying
                    </h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        Industrial-grade dehumidifiers and air movers remove
                        moisture from inside the ceiling cavity.
                    </p>
                    <!-- Connector Line -->
                    <div
                        class="hidden md:block absolute top-8 left-[60%] w-[80%] border-t-2 border-dashed border-slate-200 dark:border-slate-700"
                    >
                    </div>
                </div>
                <!-- Step 4 -->
                <div class="relative flex flex-col items-center text-center">
                    <div
                        class="mb-4 flex size-16 items-center justify-center rounded-full bg-blue-50 text-3xl font-bold text-[#135bec] dark:bg-blue-900/20 dark:text-blue-400"
                    >
                        4
                    </div>
                    <h3
                        class="mb-2 text-xl font-bold text-slate-900 dark:text-white"
                    >
                        Reconstruction
                    </h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        We repair the drywall, texture, and paint, leaving your
                        ceiling looking brand new.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Local Context Section (Florida Causes) -->
    <section class="bg-blue-50 py-16 dark:bg-slate-800/50">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div
                class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end"
            >
                <div>
                    <h2
                        class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
                    >
                        Common Florida Causes
                    </h2>
                    <p class="mt-2 text-slate-600 dark:text-slate-400">
                        Understanding why this happens helps prevent future
                        damage.
                    </p>
                </div>
                <a
                    href="/resources/"
                    class="flex items-center gap-2 font-bold text-[#135bec] hover:text-blue-700 dark:text-blue-400"
                >
                    View Maintenance Tips <span
                        class="material-symbols-outlined">arrow_forward</span
                    >
                </a>
            </div>
            <div class="grid gap-6 md:grid-cols-3">
                <div
                    class="flex gap-4 rounded-lg bg-white p-6 shadow-sm dark:bg-slate-900"
                >
                    <div
                        class="shrink-0 rounded bg-blue-100 p-2 text-[#135bec] dark:bg-blue-900/30 dark:text-blue-400 h-fit"
                    >
                        <span class="material-symbols-outlined">ac_unit</span>
                    </div>
                    <div>
                        <h3
                            class="mb-1 text-lg font-bold text-slate-900 dark:text-white"
                        >
                            HVAC Condensation
                        </h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">
                            In humid climates, clogged condensate lines often
                            overflow into attic pans and leak through ceilings.
                        </p>
                    </div>
                </div>
                <div
                    class="flex gap-4 rounded-lg bg-white p-6 shadow-sm dark:bg-slate-900"
                >
                    <div
                        class="shrink-0 rounded bg-blue-100 p-2 text-[#135bec] dark:bg-blue-900/30 dark:text-blue-400 h-fit"
                    >
                        <span class="material-symbols-outlined"
                            >thunderstorm</span
                        >
                    </div>
                    <div>
                        <h3
                            class="mb-1 text-lg font-bold text-slate-900 dark:text-white"
                        >
                            Storm Damage
                        </h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">
                            Roof tiles displaced by high winds allow rainwater
                            to penetrate the underlayment and soak insulation.
                        </p>
                    </div>
                </div>
                <div
                    class="flex gap-4 rounded-lg bg-white p-6 shadow-sm dark:bg-slate-900"
                >
                    <div
                        class="shrink-0 rounded bg-blue-100 p-2 text-[#135bec] dark:bg-blue-900/30 dark:text-blue-400 h-fit"
                    >
                        <span class="material-symbols-outlined">plumbing</span>
                    </div>
                    <div>
                        <h3
                            class="mb-1 text-lg font-bold text-slate-900 dark:text-white"
                        >
                            Upstairs Plumbing
                        </h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">
                            Leaks from bathtubs, toilets, or supply lines on the
                            second floor often manifest as ceiling stains below.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-white py-16 dark:bg-[#101622]">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
            <h2
                class="mb-8 text-center text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
            >
                Frequently Asked Questions
            </h2>
            <div class="space-y-4">
                <!-- FAQ 1 -->
                <details
                    class="group rounded-lg border border-slate-200 bg-slate-50 p-4 [&_summary::-webkit-details-marker]:hidden dark:border-slate-800 dark:bg-slate-900"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between text-slate-900 dark:text-white"
                    >
                        <h3 class="font-bold">
                            Should I pop the water blister in my paint?
                        </h3>
                        <span
                            class="material-symbols-outlined transition duration-300 group-open:-rotate-180"
                            >expand_more</span
                        >
                    </summary>
                    <div class="mt-4 text-slate-600 dark:text-slate-400">
                        <p>
                            <strong>Yes, but act carefully.</strong> Have a bucket
                            ready underneath. Puncturing the blister relieves the
                            weight and prevents the drywall from collapsing. However,
                            this is a temporary fix—you must address the source of
                            the water immediately.
                        </p>
                    </div>
                </details>
                <!-- FAQ 2 -->
                <details
                    class="group rounded-lg border border-slate-200 bg-slate-50 p-4 [&_summary::-webkit-details-marker]:hidden dark:border-slate-800 dark:bg-slate-900"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between text-slate-900 dark:text-white"
                    >
                        <h3 class="font-bold">
                            Does homeowners insurance cover ceiling leaks?
                        </h3>
                        <span
                            class="material-symbols-outlined transition duration-300 group-open:-rotate-180"
                            >expand_more</span
                        >
                    </summary>
                    <div class="mt-4 text-slate-600 dark:text-slate-400">
                        <p>
                            Typically, yes. If the damage is "sudden and
                            accidental" (like a burst pipe), most policies cover
                            the restoration. Slow leaks caused by lack of
                            maintenance might not be covered. We can help you
                            navigate the claim process.
                        </p>
                    </div>
                </details>
                <!-- FAQ 3 -->
                <details
                    class="group rounded-lg border border-slate-200 bg-slate-50 p-4 [&_summary::-webkit-details-marker]:hidden dark:border-slate-800 dark:bg-slate-900"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between text-slate-900 dark:text-white"
                    >
                        <h3 class="font-bold">
                            How long does the drying process take?
                        </h3>
                        <span
                            class="material-symbols-outlined transition duration-300 group-open:-rotate-180"
                            >expand_more</span
                        >
                    </summary>
                    <div class="mt-4 text-slate-600 dark:text-slate-400">
                        <p>
                            Depending on the extent of the saturation,
                            structural drying usually takes 3 to 5 days. We
                            monitor moisture levels daily to ensure the area is
                            completely dry before starting reconstruction.
                        </p>
                    </div>
                </details>
            </div>
        </div>
    </section>
</ServiceLayout>
