---
import { getEntry } from "astro:content";
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import FeatureGrid from "../../../components/service/FeatureGrid.astro";
import ProcessTimeline from "../../../components/service/ProcessTimeline.astro";
import FAQAccordion from "../../../components/ui/FAQAccordion";
import {
    FaBiohazard,
    FaHeadSideMask,
    FaLayerGroup,
    FaSmog,
    FaShieldAlt,
    FaTrashAlt,
    FaPumpSoap,
    FaWind,
    FaVial,
} from "react-icons/fa";

import { generateServiceSchema } from "../../../utils/schemaGenerator";
import sewageHeroImg from "../../../assets/images/restoration/water-damage/sewage-hero.webp";
import bacteriaImg from "../../../assets/images/restoration/water-damage/bacteria-microscope.webp";

// Fetch content
const entry = await getEntry("services", "sewage-cleanup");
if (!entry) {
    throw new Error("Service page content not found");
}
const { Content } = await entry.render();
const {
    title,

    pageTitle,
    pageDescription,
    features,
    processSteps,
    faqs,
    insuranceTitle,
    insuranceText,
    protocolTitle,
    protocolDescription,
} = entry.data;

// Icon map
const iconMap: Record<string, any> = {
    FaBiohazard,
    FaHeadSideMask,
    FaLayerGroup,
    FaSmog,
    FaShieldAlt,
    FaTrashAlt,
    FaPumpSoap,
    FaWind,
    FaVial,
};

// Map features
const mappedFeatures = features.map((f) => ({
    ...f,
    icon: iconMap[f.icon] || FaBiohazard,
}));

const mappedSteps = processSteps.map((s) => ({
    ...s,
    icon: iconMap[s.icon] || FaShieldAlt,
}));

const schema = generateServiceSchema({
    url: "https://paramountpropertyrestoration.com/restoration/water-damage/sewage-cleanup/",
    image: sewageHeroImg.src,
    description: pageDescription,
    services: [
        { name: "Sewage Cleanup" },
        { name: "Biohazard Remediation" },
        { name: "Odor Removal" },
    ],
});
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage={sewageHeroImg}
    themeColor="red"
    schema={schema}
>
    <!-- Hidden Dangers Bento Grid -->
    <FeatureGrid title={title} features={mappedFeatures}>
        <div
            slot="extra-card"
            class="md:col-span-2 lg:col-span-2 relative overflow-hidden rounded-xl border border-gray-200 group h-full min-h-[200px]"
        >
            <div
                class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                data-alt="Microscopic view of bacteria and pathogens"
                style={`background-image: url('${bacteriaImg.src}');`}
            >
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"
            >
            </div>
            <div class="absolute bottom-0 left-0 p-6 text-white">
                <h3
                    class="text-xl font-bold mb-2 flex items-center gap-2 font-display"
                >
                    <span class="material-symbols-outlined text-[#f59e0b]"
                        >warning</span
                    >
                    Secondary Mold Growth
                </h3>
                <p class="font-body text-sm opacity-90 max-w-lg">
                    Without immediate drying and sanitization, toxic mold
                    colonies can begin to form within 24-48 hours of initial
                    exposure.
                </p>
            </div>
        </div>
    </FeatureGrid>

    <!-- Scenarios & Insurance Section (Content from MDX + Insurance Card) -->
    <section class="py-16 bg-gray-50 border-t border-gray-200">
        <div class="max-w-[1200px] mx-auto px-4 lg:px-8">
            <div class="flex flex-col lg:flex-row gap-12">
                <!-- Left: Content from MDX (Accordion) -->
                <div class="flex-1">
                    <Content />
                </div>
                <!-- Right: Insurance Info Card -->
                <div class="flex-1">
                    <div
                        class="bg-[#135bec] text-white rounded-xl p-8 h-full relative overflow-hidden"
                    >
                        <div class="absolute top-0 right-0 p-8 opacity-10">
                            <span class="material-symbols-outlined text-9xl"
                                >policy</span
                            >
                        </div>
                        <div class="relative z-10">
                            <h3 class="text-2xl font-bold mb-4 font-display">
                                {insuranceTitle}
                            </h3>
                            <p
                                class="font-body mb-6 text-blue-100 leading-relaxed"
                            >
                                {insuranceText}
                            </p>
                            <div class="space-y-4 mb-8">
                                <div class="flex items-start gap-3">
                                    <span
                                        class="material-symbols-outlined text-[#ff6b00] shrink-0"
                                        >check_circle</span
                                    >
                                    <p class="text-sm">
                                        We work directly with all major
                                        insurance carriers.
                                    </p>
                                </div>
                                <div class="flex items-start gap-3">
                                    <span
                                        class="material-symbols-outlined text-[#ff6b00] shrink-0"
                                        >check_circle</span
                                    >
                                    <p class="text-sm">
                                        Our team documents all damage for your
                                        claim.
                                    </p>
                                </div>
                                <div class="flex items-start gap-3">
                                    <span
                                        class="material-symbols-outlined text-[#ff6b00] shrink-0"
                                        >check_circle</span
                                    >
                                    <p class="text-sm">
                                        We can help verify your coverage
                                        immediately.
                                    </p>
                                </div>
                            </div>
                            <a
                                href="/contact/"
                                class="w-full bg-white text-[#135bec] font-bold py-3 px-6 rounded-lg hover:bg-gray-100 transition-colors inline-block text-center"
                            >
                                Verify My Coverage
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section class="py-16 lg:py-24 bg-white">
        <div class="max-w-[1200px] mx-auto px-4 lg:px-8">
            <div class="text-center max-w-[800px] mx-auto mb-16">
                <span
                    class="text-[#135bec] font-bold tracking-widest uppercase text-sm mb-2 block"
                    >Industry Standard Procedures</span
                >
                <h2
                    class="text-[#111318] text-3xl md:text-4xl font-bold leading-tight mb-4 font-display"
                >
                    {protocolTitle}
                </h2>
                <p class="text-[#616f89] text-lg font-body">
                    {protocolDescription}
                </p>
            </div>
            <ProcessTimeline steps={mappedSteps} theme="light" />
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-slate-900 text-center mb-10">
                Critical Safety FAQ
            </h2>
            <div class="space-y-4">
                <FAQAccordion items={faqs} client:visible />
            </div>
        </div>
    </section>
</ServiceLayout>
