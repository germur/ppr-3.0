---
import { getEntry } from "astro:content";
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import FeatureGrid from "../../../components/service/FeatureGrid.astro";
import ProcessTimeline from "../../../components/service/ProcessTimeline.astro";
import FAQAccordion from "../../../components/ui/FAQAccordion";
import {
  FaWater,
  FaHouseDamage,
  FaBiohazard,
  FaPhoneAlt,
  FaTools,
  FaWind,
} from "react-icons/fa";

import { generateServiceSchema } from "../../../utils/schemaGenerator";
import waterDamageHero from "../../../assets/images/water-damage.webp";

// Fetch content
const entry = await getEntry("services", "water-damage");
if (!entry) {
  throw new Error("Service page content not found");
}
const { Content } = await entry.render();
const {
  title,
  description,
  pageTitle,
  pageDescription,
  features,
  processSteps,
  faqs,
  heroImage: heroImageKey,
} = entry.data;

// Image map (expandable)
const imageMap: Record<string, ImageMetadata> = {
  "water-damage": waterDamageHero,
};

imageMap[heroImageKey || "water-damage"] || waterDamageHero;

// Icon map
const iconMap: Record<string, any> = {
  FaWater,
  FaHouseDamage,
  FaBiohazard,
  FaPhoneAlt,
  FaTools,
  FaWind,
};

// Map features with actual icons
const mappedFeatures = features.map((f) => ({
  ...f,
  icon: iconMap[f.icon] || FaTools,
}));

const mappedSteps = processSteps.map((s) => ({
  ...s,
  icon: iconMap[s.icon] || FaTools,
}));

// Schema
const schema = generateServiceSchema({
  url: "https://paramountpropertyrestoration.com/restoration/water-damage/",
  image: "https://paramountpropertyrestoration.com/images/water-damage.webp",
  description: pageDescription,
  services: [
    { name: "Structural Drying" },
    { name: "Leak Repairs" },
    { name: "Emergency Water Extraction" },
  ],
});
---

<ServiceLayout
  title={pageTitle}
  description={pageDescription}
  schema={schema}
  heroImage={waterDamageHero}
  themeColor="blue"
>
  <section class="py-16 bg-white border-b">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900">
          {title}
        </h2>
        <p class="text-lg text-slate-600 mt-2 max-w-2xl mx-auto">
          {description}
        </p>
      </div>
      <FeatureGrid title={title} features={mappedFeatures} />
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">
          Why "60 Minutes or Less" Matters
        </h2>
        <div class="prose prose-lg text-slate-700 mx-auto text-left">
          <Content />
        </div>
      </div>

      <!-- Process Section -->
      <div class="border-t border-slate-200 pt-16">
        <div class="text-center mb-16">
          <span class="text-blue-600 font-bold tracking-wider uppercase text-sm"
            >Our Protocol</span
          >
          <h2 class="text-4xl font-bold text-slate-900 mt-2">
            The Restoration Process
          </h2>
          <p class="text-slate-500 mt-4 max-w-2xl mx-auto">
            Transparent, step-by-step recovery process to ensure your property
            is restored to pre-loss condition.
          </p>
        </div>
        <ProcessTimeline steps={mappedSteps} />
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900">Common Questions</h2>
      </div>
      <FAQAccordion client:visible items={faqs} />
    </div>
  </section>

  <!-- City-Service Internal Links -->
