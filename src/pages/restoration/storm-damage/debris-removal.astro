---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import { generateServiceSchema } from "../../../utils/schemaGenerator";
import debrisHero from "../../../assets/images/restoration/storm-damage/debris-removal-hero.webp";

const pageTitle = "Storm Debris Removal Help When You Need It Most";
const pageDescription =
    "We deploy heavy machinery immediately to clear hazards and restore access to your property. Professional, experienced, and ready to mobilize to get your life back to normal. 24/7.";

const schema = generateServiceSchema({
    url: "https://paramountpropertyrestoration.com/restoration/storm-damage/debris-removal/",
    image: debrisHero.src,
    description: pageDescription,
    serviceType: "Debris Removal",
    services: [
        { name: "Vegetative Hazard Removal" },
        { name: "Construction Debris Cleanup" },
        { name: "Hazardous Item Disposal" },
    ],
});
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage={debrisHero}
    themeColor="orange"
    schema={schema}
>
    <!-- Bento Grid: What We Clear -->
    <section class="py-16 md:py-24 bg-white dark:bg-[#1a2632]">
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[1280px]">
            <div
                class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4"
            >
                <div class="max-w-2xl">
                    <h2
                        class="text-[#111418] dark:text-white text-3xl font-bold leading-tight tracking-[-0.015em] mb-3"
                    >
                        What We Clear: Debris Categories
                    </h2>
                    <p class="text-[#60758a] dark:text-gray-400">
                        Our teams are equipped to handle all types of storm
                        aftermath, separating hazardous materials from general
                        debris for safe disposal.
                    </p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card 1: Vegetative (Large feature) -->
                <div
                    class="lg:col-span-2 group relative overflow-hidden rounded-xl bg-[#f5f7f8] dark:bg-[#232e3a] shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow"
                >
                    <div class="flex flex-col md:flex-row h-full">
                        <div
                            class="p-6 md:p-8 flex flex-col justify-between flex-1 gap-6"
                        >
                            <div>
                                <div
                                    class="size-12 rounded-lg bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 flex items-center justify-center mb-4"
                                >
                                    <span class="material-symbols-outlined"
                                        >forest</span
                                    >
                                </div>
                                <h3
                                    class="text-xl font-bold text-[#111418] dark:text-white mb-2"
                                >
                                    Vegetative Hazards
                                </h3>
                                <p
                                    class="text-[#60758a] dark:text-gray-300 text-sm leading-relaxed mb-4"
                                >
                                    We handle large-scale organic removal
                                    including fallen trees, large limbs, heavy
                                    brush, and root balls that block driveways
                                    or pose structural threats.
                                </p>
                                <ul
                                    class="text-sm text-[#60758a] dark:text-gray-300 space-y-2"
                                >
                                    <li class="flex items-center gap-2">
                                        <span
                                            class="material-symbols-outlined text-green-500 text-base"
                                            >check_circle</span
                                        > Tree trunks & stumps
                                    </li>
                                    <li class="flex items-center gap-2">
                                        <span
                                            class="material-symbols-outlined text-green-500 text-base"
                                            >check_circle</span
                                        > Scattered branches
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div
                            class="w-full md:w-2/5 min-h-[200px] md:min-h-full bg-cover bg-center"
                            data-alt="Worker cutting a fallen tree with a chainsaw"
                            style="background-image: url('/assets/images/restoration/storm-damage/debris-removal-truck.webp');"
                        >
                        </div>
                    </div>
                </div>
                <!-- Card 2: Construction -->
                <div
                    class="group relative overflow-hidden rounded-xl bg-[#f5f7f8] dark:bg-[#232e3a] shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow flex flex-col"
                >
                    <div
                        class="h-48 bg-cover bg-center"
                        data-alt="Pile of construction debris and wood planks"
                        style="background-image: url('/assets/images/restoration/storm-damage/debris-removal-crew.webp');"
                    >
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <div
                            class="size-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 flex items-center justify-center mb-4"
                        >
                            <span class="material-symbols-outlined"
                                >foundation</span
                            >
                        </div>
                        <h3
                            class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                        >
                            Construction & Structural
                        </h3>
                        <p
                            class="text-[#60758a] dark:text-gray-300 text-sm mb-4 flex-1"
                        >
                            Safe removal of siding, roofing materials, damaged
                            drywall, shattered glass, and wrecked fencing.
                        </p>
                    </div>
                </div>
                <!-- Card 3: Hazardous -->
                <div
                    class="group relative overflow-hidden rounded-xl bg-[#f5f7f8] dark:bg-[#232e3a] shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow flex flex-col"
                >
                    <div class="p-6 flex flex-col h-full">
                        <div
                            class="size-10 rounded-lg bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 flex items-center justify-center mb-4"
                        >
                            <span class="material-symbols-outlined"
                                >warning</span
                            >
                        </div>
                        <h3
                            class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                        >
                            Hazardous Items
                        </h3>
                        <p
                            class="text-[#60758a] dark:text-gray-300 text-sm mb-4 flex-1"
                        >
                            Careful separation and disposal of white goods
                            (appliances), electronics, and potential chemical
                            hazards.
                        </p>
                        <div
                            class="bg-orange-50 dark:bg-orange-900/10 border border-orange-100 dark:border-orange-800 rounded p-3 text-xs text-orange-800 dark:text-orange-200"
                        >
                            <strong>Safety Note:</strong> Do not touch leaking containers
                            or downed power lines.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section
        id="process"
        class="py-16 md:py-24 bg-[#f5f7f8] dark:bg-[#101922] relative"
    >
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[1280px]">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span
                    class="text-[#f97316] font-bold tracking-wider uppercase text-sm mb-2 block"
                    >Our Workflow</span
                >
                <h2
                    class="text-[#111418] dark:text-white text-3xl font-bold mb-4"
                >
                    The Process: Clearing the Way for Recovery
                </h2>
                <p class="text-[#60758a] dark:text-gray-400">
                    We follow a strict safety and logistical protocol to ensure
                    your property is cleared efficiently without causing further
                    damage.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
                <!-- Connector Line (Desktop) -->
                <div
                    class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-gray-200 dark:bg-gray-700 -z-0"
                >
                </div>
                <!-- Step 1 -->
                <div
                    class="relative z-10 flex flex-col items-center text-center"
                >
                    <div
                        class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-[#f97316] flex items-center justify-center mb-6 shadow-sm"
                    >
                        <span
                            class="material-symbols-outlined text-4xl text-[#f97316]"
                            >search_check</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                    >
                        1. Assessment
                    </h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">
                        We inspect the site for hidden hazards like downed lines
                        or unstable structures.
                    </p>
                </div>
                <!-- Step 2 -->
                <div
                    class="relative z-10 flex flex-col items-center text-center"
                >
                    <div
                        class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-gray-200 dark:border-gray-700 flex items-center justify-center mb-6 shadow-sm"
                    >
                        <span
                            class="material-symbols-outlined text-4xl text-[#60758a] dark:text-gray-400"
                            >category</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                    >
                        2. Sorting
                    </h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">
                        Debris is separated into categories (vegetative,
                        construction, white goods) for disposal.
                    </p>
                </div>
                <!-- Step 3 -->
                <div
                    class="relative z-10 flex flex-col items-center text-center"
                >
                    <div
                        class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-gray-200 dark:border-gray-700 flex items-center justify-center mb-6 shadow-sm"
                    >
                        <span
                            class="material-symbols-outlined text-4xl text-[#60758a] dark:text-gray-400"
                            >agriculture</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                    >
                        3. Removal
                    </h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">
                        Heavy machinery (skid steers, grapple trucks) loads and
                        hauls material away.
                    </p>
                </div>
                <!-- Step 4 -->
                <div
                    class="relative z-10 flex flex-col items-center text-center"
                >
                    <div
                        class="w-24 h-24 bg-white dark:bg-[#1a2632] rounded-full border-4 border-gray-200 dark:border-gray-700 flex items-center justify-center mb-6 shadow-sm"
                    >
                        <span
                            class="material-symbols-outlined text-4xl text-[#60758a] dark:text-gray-400"
                            >recycling</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-[#111418] dark:text-white mb-2"
                    >
                        4. Disposal
                    </h3>
                    <p class="text-sm text-[#60758a] dark:text-gray-400">
                        All materials are disposed of responsibly at certified
                        local facilities.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Insurance Context -->
    <section
        class="py-16 bg-blue-50 dark:bg-[#15202b] border-y border-blue-100 dark:border-blue-900/30"
    >
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[1280px]">
            <div class="flex flex-col lg:flex-row gap-12 items-center">
                <div class="flex-1">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-bold w-fit mb-4"
                    >
                        <span class="material-symbols-outlined text-[16px]"
                            >policy</span
                        >
                        Insurance Assistance
                    </div>
                    <h2
                        class="text-[#111418] dark:text-white text-3xl font-bold mb-4"
                    >
                        Debris Removal Coverage
                    </h2>
                    <p class="text-[#60758a] dark:text-gray-300 mb-6 text-lg">
                        Understanding your policy can be confusing during a
                        crisis. Most standard homeowner policies (HO-3) include
                        a provision for debris removal, but specifics vary.
                    </p>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div
                            class="bg-white dark:bg-[#1e2a36] p-4 rounded-lg shadow-sm border-l-4 border-green-500"
                        >
                            <h4
                                class="font-bold text-[#111418] dark:text-white mb-2 flex items-center gap-2"
                            >
                                <span
                                    class="material-symbols-outlined text-green-500"
                                    >check_circle</span
                                > Typically Covered
                            </h4>
                            <p
                                class="text-sm text-[#60758a] dark:text-gray-400"
                            >
                                Removal of trees that have fallen on covered
                                structures (house, garage) or block driveways.
                            </p>
                        </div>
                        <div
                            class="bg-white dark:bg-[#1e2a36] p-4 rounded-lg shadow-sm border-l-4 border-orange-500"
                        >
                            <h4
                                class="font-bold text-[#111418] dark:text-white mb-2 flex items-center gap-2"
                            >
                                <span
                                    class="material-symbols-outlined text-orange-500"
                                    >info</span
                                > Often Excluded
                            </h4>
                            <p
                                class="text-sm text-[#60758a] dark:text-gray-400"
                            >
                                Trees that fall in the yard without damaging
                                structures or blocking access (varies by
                                carrier).
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-16 bg-white dark:bg-[#1a2632]">
        <div class="layout-container px-4 md:px-10 mx-auto max-w-[960px]">
            <h2
                class="text-[#111418] dark:text-white text-3xl font-bold mb-10 text-center"
            >
                Debris Removal FAQ
            </h2>
            <div class="space-y-4">
                <!-- FAQ Item 1 -->
                <details
                    class="group bg-[#f5f7f8] dark:bg-[#101922] rounded-lg p-4 [&_summary::-webkit-details-marker]:hidden open:ring-1 open:ring-[#f97316]/20"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between gap-1.5 text-[#111418] dark:text-white font-bold text-lg"
                    >
                        <h3 class="text-base sm:text-lg">
                            Do I need to be home for the pickup?
                        </h3>
                        <span
                            class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-[#111418] dark:text-white sm:p-3 group-open:-rotate-180 transition-transform"
                        >
                            <span class="material-symbols-outlined"
                                >expand_more</span
                            >
                        </span>
                    </summary>
                    <p
                        class="mt-4 leading-relaxed text-[#60758a] dark:text-gray-300 text-sm sm:text-base"
                    >
                        In most cases, no. As long as our crews have clear
                        access to the debris piles, we can perform the removal
                        while you tend to other matters. We will send photo
                        confirmation once the job is complete.
                    </p>
                </details>
                <!-- FAQ Item 2 -->
                <details
                    class="group bg-[#f5f7f8] dark:bg-[#101922] rounded-lg p-4 [&_summary::-webkit-details-marker]:hidden open:ring-1 open:ring-[#f97316]/20"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between gap-1.5 text-[#111418] dark:text-white font-bold text-lg"
                    >
                        <h3 class="text-base sm:text-lg">
                            Will you take the tree trunk or just branches?
                        </h3>
                        <span
                            class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-[#111418] dark:text-white sm:p-3 group-open:-rotate-180 transition-transform"
                        >
                            <span class="material-symbols-outlined"
                                >expand_more</span
                            >
                        </span>
                    </summary>
                    <p
                        class="mt-4 leading-relaxed text-[#60758a] dark:text-gray-300 text-sm sm:text-base"
                    >
                        We remove everything. Our heavy grappling equipment can
                        handle massive trunks, root balls, and piles of brush.
                        We ensure the area is raked and swept clean after
                        removal.
                    </p>
                </details>
                <!-- FAQ Item 3 -->
                <details
                    class="group bg-[#f5f7f8] dark:bg-[#101922] rounded-lg p-4 [&_summary::-webkit-details-marker]:hidden open:ring-1 open:ring-[#f97316]/20"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between gap-1.5 text-[#111418] dark:text-white font-bold text-lg"
                    >
                        <h3 class="text-base sm:text-lg">
                            How quickly can you get here?
                        </h3>
                        <span
                            class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-[#111418] dark:text-white sm:p-3 group-open:-rotate-180 transition-transform"
                        >
                            <span class="material-symbols-outlined"
                                >expand_more</span
                            >
                        </span>
                    </summary>
                    <p
                        class="mt-4 leading-relaxed text-[#60758a] dark:text-gray-300 text-sm sm:text-base"
                    >
                        During storm events, we operate 24/7. Priority is given
                        to hazards blocking access or posing immediate danger.
                        We typically schedule assessments within 24 hours of
                        your call.
                    </p>
                </details>
            </div>
        </div>
    </section>
</ServiceLayout>
