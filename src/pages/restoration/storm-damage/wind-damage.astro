---
import WindDamageLayout from '../../../layouts/WindDamageLayout.astro';
---

<WindDamageLayout>
    <!-- Hero Section -->
    <section class="relative bg-white dark:bg-[#101922] pt-12 pb-20 lg:pt-20 lg:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
                <!-- Content -->
                <div class="flex flex-col gap-6 max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-bold uppercase tracking-wider w-fit border border-red-100 dark:border-red-800">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                        </span>
                        24/7 Emergency Response
                    </div>
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white leading-[1.1] tracking-tight">
                        Wind Damage Help When You Need It Most
                    </h1>
                    <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl">
                        Don't let water intrusion cause further damage to your home in <span class="font-semibold text-[#0d7ff2] underline decoration-dotted decoration-2 underline-offset-4">Florida</span>. Our technicians provide immediate board-up services and comprehensive structural repairs.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 pt-4">
                        <a href="tel:7866022217" class="flex items-center justify-center gap-2 w-full sm:w-auto bg-[#f25c0d] hover:bg-orange-600 text-white text-base font-bold h-12 px-8 rounded-lg transition-all shadow-lg shadow-orange-500/30 transform hover:-translate-y-0.5">
                            <span class="material-symbols-outlined">call</span>
                            Call for Emergency Board-Up
                        </a>
                        <a href="/contact/" class="flex items-center justify-center gap-2 w-full sm:w-auto bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-white text-base font-bold h-12 px-8 rounded-lg transition-colors border border-slate-200 dark:border-slate-700">
                            Get a Free Inspection
                        </a>
                    </div>
                    <div class="flex items-center gap-4 mt-4 text-sm text-slate-500 dark:text-slate-400">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full border-2 border-white dark:border-[#101922] bg-gray-200" data-alt="Headshot of a happy customer" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBOIMMJ_Fe93JWAdovovBwvxdsvA6cCXZuOY3owkejKUXJTxjv7OCBDcFCqOUTS6728Rjn1poPOz5moulSAapk4IYx-6LvDhUQHoLtEwQlFdO_FwBMdwh7CL539G4IzrJ0AnPwZ-sET8S9e_QfiU_TuQtUeLTYdLRusXdjTtpZQPtl7SSc_9DESt5Qdd1Gle4b9goVtAtK8XzlazqBkbjeqdB7Df3-h-Wg3YR9KLMOpi5bDqfNeuY70Ebv4uGJ0aOtuo6mnl9rcHieN'); background-size: cover;"></div>
                            <div class="w-8 h-8 rounded-full border-2 border-white dark:border-[#101922] bg-gray-200" data-alt="Headshot of a happy customer" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBhkgCgF0Fmtas7hqZBYZUhsJ8iE2--jhUS6tAWCDhRHulU5HiXt6tSCTFFSyDG9SJBBwFIeFcaC7paQyTHKIZiBHcQ7FftLA0nXAky4ODknrcxuiF-d9DsqA9Jmqs0oyDqS0dAbSFpgWJ4RSulQsozM1uTxRuvtvgQLBHOaMZV5EVmlodNMfgvtWnQGEQsHGTDpT_SxlrJV0mkcol5waz7WuKiZEUYOYgLN9nLJlh-zA1EDfHuykpcE4ipiwIdUltcxZV4KFG2Tyc5'); background-size: cover;"></div>
                            <div class="w-8 h-8 rounded-full border-2 border-white dark:border-[#101922] bg-gray-200" data-alt="Headshot of a happy customer" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuA80PLDx96ioX5hIJSam0xEjhJBLqEt8pFi9PSt3qH6MpDQu9dV_4NkPL4b9xNgHB6l11cGYracnbRUNajdq5fXoggdh73FPZvgoZeSZsnbTxXJDmZsAQ0iMT7GbXPp75LyG84ih-dVpHaoavwOi8gou7h03YUVVI62pcayeGQG4SFEBNDU1BHYaDat4lrTvin63LZk3k5RoyxTcnzywO3HLjg3-1YVBo5v-T8Hgn9iAJoVfvOBy7IxeCjsBLH55Wf2mOulQ1IVJeG1'); background-size: cover;"></div>
                        </div>
                        <p>Trusted by 500+ local homeowners</p>
                    </div>
                </div>
                <!-- Image -->
                <div class="relative rounded-2xl overflow-hidden shadow-2xl group">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent z-10"></div>
                    <div class="bg-gray-200 w-full aspect-[4/3] bg-cover bg-center transform transition-transform duration-700 group-hover:scale-105" data-alt="Technician inspecting roof damage after a storm" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuALTlF3yKU6IEQ3ijmN6nnzG3-cZHNgtmbhYUFrEP450ntF_Y8Gw6039ehSiLOQv3zGI2PVwbSAXi6CBztVk9NhvU-Ds789YUN-qMa-7aV3OyD0WBO40coDUwYNOmqJEvdqlHuD8rxlxgHwPN8sxOd5VMP1M36-KnhSer5FQtkIjnHw7QbAb0-mVNdiBwVGRz2KQTszjtNXn9ZqSSQMHM0-4ukzSJdgnMmWH00Yilw57IV54K5jQerP86kAOROVh_LW5zhl6VLURmpO');">
                    </div>
                    <!-- Floating Card -->
                    <div class="absolute bottom-6 left-6 right-6 z-20">
                        <div class="bg-white/95 dark:bg-slate-900/95 backdrop-blur p-4 rounded-xl border border-white/20 shadow-lg flex items-center gap-4">
                            <div class="bg-green-100 dark:bg-green-900/40 p-2 rounded-lg text-green-600 dark:text-green-400">
                                <span class="material-symbols-outlined">verified_user</span>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 dark:text-white text-sm">Professional Experts</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400">We handle the paperwork with your insurer.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Background decorative elements -->
        <div class="absolute top-0 right-0 -translate-y-12 translate-x-12 w-64 h-64 bg-[#0d7ff2]/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 translate-y-12 -translate-x-12 w-96 h-96 bg-[#f25c0d]/5 rounded-full blur-3xl"></div>
    </section>

    <!-- Wind Impact Bento Grid Section -->
    <section class="py-20 bg-[#f3f4f6] dark:bg-[#1e293b]/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-[#0d7ff2] font-bold text-sm uppercase tracking-wider mb-3">Diagnostic Guide</h2>
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">Identify the Signs: Wind Impact Assessment</h2>
                <p class="text-slate-600 dark:text-slate-300">High winds can cause hidden structural issues. Use this visual guide to identify potential vulnerabilities in your property before they worsen.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Card 1 -->
                <div class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#0d7ff2] flex items-center justify-center mb-4 group-hover:bg-[#0d7ff2] group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[28px]">roofing</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Lifted or Missing Shingles</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow">
                        Exposes your roof deck to rain and leaks, leading to potential water damage inside walls. Look for uneven lines on your roof.
                    </p>
                    <div class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-cover bg-center" data-alt="Close up of damaged roof shingles" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDcDaKMfmU8LjhbnGW4MMsTk7-1Cznjrtl209La0pJypb0UXK8BmOiZFDhthzbHx5YtpxRrMlslRHy7gfWc7mOXQahW5D1pSSZy47KbLgbnF0CDsH5kCVjqwaDdgXzlCRh0u3Z9Uk1ZRuiCWVUie4PaSmUYJttNNg6ipiYNUje7ttabDErY0uxv6icaQ70dBUcq-gXaUcoLVlgx6atHcP6rS3-xiG81zesqiU2Pt34DT27tRHFcD0e9pJaJ3HdcN2uwqYIarLcd8W8w');"></div>
                    </div>
                </div>
                <!-- Card 2 -->
                <div class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#0d7ff2] flex items-center justify-center mb-4 group-hover:bg-[#0d7ff2] group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[28px]">mode_fan</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Flying Debris Impact</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow">
                        Windows, siding, or doors broken by tree limbs or other flying objects. Immediate board-up is crucial to prevent looting or pests.
                    </p>
                    <div class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-cover bg-center" data-alt="Broken window glass from storm debris" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuB9QrnEMi2jfo9p-pg1tR4XhIijZYl10DtpVTFEUT3fQE2qNa908N_WgDkEpZ6MHxQIq4_oF6xG9Uh_eeANBmPjLByESI2bqnXdhg6ixdAEShocEHeLULGfKTsUiE5mojuWa91MMT2WgtM--XpMRq-eqeG_YZFOR5wLmyju0hu_uxoydXdIkCS8LGbxjdVrIguU7l24Ua4MN8OL8jge7tV7mNd9E-B8x3ubDPCH2k5Ii4OqYDmzzFZl8lC5EfAOLxZM-YCmjM2S9lp1');"></div>
                    </div>
                </div>
                <!-- Card 3 -->
                <div class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#0d7ff2] flex items-center justify-center mb-4 group-hover:bg-[#0d7ff2] group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[28px]">foundation</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Leaning Structures</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow">
                        Fences, sheds, or even load-bearing walls shifting due to intense wind pressure. This indicates severe structural compromise.
                    </p>
                    <div class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-cover bg-center" data-alt="Wooden fence leaning over after wind storm" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBSeaoZ6awMWwrw-xthE5yOt_cy1MAXlRfN2T5ylwZgESRSiKwi_eihSF8wGYnvL-DLPvPsYV9yk89Yi87LlnQnprFLLr-1PmE6HXMEqNp4Kbu0kgV_3nXOvYFe5jYFG9_XXT4AYIfAWN7Ej9n3kDklo3nzVnT4d8z-wGOuln6bC0xxRLy5gvWg21YI4PEyUpsdsWNWeWfTNFHN0HxqlJq06rfJJMQByV_v0yyxUw0y5YGqXt3VvEqOU1Uqg4IiEQgYCeVAnABM0h4P');"></div>
                    </div>
                </div>
                <!-- Card 4 -->
                <div class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#0d7ff2] flex items-center justify-center mb-4 group-hover:bg-[#0d7ff2] group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[28px]">water_drop</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Seal Failure</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow">
                        Drafts or water spots appearing around window frames. Wind can break the seals, destroying the insulation properties of your home.
                    </p>
                    <div class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-cover bg-center" data-alt="Water stain on ceiling near window" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDL08--HLxBQ-QawFoahAQ52MzW5B0E-9n0rWMnGFpW6uJRVEZ4cE9WExCupH-YYm1iRppSP9vuyt9Xe66kPsUsb9LRwobtLNeM0qdWsgecJltWBKO6mN4IF6YarJDNlhRJ6s6N4UreFL2LFYaapwNtmuTDh7MAcz_au8i9WZ9q8MpJ25EUm1k1K5X0Dv0Y2DW04OE-NtGBEC6iz4BC_otL5VWYmbzcy2-9xSoIw55H-hKEoDB7jKP-sZHfrFyvME1QCYZIPgjxCZ9a');"></div>
                    </div>
                </div>
            </div>
            <div class="mt-12 text-center">
                <a href="/contact/" class="flex items-center justify-center gap-2 mx-auto bg-[#0d7ff2] hover:bg-blue-600 text-white text-base font-bold h-12 px-8 rounded-lg transition-colors inline-flex">
                    Schedule a Free Assessment
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Restoration Process & Insurance -->
    <section class="py-20 bg-white dark:bg-[#101922] overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
                <!-- Process Column -->
                <div class="lg:col-span-7">
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">Our Repair & Restoration Process</h2>
                    <div class="relative pl-8 border-l-2 border-slate-200 dark:border-slate-800 space-y-12">
                        <!-- Step 1 -->
                        <div class="relative">
                            <div class="absolute -left-[41px] top-0 w-8 h-8 rounded-full bg-[#0d7ff2] text-white flex items-center justify-center font-bold text-sm ring-4 ring-white dark:ring-[#101922]">1</div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Emergency Mitigation</h3>
                            <p class="text-slate-600 dark:text-slate-300">We arrive within hours to board up windows, tarp roofs, and remove dangerous debris to secure your property immediately.</p>
                        </div>
                        <!-- Step 2 -->
                        <div class="relative">
                            <div class="absolute -left-[41px] top-0 w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center font-bold text-sm ring-4 ring-white dark:ring-[#101922]">2</div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Documentation & Assessment</h3>
                            <p class="text-slate-600 dark:text-slate-300">Our team uses advanced thermal imaging and moisture meters to document the full extent of damage for your insurance claim.</p>
                        </div>
                        <!-- Step 3 -->
                        <div class="relative">
                            <div class="absolute -left-[41px] top-0 w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center font-bold text-sm ring-4 ring-white dark:ring-[#101922]">3</div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Restoration & Matching</h3>
                            <p class="text-slate-600 dark:text-slate-300">We don't just patch; we source materials that match your existing siding, roofing, and trim to restore your home's original curb appeal.</p>
                        </div>
                    </div>
                </div>
                <!-- Insurance Column -->
                <div class="lg:col-span-5">
                    <div class="bg-blue-50 dark:bg-blue-900/10 p-8 rounded-2xl border border-blue-100 dark:border-blue-900/30 sticky top-24">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="material-symbols-outlined text-[#0d7ff2] text-3xl">policy</span>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Insurance Context: Windstorm Policies</h3>
                        </div>
                        <div class="space-y-6">
                            <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
                                Navigating insurance claims after a storm can be confusing. Windstorm deductibles often differ from standard homeowner policies.
                            </p>
                            <div class="bg-white dark:bg-[#101922] p-4 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800">
                                <h4 class="font-bold text-slate-900 dark:text-white mb-2 text-sm flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[#f25c0d] text-base">warning</span>
                                    Before We Arrive:
                                </h4>
                                <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-2 list-disc list-inside">
                                    <li>Take photos of all debris in the yard.</li>
                                    <li>Do not throw away damaged items until documented.</li>
                                    <li>Keep receipts for any temporary repairs you make.</li>
                                </ul>
                            </div>
                            <div class="pt-2">
                                <a class="text-[#0d7ff2] font-bold text-sm hover:underline flex items-center gap-1" href="/resources/">
                                    Download our Insurance Checklist
                                    <span class="material-symbols-outlined text-sm">download</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-[#f3f4f6] dark:bg-[#1e293b]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center text-slate-900 dark:text-white mb-12">Wind Damage FAQ</h2>
            <div class="space-y-4">
                <!-- FAQ Item 1 -->
                <details class="group bg-white dark:bg-[#101922] rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden open:ring-2 open:ring-[#0d7ff2]/20">
                    <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-slate-900 dark:text-white">
                        Will the new siding match my old siding?
                        <span class="material-symbols-outlined transition-transform duration-300 group-open:-rotate-180">keyboard_arrow_down</span>
                    </summary>
                    <div class="px-6 pb-6 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-transparent group-open:border-slate-100 dark:group-open:border-slate-800">
                        <div class="pt-4">
                            We work with extensive supplier networks to find the closest possible match. If a match isn't available due to fading or discontinuation, we advocate with your insurance company to replace entire elevations (sides) of the house to ensure consistency.
                        </div>
                    </div>
                </details>
                <!-- FAQ Item 2 -->
                <details class="group bg-white dark:bg-[#101922] rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden open:ring-2 open:ring-[#0d7ff2]/20">
                    <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-slate-900 dark:text-white">
                        Does insurance cover tornado damage?
                        <span class="material-symbols-outlined transition-transform duration-300 group-open:-rotate-180">keyboard_arrow_down</span>
                    </summary>
                    <div class="px-6 pb-6 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-transparent group-open:border-slate-100 dark:group-open:border-slate-800">
                        <div class="pt-4">
                            Generally, yes. Standard homeowners insurance policies usually cover wind damage, including tornadoes. However, coverage limits and deductibles vary. We help you understand your specific policy language.
                        </div>
                    </div>
                </details>
                <!-- FAQ Item 3 -->
                <details class="group bg-white dark:bg-[#101922] rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden open:ring-2 open:ring-[#0d7ff2]/20">
                    <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-slate-900 dark:text-white">
                        How quickly can you board up my windows?
                        <span class="material-symbols-outlined transition-transform duration-300 group-open:-rotate-180">keyboard_arrow_down</span>
                    </summary>
                    <div class="px-6 pb-6 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-transparent group-open:border-slate-100 dark:group-open:border-slate-800">
                        <div class="pt-4">
                            We have 24/7 emergency response teams. In most local cases, we can be on-site within 2-4 hours of your call to secure the property and prevent further weather damage or looting.
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </section>
</WindDamageLayout>
