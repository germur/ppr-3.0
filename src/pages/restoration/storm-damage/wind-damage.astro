---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import windHero from "../../../assets/images/restoration/storm-damage/wind-damage-hero.webp";

const pageTitle = "Wind Damage Help When You Need It Most | Florida";
const pageDescription =
    "Don't let water intrusion cause further damage to your home. Our technicians provide immediate board-up services and comprehensive structural repairs. 24/7 Emergency Response.";

const schema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Wind Damage Repair",
    provider: {
        "@type": "GeneralContractor",
        name: "Paramount Property Restoration",
    },
};
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage={windHero}
    themeColor="red"
    schema={schema}
>
    <!-- Wind Impact Bento Grid Section -->
    <section class="py-20 bg-[#f3f4f6] dark:bg-[#1e293b]/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2
                    class="text-[#f97316] font-bold text-sm uppercase tracking-wider mb-3"
                >
                    Diagnostic Guide
                </h2>
                <h2
                    class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4"
                >
                    Identify the Signs: Wind Impact Assessment
                </h2>
                <p class="text-slate-600 dark:text-slate-300">
                    High winds can cause hidden structural issues. Use this
                    visual guide to identify potential vulnerabilities in your
                    property before they worsen.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Card 1 -->
                <div
                    class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full"
                >
                    <div
                        class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#f97316] flex items-center justify-center mb-4 group-hover:bg-[#f97316] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >roofing</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Lifted or Missing Shingles
                    </h3>
                    <p
                        class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow"
                    >
                        Exposes your roof deck to rain and leaks, leading to
                        potential water damage inside walls. Look for uneven
                        lines on your roof.
                    </p>
                    <div
                        class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative"
                    >
                        <div
                            class="absolute inset-0 bg-cover bg-center"
                            data-alt="Close up of damaged roof shingles"
                            style="background-image: url('/assets/images/restoration/storm-damage/wind-damage-roof.webp');"
                        >
                        </div>
                    </div>
                </div>
                <!-- Card 2 -->
                <div
                    class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full"
                >
                    <div
                        class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#f97316] flex items-center justify-center mb-4 group-hover:bg-[#f97316] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >mode_fan</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Flying Debris Impact
                    </h3>
                    <p
                        class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow"
                    >
                        Windows, siding, or doors broken by tree limbs or other
                        flying objects. Immediate board-up is crucial to prevent
                        looting or pests.
                    </p>
                    <div
                        class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative"
                    >
                        <div
                            class="absolute inset-0 bg-cover bg-center"
                            data-alt="Broken window glass from storm debris"
                            style="background-image: url('/assets/images/restoration/storm-damage/wind-damage-siding.webp');"
                        >
                        </div>
                    </div>
                </div>
                <!-- Card 3 -->
                <div
                    class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full"
                >
                    <div
                        class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#f97316] flex items-center justify-center mb-4 group-hover:bg-[#f97316] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >foundation</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Leaning Structures
                    </h3>
                    <p
                        class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow"
                    >
                        Fences, sheds, or even load-bearing walls shifting due
                        to intense wind pressure. This indicates severe
                        structural compromise.
                    </p>
                    <div
                        class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative"
                    >
                        <div
                            class="absolute inset-0 bg-cover bg-center"
                            data-alt="Wooden fence leaning over after wind storm"
                            style="background-image: url('/assets/images/restoration/storm-damage/wind-damage-fence.webp');"
                        >
                        </div>
                    </div>
                </div>
                <!-- Card 4 -->
                <div
                    class="bento-card group bg-white dark:bg-[#101922] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col h-full"
                >
                    <div
                        class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-[#f97316] flex items-center justify-center mb-4 group-hover:bg-[#f97316] group-hover:text-white transition-colors"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >water_drop</span
                        >
                    </div>
                    <h3
                        class="text-lg font-bold text-slate-900 dark:text-white mb-2"
                    >
                        Seal Failure
                    </h3>
                    <p
                        class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-grow"
                    >
                        Drafts or water spots appearing around window frames.
                        Wind can break the seals, destroying the insulation
                        properties of your home.
                    </p>
                    <div
                        class="h-32 w-full rounded-lg bg-gray-100 overflow-hidden relative"
                    >
                        <div
                            class="absolute inset-0 bg-cover bg-center"
                            data-alt="Water stain on ceiling near window"
                            style="background-image: url('/assets/images/restoration/storm-damage/wind-damage-tree.webp');"
                        >
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-12 text-center">
                <a
                    href="/contact/"
                    class="flex items-center justify-center gap-2 mx-auto bg-[#f97316] hover:bg-orange-600 text-white text-base font-bold h-12 px-8 rounded-lg transition-colors inline-flex"
                >
                    Schedule a Free Assessment
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Restoration Process & Insurance -->
    <section class="py-20 bg-white dark:bg-[#101922] overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
                <!-- Process Column -->
                <div class="lg:col-span-7">
                    <h2
                        class="text-3xl font-bold text-slate-900 dark:text-white mb-8"
                    >
                        Our Repair & Restoration Process
                    </h2>
                    <div
                        class="relative pl-8 border-l-2 border-slate-200 dark:border-slate-800 space-y-12"
                    >
                        <!-- Step 1 -->
                        <div class="relative">
                            <div
                                class="absolute -left-[41px] top-0 w-8 h-8 rounded-full bg-[#f97316] text-white flex items-center justify-center font-bold text-sm ring-4 ring-white dark:ring-[#101922]"
                            >
                                1
                            </div>
                            <h3
                                class="text-xl font-bold text-slate-900 dark:text-white mb-2"
                            >
                                Emergency Mitigation
                            </h3>
                            <p class="text-slate-600 dark:text-slate-300">
                                We arrive within hours to board up windows, tarp
                                roofs, and remove dangerous debris to secure
                                your property immediately.
                            </p>
                        </div>
                        <!-- Step 2 -->
                        <div class="relative">
                            <div
                                class="absolute -left-[41px] top-0 w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center font-bold text-sm ring-4 ring-white dark:ring-[#101922]"
                            >
                                2
                            </div>
                            <h3
                                class="text-xl font-bold text-slate-900 dark:text-white mb-2"
                            >
                                Documentation & Assessment
                            </h3>
                            <p class="text-slate-600 dark:text-slate-300">
                                Our team uses advanced thermal imaging and
                                moisture meters to document the full extent of
                                damage for your insurance claim.
                            </p>
                        </div>
                        <!-- Step 3 -->
                        <div class="relative">
                            <div
                                class="absolute -left-[41px] top-0 w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center font-bold text-sm ring-4 ring-white dark:ring-[#101922]"
                            >
                                3
                            </div>
                            <h3
                                class="text-xl font-bold text-slate-900 dark:text-white mb-2"
                            >
                                Restoration & Matching
                            </h3>
                            <p class="text-slate-600 dark:text-slate-300">
                                We don't just patch; we source materials that
                                match your existing siding, roofing, and trim to
                                restore your home's original curb appeal.
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Insurance Column -->
                <div class="lg:col-span-5">
                    <div
                        class="bg-blue-50 dark:bg-blue-900/10 p-8 rounded-2xl border border-blue-100 dark:border-blue-900/30 sticky top-24"
                    >
                        <div class="flex items-center gap-3 mb-6">
                            <span
                                class="material-symbols-outlined text-[#0d7ff2] text-3xl"
                                >policy</span
                            >
                            <h3
                                class="text-xl font-bold text-slate-900 dark:text-white"
                            >
                                Insurance Context: Windstorm Policies
                            </h3>
                        </div>
                        <div class="space-y-6">
                            <p
                                class="text-slate-700 dark:text-slate-300 leading-relaxed"
                            >
                                Navigating insurance claims after a storm can be
                                confusing. Windstorm deductibles often differ
                                from standard homeowner policies.
                            </p>
                            <div
                                class="bg-white dark:bg-[#101922] p-4 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800"
                            >
                                <h4
                                    class="font-bold text-slate-900 dark:text-white mb-2 text-sm flex items-center gap-2"
                                >
                                    <span
                                        class="material-symbols-outlined text-[#f25c0d] text-base"
                                        >warning</span
                                    >
                                    Before We Arrive: H4
                                </h4>
                                <ul
                                    class="text-sm text-slate-600 dark:text-slate-400 space-y-2 list-disc list-inside"
                                >
                                    <li>
                                        Take photos of all debris in the yard.
                                    </li>
                                    <li>
                                        Do not throw away damaged items until
                                        documented.
                                    </li>
                                    <li>
                                        Keep receipts for any temporary repairs
                                        you make.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-[#f3f4f6] dark:bg-[#1e293b]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-3xl font-bold text-center text-slate-900 dark:text-white mb-12"
            >
                Wind Damage FAQ
            </h2>
            <div class="space-y-4">
                <!-- FAQ Item 1 -->
                <details
                    class="group bg-white dark:bg-[#101922] rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden open:ring-2 open:ring-[#f97316]/20"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between p-6 font-bold text-slate-900 dark:text-white"
                    >
                        Will the new siding match my old siding?
                        <span
                            class="material-symbols-outlined transition-transform duration-300 group-open:-rotate-180"
                            >keyboard_arrow_down</span
                        >
                    </summary>
                    <div
                        class="px-6 pb-6 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-transparent group-open:border-slate-100 dark:group-open:border-slate-800"
                    >
                        <div class="pt-4">
                            We work with extensive supplier networks to find the
                            closest possible match. If a match isn't available
                            due to fading or discontinuation, we advocate with
                            your insurance company to replace entire elevations
                            (sides) of the house to ensure consistency.
                        </div>
                    </div>
                </details>
                <!-- FAQ Item 2 -->
                <details
                    class="group bg-white dark:bg-[#101922] rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden open:ring-2 open:ring-[#f97316]/20"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between p-6 font-bold text-slate-900 dark:text-white"
                    >
                        Does insurance cover tornado damage?
                        <span
                            class="material-symbols-outlined transition-transform duration-300 group-open:-rotate-180"
                            >keyboard_arrow_down</span
                        >
                    </summary>
                    <div
                        class="px-6 pb-6 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-transparent group-open:border-slate-100 dark:group-open:border-slate-800"
                    >
                        <div class="pt-4">
                            Generally, yes. Standard homeowners insurance
                            policies usually cover wind damage, including
                            tornadoes. However, coverage limits and deductibles
                            vary. We help you understand your specific policy
                            language.
                        </div>
                    </div>
                </details>
                <!-- FAQ Item 3 -->
                <details
                    class="group bg-white dark:bg-[#101922] rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden open:ring-2 open:ring-[#f97316]/20"
                >
                    <summary
                        class="flex cursor-pointer items-center justify-between p-6 font-bold text-slate-900 dark:text-white"
                    >
                        How quickly can you board up my windows?
                        <span
                            class="material-symbols-outlined transition-transform duration-300 group-open:-rotate-180"
                            >keyboard_arrow_down</span
                        >
                    </summary>
                    <div
                        class="px-6 pb-6 pt-0 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-transparent group-open:border-slate-100 dark:group-open:border-slate-800"
                    >
                        <div class="pt-4">
                            We have 24/7 emergency response teams. In most local
                            cases, we can be on-site within 2-4 hours of your
                            call to secure the property and prevent further
                            weather damage or looting.
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </section>
</ServiceLayout>
