---
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import FAQAccordion from "../../../components/ui/FAQAccordion";
import { stormDamageFAQs } from "../../../data/restoration-faqs";

const pageTitle = "Hurricane Damage Help When You Need It Most";
const pageDescription =
    "Mobilizing now. We secure your property, extract water, and handle your claim. On-Site in 60 Mins.";

const schema = {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    name: "Paramount Property Restoration",
    description: pageDescription,
};
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage="/assets/images/restoration/storm-damage/storm-damage-hero-main.webp"
    themeColor="red"
    schema={schema}
>
    <!-- Triage Bento Grid Section -->
    <section
        id="protocols"
        class="py-16 px-4 md:px-10 lg:px-40 bg-slate-50 border-b border-slate-200"
    >
        <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
            <div class="flex flex-col gap-4 max-w-[720px]">
                <h2
                    class="text-slate-900 text-3xl font-black leading-tight tracking-[-0.033em]"
                >
                    Immediate Response Protocols
                </h2>
                <p class="text-slate-600 text-lg font-normal leading-normal">
                    Our Triage Team prioritizes critical damage to prevent
                    secondary loss. We deploy immediately with specialized
                    equipment.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Card 1 -->
                <div
                    class="group flex flex-col gap-4 p-6 rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-[#1162d4]/50 transition-all duration-300"
                >
                    <div
                        class="size-12 rounded-full bg-blue-50 flex items-center justify-center text-[#1162d4] group-hover:scale-110 transition-transform"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >umbrella</span
                        >
                    </div>
                    <div class="flex flex-col gap-2">
                        <h3 class="text-lg font-bold text-slate-900">
                            Emergency Roof Tarping
                        </h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Prevent rain intrusion immediately with
                            industrial-grade shrink wrap and tarping systems.
                        </p>
                    </div>
                </div>
                <!-- Card 2 -->
                <div
                    class="group flex flex-col gap-4 p-6 rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-[#1162d4]/50 transition-all duration-300"
                >
                    <div
                        class="size-12 rounded-full bg-blue-50 flex items-center justify-center text-[#1162d4] group-hover:scale-110 transition-transform"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >water_drop</span
                        >
                    </div>
                    <div class="flex flex-col gap-2">
                        <h3 class="text-lg font-bold text-slate-900">
                            Flood Water Extraction
                        </h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            High-volume truck-mounted pumps remove standing
                            flood water from your home fast.
                        </p>
                    </div>
                </div>
                <!-- Card 3 -->
                <div
                    class="group flex flex-col gap-4 p-6 rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-[#1162d4]/50 transition-all duration-300"
                >
                    <div
                        class="size-12 rounded-full bg-blue-50 flex items-center justify-center text-[#1162d4] group-hover:scale-110 transition-transform"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >air</span
                        >
                    </div>
                    <div class="flex flex-col gap-2">
                        <h3 class="text-lg font-bold text-slate-900">
                            Structural Drying
                        </h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Hospital-grade dehumidifiers and air movers to dry
                            wall cavities and prevent mold.
                        </p>
                    </div>
                </div>
                <!-- Card 4 -->
                <div
                    class="group flex flex-col gap-4 p-6 rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-[#1162d4]/50 transition-all duration-300"
                >
                    <div
                        class="size-12 rounded-full bg-blue-50 flex items-center justify-center text-[#1162d4] group-hover:scale-110 transition-transform"
                    >
                        <span class="material-symbols-outlined text-[28px]"
                            >forest</span
                        >
                    </div>
                    <div class="flex flex-col gap-2">
                        <h3 class="text-lg font-bold text-slate-900">
                            Debris Removal
                        </h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Clearing fallen trees and storm debris to create
                            safe access for restoration crews.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Wind vs Flood & Education Split -->
    <section class="py-16 px-4 md:px-10 lg:px-40 bg-white">
        <div
            class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20"
        >
            <!-- Left: Wind vs Flood -->
            <div class="flex flex-col gap-8">
                <div class="flex flex-col gap-3">
                    <h2 class="text-slate-900 text-2xl font-bold">
                        Insurance Reality Check
                    </h2>
                    <p class="text-slate-600">
                        Understanding the source of damage is critical for your
                        claim approval.
                    </p>
                </div>
                <div
                    class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg"
                >
                    <div class="bg-[#1162d4] p-6 text-white">
                        <h3 class="text-xl font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined"
                                >compare_arrows</span
                            >
                            Wind vs. Flood
                        </h3>
                        <p class="text-blue-100 text-sm mt-1">
                            Most policies treat these as separate events.
                        </p>
                    </div>
                    <div class="bg-white p-0 flex flex-col sm:flex-row">
                        <div
                            class="flex-1 p-6 border-b sm:border-b-0 sm:border-r border-slate-100"
                        >
                            <div
                                class="flex items-center gap-2 mb-3 text-[#f97316] font-bold"
                            >
                                <span class="material-symbols-outlined"
                                    >cyclone</span
                                >
                                WIND DAMAGE
                            </div>
                            <p class="text-sm text-slate-600 mb-4">
                                Damage caused "from above" (roof lift, broken
                                windows, rain entry).
                            </p>
                            <ul
                                class="text-sm text-slate-500 list-disc pl-4 space-y-1"
                            >
                                <li>Usually Standard Homeowners</li>
                                <li>Roof shingle loss</li>
                                <li>Broken windows</li>
                            </ul>
                        </div>
                        <div class="flex-1 p-6 bg-slate-50">
                            <div
                                class="flex items-center gap-2 mb-3 text-blue-600 font-bold"
                            >
                                <span class="material-symbols-outlined"
                                    >flood</span
                                >
                                FLOOD DAMAGE
                            </div>
                            <p class="text-sm text-slate-600 mb-4">
                                Damage caused "from below" (rising water, storm
                                surge).
                            </p>
                            <ul
                                class="text-sm text-slate-500 list-disc pl-4 space-y-1"
                            >
                                <li>Requires Flood Policy (NFIP)</li>
                                <li>Rising creek/street water</li>
                                <li>Storm surge</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div
                    class="bg-blue-50 p-4 rounded-lg border border-blue-100 flex gap-4 items-start"
                >
                    <span class="material-symbols-outlined text-[#1162d4] mt-1"
                        >info</span
                    >
                    <div class="text-sm text-slate-700">
                        <strong>We document everything.</strong> Our team uses 3D
                        Matterport scanning to prove exactly how water entered your
                        property to protect your claim.
                    </div>
                </div>
            </div>
            <!-- Right: Critical Steps (Education) -->
            <div class="flex flex-col gap-6">
                <h2 class="text-slate-900 text-2xl font-bold">
                    Critical Steps After the Storm Passes
                </h2>
                <div class="flex flex-col gap-4">
                    <!-- Step 1 -->
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center">
                            <div
                                class="w-8 h-8 rounded-full bg-[#f97316] text-white flex items-center justify-center font-bold text-sm"
                            >
                                1
                            </div>
                            <div class="w-0.5 h-full bg-gray-200 my-2"></div>
                        </div>
                        <div class="pb-6">
                            <h4 class="font-bold text-slate-900 text-lg">
                                Ensure Safety First
                            </h4>
                            <p class="text-slate-600 text-sm mt-1">
                                Do not enter standing water if power lines are
                                down. Turn off main water and electricity if
                                safe to access.
                            </p>
                        </div>
                    </div>
                    <!-- Step 2 -->
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center">
                            <div
                                class="w-8 h-8 rounded-full bg-gray-200 text-slate-600 flex items-center justify-center font-bold text-sm"
                            >
                                2
                            </div>
                            <div class="w-0.5 h-full bg-gray-200 my-2"></div>
                        </div>
                        <div class="pb-6">
                            <h4 class="font-bold text-slate-900 text-lg">
                                Document the Damage
                            </h4>
                            <p class="text-slate-600 text-sm mt-1">
                                Take photos and videos of everything before
                                moving debris. This is your primary evidence for
                                insurance.
                            </p>
                        </div>
                    </div>
                    <!-- Step 3 -->
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center">
                            <div
                                class="w-8 h-8 rounded-full bg-gray-200 text-slate-600 flex items-center justify-center font-bold text-sm"
                            >
                                3
                            </div>
                            <div class="w-0.5 h-full bg-gray-200 my-2"></div>
                        </div>
                        <div class="pb-6">
                            <h4 class="font-bold text-slate-900 text-lg">
                                Mitigate Further Loss
                            </h4>
                            <p class="text-slate-600 text-sm mt-1">
                                Insurance policies require you to "mitigate."
                                Cover broken windows and stop active leaks. Call
                                PPR for professional help.
                            </p>
                        </div>
                    </div>
                    <!-- Step 4 -->
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center">
                            <div
                                class="w-8 h-8 rounded-full bg-gray-200 text-slate-600 flex items-center justify-center font-bold text-sm"
                            >
                                4
                            </div>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 text-lg">
                                Call Your Restoration Partner
                            </h4>
                            <p class="text-slate-600 text-sm mt-1">
                                Contact us immediately to get on the priority
                                list. The faster we start drying, the less
                                damage occurs.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section
        class="py-16 px-4 md:px-10 lg:px-40 bg-white border-t border-slate-100"
    >
        <div class="max-w-[720px] mx-auto">
            <h2
                class="text-slate-900 text-3xl font-black leading-tight tracking-[-0.033em] text-center mb-10"
            >
                Common Storm Questions
            </h2>
            <div class="space-y-4">
                <FAQAccordion items={stormDamageFAQs} client:visible />
            </div>
        </div>
    </section>

    <!-- Local Programmatic SEO Section -->
    <section
        class="py-12 px-4 md:px-10 lg:px-40 bg-gray-50 border-t border-gray-200"
    >
        <div class="max-w-[1200px] mx-auto text-center">
            <h3 class="text-slate-900 text-xl font-bold mb-8">
                Deploying Units to Impacted Florida Communities
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/south-florida/miami/"
                    >Miami Restoration</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/tampa-bay/tampa/">Tampa Cleanup</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/central-florida/orlando/"
                    >Orlando Flood Help</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/southwest-florida/naples/"
                    >Naples Repair</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/southwest-florida/fort-myers/"
                    >Ft. Myers Storm</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/tampa-bay/sarasota/">Sarasota Dryout</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/">Jacksonville Water</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/south-florida/">Key West Relief</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/">Panama City</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/">Tallahassee Roof</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/south-florida/boca-raton/"
                    >Boca Raton</a
                >
                <a
                    class="text-sm text-slate-600 hover:text-[#1162d4] hover:underline bg-white p-2 rounded border border-gray-200 shadow-sm transition-colors"
                    href="/service-areas/southwest-florida/cape-coral/"
                    >Cape Coral</a
                >
            </div>
        </div>
    </section>
</ServiceLayout>
