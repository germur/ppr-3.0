                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/fort-pierce/fire-damage-restoration/">Fort Pierce</a>
                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/hobe-sound/fire-damage-restoration/">Hobe Sound</a>
            </div>
        </div>
    </section>
</ServiceLayout>
