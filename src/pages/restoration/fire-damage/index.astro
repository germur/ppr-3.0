                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/winter-park/fire-damage-restoration/">Winter Park</a>
                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/winter-garden/fire-damage-restoration/">Winter Garden</a>
                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/ocala/fire-damage-restoration/">Ocala</a>
