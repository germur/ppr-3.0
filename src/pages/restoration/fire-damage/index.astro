---
import { getEntry } from "astro:content";
import ServiceLayout from "../../../layouts/ServiceLayout.astro";
import FeatureGrid from "../../../components/service/FeatureGrid.astro";
import ProcessTimeline from "../../../components/service/ProcessTimeline.astro";
import FAQAccordion from "../../../components/ui/FAQAccordion";
import {
    FaFire,
    FaCloud,
    FaWater,
    FaHammer,
    FaPaintRoller,
    FaTools,
} from "react-icons/fa";

import { generateServiceSchema } from "../../../utils/schemaGenerator";
import fireHeroImg from "../../../assets/images/restoration/fire-damage/hero.webp";
import kitchenFireImg from "../../../assets/images/restoration/fire-damage/kitchen-fire.webp";
import electricalFireImg from "../../../assets/images/restoration/fire-damage/electrical-fire.webp";
import commercialFireImg from "../../../assets/images/restoration/fire-damage/commercial-fire.webp";

// Fetch content
const entry = await getEntry("services", "fire-damage");
if (!entry) {
    throw new Error("Service page content not found");
}
const { Content } = await entry.render();
const { title, pageTitle, pageDescription, features, processSteps, faqs } =
    entry.data;

// Image map
const fireHeroUrl = fireHeroImg;

// Icon map
const iconMap: Record<string, any> = {
    FaFire,
    FaCloud,
    FaWater,
    FaHammer,
    FaPaintRoller,
    FaTools,
};

// Map features
const mappedFeatures = features.map((f) => ({
    ...f,
    icon: iconMap[f.icon] || FaTools,
}));

const mappedSteps = processSteps.map((s) => ({
    ...s,
    icon: iconMap[s.icon] || FaTools,
}));

const schema = generateServiceSchema({
    url: "https://paramountpropertyrestoration.com/restoration/fire-damage/",
    image: fireHeroUrl.src,
    description: pageDescription,
    services: [
        { name: "Fire Damage Restoration" },
        { name: "Smoke Odor Removal" },
        { name: "Structural Reconstruction" },
    ],
});
---

<ServiceLayout
    title={pageTitle}
    description={pageDescription}
    heroImage={fireHeroUrl}
    themeColor="orange"
    schema={schema}
>
    <!-- Triple Threat Bento Grid -->
    <FeatureGrid title={title} features={mappedFeatures} />

    <!-- First 24 Hours Guide -->
    <section class="py-20 relative bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-6">
                <Content />
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section id="process" class="py-20 bg-slate-900 overflow-hidden text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col lg:flex-row gap-16">
                <!-- Left: Title & Intro -->
                <div class="lg:w-1/3">
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                        Our Process: <br />Stabilize to Rebuild
                    </h2>
                    <p class="text-slate-400 mb-8">
                        We handle every step of the journey, ensuring you only
                        have to deal with one point of contact for the entire
                        restoration project.
                    </p>
                    <a
                        href="#process"
                        class="hidden lg:flex bg-white/5 hover:bg-white/10 text-white px-6 py-3 rounded-lg font-semibold transition-colors items-center gap-2 border border-white/10"
                    >
                        View Full Timeline <span
                            class="material-symbols-outlined"
                            >arrow_downward</span
                        >
                    </a>
                </div>
                <!-- Right: Vertical Timeline -->
                <div class="lg:w-2/3">
                    <ProcessTimeline steps={mappedSteps} theme="dark" />
                </div>
            </div>
        </div>
    </section>

    <!-- Specific Scenarios Cards (Keeping static for now or could migrate to separate MDX or keep here if strict UI specific) -->
    <!-- Ideally this should be data-driven too, but I'll leave these as static HTML for now to avoid overcomplication/loss of images manually -->
    <section class="py-20 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-slate-900">
                    Specific Fire Scenarios
                </h2>
                <p class="text-slate-600 mt-4">
                    We are equipped to handle specialized fire damage
                    situations.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Kitchen -->
                <div
                    class="bg-white border border-slate-200 rounded-xl overflow-hidden hover:shadow-lg transition-all group"
                >
                    <div
                        class="h-40 bg-cover bg-center relative"
                        data-alt="Modern kitchen interior with clean surfaces"
                        style={`background-image: url('${kitchenFireImg.src}');`}
                    >
                        <div
                            class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"
                        >
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <span
                                class="material-symbols-outlined text-white text-3xl"
                                >skillet</span
                            >
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            Kitchen Grease Fires
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Specialized cleaning for protein-based residues that
                            leave sticky, pungent films across surfaces.
                        </p>
                    </div>
                </div>
                <!-- Electrical -->
                <div
                    class="bg-white border border-slate-200 rounded-xl overflow-hidden hover:shadow-lg transition-all group"
                >
                    <div
                        class="h-40 bg-cover bg-center relative"
                        style={`background-image: url('${electricalFireImg.src}');`}
                    >
                        <div
                            class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"
                        >
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <span
                                class="material-symbols-outlined text-white text-3xl"
                                >electric_bolt</span
                            >
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            Electrical Malfunctions
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Addressing hidden damage within walls and ensuring
                            the electrical system is safe before power
                            restoration.
                        </p>
                    </div>
                </div>
                <!-- Commercial -->
                <div
                    class="bg-white border border-slate-200 rounded-xl overflow-hidden hover:shadow-lg transition-all group"
                >
                    <div
                        class="h-40 bg-cover bg-center relative"
                        style={`background-image: url('${commercialFireImg.src}');`}
                    >
                        <div
                            class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"
                        >
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <span
                                class="material-symbols-outlined text-white text-3xl"
                                >domain</span
                            >
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold text-slate-900 mb-2">
                            Commercial Complex
                        </h3>
                        <p class="text-slate-600 text-sm">
                            Large-scale loss recovery designed to minimize
                            business downtime and get doors open faster.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-slate-900 text-center mb-10">
                Frequently Asked Questions
            </h2>
            <div class="space-y-4">
                <FAQAccordion items={faqs} client:visible />
            </div>
        </div>
    </section>

    <!-- City-Service Internal Links -->
    <section class="py-16 bg-slate-50 border-t border-slate-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <h2 class="text-2xl font-bold text-slate-900">Fire Damage Restoration by City</h2>
                <p class="text-slate-500 mt-2">Licensed fire restoration across Florida — click your city for local details.</p>
            </div>
            <div class="flex flex-wrap justify-center gap-3">
                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/miami/fire-damage-restoration/">Miami</a>
                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/orlando/fire-damage-restoration/">Orlando</a>
                <a class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-600 hover:border-[#f97316] hover:text-[#f97316] transition-colors shadow-sm" href="/service-areas/tampa/fire-damage-restoration/">Tampa</a>
