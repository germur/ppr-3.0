    <!-- Scripts for Sliders -->
    <script>
        // Init logic for multiple sliders
        const sliders = document.querySelectorAll(".before-after-slider");

        sliders.forEach((slider) => {
            const container = slider as HTMLElement;
            const beforeImage = container.querySelector(
                ".before-image-wrapper",
            ) as HTMLElement;
            const sliderHandle = container.querySelector(
                ".slider-handle",
            ) as HTMLElement;
            // The inner image needs to be the one inside before-image-wrapper

            if (container && beforeImage && sliderHandle) {
                let isDragging = false;

                const updateSlider = (x: number) => {
                    const rect = container.getBoundingClientRect();
                    let position = ((x - rect.left) / rect.width) * 100;

                    // Clamp position
                    position = Math.max(0, Math.min(100, position));

                    beforeImage.style.width = `${position}%`;
                    sliderHandle.style.left = `${position}%`;
                };

                const onMouseMove = (e: MouseEvent) => {
                    if (!isDragging) return;
                    updateSlider(e.clientX);
                };

                const onTouchMove = (e: TouchEvent) => {
                    if (!isDragging) return;
                    updateSlider(e.touches[0].clientX);
                };

                const onMouseDown = (e: MouseEvent) => {
                    isDragging = true;
                    // Optional: jump to click position on mouse down
                    updateSlider(e.clientX);
                };

                const onTouchStart = (e: TouchEvent) => {
                    isDragging = true;
                    updateSlider(e.touches[0].clientX);
                };

                const onMouseUp = () => (isDragging = false);

                // Mouse events
                container.addEventListener("mousedown", onMouseDown);
                window.addEventListener("mouseup", onMouseUp);
                window.addEventListener("mousemove", onMouseMove);

                // Touch events
                container.addEventListener("touchstart", onTouchStart);
                window.addEventListener("touchend", onMouseUp);
                window.addEventListener("touchmove", onTouchMove);
            }
        });
    </script>
