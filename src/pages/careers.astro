---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Careers | Paramount Property Restoration">
  <div class="py-20 px-6 max-w-4xl mx-auto text-center">
    <h1 class="text-4xl font-bold mb-6 text-gray-900 dark:text-white">Join Our Team</h1>
    <p class="text-lg text-gray-600 dark:text-gray-300">
      We are always looking for dedicated professionals to join the Paramount family.
    </p>
    <div class="mt-8">
      <a href="/contact" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-bold">
        Contact Us for Opportunities
      </a>
    </div>
  </div>
</MainLayout>
