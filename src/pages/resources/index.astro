---
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<ResourcesLayout>
    <main class="flex flex-col items-center">
        <!-- Hero Section with Search -->
        <section class="w-full relative bg-[#111418]">
            <div class="absolute inset-0 z-0">
                <div class="w-full h-full bg-cover bg-center opacity-40" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuA5mnMJGxdnj6-NIhm9zmVrACTI8vw0RwuI9wVsDa_0RqcHfNWjJvljMYprtUVRmBgPrxSFneRa57YCbSWCwSR-UWTJ9lAurHLNL6_Ejp8WITj7RjPed4ifjvJlHLMK7MttYe6N2NHWK3boJiaSpK6XQx4CJvwqZyIJ59dJVnieMLZaLiDlxyxdkeCBnQ7ZuMvIPES6HSis_wdHI9nhjBFdwmtHdKae6aaht5CH-8mfXGbyTGSMl885M6be-eGNHwE0y2OdHupX7Kkv');"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-[#111418]/80 via-[#111418]/90 to-[#f6f7f8] dark:to-[#101922]"></div>
            </div>
            <div class="relative z-10 w-full max-w-[1000px] mx-auto px-4 md:px-10 py-20 md:py-28 flex flex-col items-center text-center">
                <span class="text-[#f97316] font-bold tracking-wider uppercase text-sm mb-4">The Knowledge Hub</span>
                <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tight mb-6">
                    Property Knowledge Center
                </h1>
                <p class="text-gray-300 text-lg md:text-xl font-normal leading-relaxed mb-10 max-w-2xl">
                    Expert advice on restoration, remodeling, and property maintenance. Find answers to your questions and protect your investment.
                </p>
                <div class="w-full max-w-2xl bg-white dark:bg-[#1f2937] p-2 rounded-2xl shadow-2xl border border-[#dbe0e6] dark:border-[#374151]">
                    <div class="flex p-1 bg-[#f0f2f4] dark:bg-[#111418] rounded-xl mb-3">
                        <button class="flex-1 py-2 text-sm font-bold text-[#111418] dark:text-white bg-white dark:bg-[#1f2937] rounded-lg shadow-sm border border-[#dbe0e6] dark:border-[#374151]">
                            For Homeowners
                        </button>
                        <button class="flex-1 py-2 text-sm font-medium text-[#617589] hover:text-[#111418] dark:hover:text-white transition-colors">
                            For Property Managers
                        </button>
                    </div>
                    <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-4 text-[#9ca3af] text-2xl">search</span>
                        <input class="w-full h-14 pl-12 pr-4 rounded-xl bg-transparent border-0 text-[#111418] dark:text-white placeholder:text-[#9ca3af] focus:ring-2 focus:ring-[#137fec] text-lg" placeholder="Search for 'water damage', 'permits', or 'mold'..." type="text" />
                        <button class="absolute right-2 h-10 px-6 bg-[#137fec] hover:bg-blue-600 text-white font-bold rounded-lg transition-colors">
                            Search
                        </button>
                    </div>
                </div>
                <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm text-[#9ca3af]">
                    <span>Popular:</span>
                    <a class="text-[#137fec] hover:underline" href="/restoration/storm-damage/">Hurricane Prep</a>
                    <span class="text-[#617589]">•</span>
                    <a class="text-[#137fec] hover:underline" href="/insurance-claims/">Insurance Claims</a>
                    <span class="text-[#617589]">•</span>
                    <a class="text-[#137fec] hover:underline" href="/remodeling-services/kitchen-remodeling/">Kitchen Remodel Costs</a>
                </div>
            </div>
        </section>

        <!-- Category Grid -->
        <section class="w-full max-w-[1440px] mx-auto px-4 md:px-10 py-16 -mt-16 relative z-20">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Water Damage -->
                <div class="bg-white dark:bg-[#1f2937] rounded-xl p-6 shadow-lg border border-[#dbe0e6] dark:border-[#374151] hover:-translate-y-1 transition-transform duration-300">
                    <div class="size-12 rounded-lg bg-blue-50 dark:bg-blue-900/20 text-[#137fec] flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-2xl">water_drop</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-4">Water Damage & Leaks</h3>
                    <ul class="space-y-3">
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/water-damage/"><span class="material-symbols-outlined text-base">chevron_right</span> Burst Pipe Emergency</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/water-damage/"><span class="material-symbols-outlined text-base">chevron_right</span> Slab Leak Detection</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/water-damage/"><span class="material-symbols-outlined text-base">chevron_right</span> Drying & Dehumidification</a></li>
                    </ul>
                </div>
                <!-- Mold -->
                <div class="bg-white dark:bg-[#1f2937] rounded-xl p-6 shadow-lg border border-[#dbe0e6] dark:border-[#374151] hover:-translate-y-1 transition-transform duration-300">
                    <div class="size-12 rounded-lg bg-green-50 dark:bg-green-900/20 text-green-600 flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-2xl">air</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-4">Mold & Air Quality</h3>
                    <ul class="space-y-3">
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/mold-remediation/"><span class="material-symbols-outlined text-base">chevron_right</span> Identifying Black Mold</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/mold-remediation/"><span class="material-symbols-outlined text-base">chevron_right</span> Health Risks</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/mold-remediation/"><span class="material-symbols-outlined text-base">chevron_right</span> Remediation Process</a></li>
                    </ul>
                </div>
                <!-- Remodeling -->
                <div class="bg-white dark:bg-[#1f2937] rounded-xl p-6 shadow-lg border border-[#dbe0e6] dark:border-[#374151] hover:-translate-y-1 transition-transform duration-300">
                    <div class="size-12 rounded-lg bg-orange-50 dark:bg-orange-900/20 text-[#f97316] flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-2xl">design_services</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-4">Design & Remodeling</h3>
                    <ul class="space-y-3">
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/remodeling-services/kitchen-remodeling/"><span class="material-symbols-outlined text-base">chevron_right</span> Modern Kitchen Layouts</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/remodeling-services/bathroom-remodeling/"><span class="material-symbols-outlined text-base">chevron_right</span> Bathroom Vanities</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/remodeling-services/"><span class="material-symbols-outlined text-base">chevron_right</span> Flooring Guides</a></li>
                    </ul>
                </div>
                <!-- Storm Prep -->
                <div class="bg-white dark:bg-[#1f2937] rounded-xl p-6 shadow-lg border border-[#dbe0e6] dark:border-[#374151] hover:-translate-y-1 transition-transform duration-300">
                    <div class="size-12 rounded-lg bg-purple-50 dark:bg-purple-900/20 text-purple-600 flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-2xl">cyclone</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-4">Storm Prep & Safety</h3>
                    <ul class="space-y-3">
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/storm-damage/"><span class="material-symbols-outlined text-base">chevron_right</span> Hurricane Checklist</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/storm-damage/"><span class="material-symbols-outlined text-base">chevron_right</span> Roof Tarping</a></li>
                        <li><a class="text-[#617589] hover:text-[#137fec] text-sm flex items-center gap-2" href="/restoration/storm-damage/"><span class="material-symbols-outlined text-base">chevron_right</span> Backup Generators</a></li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Featured Guide -->
        <section class="w-full max-w-[1440px] mx-auto px-4 md:px-10 py-12">
            <div class="bg-[#111418] rounded-2xl overflow-hidden shadow-2xl">
                <div class="flex flex-col lg:flex-row">
                    <div class="w-full lg:w-1/2 p-8 md:p-16 flex flex-col justify-center">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f97316]/20 border border-[#f97316]/30 backdrop-blur-sm mb-6 w-fit">
                            <span class="material-symbols-outlined text-[#f97316] text-sm">trending_up</span>
                            <span class="text-[#f97316] text-xs font-bold uppercase tracking-wide">Featured Pillar Guide</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">The Ultimate Guide to Restoration Costs in Florida (2024 Edition)</h2>
                        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                            Stop guessing. Our comprehensive annual report breaks down the real cost of water damage repair, mold remediation, and reconstruction per square foot in the Florida market.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="/contact/" class="h-12 px-8 rounded-lg bg-[#137fec] text-white font-bold hover:bg-blue-600 transition-colors flex items-center justify-center">
                                Read the Full Guide
                            </a>
                            <a href="/resources/" class="h-12 px-8 rounded-lg bg-transparent border border-white/20 text-white font-bold hover:bg-white/10 transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">download</span> Download PDF
                            </a>
                        </div>
                    </div>
                    <div class="w-full lg:w-1/2 relative h-[300px] lg:h-auto">
                        <img alt="Contractors reviewing blueprints and cost estimates" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAyi0958AQCAcOfHoovisd-zCwA7NKzNYzV0nMJsDW3NC6Zrp5opDNusmDtNofQoVBQns-Zt2P4RYkQH00yaNOGTi-2jZIreonuYif24QFrY3KL3qNCjuimr9RA-sizajKyKJH1DY2Il2w2cQDBagWvhKLcqrrSjk2kYfSg5A4e0iXxX2S1C8lRX-9_CFWiWZAOAESmnW8-a5Fkf3IdNh41EJEPzsR2dehiqSOZY5ijSX8NZRR4nutBljtQt_v07AN_Hh6y3teLFvMJ" />
                        <div class="absolute inset-0 bg-gradient-to-r from-[#111418] to-transparent lg:bg-gradient-to-t lg:from-transparent lg:to-transparent"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Insurance Claims Hub -->
        <section class="w-full bg-blue-50 dark:bg-[#1f2937]/50 border-y border-[#dbe0e6] dark:border-[#374151] py-20">
            <div class="max-w-[1440px] mx-auto px-4 md:px-10">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <span class="text-[#137fec] font-bold tracking-wider uppercase text-sm mb-2 block">Advocacy & Process</span>
                    <h2 class="text-3xl md:text-4xl font-bold text-[#111418] dark:text-white mb-4">Insurance Claims Hub</h2>
                    <p class="text-[#617589] dark:text-[#9ca3af] text-lg">Navigating property insurance claims can be complex. We break it down into simple, actionable steps.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Claim Step 1 -->
                    <a class="group block bg-white dark:bg-[#111418] p-8 rounded-xl border border-[#dbe0e6] dark:border-[#374151] hover:border-[#137fec] transition-all shadow-sm hover:shadow-lg" href="/contact/">
                        <div class="size-14 rounded-full bg-[#f0f2f4] dark:bg-[#1f2937] flex items-center justify-center mb-6 group-hover:bg-[#137fec] transition-colors">
                            <span class="material-symbols-outlined text-3xl text-[#617589] dark:text-[#9ca3af] group-hover:text-white transition-colors">description</span>
                        </div>
                        <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3 group-hover:text-[#137fec] transition-colors">How to File a Claim</h3>
                        <p class="text-[#617589] text-sm leading-relaxed mb-4">Step-by-step instructions on what to document, who to call, and what to say during the first 24 hours.</p>
                        <span class="text-[#137fec] font-bold text-sm flex items-center gap-1">Read Guide <span class="material-symbols-outlined text-base">arrow_forward</span></span>
                    </a>
                    <!-- Claim Step 2 -->
                    <a class="group block bg-white dark:bg-[#111418] p-8 rounded-xl border border-[#dbe0e6] dark:border-[#374151] hover:border-[#137fec] transition-all shadow-sm hover:shadow-lg" href="/contact/">
                        <div class="size-14 rounded-full bg-[#f0f2f4] dark:bg-[#1f2937] flex items-center justify-center mb-6 group-hover:bg-[#137fec] transition-colors">
                            <span class="material-symbols-outlined text-3xl text-[#617589] dark:text-[#9ca3af] group-hover:text-white transition-colors">gavel</span>
                        </div>
                        <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3 group-hover:text-[#137fec] transition-colors">Denied Claim? Next Steps</h3>
                        <p class="text-[#617589] text-sm leading-relaxed mb-4">Understanding why claims get denied in Florida and how to appeal or work with a public adjuster.</p>
                        <span class="text-[#137fec] font-bold text-sm flex items-center gap-1">Read Guide <span class="material-symbols-outlined text-base">arrow_forward</span></span>
                    </a>
                    <!-- Claim Step 3 -->
                    <a class="group block bg-white dark:bg-[#111418] p-8 rounded-xl border border-[#dbe0e6] dark:border-[#374151] hover:border-[#137fec] transition-all shadow-sm hover:shadow-lg" href="/contact/">
                        <div class="size-14 rounded-full bg-[#f0f2f4] dark:bg-[#1f2937] flex items-center justify-center mb-6 group-hover:bg-[#137fec] transition-colors">
                            <span class="material-symbols-outlined text-3xl text-[#617589] dark:text-[#9ca3af] group-hover:text-white transition-colors">history_edu</span>
                        </div>
                        <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3 group-hover:text-[#137fec] transition-colors">Documenting Loss</h3>
                        <p class="text-[#617589] text-sm leading-relaxed mb-4">Download our photo checklist to ensure you capture every detail of damage before cleanup begins.</p>
                        <span class="text-[#137fec] font-bold text-sm flex items-center gap-1">Read Guide <span class="material-symbols-outlined text-base">arrow_forward</span></span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Tools & Resources -->
        <section class="w-full max-w-[1440px] mx-auto px-4 md:px-10 py-20">
            <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
                <div>
                    <h2 class="text-3xl font-bold text-[#111418] dark:text-white mb-2">Interactive Tools & Resources</h2>
                    <p class="text-[#617589] dark:text-[#9ca3af]">Calculators, checklists, and downloads to help you plan.</p>
                </div>
                <a class="text-[#137fec] font-bold hover:underline" href="/resources/">View All Resources</a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Tool 1 -->
                <div class="flex flex-col bg-white dark:bg-[#111418] rounded-xl overflow-hidden border border-[#dbe0e6] dark:border-[#374151] shadow-sm hover:shadow-xl transition-shadow">
                    <div class="h-48 bg-[#f0f2f4] dark:bg-[#1f2937] flex items-center justify-center relative group">
                        <span class="material-symbols-outlined text-6xl text-[#dbe0e6] group-hover:scale-110 transition-transform duration-500">calculate</span>
                        <div class="absolute top-4 right-4 bg-[#137fec] text-white text-xs font-bold px-2 py-1 rounded">Interactive</div>
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Restoration Cost Estimator</h3>
                        <p class="text-[#617589] text-sm mb-6">Get a rough estimate for your project based on square footage and damage type.</p>
                        <a href="/contact/" class="mt-auto w-full py-3 rounded-lg bg-[#111418] dark:bg-white text-white dark:text-[#111418] font-bold hover:opacity-90 transition-opacity text-center block">
                            Start Calculator
                        </a>
                    </div>
                </div>
                <!-- Tool 2 -->
                <div class="flex flex-col bg-white dark:bg-[#111418] rounded-xl overflow-hidden border border-[#dbe0e6] dark:border-[#374151] shadow-sm hover:shadow-xl transition-shadow">
                    <div class="h-48 bg-[#f0f2f4] dark:bg-[#1f2937] flex items-center justify-center relative group">
                        <span class="material-symbols-outlined text-6xl text-[#dbe0e6] group-hover:scale-110 transition-transform duration-500">checklist</span>
                        <div class="absolute top-4 right-4 bg-[#f97316] text-white text-xs font-bold px-2 py-1 rounded">PDF Download</div>
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Hurricane Prep Checklist</h3>
                        <p class="text-[#617589] text-sm mb-6">A printable one-pager to ensure your home and family are ready for storm season.</p>
                        <a href="/restoration/storm-damage/" class="mt-auto w-full py-3 rounded-lg border-2 border-[#dbe0e6] dark:border-[#374151] text-[#111418] dark:text-white font-bold hover:bg-[#f0f2f4] dark:hover:bg-[#1f2937] transition-colors text-center block">
                            Download PDF
                        </a>
                    </div>
                </div>
                <!-- Tool 3 -->
                <div class="flex flex-col bg-white dark:bg-[#111418] rounded-xl overflow-hidden border border-[#dbe0e6] dark:border-[#374151] shadow-sm hover:shadow-xl transition-shadow">
                    <div class="h-48 bg-[#f0f2f4] dark:bg-[#1f2937] flex items-center justify-center relative group">
                        <span class="material-symbols-outlined text-6xl text-[#dbe0e6] group-hover:scale-110 transition-transform duration-500">image_search</span>
                        <div class="absolute top-4 right-4 bg-[#137fec] text-white text-xs font-bold px-2 py-1 rounded">Visual Guide</div>
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">Mold Identification Chart</h3>
                        <p class="text-[#617589] text-sm mb-6">Visual guide to common household molds, their colors, and danger levels.</p>
                        <a href="/restoration/mold-remediation/" class="mt-auto w-full py-3 rounded-lg border-2 border-[#dbe0e6] dark:border-[#374151] text-[#111418] dark:text-white font-bold hover:bg-[#f0f2f4] dark:hover:bg-[#1f2937] transition-colors text-center block">
                            View Guide
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Fresh Content / Blog Grid -->
        <section class="w-full bg-white dark:bg-[#111418] border-t border-[#dbe0e6] dark:border-[#374151] py-20">
            <div class="max-w-[1440px] mx-auto px-4 md:px-10">
                <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-6">
                    <div>
                        <span class="text-[#137fec] font-bold text-sm tracking-wider uppercase">Fresh Content</span>
                        <h2 class="text-3xl font-bold text-[#111418] dark:text-white mt-2">Latest Industry Insights</h2>
                    </div>
                    <div class="flex gap-2">
                        <a href="/resources/water-damage" class="size-10 rounded-full border border-[#dbe0e6] dark:border-[#374151] flex items-center justify-center hover:bg-[#f0f2f4] dark:hover:bg-[#1f2937] text-[#111418] dark:text-white">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </a>
                        <a href="/resources/water-damage" class="size-10 rounded-full bg-[#137fec] text-white flex items-center justify-center hover:bg-blue-600">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {sortedPosts.map(post => (
                    <a href={`/resources/${post.data.subcategory}/${post.slug}`} class="flex flex-col group cursor-pointer">
                        <div class="relative rounded-xl overflow-hidden aspect-[16/10] mb-4">
                            {post.data.image && (
                            <img alt={post.data.title} class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500" src={post.data.image} />
                            )}
                            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold text-[#111418] uppercase">{post.data.category}</div>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-[#617589] mb-3">
                            <span class="material-symbols-outlined text-sm">calendar_today</span> {post.data.pubDate.toLocaleDateString()}
                        </div>
                        <h3 class="text-xl font-bold text-[#111418] dark:text-white mb-3 group-hover:text-[#137fec] transition-colors line-clamp-2">
                            {post.data.title}
                        </h3>
                        <p class="text-[#617589] dark:text-[#9ca3af] text-sm mb-4 line-clamp-3">
                            {post.data.description}
                        </p>
                        <span class="text-[#137fec] font-bold text-sm mt-auto inline-flex items-center gap-1">Read Article <span class="material-symbols-outlined text-sm">arrow_forward</span></span>
                    </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="w-full bg-[#137fec] py-12">
            <div class="max-w-[1440px] mx-auto px-4 md:px-10 flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Need Help with a Specific Problem?</h2>
                    <p class="text-blue-100 text-lg">Our experts are available to answer your questions.</p>
                </div>
                <div class="flex gap-4">
                    <a href="/contact/" class="h-12 px-6 rounded-lg bg-white text-[#137fec] text-base font-bold hover:bg-blue-50 transition-colors shadow-lg flex items-center justify-center">
                        Ask an Expert
                    </a>
