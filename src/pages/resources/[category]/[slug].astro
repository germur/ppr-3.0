---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { 
        category: post.data.subcategory,
        slug: post.slug 
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Fetch Related Posts from SAME Subcategory
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
    .filter(p => p.data.subcategory === post.data.subcategory && p.slug !== post.slug)
    .slice(0, 3);
---

<MainLayout title={post.data.title}>
{post.data.fullWidth ? (
      <Content />
  ) : (
    <div class="bg-white dark:bg-slate-900 min-h-screen">
      
      <!-- Reading Progress Bar -->
      <div class="fixed top-0 left-0 w-full h-1 bg-gray-200 z-50">
          <div class="bg-blue-600 h-full w-0" id="progress-bar"></div>
      </div>
  
      <!-- Header -->
      <header class="bg-[#111418] text-white py-20 px-4">
          <div class="container mx-auto max-w-4xl">
               <div class="flex items-center gap-3 text-sm text-gray-400 mb-6">
                   <a href="/resources" class="hover:text-white">Resources</a>
                   <span class="material-symbols-outlined text-xs">chevron_right</span>
                   <a href={`/resources/${post.data.subcategory}`} class="hover:text-white capitalize">{post.data.subcategory.replace('-', ' ')}</a>
                   <span class="material-symbols-outlined text-xs">chevron_right</span>
                   <span class="text-white line-clamp-1">{post.data.title}</span>
               </div>
               <h1 class="text-3xl md:text-5xl font-black leading-tight mb-6">{post.data.title}</h1>
               <div class="flex items-center gap-4">
                   {post.data.author && (
                       <div class="flex items-center gap-2">
                           <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold text-xs">
                               {post.data.author.charAt(0)}
                           </div>
                           <span class="font-medium">{post.data.author}</span>
                       </div>
                   )}
                   <span class="text-gray-500">•</span>
                   <time>{post.data.pubDate.toLocaleDateString()}</time>
               </div>
          </div>
      </header>
  
      <div class="container mx-auto max-w-6xl px-4 py-12 grid lg:grid-cols-12 gap-12">
          
          <!-- Main Content -->
          <main class="lg:col-span-8">
              <article class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 hover:prose-a:text-blue-700 md:prose-img:rounded-xl">
                   {post.data.image && (
                       <img src={post.data.image} alt={post.data.title} class="w-full aspect-video object-cover rounded-xl mb-8 shadow-sm" />
                   )}
                   <Content />
              </article>
  
              <!-- CTA -->
              <div class="mt-16 bg-blue-50 dark:bg-blue-900/20 p-8 rounded-2xl border border-blue-100 dark:border-blue-800 text-center">
                  <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Need Professional Help?</h3>
                  <p class="text-slate-600 dark:text-slate-300 mb-6">Get a free consultation from Florida's trusted restoration experts.</p>
                  <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 bg-[#1162d4] text-white font-bold rounded-lg hover:bg-blue-700 transition-all shadow-lg hover:shadow-xl">
                      Request Evaluation
                  </a>
              </div>
          </main>
  
          <!-- Sidebar (Sticky) -->
          <aside class="lg:col-span-4 space-y-8">
              <div class="sticky top-8">
                  <!-- Related Articles (Siloed) -->
                  {relatedPosts.length > 0 && (
                      <div class="bg-gray-50 dark:bg-slate-800 p-6 rounded-xl border border-gray-200 dark:border-slate-700">
                          <h3 class="font-bold text-lg mb-4 text-slate-900 dark:text-white flex items-center gap-2">
                              <span class="material-symbols-outlined text-blue-600">library_books</span>
                              Related Guides
                          </h3>
                          <div class="space-y-4">
                              {relatedPosts.map(rel => (
                                  <a href={`/resources/${rel.data.subcategory}/${rel.slug}`} class="block group">
                                      <h4 class="font-bold text-slate-700 dark:text-slate-300 group-hover:text-blue-600 line-clamp-2 transition-colors">
                                          {rel.data.title}
                                      </h4>
                                      <span class="text-xs text-gray-500 mt-1 block">Read More →</span>
                                  </a>
                              ))}
                          </div>
                      </div>
                  )}
  
                  <!-- Category Menu -->
                  <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-gray-200 dark:border-slate-700 mt-8">
                      <h3 class="font-bold text-lg mb-4 text-slate-900 dark:text-white">Topics</h3>
                      <ul class="space-y-2 text-sm">
                          <li><a href="/resources/water-damage" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 block py-1">Water Damage</a></li>
                          <li><a href="/resources/fire-smoke" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 block py-1">Fire & Smoke</a></li>
                          <li><a href="/resources/mold-remediation" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 block py-1">Mold Remediation</a></li>
                          <li><a href="/resources/kitchen-renovations" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 block py-1">Kitchen Renovation</a></li>
                      </ul>
                  </div>
              </div>
          </aside>
  
      </div>
  
    </div>
  )}

  <script>
      // Simple Scroll Progress
      window.addEventListener('scroll', () => {
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          const progressBar = document.getElementById('progress-bar');
          if (progressBar) {
              progressBar.style.width = scrolled + "%";
          }
      });
  </script>
</MainLayout>
