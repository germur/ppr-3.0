---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "Storm Preparation Guide | Paramount";
const description = "Essential checklist and tips for preparing your Florida home for hurricane season.";
---

<MainLayout title={title} description={description}>
    <section class="min-h-[60vh] flex items-center justify-center bg-gray-50 dark:bg-gray-900">
        <div class="text-center px-4">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Storm Preparation Guide</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">Expert tips to secure your property before the storm hits.</p>
            <p class="text-sm text-gray-500">Resource content coming soon.</p>
        </div>
    </section>
</MainLayout>
