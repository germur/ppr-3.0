---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "Insurance Claims Tips & Guide | Paramount Property Restoration";
const description = "Navigate your property damage insurance claim with confidence. Expert advice for Florida homeowners.";
---

<MainLayout title={title} description={description}>
    <section class="min-h-[60vh] flex items-center justify-center bg-gray-50 dark:bg-gray-900">
        <div class="text-center px-4">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Insurance Claims Guide</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">Learn the dos and don'ts of filing a property damage claim.</p>
             <a href="/contact" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg transition-colors">
                Speak to a Claims Specialist
            </a>
        </div>
    </section>
</MainLayout>
