---
import MainLayout from '../../layouts/MainLayout.astro';
import ServiceHero from '../../components/service/ServiceHero';
import { FileText, Phone, CheckCircle, AlertTriangle } from 'lucide-react';
---

<MainLayout title="Insurance Claims Assistance | Paramount Property Restoration" description="We work directly with your insurance carrier to expedite your claim. Guide for homeowners on navigating property damage claims." service="restoration">
    <ServiceHero 
        client:load
        title="Insurance Claims Assistance"
        subtitle="We speak the language of insurance adjusters so you don't have to. We bill your carrier directly."
        image="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?q=80&w=2670&auto=format&fit=crop"
        serviceType="restoration"
    >
         <div slot="extra-content" class="mt-8">
            <button class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-bold">Start a Claim</button>
        </div>
    </ServiceHero>

    <section class="py-24 bg-white">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <h2 class="text-3xl font-bold mb-6">Direct Billing to All Major Carriers</h2>
            <p class="text-slate-600 mb-12">We work with every major homeowners insurance provider in Florida. Our goal is to ensure your claim is documented correctly from Day 1.</p>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 opacity-60 grayscale hover:grayscale-0 transition-all cursor-pointer">
                {/* Simulated Logos */}
                <div class="h-16 bg-slate-100 rounded-lg flex items-center justify-center font-bold text-slate-400">State Farm</div>
                <div class="h-16 bg-slate-100 rounded-lg flex items-center justify-center font-bold text-slate-400">Allstate</div>
                <div class="h-16 bg-slate-100 rounded-lg flex items-center justify-center font-bold text-slate-400">Liberty Mutual</div>
                <div class="h-16 bg-slate-100 rounded-lg flex items-center justify-center font-bold text-slate-400">Citizens</div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-slate-50">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                 <div>
                    <h2 class="text-3xl font-bold mb-8">The "Assignment of Benefits" (AOB)</h2>
                    <div class="bg-yellow-50 border-l-4 border-yellow-500 p-6 mb-8">
                        <div class="flex items-start gap-4">
                            <AlertTriangle className="text-yellow-600 shrink-0" />
                            <p class="text-sm text-yellow-800">Warning: Florida laws regarding AOBs have changed. Ensure you understand what you are signing.</p>
                        </div>
                    </div>
                    <p class="text-slate-600 mb-4">We believe in transparency. We will explain exactly what forms authorize us to communicate with your carrier and perform work.</p>
                    <p class="text-slate-600 font-bold">We Document Everything:</p>
                    <ul class="mt-4 space-y-2">
                        <li class="flex items-center gap-2 text-sm text-slate-600"><CheckCircle size={16} className="text-green-500"/> Moisture Mapping Reports</li>
                         <li class="flex items-center gap-2 text-sm text-slate-600"><CheckCircle size={16} className="text-green-500"/> Thermal Imaging Proof</li>
                          <li class="flex items-center gap-2 text-sm text-slate-600"><CheckCircle size={16} className="text-green-500"/> Itemized Loss Inventory</li>
                    </ul>
                 </div>
                 
                 <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
                    <h3 class="text-xl font-bold mb-6">Process a Claim</h3>
                    <form class="space-y-4" name="insurance-claims-lead" method="POST" data-netlify="true">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Insurance Carrier</label>
                            <input type="text" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3" placeholder="e.g. State Farm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Policy Number</label>
                            <input type="text" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3" placeholder="Policy #" />
                        </div>
                         <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Claim Number (If assigned)</label>
                            <input type="text" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-3" placeholder="Claim #" />
                        </div>
                        <button class="w-full bg-blue-600 text-white font-bold py-4 rounded-lg hover:bg-blue-700 transition-colors">Submit Information</button>
                    </form>
                 </div>
            </div>
        </div>
    </section>

</MainLayout>
