---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Home Additions | Paramount Property Restoration">
  <div class="py-20 px-6 max-w-4xl mx-auto text-center">
    <h1 class="text-4xl font-bold mb-6 text-gray-900 dark:text-white">Home Additions</h1>
    <p class="text-lg text-gray-600 dark:text-gray-300">
      Expand your living space with our expert home addition services.
    </p>
    <div class="mt-12 p-8 bg-gray-50 dark:bg-gray-800 rounded-xl">
      <p class="text-gray-500 italic">Portfolio and service details coming soon.</p>
    </div>
  </div>
</MainLayout>
