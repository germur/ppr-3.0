---
import RemodelingLayout from '../../layouts/RemodelingLayout.astro';

const pageTitle = "Kitchen Remodeling - Paramount Property Restoration";
---

<RemodelingLayout title={pageTitle}>
    <main class="flex flex-col">
        <!-- Hero Section -->
        <section class="relative w-full py-12 lg:py-20 overflow-hidden bg-white dark:bg-[#101822]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <!-- Hero Content -->
                    <div class="flex flex-col gap-6 order-2 lg:order-1">
                        <div class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 dark:bg-blue-900/30 px-3 py-1 text-xs font-semibold text-[#1162d4] dark:text-blue-300 border border-blue-100 dark:border-blue-800">
                            <span class="material-symbols-outlined text-[16px]">verified</span>
                            Trusted & Reliable
                        </div>
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight text-[#111418] dark:text-white">
                            Transform Your Home with Expert <span class="text-[#1162d4]">Kitchen Remodeling</span>
                        </h1>
                        <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-xl">
                            From initial concept to final polish, we handle design, permits, and construction. Experience a seamless renovation for your dream kitchen.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 mt-2">
                            <button class="flex items-center justify-center rounded-lg bg-[#f97316] hover:bg-[#ea580c] text-white h-12 px-8 text-base font-bold transition-all shadow-lg shadow-orange-500/20">
                                Get Your Free Kitchen Estimate
                            </button>
                            <button class="flex items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#1a2432] text-[#111418] dark:text-white h-12 px-6 text-base font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
                                View Portfolio
                            </button>
                        </div>
                        <!-- Trust Badges -->
                        <div class="pt-6 border-t border-gray-100 dark:border-gray-800 flex flex-wrap gap-6 items-center opacity-80">
                            <div class="flex items-center gap-1.5 text-xs font-bold text-gray-500 dark:text-gray-400">
                                <span class="material-symbols-outlined text-yellow-500">star</span>
                                4.9/5 Average Rating
                            </div>
                            <div class="flex items-center gap-1.5 text-xs font-bold text-gray-500 dark:text-gray-400">
                                <span class="material-symbols-outlined text-green-600">check_circle</span>
                                100% Satisfaction Guarantee
                            </div>
                            <div class="flex items-center gap-1.5 text-xs font-bold text-gray-500 dark:text-gray-400">
                                <span class="material-symbols-outlined text-[#1162d4]">schedule</span>
                                On-Time Completion
                            </div>
                        </div>
                    </div>
                    <!-- Hero Image -->
                    <div class="order-1 lg:order-2 relative group">
                        <div class="absolute -inset-1 bg-gradient-to-r from-[#1162d4] to-[#f97316] rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
                        <div class="relative w-full aspect-[4/3] sm:aspect-video lg:aspect-square xl:aspect-[4/3] bg-gray-200 rounded-xl overflow-hidden shadow-2xl">
                            <img alt="Bright modern kitchen with white island and wooden stools" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB84zNki7ECfo-eN9s2sM7KbPMIdkP1D5n_26gUPtsjyebAsrGsgdUHh2S5RjZuRb-7UmHgdyOszUIoodSYtCjXbKGL0OejjZcbhRFl11P-UNK5Xeme0f0igHcCd6-BW_C7C_HLwUEnrXxd9MD54ODsA7vln1trS9fe3uP8UqfNYeB0b-GyTSEBOzRZnjkWdJ4RSH3q1ibbOZRlhtb0vx7QrtQ1SJmqnNKZaazxb-4TVlpIM1UEQYyv0h5TzuLPOTLrtn23vZCaBq6i" />
                            <!-- Floating Card -->
                            <div class="absolute bottom-6 left-6 right-6 bg-white/90 dark:bg-[#1a2432]/95 backdrop-blur-sm p-4 rounded-lg shadow-lg border border-white/20 flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Project</p>
                                    <p class="text-sm font-bold text-[#111418] dark:text-white">Modern Farmhouse - Austin, TX</p>
                                </div>
                                <div class="h-10 w-10 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600 dark:text-green-400">
                                    <span class="material-symbols-outlined">trending_up</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Bento Grid / Inspiration Section -->
        <section class="py-16 lg:py-24 bg-white dark:bg-[#0b1118]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <h2 class="text-3xl font-bold tracking-tight text-[#111418] dark:text-white sm:text-4xl mb-4">Dream Your Design</h2>
                    <p class="text-lg text-gray-500 dark:text-gray-400">Explore the possibilities. From chef-grade functionality to open-concept living, we bring your vision to life.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 grid-rows-2 gap-4 h-auto md:h-[600px]">
                    <!-- Large item spanning 2 rows on desktop -->
                    <div class="group relative md:row-span-2 overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Luxury open concept kitchen with large windows and sunlight" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDZCBnNamDCMPuNNdsbQSOzE0X6MIwDS33z2c_q6wakkmRlyXZ6xBFFY-VEC8yZCUWU_pJAqodqw1wWmbMI9QvAeCvN2qdrj7UhXIgveKzorgOxkc88owCuepzEQ4uyaUGB1o_ohq-2PZ85TzL7FVp_PMFYFHBBFgPl33F4P4-ZZu7RlCEPBTpU4_gruiUBveY5RlQl601LSxCTkzyLdOyOYdLLW2xrkmdeQD7Q4VgdaoEfYUO8pMdpBYLr5B-EvpmC0DyIfKqzz7zv" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 p-6">
                            <h3 class="text-xl font-bold text-white mb-1">Modern & Open Concept</h3>
                            <p class="text-sm text-gray-200 line-clamp-2">Seamlessly blend your cooking and living spaces for a spacious, airy feel.</p>
                        </div>
                    </div>
                    <!-- Wide item -->
                    <div class="group relative md:col-span-2 overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Professional grade stainless steel appliances and large range hood" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD6Q_H6wmOAyahepJVo7Niv047DUNRpYzZIwpC-gu3wGWBQZP3unGooCe4xDaspSAJUft_OM2qh7FjW9-J8o3ELMTu9tFQ9MaynPJ3YTxvZYgr_WtMQREBTceolPmyUhC62xFwgZhzkRRHCTi0R1jIKUi8mP8sZnYdMn3ZUm3WTH-aV4vU1TFXeeJq5w39Up9LjKAT7Sji0fU5SMmze0YzmCZRN-KaNG2bZVyRnkPY3yloBXLMsQkS7ZWN-5CukO-E082AQyVhgU1sJ" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 p-6">
                            <h3 class="text-xl font-bold text-white mb-1">Chef’s Grade Kitchens</h3>
                            <p class="text-sm text-gray-200">High-performance appliances and ergonomic layouts for the serious cook.</p>
                        </div>
                    </div>
                    <!-- Standard item -->
                    <div class="group relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Custom navy blue cabinetry with gold hardware detail" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAbSclWJlcnhRqYC1FEEvkyrp9aEJXyIChqeF7gvyBZYlRwmQIjDgw_099ev8kysOx4_ntFWHl-3f33Jysmt5ZaahUjbqB31uBTFH67M8Fts5J_xw-kl3UlKcJKszP5_T99cLZuZ4Ov5UIS5e1lk-MJ3dUOqDICrzl6SIsrXnt-6t9ODGBGBhcCd0HVWVtTGwZo7iug007ZOOf7Q89aovuPFpWUUQiH7gMCPlDEbNC7pkynXrXQEQvhZtmTIijXc0fwLBNZ7w4_hL0R" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 p-6">
                            <h3 class="text-xl font-bold text-white mb-1">Custom Cabinetry</h3>
                            <p class="text-sm text-gray-200">Maximize storage with bespoke solutions.</p>
                        </div>
                    </div>
                    <!-- Standard item -->
                    <div class="group relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
                        <img alt="Close up of marble countertop texture and undermount sink" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuI743BFRk8O0ZuoUxuH9AC03EACxQCcWN8F8fUAnTXqVy8qlwPdf03jyL0BAbCBjMJLkfoVnjgKfNjepRsW_jAz5bLzWh1hiuAJ6C-RQ--NtzuVNk3bwNQM2FflVbwjmBC1SpMhJuyFIWNllR8gJXAMyRt88fFJjo07OKzdKo6oBCUeLSxR3piJPcYaNjD3u98ntwlNQM1YBUDNe_SA54laY5TIfLkF0UYLzplYFprH2ARal1aNvHVhXXLgVVA5ylm6Y7RTGE6eKs" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 p-6">
                            <h3 class="text-xl font-bold text-white mb-1">Luxury Countertops</h3>
                            <p class="text-sm text-gray-200">Quartz, Granite, and Marble finishes.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Process Section -->
        <section class="py-16 lg:py-24 bg-[#f6f7f8] dark:bg-[#101922]">
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
                <div class="mb-16 md:text-center">
                    <span class="text-[#1162d4] font-bold tracking-wider uppercase text-sm">Transparent Journey</span>
                    <h2 class="text-3xl font-bold tracking-tight text-[#111418] dark:text-white sm:text-4xl mt-2">Our 4-Step Renovation Process</h2>
                </div>
                <div class="relative grid grid-cols-1 md:grid-cols-4 gap-8">
                    <!-- Connector Line (Desktop) -->
                    <div class="hidden md:block absolute top-8 left-[12.5%] right-[12.5%] h-0.5 bg-gray-200 dark:bg-gray-700 -z-10"></div>
                    <!-- Step 1 -->
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-[#1162d4] text-[#1162d4] flex items-center justify-center shadow-lg mb-6 group-hover:scale-110 transition-transform">
                            <span class="material-symbols-outlined text-3xl">design_services</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">1. Consultation & Design</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">We meet to discuss your vision, budget, and timeline. Our designers create 3D renderings of your new space.</p>
                    </div>
                    <!-- Step 2 -->
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 flex items-center justify-center shadow-lg mb-6 group-hover:border-[#1162d4] group-hover:text-[#1162d4] group-hover:scale-110 transition-all">
                            <span class="material-symbols-outlined text-3xl">sound_sampler</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">2. Material Selection</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Choose your cabinets, countertops, flooring, and fixtures with guidance from our style experts.</p>
                    </div>
                    <!-- Step 3 -->
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 flex items-center justify-center shadow-lg mb-6 group-hover:border-[#1162d4] group-hover:text-[#1162d4] group-hover:scale-110 transition-all">
                            <span class="material-symbols-outlined text-3xl">construction</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">3. Demolition & Build</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Our expert team handles everything from permits to plumbing, keeping the site clean and safe.</p>
                    </div>
                    <!-- Step 4 -->
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-white dark:bg-[#1a2432] border-2 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 flex items-center justify-center shadow-lg mb-6 group-hover:border-[#1162d4] group-hover:text-[#1162d4] group-hover:scale-110 transition-all">
                            <span class="material-symbols-outlined text-3xl">check_circle</span>
                        </div>
                        <h3 class="text-lg font-bold text-[#111418] dark:text-white mb-2">4. Final Walkthrough</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">We perform a detailed inspection to ensure every detail is perfect before handing over your new kitchen.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ROI & Value Section -->
        <section class="py-16 lg:py-24 bg-[#1162d4] text-white overflow-hidden relative">
            <!-- Background Pattern -->
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 30px 30px;"></div>
            <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <h2 class="text-3xl sm:text-4xl font-black mb-6">Invest in Your Home's Value</h2>
                        <p class="text-blue-100 text-lg mb-8 leading-relaxed">
                            A kitchen remodel isn't just about style—it's a smart financial decision. Real estate data consistently shows that updated kitchens are the #1 feature homebuyers look for.
                        </p>
                        <div class="flex flex-col gap-6">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-2xl">trending_up</span>
                                </div>
                                <div>
                                    <h4 class="text-xl font-bold mb-1">Up to 80% ROI</h4>
                                    <p class="text-blue-100 text-sm">Recover a significant portion of your renovation costs upon resale.</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-2xl">energy_savings_leaf</span>
                                </div>
                                <div>
                                    <h4 class="text-xl font-bold mb-1">Energy Efficiency</h4>
                                    <p class="text-blue-100 text-sm">New appliances and lighting can reduce your utility bills by up to 30%.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white dark:bg-[#1a2432] text-[#111418] dark:text-white rounded-2xl p-8 shadow-2xl">
                        <div class="flex items-center justify-between mb-8 border-b border-gray-100 dark:border-gray-700 pb-4">
                            <h3 class="font-bold text-xl">Estimated Value Increase</h3>
                            <span class="text-green-600 dark:text-green-400 font-bold bg-green-50 dark:bg-green-900/20 px-3 py-1 rounded-full text-sm">+ $35,000</span>
                        </div>
                        <!-- Simple visual graph representation -->
                        <div class="space-y-6">
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2 text-gray-500 dark:text-gray-400">
                                    <span>Pre-Renovation Value</span>
                                    <span>$450,000</span>
                                </div>
                                <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-3">
                                    <div class="bg-gray-400 h-3 rounded-full" style="width: 75%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2">
                                    <span class="font-bold text-[#1162d4]">Post-Renovation Value</span>
                                    <span class="font-bold text-[#1162d4]">$485,000</span>
                                </div>
                                <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-3 relative">
                                    <div class="bg-[#f97316] h-3 rounded-full absolute top-0 left-0 animate-pulse" style="width: 88%"></div>
                                    <div class="bg-[#1162d4] h-3 rounded-full relative z-10" style="width: 82%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-700">
                            <p class="text-xs text-center text-gray-500 italic">
                                *Estimates vary based on location and scope of work. Consult our experts for a detailed analysis.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-16 lg:py-24 bg-white dark:bg-[#0b1118]">
            <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-3xl font-bold text-center mb-12 text-[#111418] dark:text-white">Frequently Asked Questions</h2>
                <div class="space-y-4">
                    <!-- Q1 -->
                    <details class="group bg-[#f6f7f8] dark:bg-[#1a2432] rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-6 text-gray-900 dark:text-white font-bold hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <h3 class="text-lg">Do I need a permit for my kitchen remodel?</h3>
                            <span class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-gray-900 dark:text-white sm:p-3 group-open:-rotate-180 transition-transform">
                                <span class="material-symbols-outlined">expand_more</span>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 leading-relaxed text-gray-600 dark:text-gray-300">
                            <p>Most structural changes, electrical work, and plumbing updates require permits. As a full-service remodeling company, Paramount Property Restoration handles all permitting and city inspections for you.</p>
                        </div>
                    </details>
                    <!-- Q2 -->
                    <details class="group bg-[#f6f7f8] dark:bg-[#1a2432] rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-6 text-gray-900 dark:text-white font-bold hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <h3 class="text-lg">How long does a typical kitchen renovation take?</h3>
                            <span class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-gray-900 dark:text-white sm:p-3 group-open:-rotate-180 transition-transform">
                                <span class="material-symbols-outlined">expand_more</span>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 leading-relaxed text-gray-600 dark:text-gray-300">
                            <p>Timelines vary by scope, but a standard kitchen remodel typically takes 6-8 weeks from demolition to completion. We provide a detailed schedule before we start so you know exactly what to expect.</p>
                        </div>
                    </details>
                    <!-- Q3 -->
                    <details class="group bg-[#f6f7f8] dark:bg-[#1a2432] rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-6 text-gray-900 dark:text-white font-bold hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <h3 class="text-lg">Can I stay in my home during the renovation?</h3>
                            <span class="shrink-0 rounded-full bg-white dark:bg-gray-700 p-1.5 text-gray-900 dark:text-white sm:p-3 group-open:-rotate-180 transition-transform">
                                <span class="material-symbols-outlined">expand_more</span>
                            </span>
                        </summary>
                        <div class="px-6 pb-6 leading-relaxed text-gray-600 dark:text-gray-300">
                            <p>Yes, most clients stay home. We set up dust barriers and temporary kitchenette areas to minimize disruption to your daily life.</p>
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-20 bg-[#f6f7f8] dark:bg-[#101822] border-t border-gray-200 dark:border-gray-800">
            <div class="max-w-4xl mx-auto px-4 text-center">
                <h2 class="text-3xl sm:text-4xl font-black text-[#111418] dark:text-white mb-6">Ready to Build Your Dream Kitchen?</h2>
                <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">Schedule a free, no-obligation consultation with our design team today.</p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <button class="flex items-center justify-center rounded-lg bg-[#f97316] hover:bg-[#ea580c] text-white h-14 px-8 text-lg font-bold transition-all shadow-xl shadow-orange-500/20">
                        Get Your Free Estimate
                    </button>
                    <button class="flex items-center justify-center rounded-lg border-2 border-[#1162d4] text-[#1162d4] hover:bg-[#1162d4] hover:text-white h-14 px-8 text-lg font-bold transition-all">
                        Call (555) 123-4567
                    </button>
                </div>
            </div>
        </section>
    </main>
</RemodelingLayout>
