---
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  // Variables para Schema Dinámico
  schemaType?:
    | "LocalBusiness"
    | "Service"
    | "Article"
    | "FAQPage"
    | "EmergencyService"
    | "CleaningService";
  city?: string; // Para pSEO (ej: "Orlando")
  serviceName?: string; // Para pSEO (ej: "Water Damage Restoration")
  publishDate?: string; // Para Blogs
  authorName?: string; // Para Blogs
  faqData?: { question: string; answer: string }[]; // Para FAQs
  customSchema?: any; // Fallback for custom injections
  type?:
    | "LocalBusiness"
    | "Service"
    | "Article"
    | "FAQPage"
    | "EmergencyService"
    | "CleaningService"; // Backwards compatibility alias for schemaType
}

const {
  title,
  description,
  image = "/ppr-logo.png",
  canonical,
  noindex = false,
  schemaType = "LocalBusiness",
  city,
  serviceName,
  publishDate,
  authorName = "Paramount Property Restoration Team",
  faqData = [],
  customSchema,
  type,
} = Astro.props;

// Map legacy 'type' prop to schemaType if schemaType is default/unset but type is present
const effectiveSchemaType = type || schemaType;

import { COMPANY_INFO } from "../../data/company";

// 1. Construcción de URLs Absolutas (Crítico para SEO y OpenGraph)
const siteURL = Astro.site
  ? Astro.site.origin
  : "https://paramountpropertyrestoration.com"; // Consider pulling this from config too if available, but okay for main domain
const canonicalURL = canonical || new URL(Astro.url.pathname, siteURL).href;
const absoluteImage = new URL(image, siteURL).href;

// 2. Base del Schema: Organización Global (Siempre presente para E-E-A-T)
const organizationSchema = {
  "@type": "GeneralContractor",
  "@id": `${siteURL}/#organization`,
  name: COMPANY_INFO.name,
  url: siteURL,
  logo: `${siteURL}/ppr-logo.png`,
  image: `${siteURL}/ppr-logo.png`,
  telephone: `+1-${COMPANY_INFO.phoneDashes}`, // Ensure +1 prefix
  address: {
    "@type": "PostalAddress",
    streetAddress: COMPANY_INFO.address,
    addressLocality: COMPANY_INFO.city,
    addressRegion: COMPANY_INFO.state,
    postalCode: COMPANY_INFO.zip,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 25.790654,
    longitude: -80.370327,
  },
  license: "CGC #1529606",
  sameAs: [
    COMPANY_INFO.social.facebook,
    COMPANY_INFO.social.linkedin,
    COMPANY_INFO.social.instagram,
  ].filter(Boolean),
};

// 3. Generación Dinámica del Schema de la Página
let mainEntitySchema;

if (effectiveSchemaType === "Service" && serviceName) {
  // Schema para Páginas de Servicio y pSEO (Ciudades)
  mainEntitySchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    provider: { "@id": `${siteURL}/#organization` },
    areaServed: city
      ? {
          "@type": "City",
          name: city,
          address: {
            "@type": "PostalAddress",
            addressRegion: "FL",
            addressCountry: "US",
          },
        }
      : {
          "@type": "State",
          name: "Florida",
        },
    description: description,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: serviceName,
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: `${serviceName} in ${city || "Florida"}`,
          },
        },
      ],
    },
  };
} else if (effectiveSchemaType === "Article") {
  // Schema para Blog (Potencia E-E-A-T y "Article" Rich Results)
  mainEntitySchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    image: absoluteImage,
    author: {
      "@type": "Person",
      name: authorName,
    },
    publisher: { "@id": `${siteURL}/#organization` },
    datePublished: publishDate,
    description: description,
  };
} else {
  // Fallback a LocalBusiness
  mainEntitySchema = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${siteURL}/#organization`,
    name: title,
    description: description,
  };
}

// 4. Schema de Breadcrumbs (Migas de Pan)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteURL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: title,
      item: canonicalURL,
    },
  ],
};

// 5. Schema de FAQ
let faqSchema = null;
if (faqData.length > 0) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqData.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  };
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/ppr-icon.png" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  !noindex && (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:site_name" content="Paramount Property Restoration" />
<meta property="og:locale" content="en_US" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absoluteImage} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    ...organizationSchema,
  })}
/>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(mainEntitySchema)}
/>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema)}
/>

{
  faqSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  )
}

{
  customSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(customSchema)}
    />
  )
}
