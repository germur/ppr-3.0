---
interface Props {
    variant?: "default" | "emergency";
    theme?: "light" | "dark" | "transparent";
    sticky?: boolean;
    secondaryColor?: string; // Hex color for hover states/accents
    emergencyBtnText?: string;
    logoText?: string;
}

import { COMPANY_INFO } from "../../data/company";

const {
    variant = "default",
    theme = "light",
    sticky = true,
    secondaryColor = "#0d7ff2", // Default Primary Blue
    emergencyBtnText = COMPANY_INFO.phone,
} = Astro.props;

import Navigation from "./Navigation.astro";

// Theme-based classes
const themeClasses = {
    light: "bg-white border-b border-gray-100 text-slate-900",
    dark: "bg-[#101922] border-b border-gray-800 text-white",
    transparent:
        "bg-transparent border-b border-white/10 text-white backdrop-blur-md",
};
---

<header
    class:list={[
        "w-full z-50 transition-colors duration-300",
        sticky ? "sticky top-0" : "relative",
        themeClasses[theme],
    ]}
    style={`--secondary-color: ${secondaryColor};`}
>
    <div class="max-w-[1280px] mx-auto px-4 lg:px-4 xl:px-8">
        <div
            class="flex items-center lg:items-center justify-between h-20 lg:h-24"
        >
            <!-- Brand Logo -->
            <a
                href="/"
                class="block shrink-0 group relative z-10 flex items-center h-full py-1"
            >
                <!-- Mobile Icon -->
                <img
                    src="/ppr-icon.png"
                    alt="Paramount Property Restoration"
                    class="h-12 w-auto object-contain lg:hidden transition-transform group-hover:scale-105"
                />
                <!-- Desktop Logo - Natural Size -->
                <img
                    src="/ppr-logo.png"
                    alt="Paramount Property Restoration"
                    class="hidden lg:block h-10 xl:h-14 w-auto object-contain transition-transform group-hover:scale-105"
                />
            </a>

            <!-- Desktop Navigation -->
            <Navigation theme={theme} secondaryColor={secondaryColor} />

            <!-- Action Buttons -->
            <div class="flex items-center gap-3 shrink-0 mb-1">
                <a
                    href={variant === "emergency" ? "/contact" : "/contact"}
                    class={`hidden sm:flex items-center justify-center px-4 xl:px-6 py-2 xl:py-2.5 rounded-lg text-white font-bold text-xs xl:text-sm transition-all hover:opacity-90 shadow-sm whitespace-nowrap`}
                    style={`background-color: ${secondaryColor}`}
                >
                    {variant === "emergency" ? "File a Claim" : "Request Quote"}
                </a>

                <!-- Emergency Button -->
                <a
                    href={`tel:${COMPANY_INFO.phoneRaw}`}
                    class="flex items-center gap-2 px-4 xl:px-6 py-2 xl:py-2.5 rounded-lg text-white font-bold text-xs xl:text-sm transition-all shadow-lg hover:opacity-90 animate-pulse whitespace-nowrap"
                    style="background-color: #dc2626;"
                >
                    <span class="material-symbols-outlined text-[20px]"
                        >phone_in_talk</span
                    >
                    <span class="hidden lg:inline">{emergencyBtnText}</span>
                    <span class="lg:hidden">Call</span>
                </a>
            </div>

            <!-- Mobile Menu Toggle -->
            <button
                id="mobile-menu-btn"
                class={`lg:hidden ${theme === "light" ? "text-slate-900" : "text-white"}`}
                aria-label="Open menu"
            >
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
        </div>
    </div>
</header>
