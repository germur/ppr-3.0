<script>
    // Initial check
    // We actually handle this better with CSS media queries for display,
    // but <details> 'open' attribute is semantic.
    // Ensuring 'open' is present on desktop via script is a good progressive enhancement.

    // Simple CSS-only approach for the 'open' state is hard because the attribute controls visibility.
    // We will use a script to enforce 'open' on desktop load.

    window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024) {
            document
                .querySelectorAll("footer details")
                .forEach((d) => d.setAttribute("open", ""));
        }
    });

    if (window.innerWidth >= 1024) {
        document
            .querySelectorAll("footer details")
            .forEach((d) => d.setAttribute("open", ""));
    }
</script>

<style>
    /* Turn off the default marker for summary everywhere (we use custom icon) */
    details > summary {
        list-style: none;
    }
    details > summary::-webkit-details-marker {
        display: none;
    }
</style>
