---
const { theme = "light" } = Astro.props;
import { COMPANY_INFO } from "../../data/company";

// Theme-based classes matching Header logic
const textColorClass =
    theme === "light"
        ? "text-slate-700 hover:text-[var(--secondary-color)]"
        : "text-slate-300 hover:text-white";
const secondaryColor = Astro.props.secondaryColor || "#0d7ff2";

const links = [
    { href: "/restoration/", label: "Restoration" },
    { href: "/service-areas/", label: "Locations" },
    { href: "/commercial/", label: "Commercial" },
    { href: "/resources/", label: "Resources" },
];
