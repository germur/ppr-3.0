---
const { title, features } = Astro.props;
---

<section class="py-24 bg-slate-50">
    <div class="container mx-auto px-4 max-w-6xl">
        <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">
            {title}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                features.map((feature) => {
                    const Icon = feature.icon;
                    const cardClasses =
                        "bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-all border border-slate-100 block h-full hover:translate-y-[-5px] duration-300";

                    return feature.link ? (
                        <a href={feature.link} class={cardClasses}>
                            <div class="h-full">
                                <div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-xl flex items-center justify-center mb-6">
                                    <Icon size={24} />
                                </div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">
                                    {feature.title}
                                </h3>
                                <p class="text-slate-500 text-sm leading-relaxed">
                                    {feature.description}
                                </p>
                            </div>
                        </a>
                    ) : (
                        <div class={cardClasses}>
                            <div class="h-full">
                                <div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-xl flex items-center justify-center mb-6">
                                    <Icon size={24} />
                                </div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">
                                    {feature.title}
                                </h3>
                                <p class="text-slate-500 text-sm leading-relaxed">
                                    {feature.description}
                                </p>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>
