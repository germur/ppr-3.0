                            <span class="truncate">Get Your Estimate</span>
                        </button>
                        <button class="flex min-w-[200px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-12 px-6 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white border border-white/30 text-base font-bold leading-normal tracking-[0.015em] transition-colors">
                            <span class="truncate">View Our Portfolio</span>
                        </button>
                    </div>
                    {/* Trust Badges Overlay */}
                    <div class="absolute bottom-6 left-0 right-0 flex justify-center gap-6 opacity-80">
                        <div class="flex items-center gap-2 text-white text-xs font-semibold uppercase tracking-wide">
