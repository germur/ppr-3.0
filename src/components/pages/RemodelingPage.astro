---
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

interface Props {
  city: CollectionEntry<'cities'>;
  service: {
    slug: string;
    type: 'restoration' | 'remodeling' | 'commercial'; // More specific if possible
    name: string;
  };
}

const { city, service } = Astro.props;
const { 
  name: cityName, 
  remodeling_desire, 
  local_building_dept, 
  local_service_radius, 
  stats, 
  compliance 
} = city.data;

// Dynamic Data setup
const roi = stats?.roi || '85%';
const valueIncrease = stats?.value_increase || '+12%';

// Tagline Logic
const taglines: Record<string, string> = {
  'Kitchen Remodeling': 'Crafting Your Culinary Oasis',
  'Bathroom Remodeling': 'Your Private Spa Retreat',
  'Whole Home Renovation': 'Reimagining Your Living Space',
  'Commercial Renovation': 'Building Business Success'
};
const tagline = taglines[service.name] || 'Excellence in Every Detail';

const isKitchen = service.slug === 'kitchen-remodeling';

// Image Logic (Fallbacks if no dynamic image provided)
const heroImage = isKitchen 
  ? 'https://lh3.googleusercontent.com/aida-public/AB6AXuAmVMMj3fxbRmw8hLgcwdCjLmSJAO8-lhT5S6-4cDlWVIzxmWtrAh1bbst00D3IYs1C9vXQt_Hz2P9ocQTngc0umxpOyzmDRlD8nJm6BIm8O8rLLoKm5fhYS2e4zjWnIArg9Ovlzlrdnb8Kqen3XDulKXQVeCGT2wFzdiNmfyxPPmMm1zl1IqoKfNMOrx7CsNWIbfeLqAuYkRIEGdXOb6Nl6FvcYQEraKW_-zMxbKk2afQ-UdhuLzqd1BUu7Z3y8Etan-ouvzYb1OVc'
  : 'https://lh3.googleusercontent.com/aida-public/AB6AXuBiEiy8YZs7Ig69Nfh1r0kKx5r3UmECqxmz3OJW5rJW9fg1ixUW6moZlDyfp4bH6kzBRLBF7e2_BGdhpZqxDbxUmER70o68ygV-ck_YYZ2WTsKhE1lUh-DyV-xn_8de08hmBZ-egPoPQtWdAOJYWNb-szb4_RVJhi71mTPk-IgW3Ng5biI-mOfW1lfNwnryWRDhJJ6Sp4KIv-rAc09H3WLYj0kGhwKkrIzXptT5USdVN4KMoH3TMtU10xAYOuz1EgJWn8ZaKRbzK9VT';

---

<MainLayout 
  title={`${service.name} ${cityName} | Paramount Property Restoration`}
  description={`Premier luxury ${service.name} services in ${cityName}. Custom design, licensed contracting, and clear communication. ${remodeling_desire}`}
  city={cityName}
  serviceName={service.name}
  schemaType="Service"
>
    
    {/* HeroSection */}
    <div class="w-full bg-white dark:bg-[#111418]">
        <div class="flex flex-col items-center">
            <div class="w-full max-w-[1280px] p-4 md:px-10 md:py-8">
                <div class="relative flex min-h-[560px] flex-col gap-6 overflow-hidden rounded-xl bg-cover bg-center bg-no-repeat p-8 md:gap-8 items-center justify-center text-center shadow-lg" 
                     data-alt={`Luxury ${service.name} in ${cityName}`} 
                     style={`background-image: linear-gradient(rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.6) 100%), url("${heroImage}");`}>
                    
                    <div class="flex flex-col gap-4 max-w-[800px]">
                        <span class="mx-auto w-fit rounded-full bg-white/20 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white backdrop-blur-md">
                            Serving {cityName} & Southwest Florida
                        </span>
                        <h1 class="text-white text-4xl font-black leading-tight tracking-[-0.033em] md:text-6xl drop-shadow-sm">
                            {cityName} {service.name}: {tagline}
                        </h1>
                        <h2 class="text-white/90 text-base font-medium leading-relaxed md:text-xl max-w-[640px] mx-auto drop-shadow-sm">
                            {remodeling_desire}
