                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {/* Bento Grid Services */}
    <div class="w-full bg-white dark:bg-[#111418] py-12 md:py-20">
        <div class="flex justify-center">
            <div class="w-full max-w-[1280px] px-4 md:px-10 flex flex-col gap-10">
                <div class="flex flex-col items-center text-center gap-4">
                    <h2 class="text-[#111418] dark:text-white text-3xl font-bold leading-tight tracking-[-0.015em] md:text-4xl">Our Specialized Services</h2>
                    <p class="text-[#617289] dark:text-gray-400 max-w-2xl">Tailored renovation solutions for every corner of your {cityName} property.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[400px]">
                    {/* Card 1: Main Feature (Dynamic to Service) */}
                    <div class="group relative flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-100 p-6 shadow-md transition-all hover:shadow-xl md:col-span-2">
                        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" 
                             style={`background-image: url("${isKitchen ? 'https://lh3.googleusercontent.com/aida-public/AB6AXuB44qeiOVzcAu2hRN5l625UiYVgEChEd98mxg_6_dZY0JmPzBaRvWb5vfH3jMY07c_5ekPvj2j7EmK_TKwBXBGnTcK3ic-7kAX5_eFCZALV9AWQS3zKwMpWTTPyZARwOCORbncuY4LVjywvJLVnHQidy2TIXWRLY2SHT2TAq9iJffBRlJkYXJnPZRWpOTUSJepAMeg-8LjJBLGI8HFDQsrKeB-Lgi3R8kaX3WpktjA_D8sXnA7TzLNZqplObpvmTfYt69vMJ8kCSQpA' : 'https://lh3.googleusercontent.com/aida-public/AB6AXuBiEiy8YZs7Ig69Nfh1r0kKx5r3UmECqxmz3OJW5rJW9fg1ixUW6moZlDyfp4bH6kzBRLBF7e2_BGdhpZqxDbxUmER70o68ygV-ck_YYZ2WTsKhE1lUh-DyV-xn_8de08hmBZ-egPoPQtWdAOJYWNb-szb4_RVJhi71mTPk-IgW3Ng5biI-mOfW1lfNwnryWRDhJJ6Sp4KIv-rAc09H3WLYj0kGhwKkrIzXptT5USdVN4KMoH3TMtU10xAYOuz1EgJWn8ZaKRbzK9VT'}");`}>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="relative z-10 flex flex-col gap-2">
                            <div class="w-fit rounded-lg bg-[#ea580c]/90 px-3 py-1 text-xs font-bold text-white uppercase mb-2">Most Popular</div>
                            <h3 class="text-3xl font-bold text-white">{cityName} Luxury {isKitchen ? 'Kitchens' : 'Bathrooms'}</h3>
                            <p class="text-white/90 text-lg max-w-md">Custom designs and high-end finishes for the connoisseur.</p>
                            <a class="mt-2 flex items-center gap-2 font-bold text-white hover:underline" href="#">View Portfolio <span class="material-symbols-outlined text-sm">arrow_outward</span></a>
                        </div>
                    </div>

                    {/* Card 2: Secondary (The 'Other' Service) */}
                    <a href={isKitchen ? `/service-areas/${city.slug}/bathroom-remodeling/` : `/service-areas/${city.slug}/kitchen-remodeling/`} class="group relative flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-100 p-6 shadow-md transition-all hover:shadow-xl">
                        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" 
                             style={`background-image: url("${isKitchen ? 'https://lh3.googleusercontent.com/aida-public/AB6AXuBiEiy8YZs7Ig69Nfh1r0kKx5r3UmECqxmz3OJW5rJW9fg1ixUW6moZlDyfp4bH6kzBRLBF7e2_BGdhpZqxDbxUmER70o68ygV-ck_YYZ2WTsKhE1lUh-DyV-xn_8de08hmBZ-egPoPQtWdAOJYWNb-szb4_RVJhi71mTPk-IgW3Ng5biI-mOfW1lfNwnryWRDhJJ6Sp4KIv-rAc09H3WLYj0kGhwKkrIzXptT5USdVN4KMoH3TMtU10xAYOuz1EgJWn8ZaKRbzK9VT' : 'https://lh3.googleusercontent.com/aida-public/AB6AXuB44qeiOVzcAu2hRN5l625UiYVgEChEd98mxg_6_dZY0JmPzBaRvWb5vfH3jMY07c_5ekPvj2j7EmK_TKwBXBGnTcK3ic-7kAX5_eFCZALV9AWQS3zKwMpWTTPyZARwOCORbncuY4LVjywvJLVnHQidy2TIXWRLY2SHT2TAq9iJffBRlJkYXJnPZRWpOTUSJepAMeg-8LjJBLGI8HFDQsrKeB-Lgi3R8kaX3WpktjA_D8sXnA7TzLNZqplObpvmTfYt69vMJ8kCSQpA'}");`}>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="relative z-10 flex flex-col gap-2">
                            <h3 class="text-2xl font-bold text-white">{isKitchen ? 'Spa Retreats' : 'Luxury Kitchens'}</h3>
                            <p class="text-white/90 text-sm">{isKitchen ? 'Transforming master baths.' : 'Culinary masterpieces.'}</p>
                        </div>
                    </a>

                    {/* Card 3: Outdoor Living */}
                    <div class="group relative flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-100 p-6 shadow-md transition-all hover:shadow-xl">
                        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAU6_1qRp2Mbpyzby2jIl3GsPeI0hcWKF9GFUJRtlxHSyN5X7EVyQsE6Fon_5nlP5CGTLPaLSdQpcXNMc5RSNnFOliQLl_USryDBjEk31EWDj2UcuLKsL4CZV2zJrTHjXHtFtYqKTMysinl5Y5s9f8BuhRGDJraAZkah9ET8iQiBjPNxqSMAS0ujySQNk7P3FOeo35-2nMMNtQ30O2_DdmAG6VuJAuPi9kQJWi9IBEppxNFKs7hushbCvXyMQ4FTvnn6-iFmgZjpK8n");'>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="relative z-10 flex flex-col gap-2">
                            <h3 class="text-2xl font-bold text-white">Outdoor Living</h3>
                            <p class="text-white/90 text-sm">Hurricane-resistant outdoor kitchens.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {/* Technical Authority & Market Data Split */}
    <div class="w-full bg-[#f0f4f8] dark:bg-[#161e28] py-12 md:py-20">
        <div class="flex justify-center">
            <div class="w-full max-w-[1280px] px-4 md:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12">
                {/* Technical Authority */}
                <div class="flex flex-col gap-6">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#1269e2]">gavel</span>
                        <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Compliance & Safety</span>
                    </div>
                    <h2 class="text-3xl font-bold text-[#111418] dark:text-white">Navigating {cityName} Building Requirements</h2>
                    <p class="text-[#617289] dark:text-gray-400">Our team handles all permitting, FEMA 50% rule calculations, and condo association approvals.</p>
                    <div class="flex flex-col gap-3">
                         {compliance ? compliance.map(item => (
                             <details class="group rounded-xl bg-white dark:bg-[#1e2732] p-4 shadow-sm open:shadow-md transition-all">
                                <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-[#111418] dark:text-white">
                                    <span>{item.title}</span>
                                    <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                                </summary>
                                <p class="mt-3 text-sm text-[#617289] dark:text-gray-400 leading-relaxed">{item.content}</p>
                            </details>
                         )) : (
                             // Fallback Content
                             <details class="group rounded-xl bg-white dark:bg-[#1e2732] p-4 shadow-sm open:shadow-md transition-all">
                                <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-[#111418] dark:text-white">
                                    <span>{cityName} Permitting Process</span>
                                    <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
                                </summary>
                                <p class="mt-3 text-sm text-[#617289] dark:text-gray-400 leading-relaxed">
                                    We work directly with {local_building_dept} to expedite approvals.
                                </p>
                            </details>
                         )}
                    </div>
                </div>

                {/* Market Data Widget */}
                <div class="flex flex-col gap-6">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#1269e2]">trending_up</span>
                        <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Market Insights</span>
                    </div>
                    <h2 class="text-3xl font-bold text-[#111418] dark:text-white">Why Renovate in {cityName} Now?</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-2 rounded-xl bg-white dark:bg-[#1e2732] p-6 shadow-sm border-l-4 border-[#1269e2]">
                            <span class="text-4xl font-black text-[#111418] dark:text-white">{roi}</span>
                            <span class="text-sm font-medium text-[#617289] dark:text-gray-400">Average ROI</span>
                        </div>
                        <div class="flex flex-col gap-2 rounded-xl bg-white dark:bg-[#1e2732] p-6 shadow-sm border-l-4 border-[#ea580c]">
