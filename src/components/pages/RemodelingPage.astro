                        </div>
                        <div class="flex items-center gap-2 text-white text-xs font-semibold uppercase tracking-wide">
                            <span class="material-symbols-outlined text-[#ea580c] text-lg">home_work</span> Local Experts
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {/* Local Context Section */}
    <div class="w-full bg-[#f8fafe] dark:bg-[#1a222c] py-12 md:py-20">
        <div class="flex justify-center">
            <div class="w-full max-w-[1280px] px-4 md:px-10">
                <div class="flex flex-col lg:flex-row gap-12 items-center">
                    <div class="flex flex-col gap-6 lg:w-1/2">
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center gap-2">
                                <div class="h-1 w-12 rounded-full bg-[#1269e2]"></div>
                                <span class="text-sm font-bold text-[#1269e2] uppercase tracking-wider">Local Context</span>
                            </div>
                            <h2 class="text-[#111418] dark:text-white text-3xl font-black leading-tight tracking-[-0.02em] md:text-5xl">
                                Remodeling for the {cityName} Lifestyle
                            </h2>
                            <p class="text-[#4e5d78] dark:text-gray-300 text-lg leading-relaxed">
                                Designing for {cityName} means understanding coastal climate challenges like humidity and salt air, while meeting the high standards of luxury entertaining.
                            </p>
                            <p class="text-[#4e5d78] dark:text-gray-300 text-base leading-relaxed">
                                We navigate the complexities of {local_building_dept} permits and HOA regulations so you don't have to.
                            </p>
                        </div>
                        <button class="w-fit flex items-center gap-2 text-[#1269e2] font-bold text-lg hover:gap-3 transition-all">
                            Learn About Our Process <span class="material-symbols-outlined">arrow_forward</span>
