    </div>

    {/* Social Proof (Bypass mapping for now, keeping static high quality layout but with city name injection if needed) */}
    <div class="w-full bg-white dark:bg-[#111418] py-12 md:py-20">
        <div class="flex justify-center">
            <div class="w-full max-w-[1280px] px-4 md:px-10 flex flex-col gap-10">
                <div class="text-center max-w-3xl mx-auto">
                    <h2 class="text-[#111418] dark:text-white text-3xl font-bold leading-tight tracking-[-0.015em] mb-4">Trusted by Neighbors in {local_service_radius || cityName}</h2>
                    <div class="flex justify-center gap-1 text-yellow-400 mb-2">
                        <span class="material-symbols-outlined fill-current">star</span>
                        <span class="material-symbols-outlined fill-current">star</span>
                        <span class="material-symbols-outlined fill-current">star</span>
                        <span class="material-symbols-outlined fill-current">star</span>
                        <span class="material-symbols-outlined fill-current">star</span>
                    </div>
                    <p class="text-[#617289] dark:text-gray-400">5-Star Rated on Google Business Profile</p>
                </div>
                 <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="flex flex-col justify-between rounded-xl bg-[#f8fafe] dark:bg-[#1a222c] p-8">
                        <div class="flex flex-col gap-4">
                            <span class="material-symbols-outlined text-4xl text-[#1269e2]/40">format_quote</span>
                            <p class="text-[#111418] dark:text-gray-200 font-medium text-lg leading-relaxed">"The team at Paramount understood exactly what we wanted for our condo. They navigated the HOA rules flawlessly and delivered a stunning kitchen."</p>
                        </div>
                        <div class="mt-6 flex items-center gap-3">
                            <div class="h-10 w-10 rounded-full bg-gray-300 bg-cover bg-center" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuA8HaCtk2ZE7mx5CUghEEGUCA-ZiRx52cny_tpO8rWFHgDZTeik6Gj8sHQj4_xnULfYm1z-xJ57s8OOqDcdTuH178PpQ_jYhs_QfZXkm28i_Ig6Sui8OEBDfbwceBp9Wl5PqbCZ87iLmn8ZXaFHHipj9lYkzJ9K7-R0v_oEuOjF8va6UvB81EwwifbCEepWZuXu8lSqTnzoudoYWEN7kDL3IE2_0oddCdGkeswkE1NOpJ4J2v8xeDojR057n3PPAmI8lWrZ3_jICEk5");'></div>
                            <div>
                                <p class="font-bold text-[#111418] dark:text-white">Sarah Jenkins</p>
                                <p class="text-sm text-[#617289] dark:text-gray-400">{cityName} Resident</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col justify-between rounded-xl bg-[#f8fafe] dark:bg-[#1a222c] p-8 shadow-lg ring-1 ring-[#1269e2]/10">
                        <div class="flex flex-col gap-4">
