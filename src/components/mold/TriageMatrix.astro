<div class="overflow-x-auto bg-white rounded-xl shadow-lg border border-gray-100">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
                <th class="p-6 text-sm font-bold text-slate-500 uppercase tracking-wider">Feature</th>
                <th class="p-6 text-sm font-bold text-red-500 uppercase tracking-wider w-1/3 text-center bg-red-50/50">"Free" Mold Inspection</th>
                <th class="p-6 text-sm font-bold text-green-600 uppercase tracking-wider w-1/3 text-center bg-green-50/50">Certified Mold Testing</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 font-medium text-slate-700">Conflict of Interest?</td>
                <td class="p-6 text-center text-red-600 font-bold bg-red-50/10">YES (They want to sell repairs)</td>
                <td class="p-6 text-center text-green-600 font-bold bg-green-50/10">NO (Unbiased Results)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 font-medium text-slate-700">Lab Analysis?</td>
                <td class="p-6 text-center text-slate-500">No (Visual only)</td>
                <td class="p-6 text-center text-green-600 font-bold bg-green-50/10">YES (Certified Lab)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 font-medium text-slate-700">Identifies Mold Species?</td>
                <td class="p-6 text-center text-slate-500">No (Guesswork)</td>
                <td class="p-6 text-center text-green-600 font-bold bg-green-50/10">YES (Exact Strain ID)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 font-medium text-slate-700">Legal Documentation?</td>
                <td class="p-6 text-center text-slate-500">Weak/None</td>
                <td class="p-6 text-center text-green-600 font-bold bg-green-50/10">YES (Admissible coverage)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 font-medium text-slate-700">Hidden Mold Detection?</td>
                <td class="p-6 text-center text-slate-500">Unlikely</td>
                <td class="p-6 text-center text-green-600 font-bold bg-green-50/10">YES (Air Spore Trap)</td>
            </tr>
        </tbody>
    </table>
</div>
